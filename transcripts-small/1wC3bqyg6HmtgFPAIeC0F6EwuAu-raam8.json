{
  "source": "1wC3bqyg6HmtgFPAIeC0F6EwuAu-raam8.mp4",
  "sha256": "3caf713cc0a843ccb0390395287cb21a18308b025d562f807b36514f635fa559",
  "model": "small",
  "language": "he",
  "language_probability": 1,
  "duration_seconds": 266.56,
  "elapsed_seconds": 205.28882336616516,
  "segments": [
    {
      "start": 0.02,
      "end": 4.02,
      "text": "נגד, שאלות על מה שהיה, כן, אילנטי שלישו?"
    },
    {
      "start": 4.02,
      "end": 10.86,
      "text": "אני לא שומרת אחרת."
    },
    {
      "start": 10.86,
      "end": 18.86,
      "text": "כן, PUSH, PUSH-DS אומר תזיז את DS, שימ אותו בראש התוכנית,"
    },
    {
      "start": 18.86,
      "end": 26.39,
      "text": "ופה SS אומר תכניס את SS לזירה ושימ אותו בסוף התוכנית."
    },
    {
      "start": 26.39,
      "end": 29.51,
      "text": "אני הייתי אומר את זה אחרת."
    },
    {
      "start": 29.51,
      "end": 38.25,
      "text": "הפקודה STOSW, הפקודה AB, יודעת שהיא צריכה לעשות קופי פייסט לתוך האקסטרסגנט."
    },
    {
      "start": 38.25,
      "end": 41.25,
      "text": "האם זה מובן? לתם מספר 20 אלף במטה, מובן?"
    },
    {
      "start": 41.25,
      "end": 42.25,
      "text": "כן."
    },
    {
      "start": 42.25,
      "end": 46.66,
      "text": "זאת אומרת, היא הולכת להסתכל על להוגן ES,"
    },
    {
      "start": 46.66,
      "end": 50.66,
      "text": "ומה שכתוב שם לשם היא הולכת, זו העיר שהיא הולכת אליה,"
    },
    {
      "start": 50.66,
      "end": 54.08,
      "text": "זו הסגמן שהיא הולכת אליה, האם זה מובן?"
    },
    {
      "start": 54.08,
      "end": 55.08,
      "text": "כן."
    },
    {
      "start": 55.08,
      "end": 59.46,
      "text": "אם אני משנה את מה שכתוב BS, אז היא הולכת למקום אחר,"
    },
    {
      "start": 59.46,
      "end": 62.46,
      "text": "לא להעירה נכונה, לא לסגמנט הנכון,"
    },
    {
      "start": 62.46,
      "end": 65.46,
      "text": "אז מה שאני עושה אני, כשאני משנה את ES,"
    },
    {
      "start": 65.46,
      "end": 71.5,
      "text": "בין צעות פוש, מתנדוחת למחסנית את DS, שזה אלף,"
    },
    {
      "start": 71.5,
      "end": 75.75,
      "text": "ועושה POP לתוך SS, אז SS עופר,"
    },
    {
      "start": 75.75,
      "end": 79.75,
      "text": "או ES, הופכים מ-1000 ל-1000,"
    },
    {
      "start": 79.75,
      "end": 81.75,
      "text": "או מ-1400 ל-1000,"
    },
    {
      "start": 81.75,
      "end": 84.78,
      "text": "אז הם פשוט הופכים להיות מצביעים"
    },
    {
      "start": 84.78,
      "end": 88.78,
      "text": "לזירה במקום למחסנית או לאקסר סגמנט."
    },
    {
      "start": 89.17,
      "end": 91.55,
      "text": "אני הבנתי את המחסנית,"
    },
    {
      "start": 91.55,
      "end": 94.55,
      "text": "אבל לא הבנתי מה זאת אומר האקסר סגמנט."
    },
    {
      "start": 94.55,
      "end": 96.55,
      "text": "האקסר סגמנט זה זה."
    },
    {
      "start": 96.55,
      "end": 99.12,
      "text": "אתה לא בשטוף."
    },
    {
      "start": 99.12,
      "end": 103.42,
      "text": "אנחנו בהקלטה?"
    },
    {
      "start": 103.42,
      "end": 104.94,
      "text": "כן."
    },
    {
      "start": 104.94,
      "end": 105.94,
      "text": "כן."
    },
    {
      "start": 105.94,
      "end": 106.94,
      "text": "כן."
    },
    {
      "start": 106.94,
      "end": 108.94,
      "text": "האקסר סגמנט זה זה, אלף,"
    },
    {
      "start": 108.94,
      "end": 110.94,
      "text": "אם אני עושה דיבג, רגע,"
    },
    {
      "start": 110.94,
      "end": 114.94,
      "text": "אנחנו עובדת בברום,"
    },
    {
      "start": 114.94,
      "end": 118.28,
      "text": "כל השאר,"
    },
    {
      "start": 118.28,
      "end": 122.41,
      "text": "כדי שלא ילנו בלגן בהרבנה,"
    },
    {
      "start": 122.41,
      "end": 131.92,
      "text": "כן?"
    },
    {
      "start": 131.92,
      "end": 136.9,
      "text": "אז האקסר סגמנט זה זה."
    },
    {
      "start": 136.9,
      "end": 145.37,
      "text": "השאר ממורי?"
    },
    {
      "start": 145.37,
      "end": 147.62,
      "text": "השאר ממורי, שזה פה."
    },
    {
      "start": 147.62,
      "end": 149.62,
      "text": "זה זיכרון פה."
    },
    {
      "start": 149.62,
      "end": 151.62,
      "text": "לאן שעשתו ה-SW הולך"
    },
    {
      "start": 151.62,
      "end": 153.62,
      "text": "מנכתחיל להפלזנו שלי."
    },
    {
      "start": 153.62,
      "end": 155.62,
      "text": "כן, מנכתחיל להעשתו ה-SW"
    },
    {
      "start": 155.62,
      "end": 159.83,
      "text": "יודע שהוא צריך ללכת לפה,"
    },
    {
      "start": 159.83,
      "end": 163.83,
      "text": "אבל ברגע שאני משנה את מה שכתוב פה ב-IS,"
    },
    {
      "start": 163.83,
      "end": 165.83,
      "text": "ואני גורם לו ללכת לפה,"
    },
    {
      "start": 165.83,
      "end": 168.06,
      "text": "אז הוא הולך למקום הלא נכון."
    },
    {
      "start": 168.06,
      "end": 171.09,
      "text": "ואז אני נכנס את הזירה ומתחיל להתקוף."
    },
    {
      "start": 171.09,
      "end": 173.18,
      "text": "בדיוק?"
    },
    {
      "start": 173.18,
      "end": 175.18,
      "text": "אין זה מובן?"
    },
    {
      "start": 175.18,
      "end": 177.22,
      "text": "הוא תוקף ביילות גדולה."
    },
    {
      "start": 177.22,
      "end": 179.22,
      "text": "עוד שאלות?"
    },
    {
      "start": 179.22,
      "end": 182.22,
      "text": "כן, שערבים קום האקס נתחוף משהו אחר,"
    },
    {
      "start": 182.22,
      "end": 184.22,
      "text": "כאילו הוא לא יודע כמו..."
    },
    {
      "start": 184.22,
      "end": 186.22,
      "text": "לא, סטו-SW יכולה,"
    },
    {
      "start": 186.22,
      "end": 189.22,
      "text": "סטו-SW ופו-SW יכולות רק"
    },
    {
      "start": 189.22,
      "end": 191.22,
      "text": "את מה שיש ב-AX לעשות."
    },
    {
      "start": 191.22,
      "end": 192.34,
      "text": "אוקיי."
    },
    {
      "start": 192.34,
      "end": 194.34,
      "text": "זאת אומרת, עם קופי פייסט,"
    },
    {
      "start": 194.34,
      "end": 195.34,
      "text": "אני לא יכול לגרום את פקודה לעשות"
    },
    {
      "start": 195.34,
      "end": 197.34,
      "text": "מה שהיא לא מסלובת את אליה מראש."
    },
    {
      "start": 197.34,
      "end": 199.34,
      "text": "הפקודה סטו-SW,"
    },
    {
      "start": 199.34,
      "end": 201.34,
      "text": "קקודה פושי X,"
    },
    {
      "start": 201.34,
      "end": 203.34,
      "text": "אני לא יכול לגרום לעבוד"
    },
    {
      "start": 203.34,
      "end": 205.34,
      "text": "עם אוגרים אחרים."
    },
    {
      "start": 205.34,
      "end": 207.34,
      "text": "סטו-SW עובדת עם האוגר-S"
    },
    {
      "start": 207.34,
      "end": 209.34,
      "text": "כדי להבין לאסס סגמנט להגיע."
    },
    {
      "start": 209.34,
      "end": 211.34,
      "text": "עם האוגר-DI"
    },
    {
      "start": 211.34,
      "end": 213.34,
      "text": "כדי להבין בתוך הסגמנט איפה ולהתמכם."
    },
    {
      "start": 213.34,
      "end": 215.34,
      "text": "ומאגר-AX"
    },
    {
      "start": 215.34,
      "end": 217.92,
      "text": "כדי להבין מה לדבי."
    },
    {
      "start": 217.92,
      "end": 219.92,
      "text": "סטו-SW עובדת עם"
    },
    {
      "start": 219.92,
      "end": 222.08,
      "text": "Bears,"
    },
    {
      "start": 222.08,
      "end": 224.08,
      "text": "כדי להבין לאסס סגמנט להגיע,"
    },
    {
      "start": 224.08,
      "end": 225.08,
      "text": "שזה המחסנית,"
    },
    {
      "start": 225.08,
      "end": 227.11,
      "text": "עם האוגר-SP"
    },
    {
      "start": 227.11,
      "end": 229.11,
      "text": "כדי להבין בתוך המחסנית איפה"
    },
    {
      "start": 229.11,
      "end": 248.91,
      "text": "ומאוגר אי איקס כדי להבין מלד ביקשם האם זה מובן וגם אי פושי איקס יודעת שיובד את החוק שהיא גורמת לאס פי פחות שתיים פחות שתיים פחות שתיים וסטוי זו הוא עושה פלוש שתיים פלוש שתיים לדייי אני לא יכול"
    },
    {
      "start": 248.91,
      "end": 266.4,
      "text": "שנות את זה אני רק יכול לשנות את התוכן שלהוגלים כדי לעוות את איך שהאינטראט עובד כל מיזה אינטראט האם זה מובן כן סבבה אני גומר רק לתה ועובר לנו סבבה"
    }
  ]
}