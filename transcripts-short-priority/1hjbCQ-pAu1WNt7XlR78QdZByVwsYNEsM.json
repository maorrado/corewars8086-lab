{
  "source": "1hjbCQ-pAu1WNt7XlR78QdZByVwsYNEsM.mp4",
  "sha256": "dcf6a4d86452ca1a34774f26ae77cac05c2560c98e33e51a0dab9d6680808809",
  "model": "small",
  "language": "he",
  "language_probability": 1,
  "duration_seconds": 531.9253125,
  "elapsed_seconds": 658.7743511199951,
  "segments": [
    {
      "start": 0.0,
      "end": 3.0,
      "text": "מה שמתקרים לנסת קום, ואז זה נכון בגמות."
    },
    {
      "start": 3.0,
      "end": 8.2,
      "text": "כן, של כל הנקודות שצריך לשים לב אליהם."
    },
    {
      "start": 8.2,
      "end": 13.4,
      "text": "אני מציע לכולם להקשיב להקלטה מלאה הזאת, אבל כסיכום."
    },
    {
      "start": 13.4,
      "end": 18.62,
      "text": "אחד, אורחים יש מעט מאוד עם בכלל נוכל לאפשר."
    },
    {
      "start": 18.62,
      "end": 23.98,
      "text": "יש לנו אחר ורק מהמקומות 70 שחקנים,"
    },
    {
      "start": 23.98,
      "end": 27.42,
      "text": "בסביבות עשרה אנשי צוות, עשרה אורחים,"
    },
    {
      "start": 27.42,
      "end": 30.02,
      "text": "נשארו לי מקום ל-10-15 אורחים."
    },
    {
      "start": 30.02,
      "end": 36.02,
      "text": "עד רק במקרה ממש ממש דחוף, אורח יכול להגיע,"
    },
    {
      "start": 36.02,
      "end": 40.02,
      "text": "אורים יכולים לחוקות בחוץ, יש לנו בדיוק,"
    },
    {
      "start": 40.02,
      "end": 42.62,
      "text": "המקום קטן יש ברק מהמקומות."
    },
    {
      "start": 42.62,
      "end": 45.82,
      "text": "יהיה דוקס של אורחים, אנחנו נעשר."
    },
    {
      "start": 45.82,
      "end": 47.42,
      "text": "זה דבר אחד, דבר שני."
    },
    {
      "start": 47.42,
      "end": 50.02,
      "text": "כל התחרות היא מאפס."
    },
    {
      "start": 50.02,
      "end": 55.42,
      "text": "יש לכם ביום שלישי, zombie, zombie fractal, רק לבוגרים."
    },
    {
      "start": 55.42,
      "end": 60.02,
      "text": "אתם מנסים לפתור אותו, מגישים אותו לפני התחרות ביום חמישי,"
    },
    {
      "start": 60.02,
      "end": 62.62,
      "text": "באיזשהו שעה, אולי בשתיים, אולי פשוט שלוש, אולי בער,"
    },
    {
      "start": 62.62,
      "end": 64.22,
      "text": "אני לא יודע, נחליט."
    },
    {
      "start": 64.22,
      "end": 69.22,
      "text": "אחר כך, zombie הזה ייתן לכם איזשהו אחוז מסוים בניקול."
    },
    {
      "start": 69.22,
      "end": 73.02,
      "text": "אחר כך בתחרות, זה הולך ככה."
    },
    {
      "start": 73.02,
      "end": 76.42,
      "text": "אתם מקבלים zombie,"
    },
    {
      "start": 76.42,
      "end": 79.22,
      "text": "אה, עוד דבר ברק מרח שום."
    },
    {
      "start": 79.22,
      "end": 83.62,
      "text": "המלצה שלי, תגיעו בשעה ארבע."
    },
    {
      "start": 83.62,
      "end": 89.9,
      "text": "תגיעו מוקדם, תתפסו מקום טוב, תבויו כולם, אם נפצלים,"
    },
    {
      "start": 89.9,
      "end": 92.58,
      "text": "אם מחשבים נידים,"
    },
    {
      "start": 92.58,
      "end": 98.78,
      "text": "אם חבילת גלישה בטלפון, אם מתאין למחשב, אם מתאין לטלפון,"
    },
    {
      "start": 98.78,
      "end": 103.18,
      "text": "אוכל לא צריך להביא, יש שם אוכל."
    },
    {
      "start": 103.18,
      "end": 107.38,
      "text": "אני לא יודע לגבי קשר, כן, יהיה קשר למאדרים,"
    },
    {
      "start": 107.38,
      "end": 110.98,
      "text": "יהיה קשר למאדרים, האוכל יהיה קשר למאדרים, אז לא בעיה."
    },
    {
      "start": 110.98,
      "end": 113.38,
      "text": "גם למכון, אולי דבר מלח."
    },
    {
      "start": 113.38,
      "end": 115.18,
      "text": "האוכל יהיה קשר למאדרים."
    },
    {
      "start": 115.18,
      "end": 116.57,
      "text": "בבדה."
    },
    {
      "start": 116.57,
      "end": 122.17,
      "text": "תראו, אם מישהו ממש, אז תביאו משהו, תביאו משהו שלכם,"
    },
    {
      "start": 122.17,
      "end": 127.17,
      "text": "אבל עקרונית, זה יהיה בדיוק כמו בקודגור מתמטיקה, אוכל קשר, בסדר?"
    },
    {
      "start": 127.17,
      "end": 132.57,
      "text": "עכשיו לגבי האירוע, אני מזכיר,"
    },
    {
      "start": 132.57,
      "end": 136.17,
      "text": "אתם מגיעים, מקבלים משימה,"
    },
    {
      "start": 136.17,
      "end": 142.77,
      "text": "באיזו רבע לחמש מתחילים אותה, בשש, שש ורבע מגישים אותה,"
    },
    {
      "start": 142.77,
      "end": 149.57,
      "text": "אנחנו מפרסמים את כל הסורדים של אלף,"
    },
    {
      "start": 149.57,
      "end": 152.57,
      "text": "את כל הסורדים של,"
    },
    {
      "start": 152.57,
      "end": 155.77,
      "text": "את כל סורדי אלף, גם של הבוגרים, גם של הצעירים,"
    },
    {
      "start": 155.77,
      "end": 159.77,
      "text": "יש לכם עוד בסבירות שעה, 40-50 דקות,"
    },
    {
      "start": 159.77,
      "end": 163.77,
      "text": "לעניינה על סורד אלף, מגישים את סורד בית,"
    },
    {
      "start": 163.77,
      "end": 169.17,
      "text": "בשבילות שבע, שבע ורבע אנחנו עושים הרצה,"
    },
    {
      "start": 169.17,
      "end": 172.17,
      "text": "יודעים מהטופפור בבוגרים בצעירים,"
    },
    {
      "start": 172.97,
      "end": 176.97,
      "text": "החבורה הזאת יוצאת החוצה מהפול של ההרצה,"
    },
    {
      "start": 176.97,
      "end": 179.17,
      "text": "יוצאת החוצה מהפול של ההרצה,"
    },
    {
      "start": 179.17,
      "end": 185.97,
      "text": "והיא ניגשת לעבודה, בזמן שהיא מרצה ההורח,"
    },
    {
      "start": 185.97,
      "end": 188.57,
      "text": "הגיעו אנשים מאוד מאוד מעניינים,"
    },
    {
      "start": 188.57,
      "end": 194.17,
      "text": "שגם התעניים בכם ובה אפשרות איך לעבוד איתכם,"
    },
    {
      "start": 194.17,
      "end": 196.57,
      "text": "מה לעשות איתכם בהמשך של החיים,"
    },
    {
      "start": 196.57,
      "end": 199.17,
      "text": "וגם כבספר לכם על דברים מגלימים,"
    },
    {
      "start": 199.17,
      "end": 203.17,
      "text": "התופפור לא יפלו לשמוע את ההרצות האלה,"
    },
    {
      "start": 203.17,
      "end": 204.17,
      "text": "הם הולכים לעבוד,"
    },
    {
      "start": 204.17,
      "end": 207.17,
      "text": "התופאית עדיין לא יודעים מה קורה איתם,"
    },
    {
      "start": 207.17,
      "end": 210.77,
      "text": "אבל הפרדנו את זה עכשיו בעצם יהיו ארבע תחרויות,"
    },
    {
      "start": 210.77,
      "end": 212.77,
      "text": "זאת אומרת יהיה תחרות לתופפור,"
    },
    {
      "start": 212.77,
      "end": 215.77,
      "text": "ולתופאית, ולתופפור, ולתופאית."
    },
    {
      "start": 217.86,
      "end": 220.66,
      "text": "כאשר, באזור 8, עם משהו כזה,"
    },
    {
      "start": 220.66,
      "end": 224.66,
      "text": "כאשר האירוע מסתיים והגישו את הדברים,"
    },
    {
      "start": 225.26,
      "end": 228.26,
      "text": "את ה... כולם הגישו,"
    },
    {
      "start": 228.26,
      "end": 234.26,
      "text": "אנחנו נריץ, אנחנו נותן תעודות"
    },
    {
      "start": 235.66,
      "end": 239.46,
      "text": "להרבה את המקומות הראשונים שפילו להרצית,"
    },
    {
      "start": 241.13,
      "end": 242.53,
      "text": "כתעודה."
    },
    {
      "start": 242.53,
      "end": 245.73,
      "text": "אחר כך אנחנו נריץ את התחרות של הטופ 8,"
    },
    {
      "start": 245.73,
      "end": 250.73,
      "text": "ונידע מקומות 8 עד 8, 7, 6 ו5,"
    },
    {
      "start": 250.73,
      "end": 254.73,
      "text": "ואז אנחנו נוסיף לזה ציון הפרקטל,"
    },
    {
      "start": 254.73,
      "end": 258.73,
      "text": "וזה יקבע את המועמדים, אז נדע מזה 8, 4, 6 ו5,"
    },
    {
      "start": 259.73,
      "end": 262.73,
      "text": "8, 7, 6 ו5, ואז נעשה את התופפור,"
    },
    {
      "start": 263.73,
      "end": 266.73,
      "text": "נוסיף לזה את הפרקטל, נעשה את התופור,"
    },
    {
      "start": 266.73,
      "end": 269.73,
      "text": "נדע מן 4, 2, 3, 1, ואז נוסיף את הפרקטל,"
    },
    {
      "start": 269.73,
      "end": 274.73,
      "text": "ואז נדע מזה 4, 2, 3, 1, ואז תעודות וצילומים,"
    },
    {
      "start": 275.73,
      "end": 278.73,
      "text": "ואז מדליות. מדליות רק לטופ 4,"
    },
    {
      "start": 278.73,
      "end": 280.73,
      "text": "מדלת זה אף כסף והרד,"
    },
    {
      "start": 280.73,
      "end": 286.73,
      "text": "וכל הטופ 4, טופ 4 של הבוגרים וטופ 4 של הקטנים,"
    },
    {
      "start": 287.73,
      "end": 290.73,
      "text": "מגיעים ליום כיף בחברת NSR,"
    },
    {
      "start": 291.73,
      "end": 294.73,
      "text": "שיהיה גם יום של פוטנציאל והעיונות עבודה."
    },
    {
      "start": 296.14,
      "end": 297.14,
      "text": "מובן לכולם?"
    },
    {
      "start": 297.14,
      "end": 302.14,
      "text": "מובן."
    },
    {
      "start": 303.34,
      "end": 305.34,
      "text": "שאלות? כלשהן? גאיטור?"
    },
    {
      "start": 306.34,
      "end": 308.34,
      "text": "יש תעודות גם למקום 8 ומטה?"
    },
    {
      "start": 309.34,
      "end": 311.5,
      "text": "תיבלתו כבר, בהתחרות הארצית."
    },
    {
      "start": 311.5,
      "end": 314.5,
      "text": "שיבדתי מהרצית את התעודה הזה."
    },
    {
      "start": 314.5,
      "end": 316.5,
      "text": "מה זה בדיוק טופ 4?"
    },
    {
      "start": 319.1,
      "end": 321.1,
      "text": "4 קבוצות העיונות."
    },
    {
      "start": 321.1,
      "end": 323.16,
      "text": "קבוצות עיונות."
    },
    {
      "start": 323.16,
      "end": 327.9,
      "text": "שאלה קולי, יהיה מקומות 1, 2, 3, 4, 5, 6, 7, 8."
    },
    {
      "start": 328.9,
      "end": 330.28,
      "text": "כן, דניאל."
    },
    {
      "start": 331.5,
      "end": 332.5,
      "text": "שתי שאלות."
    },
    {
      "start": 332.5,
      "end": 334.5,
      "text": "אחד, יהודי קיבלתי ממך,"
    },
    {
      "start": 335.5,
      "end": 339.5,
      "text": "מלפני בערך חצי שעה אימה ללנקים זומה,"
    },
    {
      "start": 339.5,
      "end": 341.5,
      "text": "אם הם נצא לעשות עם זה משהו,"
    },
    {
      "start": 341.5,
      "end": 344.5,
      "text": "ושתיים, האם יהיה פרסים קספיים,"
    },
    {
      "start": 344.5,
      "end": 347.5,
      "text": "או פרסים מקללי לגבוצות חוץ מהקבוצה במקום 8?"
    },
    {
      "start": 347.5,
      "end": 349.5,
      "text": "לא, אין פרסים קספיים."
    },
    {
      "start": 350.5,
      "end": 355.32,
      "text": "מדעת ליות יהודות, והזדמנו יד."
    },
    {
      "start": 356.32,
      "end": 357.48,
      "text": "אוקיי."
    },
    {
      "start": 357.48,
      "end": 358.48,
      "text": "בכל אופן."
    },
    {
      "start": 358.48,
      "end": 359.48,
      "text": "תעבור לצרחת קבוצות."
    },
    {
      "start": 359.48,
      "end": 361.51,
      "text": "אם צריך שאלות לגבי,"
    },
    {
      "start": 362.51,
      "end": 365.51,
      "text": "איך משהו עובד או קוד או כל מיני כאלה,"
    },
    {
      "start": 365.51,
      "end": 367.51,
      "text": "כי הבנתי שיש כאלה שזה לא שם להם עדיין,"
    },
    {
      "start": 368.51,
      "end": 369.51,
      "text": "אתה באמת, תעברו להעכשיוות,"
    },
    {
      "start": 369.51,
      "end": 371.51,
      "text": "ואתם יותר ממוזמנים לשאול אותנו את הצוות,"
    },
    {
      "start": 371.51,
      "end": 373.51,
      "text": "אנחנו בסמכנה עזור לכם."
    },
    {
      "start": 374.51,
      "end": 378.51,
      "text": "אבל ממש ממש חשוב, שכבר תענו על התפסים שצריך,"
    },
    {
      "start": 378.51,
      "end": 380.51,
      "text": "ותעשו את מה שצריך,"
    },
    {
      "start": 380.51,
      "end": 382.51,
      "text": "הם בנים זה הבדיקה שלכם באתר רגשות,"
    },
    {
      "start": 382.51,
      "end": 385.51,
      "text": "בנים זה לענות על הטופס ששלחתי,"
    },
    {
      "start": 385.51,
      "end": 387.51,
      "text": "או אם פתאום צעצר לכם משהו,"
    },
    {
      "start": 387.51,
      "end": 389.51,
      "text": "ואתם לא מגיעים, גם זה חשוב להתקן."
    },
    {
      "start": 389.51,
      "end": 391.74,
      "text": "איזה טופס שלחת?"
    },
    {
      "start": 391.74,
      "end": 392.74,
      "text": "שיחתי גם בו רצא וגם רצא."
    },
    {
      "start": 392.74,
      "end": 394.74,
      "text": "חפת לאור חי ביי."
    },
    {
      "start": 394.74,
      "end": 397.74,
      "text": "ועוד אני מזכיר,"
    },
    {
      "start": 397.74,
      "end": 399.74,
      "text": "חבר'ה, קחו לכם תיימים הקרובים,"
    },
    {
      "start": 399.74,
      "end": 401.74,
      "text": "תלמדו חזק,"
    },
    {
      "start": 401.74,
      "end": 403.74,
      "text": "תיכנסו לאתר, תיכנסו לאך שרות,"
    },
    {
      "start": 403.74,
      "end": 406.74,
      "text": "תלמדו לעבוד ותקודות,"
    },
    {
      "start": 406.74,
      "end": 409.74,
      "text": "עם אינטראפטים, עם כל פערים,"
    },
    {
      "start": 409.74,
      "end": 410.74,
      "text": "עם אנטי כל פערים,"
    },
    {
      "start": 410.74,
      "end": 411.74,
      "text": "כל מה שצריך,"
    },
    {
      "start": 411.74,
      "end": 413.74,
      "text": "תחשבו על אסטרוטגיות,"
    },
    {
      "start": 413.74,
      "end": 415.74,
      "text": "תבואו כצוות מוכנים,"
    },
    {
      "start": 415.74,
      "end": 418.74,
      "text": "תדועו מהחוזקות של אנשי הצוות שלכם,"
    },
    {
      "start": 418.74,
      "end": 420.74,
      "text": "תדועו מה, מילוקי אכמה,"
    },
    {
      "start": 420.74,
      "end": 421.74,
      "text": "מי עושה מה,"
    },
    {
      "start": 421.74,
      "end": 424.74,
      "text": "תחלקו לכם מראש את האירוע הזה,"
    },
    {
      "start": 424.74,
      "end": 426.74,
      "text": "ותבואו הכי מוכנים."
    },
    {
      "start": 426.74,
      "end": 429.74,
      "text": "זכייה."
    },
    {
      "start": 429.74,
      "end": 432.74,
      "text": "ועצם עובדה שהשתתפתם"
    },
    {
      "start": 432.74,
      "end": 435.74,
      "text": "התיישה ולכם המון בחיים,"
    },
    {
      "start": 435.74,
      "end": 437.74,
      "text": "התיישה ולכם המון לקריירה,"
    },
    {
      "start": 437.74,
      "end": 439.74,
      "text": "תיישה ולכם המון לחיים,"
    },
    {
      "start": 439.74,
      "end": 443.74,
      "text": "ובטח, בטח, מי שיגיע,"
    },
    {
      "start": 443.74,
      "end": 446.74,
      "text": "בטח, בטח, מי שיגיע לסגבות."
    },
    {
      "start": 446.74,
      "end": 449.74,
      "text": "אבל עצם עובדה שאתם בגמה,"
    },
    {
      "start": 449.74,
      "end": 451.74,
      "text": "יהיה למשמעות גבוהה,"
    },
    {
      "start": 451.74,
      "end": 454.74,
      "text": "ובי הלן ודוד,"
    },
    {
      "start": 454.74,
      "end": 456.74,
      "text": "אתם פשוט,"
    },
    {
      "start": 456.74,
      "end": 458.74,
      "text": "דוד, בגלל שאתה בכיתה היק,"
    },
    {
      "start": 458.74,
      "end": 460.74,
      "text": "קיבלת זכות מיוחדת,"
    },
    {
      "start": 460.74,
      "end": 462.74,
      "text": "להשתתף,"
    },
    {
      "start": 462.74,
      "end": 464.74,
      "text": "שתכם קיבלת זכות מיוחדת,"
    },
    {
      "start": 464.74,
      "end": 467.74,
      "text": "להשתתף בתחרות הצעירים."
    },
    {
      "start": 467.74,
      "end": 468.96,
      "text": "בסדר?"
    },
    {
      "start": 468.96,
      "end": 470.96,
      "text": "ואתם להשתתפים בפועל,"
    },
    {
      "start": 470.96,
      "end": 472.96,
      "text": "תסחקנים בתחרות הצעירים."
    },
    {
      "start": 472.96,
      "end": 474.96,
      "text": "אתם לא אוכל."
    },
    {
      "start": 474.96,
      "end": 476.99,
      "text": "תסחקנים, אתם לא אוכל."
    },
    {
      "start": 476.99,
      "end": 480.4,
      "text": "בסדר? עוד משהו?"
    },
    {
      "start": 480.4,
      "end": 482.4,
      "text": "אם יש שאלות,"
    },
    {
      "start": 482.4,
      "end": 484.4,
      "text": "מוזמנים לפנות אלינו גם בפרטי, כן?"
    },
    {
      "start": 484.4,
      "end": 485.4,
      "text": "זה ברור."
    },
    {
      "start": 485.4,
      "end": 487.4,
      "text": "אם זה שאלה מקצועית כזה על הקוד,"
    },
    {
      "start": 487.4,
      "end": 489.4,
      "text": "או על זומנים,"
    },
    {
      "start": 489.4,
      "end": 491.4,
      "text": "תכתבו גם בקרוצות,"
    },
    {
      "start": 491.4,
      "end": 493.4,
      "text": "רגע,"
    },
    {
      "start": 493.4,
      "end": 495.4,
      "text": "שבאה בקודו שאני צריך לך זרע במה שוב להבין,"
    },
    {
      "start": 495.4,
      "end": 497.4,
      "text": "אני יכול להיליש לך חודא?"
    },
    {
      "start": 497.4,
      "end": 499.4,
      "text": "נכון כך, תשאל,"
    },
    {
      "start": 499.4,
      "end": 501.4,
      "text": "יונתן יונתן,"
    },
    {
      "start": 501.4,
      "end": 503.4,
      "text": "בקרוצה, בפרטי, למישהו מאיתנו,"
    },
    {
      "start": 503.4,
      "end": 505.4,
      "text": "בין,"
    },
    {
      "start": 505.4,
      "end": 507.4,
      "text": "כל מי שטל, ירושל,"
    },
    {
      "start": 507.4,
      "end": 509.4,
      "text": "כל מי שרק יכול להיות זאת,"
    },
    {
      "start": 509.4,
      "end": 511.4,
      "text": "רות, איך צוות תשערות פה,"
    },
    {
      "start": 511.4,
      "end": 513.4,
      "text": "רגע, שנדבר,"
    },
    {
      "start": 513.4,
      "end": 515.4,
      "text": "וכל השאל,"
    },
    {
      "start": 515.4,
      "end": 517.4,
      "text": "תודה רבה שהגעתם."
    },
    {
      "start": 517.4,
      "end": 519.4,
      "text": "כפי שאמרנו גם,"
    },
    {
      "start": 519.4,
      "end": 521.4,
      "text": "כשיונתן אמר, באמת, כאילו,"
    },
    {
      "start": 521.4,
      "end": 523.4,
      "text": "התחרות הזאת בשבילכם,"
    },
    {
      "start": 523.4,
      "end": 525.4,
      "text": "ובאמת, אם תהיו חברים בה,"
    },
    {
      "start": 525.4,
      "end": 527.4,
      "text": "זה הכי חשוב, זה הרבה יותר חשוב מהשרד נצח בה."
    },
    {
      "start": 527.4,
      "end": 530.84,
      "text": "להיות חברים מחדשני."
    }
  ]
}