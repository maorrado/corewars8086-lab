     1                                  ; E1 Z22 (A side): A no longer detects the V6 family itself. In phoenix_init (DS still the arena) it reads
     2                                  ; [4A17h] (= our B's zombie_entry, written by B at its instr 8) and takes the FAR_SEG word from B's own patched
     3                                  ; 'or dx,imm16' at entry+68h, so A, B and captured zombies always share one lattice (52h / 42h V6 family / 22h zrl03-ah02).
     4                                  ; The two freed startup slots are nops and the 2 reads replace cmp/adc, so A's turn schedule equals DET2's.
     5                                  ; D4 DET2: DET with B's [5D13h]/[0CC13h] writes back at instr 4/5 (rev1 rounds). DET's instr-3 [0CC13h]
     6                                  ; write tied with the zchain/zrl03/ah02 A write (instr 3) and lost the p0f13 hook half the time (screen n6sgd).
     7                                  ; D4 DET (day2, base rev1 KPHL): adaptive whole-team lattice. If a V6-family team is present (its B writes
     8                                  ; [4A17h] at instr 3; no other team in our fields writes that cell), every stream of ours (A, B, captured zombies)
     9                                  ; uses FAR_SEG 0FFAh = lattice 42h (10h below the V6-family 52h lattice, measured +0.28/+0.24 on leader2/3 cohorts
    10                                  ; in D4 W42 screen 0b3hc); otherwise FAR_SEG 0FFBh = 52h as in rev1 (W42's plain 2025/strong cost avoided).
    11                                  ; Detection: our B now writes [4A17h] late (instr 7), so at A's instr 5 and B's instr 5 the cell is still CCCCh
    12                                  ; unless a V6-family B wrote it at instr 3. A keeps the bit in BP; B patches the low byte of its own phoenix
    13                                  ; 'or dx,0FFBh' immediate (dec -> 0FAh) before any captured zombie can reach phoenix_init.
    14                                  ; Good_Test V6 is friend-provided code (see the provenance comments below); DET edits by agent2 day2 role D4.
    15                                  ; COMBINE (night combination coordinator, 2026-10-04, base rev0): KPHL = KP + h34 (B099 KPH_B) + locpatA (B092 KL_A). A = KL_A unchanged; B = B099 KPH_B.
    16                                  ; Good_Test V6 is friend-provided code; V6nohunt and all night edits by agent2 roles (see FINDINGS.md).
    17                                  bits 16
    18                                  
    19                                  B_FARSEG equ 068h                   ; E1: B's 'or dx,FAR_SEG' imm16 minus B's zombie_entry (checked on the B binary)
    20                                  
    21                                  ; B092 KL (warrior A): A031 K (E1 INT86 decoy block + A022 SD template edits) combined with the
    22                                  ; domain-2 defense A038 locpatA (B082 location start DI = 15*[1243h] + A038 window F2 81 C3 E1 -> FF 26 17 4A).
    23                                  ; Provenance: Good_Test V6 warrior 1 is friend-provided code (reconstructed source in
    24                                  ; study-notes/good-test-v6/source/); V6nohunt = agent2 edit (removed [7A00h] patch); E1/SD/locA2/locpatA are
    25                                  ; agent2 night edits (A031, A022, B082, A038); this merge = agent2 night role B092.
    26                                  ; Turn budget: locpatA startup (INT87 at instr 11) + E1 block (4 instr) + band math with a memory divisor
    27                                  ; (div/mul word [kq] instead of mov cx,3C00h; div cx; mul cx: same AX, one instruction fewer) + add si;
    28                                  ; phoenix_init still starts at turn 22 (as in rev0, K and locpatA). Data moved to the end (no jmp needed).
    29                                  ; B = A031 K_B (A026 Z1 + SD) unchanged.
    30                                  
    31                                  start:
    32 00000000 89C6                        mov si, ax                      ; 1
    33 00000002 BBFF26                      mov bx, 026FFh                  ; 2
    34 00000005 B9174A                      mov cx, 04A17h                  ; 3
    35 00000008 A14312                      mov ax, [1243h]                 ; 4  zom20a's v1 = hi(L*10E1h)
    36 0000000B 90                          nop                             ; 5  E1: (was mov bp,[4A17h]) A now reads the team FAR_SEG from B, see phoenix_init
    37 0000000C 90                          nop                             ; 6  E1: (was xor bp,0CCCCh) keeps A's turn schedule identical to DET2
    38 0000000D F7A4CC00                    mul word [si + k15 - start]     ; 7  ax = 15*v1
    39 00000011 97                          xchg ax, di                     ; 8
    40 00000012 C484C800                    les ax, [si + z20a_data - start]; 9  ax = 81F2h, es = 1000h (arena)
    41 00000016 BAC3E1                      mov dx, 0E1C3h                  ; 10
    42 00000019 CD87                        int 087h                        ; 11 F2 81 C3 E1 -> FF 26 17 4A, forward from DI
    43 0000001B BF80FF                      mov di, 0FF80h                  ; 12 E1: 64 x FF 1F CC CC at 0FF80h..007Fh
    44 0000001E B8FF1F                      mov ax, 01FFFh                  ; 13
    45 00000021 BACCCC                      mov dx, 0CCCCh                  ; 14
    46 00000024 CD86                        int 086h                        ; 15
    47 00000026 89F0                        mov ax, si                      ; 16 band math: floor(si/3C00h)*3C00h + 2CA2h
    48 00000028 31D2                        xor dx, dx                      ; 17
    49 0000002A F7B4CE00                    div word [si + kq - start]      ; 18
    50 0000002E F7A4CE00                    mul word [si + kq - start]      ; 19
    51 00000032 05A22C                      add ax, 02CA2h                  ; 20
    52 00000035 81C67100                    add si, strict word worker - start ; 21
