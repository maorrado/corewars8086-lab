     1                                  ; D1 (agent2 day2 role D1, base rev1 KPHL) variant cS: coupled phoenix with a V6-compatible template.
     2                                  ; Good_Test V6 is friend-provided code (warrior 1/2 reconstructed in study-notes/good-test-v6/source/);
     3                                  ; V6nohunt and all night edits are agent2 roles (see agent2/night/FINDINGS.md); this edit is agent2 day2 D1.
     4                                  ; Mechanism (trace dayTR-1e9efbcb54-dd73fad407, emulator agent2/day2/scratch/D1/absim.mjs reproduces the traced
     5                                  ;   self-kill rounds 32598/52953/65875/69725/109868/114282): the worker's sub sp,dx carries the SP excess of an EARLY
     6                                  ;   trigger into the next generation (d_new = d_trig + trail), so B and the captured zombies run decoupled ('free')
     7                                  ;   fronts that trail A's front by 4-80 bytes when A self-triggers and overwrite A's worker during its rebuild.
     8                                  ; Change: after V6's unchanged worker prefix (sub sp,dx .. dec di, byte-identical so co-anchored V6-family and
     9                                  ;   own rebuilds still write the same bytes at P+4..P+15), one lea re-derives SP from the new anchor every
    10                                  ;   generation: SP = BX + DI (+d8) with DI = new IP + 1 and the private cell BX placed so that SP = anchor + trail.
    11                                  ;   A, B and captured zombies share one byte-identical template (only the private cell offset differs).
    12                                  ; COMBINE (night combination coordinator, 2026-10-04, base rev0): KPHL = KP + h34 (B099 KPH_B) + locpatA (B092 KL_A). A = KL_A unchanged; B = B099 KPH_B.
    13                                  ; Good_Test V6 is friend-provided code; V6nohunt and all night edits by agent2 roles (see FINDINGS.md).
    14                                  bits 16
    15                                  
    16                                  ; B092 KL (warrior A): A031 K (E1 INT86 decoy block + A022 SD template edits) combined with the
    17                                  ; domain-2 defense A038 locpatA (B082 location start DI = 15*[1243h] + A038 window F2 81 C3 E1 -> FF 26 17 4A).
    18                                  ; Provenance: Good_Test V6 warrior 1 is friend-provided code (reconstructed source in
    19                                  ; study-notes/good-test-v6/source/); V6nohunt = agent2 edit (removed [7A00h] patch); E1/SD/locA2/locpatA are
    20                                  ; agent2 night edits (A031, A022, B082, A038); this merge = agent2 night role B092.
    21                                  ; Turn budget: locpatA startup (INT87 at instr 11) + E1 block (4 instr) + band math with a memory divisor
    22                                  ; (div/mul word [kq] instead of mov cx,3C00h; div cx; mul cx: same AX, one instruction fewer) + add si;
    23                                  ; phoenix_init still starts at turn 22 (as in rev0, K and locpatA). Data moved to the end (no jmp needed).
    24                                  ; B = A031 K_B (A026 Z1 + SD) unchanged.
    25                                  
    26                                  start:
    27 00000000 89C6                        mov si, ax                      ; 1
    28 00000002 BBFF26                      mov bx, 026FFh                  ; 2
    29 00000005 B9174A                      mov cx, 04A17h                  ; 3
    30 00000008 A14312                      mov ax, [1243h]                 ; 4  zom20a's v1 = hi(L*10E1h)
    31 0000000B 8B16174A                    mov dx, [4A17h]                 ; 5
    32 0000000F 89166997                    mov [9769h], dx                 ; 6  Registered_Winners hook cell
    33 00000013 F7A4D500                    mul word [si + k15 - start]     ; 7  ax = 15*v1
    34 00000017 97                          xchg ax, di                     ; 8
    35 00000018 C484D100                    les ax, [si + z20a_data - start]; 9  ax = 81F2h, es = 1000h (arena)
    36 0000001C BAC3E1                      mov dx, 0E1C3h                  ; 10
    37 0000001F CD87                        int 087h                        ; 11 F2 81 C3 E1 -> FF 26 17 4A, forward from DI
    38 00000021 BF80FF                      mov di, 0FF80h                  ; 12 E1: 64 x FF 1F CC CC at 0FF80h..007Fh
    39 00000024 B8FF1F                      mov ax, 01FFFh                  ; 13
    40 00000027 BACCCC                      mov dx, 0CCCCh                  ; 14
    41 0000002A CD86                        int 086h                        ; 15
    42 0000002C 89F0                        mov ax, si                      ; 16 band math: floor(si/3C00h)*3C00h + 2CA2h
    43 0000002E 31D2                        xor dx, dx                      ; 17
    44 00000030 F7B4D700                    div word [si + kq - start]      ; 18
    45 00000034 F7A4D700                    mul word [si + kq - start]      ; 19
    46 00000038 05A22C                      add ax, 02CA2h                  ; 20
    47 0000003B 81C67700                    add si, strict word worker - start ; 21
