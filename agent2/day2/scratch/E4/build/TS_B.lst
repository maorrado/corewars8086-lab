    57 00000002 8DAC4D00                    lea bp, [word si + zombie_entry - start]        ; 2  D4 DET: entry kept in BP (BX is the INT87 replacement)
    58 00000006 C47C49                      les di, [si + es_ptr - start]                   ; 3  (moved up; ES:DI for the INT87 below)
    59 00000009 892E135D                    mov [5D13h], bp                                 ; 4  as rev1
    60 0000000D 892E13CC                    mov [0CC13h], bp                                ; 5  as rev1 (after the zchain/zrl03/ah02 instr-3 write)
    61 00000011 813E174ACCCC                cmp word [4A17h], 0CCCCh                        ; 6  D4 DET: V6-family B wrote [4A17h] at instr 3?
    62 00000017 7404                        je short .lat52                                 ; 7
    63 00000019 FE8CC100                    dec byte [si + phx_far - start + 2]             ; 8  D4 DET: patch own phoenix 'or dx,0FFBh' -> 0FFAh (B + zombies)
    64                                  .lat52:
    65 0000001D 892E174A                    mov [4A17h], bp                                 ; 8/9 D4 DET: late write (after A's instr-5 read, before A's INT87 at instr 11)
    66 00000021 892E6997                    mov [9769h], bp                                 ; 9/10 D4 DET: Registered_Winners hook cell (moved from A; after V6 A's [9769h] write)
