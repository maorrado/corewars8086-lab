     3                                  ; Good_Test V6 warrior 1 (friend-provided; reconstructed source in
     4                                  ; study-notes/good-test-v6/source/). agent2 label form: hard-coded internal
     5                                  ; offsets replaced by label arithmetic with the original operand widths.
     6                                  ; agent2 variant: removed the [7A00h] redirect patch (ablation)
     7                                  ; agent2 night A031 variant E1 (base rev0 = V6nohunt A): A spends one of its own
     8                                  ; (previously unused) INT 86h charges right after the zom20a INT 87h on a block of
     9                                  ; 64 FF 1F CC CC decoys at 0FF80h..007Fh (wraps through 0000h). It is the first
    10                                  ; FF1FCCCC match for forward searchers starting at 0000h..007Ch (OpcodeHunter1,
    11                                  ; ADDvanced, ATO1 from ~001Ah) and for backward searchers from 0FFFFh
    12                                  ; (segment_fault1, PastRAMa), and it absorbs repeated searches (one dword each).
    13                                  ; No code is ever loaded below 400h or above 0FC00h; the only lattice point in the
    14                                  ; block is 0052h (B band 4 first anchor), written by B later than this block.
    15                                  ; Band math rewritten with 16-bit DIV (same AX, 3 turns fewer) and the no-op jmp
    16                                  ; removed, so phoenix_init is reached on the same turn as in rev0.
    17                                  
    18                                  ; A031 K = E1 + A022 SD (phoenix_init mov cx,10; dead mov dx,[4A17h] dropped; db 0CCh,0CCh after the worker).
    19                                  
    20                                  start:
    21 00000000 89C6                        mov si, ax
    22 00000002 0E                          push cs
    23 00000003 07                          pop es
    24 00000004 A1174A                      mov ax, [4A17h]
    25 00000007 A36997                      mov [9769h], ax
    26 0000000A B8E2F2                      mov ax, 0F2E2h
    27 0000000D BA81C3                      mov dx, 0C381h
    28 00000010 BBFF26                      mov bx, 026FFh
    29 00000013 B9174A                      mov cx, 04A17h
    30 00000016 CD87                        int 087h
    31 00000018 BF80FF                      mov di, 0FF80h
    32 0000001B B8FF1F                      mov ax, 01FFFh
    33 0000001E BACCCC                      mov dx, 0CCCCh
    34 00000021 CD86                        int 086h
    35 00000023 89F0                        mov ax, si
    36 00000025 31D2                        xor dx, dx
    37 00000027 B9003C                      mov cx, 03C00h
    38 0000002A F7F1                        div cx
    39 0000002C F7E1                        mul cx
    40 0000002E 05A22C                      add ax, 02CA2h
    41 00000031 81C66D00                    add si, strict word worker - start
    42                                  
