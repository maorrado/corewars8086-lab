    58 00000051 31F6                        xor si, si
    59 00000053 89C7                        mov di, ax
    60 00000055 8EC2                        mov es, dx
    61 00000057 89FC                        mov sp, di
    62 00000059 81C40001                    add sp, 00100h
    63 0000005D B90900                      mov cx, 9
    64 00000060 BA0040                      mov dx, 04000h
