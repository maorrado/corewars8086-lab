     1                                  ; D8 (day2) MC = merge-kill cell: rev1 (KPHL) with one private pointer cell 0300h shared by A, B and captured zombies,
     2                                  ; and the worker's  mov di,[bx]  replaced by the absolute  mov di,[0300h]  (same instruction count, +2 bytes).
     3                                  ; Our processes always have BX = 0300h, so for us both forms are identical. A V6-family / zchain-family process that
     4                                  ; executes one of our worker copies (same-lattice merge where our copy is written last, see trace 600di: T_V6x(CAND)
     5                                  ; endings) reads ITS OWN private word [0300h] = 0, so its stosw goes to 0FFB:0000 (physical 0FFB0h, outside the arena)
     6                                  ; and it dies with a memory exception. When we execute THEIR worker copy we use our own BX (0300h) and survive.
     7                                  ; Template copy mov cx,10 -> 11 so the worker copies keep the FF 1F CC CC tail (code is now 19 bytes).
     8                                  ; Good_Test V6 is friend-provided code; V6nohunt and all night edits by agent2 roles (see FINDINGS.md); MC by agent2 day2 D8.
     9                                  ; COMBINE (night combination coordinator, 2026-10-04, base rev0): KPHL = KP + h34 (B099 KPH_B) + locpatA (B092 KL_A). A = KL_A unchanged; B = B099 KPH_B.
    10                                  ; Good_Test V6 is friend-provided code; V6nohunt and all night edits by agent2 roles (see FINDINGS.md).
    11                                  bits 16
    12                                  
    13                                  ; B092 KL (warrior A): A031 K (E1 INT86 decoy block + A022 SD template edits) combined with the
    14                                  ; domain-2 defense A038 locpatA (B082 location start DI = 15*[1243h] + A038 window F2 81 C3 E1 -> FF 26 17 4A).
    15                                  ; Provenance: Good_Test V6 warrior 1 is friend-provided code (reconstructed source in
    16                                  ; study-notes/good-test-v6/source/); V6nohunt = agent2 edit (removed [7A00h] patch); E1/SD/locA2/locpatA are
    17                                  ; agent2 night edits (A031, A022, B082, A038); this merge = agent2 night role B092.
    18                                  ; Turn budget: locpatA startup (INT87 at instr 11) + E1 block (4 instr) + band math with a memory divisor
    19                                  ; (div/mul word [kq] instead of mov cx,3C00h; div cx; mul cx: same AX, one instruction fewer) + add si;
    20                                  ; phoenix_init still starts at turn 22 (as in rev0, K and locpatA). Data moved to the end (no jmp needed).
    21                                  ; B = A031 K_B (A026 Z1 + SD) unchanged.
    22                                  
    23                                  start:
    24 00000000 89C6                        mov si, ax                      ; 1
    25 00000002 BBFF26                      mov bx, 026FFh                  ; 2
    26 00000005 B9174A                      mov cx, 04A17h                  ; 3
    27 00000008 A14312                      mov ax, [1243h]                 ; 4  zom20a's v1 = hi(L*10E1h)
    28 0000000B 8B16174A                    mov dx, [4A17h]                 ; 5
    29 0000000F 89166997                    mov [9769h], dx                 ; 6  Registered_Winners hook cell
    30 00000013 F7A4D400                    mul word [si + k15 - start]     ; 7  ax = 15*v1
    31 00000017 97                          xchg ax, di                     ; 8
    32 00000018 C484D000                    les ax, [si + z20a_data - start]; 9  ax = 81F2h, es = 1000h (arena)
    33 0000001C BAC3E1                      mov dx, 0E1C3h                  ; 10
    34 0000001F CD87                        int 087h                        ; 11 F2 81 C3 E1 -> FF 26 17 4A, forward from DI
    35 00000021 BF80FF                      mov di, 0FF80h                  ; 12 E1: 64 x FF 1F CC CC at 0FF80h..007Fh
    36 00000024 B8FF1F                      mov ax, 01FFFh                  ; 13
    37 00000027 BACCCC                      mov dx, 0CCCCh                  ; 14
    38 0000002A CD86                        int 086h                        ; 15
    39 0000002C 89F0                        mov ax, si                      ; 16 band math: floor(si/3C00h)*3C00h + 2CA2h
    40 0000002E 31D2                        xor dx, dx                      ; 17
    41 00000030 F7B4D600                    div word [si + kq - start]      ; 18
    42 00000034 F7A4D600                    mul word [si + kq - start]      ; 19
    43 00000038 05A22C                      add ax, 02CA2h                  ; 20
    44 0000003B 81C67700                    add si, strict word worker - start ; 21
