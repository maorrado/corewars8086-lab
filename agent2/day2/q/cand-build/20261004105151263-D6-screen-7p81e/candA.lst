     1                                  ; D6 LATE (day2 agent D6, base rev1 KPHL): A no longer copies [4A17h] -> [9769h] (B now writes [9769h] itself at
     2                                  ; its instr 6, the same round as rev1 A did); the two freed A turns are nops so every other A instruction keeps its
     3                                  ; rev1 round (mov ax,[1243h] r4, INT87 r11, phoenix_init r22). Good_Test V6 is friend-provided code (see below).
     4                                  ; COMBINE (night combination coordinator, 2026-10-04, base rev0): KPHL = KP + h34 (B099 KPH_B) + locpatA (B092 KL_A). A = KL_A unchanged; B = B099 KPH_B.
     5                                  ; Good_Test V6 is friend-provided code; V6nohunt and all night edits by agent2 roles (see FINDINGS.md).
     6                                  bits 16
     7                                  
     8                                  ; B092 KL (warrior A): A031 K (E1 INT86 decoy block + A022 SD template edits) combined with the
     9                                  ; domain-2 defense A038 locpatA (B082 location start DI = 15*[1243h] + A038 window F2 81 C3 E1 -> FF 26 17 4A).
    10                                  ; Provenance: Good_Test V6 warrior 1 is friend-provided code (reconstructed source in
    11                                  ; study-notes/good-test-v6/source/); V6nohunt = agent2 edit (removed [7A00h] patch); E1/SD/locA2/locpatA are
    12                                  ; agent2 night edits (A031, A022, B082, A038); this merge = agent2 night role B092.
    13                                  ; Turn budget: locpatA startup (INT87 at instr 11) + E1 block (4 instr) + band math with a memory divisor
    14                                  ; (div/mul word [kq] instead of mov cx,3C00h; div cx; mul cx: same AX, one instruction fewer) + add si;
    15                                  ; phoenix_init still starts at turn 22 (as in rev0, K and locpatA). Data moved to the end (no jmp needed).
    16                                  ; B = A031 K_B (A026 Z1 + SD) unchanged.
    17                                  
    18                                  start:
    19 00000000 89C6                        mov si, ax                      ; 1
    20 00000002 BBFF26                      mov bx, 026FFh                  ; 2
    21 00000005 B9174A                      mov cx, 04A17h                  ; 3
    22 00000008 A14312                      mov ax, [1243h]                 ; 4  zom20a's v1 = hi(L*10E1h)
    23 0000000B 90                          nop                             ; 5  D6 LATE: [9769h] now written by B (instr 6)
    24 0000000C 90                          nop                             ; 6
    25 0000000D F7A4CC00                    mul word [si + k15 - start]     ; 7  ax = 15*v1
    26 00000011 97                          xchg ax, di                     ; 8
    27 00000012 C484C800                    les ax, [si + z20a_data - start]; 9  ax = 81F2h, es = 1000h (arena)
    28 00000016 BAC3E1                      mov dx, 0E1C3h                  ; 10
    29 00000019 CD87                        int 087h                        ; 11 F2 81 C3 E1 -> FF 26 17 4A, forward from DI
    30 0000001B BF80FF                      mov di, 0FF80h                  ; 12 E1: 64 x FF 1F CC CC at 0FF80h..007Fh
    31 0000001E B8FF1F                      mov ax, 01FFFh                  ; 13
    32 00000021 BACCCC                      mov dx, 0CCCCh                  ; 14
    33 00000024 CD86                        int 086h                        ; 15
    34 00000026 89F0                        mov ax, si                      ; 16 band math: floor(si/3C00h)*3C00h + 2CA2h
    35 00000028 31D2                        xor dx, dx                      ; 17
    36 0000002A F7B4CE00                    div word [si + kq - start]      ; 18
    37 0000002E F7A4CE00                    mul word [si + kq - start]      ; 19
    38 00000032 05A22C                      add ax, 02CA2h                  ; 20
    39 00000035 81C67100                    add si, strict word worker - start ; 21
