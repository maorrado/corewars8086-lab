    62 00000017 892E135D                    mov [5D13h], bp                                 ; 7  E5: was 4; now after V6-family B (5) and m050/Synthesis/FixedToggle A (4), before router INT87s (9+)
    63 0000001B 892E174A                    mov [4A17h], bp                                 ; 8  E5: was 8 (no V6) / 9 (V6); after A's read (A instr 5), before V6 A's INT87 (10) and ours (11)
