    },
    {
      "start": 359.93,
      "end": 361.63,
      "text": "אני מובן?"
    },
    {
      "start": 361.63,
      "end": 362.63,
      "text": "כן."
    },
    {
      "start": 362.63,
      "end": 366.59,
      "text": "זאת אומרת, זה 20,400."
    },
    {
      "start": 366.59,
      "end": 370.7,
      "text": "זה 20,400."
    },
    {
      "start": 370.7,
      "end": 374.82,
      "text": "20,000..."
    },
    {
      "start": 374.82,
      "end": 375.82,
      "text": "רגע."
    },
    {
      "start": 375.82,
      "end": 376.82,
      "text": "20,400."
    },
    {
      "start": 376.82,
      "end": 384.21,
      "text": "למה הוא כתב לי ככה?"
    },
    {
      "start": 384.21,
      "end": 389.06,
      "text": "1,400."
    },
    {
      "start": 389.06,
      "end": 391.06,
      "text": "ועוד 800."
    },
    {
