      "text": "אם זה מגיע לאפה, זה הולך לה למטה."
    },
    {
      "start": 729.93,
      "end": 731.93,
      "text": "זה כמו נחש."
    },
    {
      "start": 731.93,
      "end": 732.99,
      "text": "עכשיו תראו,"
    },
    {
      "start": 732.99,
      "end": 733.99,
      "text": "זה ה-IP שלי,"
    },
    {
      "start": 733.99,
      "end": 735.99,
      "text": "זה הפקודה שעומדת להתבצע,"
    },
    {
      "start": 735.99,
      "end": 737.99,
      "text": "זה SP,"
    },
    {
      "start": 737.99,
      "end": 738.99,
      "text": "וזה DI."
    },
    {
      "start": 738.99,
      "end": 739.99,
      "text": "עם שניהם לא קשורים לתוכנית שלי,"
    },
    {
      "start": 739.99,
      "end": 741.99,
      "text": "לא ה-SP ולא ה-DI, נכון?"
    },
    {
      "start": 741.99,
      "end": 745.43,
      "text": "עכשיו אני עושה ככה."
    },
    {
      "start": 745.43,
      "end": 752.55,
      "text": "גורם ל-SP להצביע על התוסיק של התוכנית שלי, רואים?"
    },
    {
      "start": 752.55,
      "end": 758.55,
      "text": "גורם ל-DI להצביע על הראש של התוכנית שלי, רואים?"
    },
    {
      "start": 758.55,
      "end": 763.06,
      "text": "ואז אתה בזמן תעושה גם את SW בסוף לתוכנית?"
    },
    {
      "start": 763.06,
      "end": 766.06,
      "text": "לא, אני אשים את פעם אחת, פעם אחת SP,"
    },
    {
      "start": 766.06,
      "end": 768.15,
      "text": "פעם אחת DI, פעם אחת..."
    },
    {
      "start": 768.15,
      "end": 769.15,
      "text": "אה, רגע."
    },
    {
      "start": 769.15,
      "end": 771.15,
      "text": "לא עשיתי את זה?"
    },
    {
      "start": 771.15,
      "end": 773.15,
      "text": "מה אני עכשיו אשנה פה?"
    },
    {
      "start": 773.15,
      "end": 776.92,
      "text": "את אחד מה-AB' ב-50."
    },
    {
      "start": 776.92,
      "end": 778.92,
      "text": "כל הכבוד, נכון, 50."
    },
    {
      "start": 778.92,
      "end": 780.92,
      "text": "אז אני אעשה שוב דיבי כדי שזה יהיה אולי יותר..."
    },
    {
      "start": 780.92,
      "end": 784.92,
      "text": "תתבתא בי 50 במקום בי יהיה 50."
    },
    {
      "start": 784.92,
      "end": 788.14,
      "text": "עוד פעם?"
    },
    {
      "start": 788.14,
      "end": 792.34,
      "text": "תתבתא בי 50."
    },
    {
      "start": 792.34,
      "end": 793.34,
      "text": "AB ו-50."
    },
    {
      "start": 793.34,
      "end": 794.76,
      "text": "רואה?"
    },
    {
      "start": 794.76,
      "end": 795.76,
      "text": "אין אי..."
    },
    {
      "start": 795.76,
      "end": 797.76,
      "text": "אי, אי, אי."
    },
    {
      "start": 797.76,
      "end": 798.76,
      "text": "אי, אי, אי, אי, אי."
    },
    {
      "start": 798.76,
      "end": 799.76,
      "text": "אי."
    },
    {
      "start": 799.76,
      "end": 801.43,
      "text": "דיבה."
    },
    {
      "start": 801.43,
      "end": 805.18,
      "text": "תראו פה."
    },
    {
      "start": 805.18,
      "end": 806.22,
      "text": "מוכנים?"
    },
    {
      "start": 806.22,
      "end": 807.22,
      "text": "תראו."
    },
    {
      "start": 807.22,
      "end": 808.22,
      "text": "נשגע."
    },
    {
      "start": 809.22,
      "end": 811.22,
      "text": "אני מגיל את זה שתוכלו לראות,"
    },
    {
      "start": 811.22,
      "end": 812.22,
      "text": "ותסתכלו."
    },
    {
      "start": 812.22,
      "end": 814.22,
      "text": "אחת, שתיים."
    },
    {
      "start": 814.22,
      "end": 816.22,
      "text": "מה עכשיו?"
    },
    {
      "start": 816.22,
      "end": 819.22,
      "text": "רימינו את הפקודה פושה איקס, נכון?"
    },
    {
      "start": 819.22,
      "end": 823.22,
      "text": "פושה איקס עכשיו היא תתקוף פה."
    },
    {
      "start": 823.22,
      "end": 824.22,
      "text": "בהתחלשתה..."
    },
    {
      "start": 824.22,
      "end": 825.22,
      "text": "זה בזירה."
    },
    {
      "start": 825.22,
      "end": 827.22,
      "text": "ס-פי עכשיו..."
    },
    {
      "start": 827.22,
      "end": 829.22,
      "text": "בסתם מזיסטור להתחלשת התוכנית."
    },
    {
      "start": 829.22,
      "end": 830.22,
      "text": "נכון?"
    },
    {
      "start": 830.22,
      "end": 833.22,
      "text": "ס-פי מכבן על התוסיק של התוכנית שלנו."
    },
    {
      "start": 833.22,
      "end": 838.22,
      "text": "DI, עכשיו נרמה את האקסטרסגמנט,"
    },
    {
      "start": 838.22,
      "end": 840.22,
      "text": "ES, רימינו אותו,"
    },
    {
      "start": 840.22,
      "end": 843.22,
      "text": "ועכשיו את DI אנחנו שמים בקצה, נכון?"
    },
    {
      "start": 843.22,
      "end": 845.11,
      "text": "כן."
    },
    {
      "start": 845.11,
      "end": 847.11,
      "text": "עכשיו כל מה שנשאר זה ש..."
    },
    {
      "start": 847.11,
      "end": 848.11,
      "text": "בעזרת..."
    },
    {
      "start": 848.11,
      "end": 850.11,
      "text": "שה-IP פה לנו על..."
    },
    {
      "start": 850.11,
      "end": 853.14,
      "text": "בעזרת STOISW נרשום פה,"
    },
    {
      "start": 853.14,
      "end": 857.14,
      "text": "במקום 915, נרשום פה AB50,"
    },
    {
      "start": 857.14,
      "end": 860.59,
      "text": "וקיבלנו תוכנית שעושה את הפעולה הזאת."
    },
    {
      "start": 860.59,
      "end": 863.72,
      "text": "תוקפת גם קדימה וגם אחורה."
    },
    {
      "start": 863.72,
      "end": 865.72,
      "text": "יוו, זה גאוני."
    },
    {
      "start": 865.72,
      "end": 866.72,
      "text": "רואים?"
    },
    {
      "start": 866.72,
      "end": 867.72,
      "text": "ואם אני אעשה..."
    },
    {
      "start": 867.72,
      "end": 868.72,
      "text": "COMPETITION,"
    },
    {
      "start": 868.72,
      "end": 870.72,
      "text": "עכשיו אני אראה את זה יותר..."
    },
    {
      "start": 870.72,
      "end": 871.72,
      "text": "אני אתן לצח,"
    },
    {
      "start": 871.72,
      "end": 873.72,
      "text": "בגלל שהיא לא תוקפת רק מקדימה כמו כלם,"
    },
    {
      "start": 873.72,
      "end": 876.81,
      "text": "היא תוקפת בו זמנית בשניהם."
    },
    {
      "start": 876.81,
      "end": 877.81,
      "text": "נכון."
    },
    {
      "start": 877.81,
      "end": 881.75,
      "text": "רואים?"
    },
    {
      "start": 881.75,
      "end": 883.75,
      "text": "תוקפת בו זמנית, קדימה ואחורה,"
    },
    {
      "start": 883.75,
      "end": 884.75,
      "text": "עושה הרבה בלאגן."
    },
    {
      "start": 884.75,
      "end": 885.75,
      "text": "מובן?"
    },
    {
      "start": 885.75,
      "end": 890.94,
      "text": "כי זה גם לוקח אחורה שזה הפוש ה-EX,"
    },
    {
      "start": 890.94,
      "end": 891.94,
      "text": "נכון."
    },
    {
      "start": 891.94,
      "end": 893.94,
      "text": "זה גם לוקח קדימה בגלל ה..."
    },
    {
      "start": 893.94,
      "end": 894.94,
      "text": "סטוס דוויד."
    },
    {
      "start": 894.94,
      "end": 895.94,
      "text": "נכון. אז עכשיו..."
    },
    {
      "start": 895.94,
      "end": 896.94,
      "text": "טוב."
    },
    {
      "start": 896.94,
      "end": 900.07,
      "text": "בוא ננסה להריץ את כל התוכניות."
    },
    {
      "start": 900.07,
      "end": 902.07,
      "text": "ואיפה שמי שעשית..."
    },
    {
      "start": 902.07,
      "end": 904.07,
      "text": "ננסה להריץ את כל התוכניות."
    },
    {
      "start": 904.07,
      "end": 906.07,
      "text": "ונראה..."
    },
    {
      "start": 906.07,
      "end": 908.07,
      "text": "מה קורה כשמריצים את כולם ביחד."
    },
    {
      "start": 908.07,
      "end": 910.07,
      "text": "ולמי יש שיטרון."
    },
    {
      "start": 910.07,
      "end": 914.17,
      "text": "רגע בלה, זה הגודל שלה..."
    },
    {
      "start": 914.17,
      "end": 917.17,
      "text": "כאילו הגודל של התוכנית הזאת זה גדול,"
    },
    {
      "start": 917.17,
      "end": 919.17,
      "text": "זה גודל עם הזמן, כמו הסטוס דוויד."
    },
    {
      "start": 919.17,
      "end": 921.17,
      "text": "לא, לא, התוכנית זה רק סטוס דוויד."
    },
    {
      "start": 921.17,
      "end": 922.17,
      "text": "היא לא גודלה."
    },
    {
      "start": 922.17,
      "end": 926.17,
      "text": "זה בדיוק כמו ה-90, כיוון שה-IP נשאר צמוד."
    },
    {
      "start": 926.17,
      "end": 929.87,
      "text": "אה, זה כמו הנופרק שזה גם הולך אחורה."
    },
    {
      "start": 929.87,
      "end": 930.87,
      "text": "כן, כן."
    },
    {
      "start": 930.87,
      "end": 931.87,
      "text": "נכון?"
    },
    {
      "start": 931.87,
      "end": 933.87,
      "text": "זה כמו הנופרק כולצר."
    },
    {
      "start": 933.87,
      "end": 934.87,
      "text": "עכשיו אני אעשה דיבל."
    },
    {
      "start": 934.87,
      "end": 935.9,
      "text": "קומפטישן."
    },
    {
      "start": 935.9,
      "end": 938.35,
      "text": "זה יראה ככה."
    },
    {
      "start": 938.35,
      "end": 945.18,
      "text": "זבבה בובה."
    },
    {
      "start": 945.18,
      "end": 946.18,
      "text": "זבבה בינג."
    },
    {
      "start": 946.18,
      "end": 948.18,
      "text": "זבבה בינג."
    },
    {
      "start": 948.18,
      "end": 949.18,
      "text": "זבבה בינג."
    },
    {
      "start": 949.18,
      "end": 952.18,
      "text": "בפירוש יש לה יתרון משמעותי."
    },
    {
      "start": 952.18,
      "end": 953.18,
      "text": "מסכימים?"
    },
    {
      "start": 953.18,
      "end": 955.7,
      "text": "בהמון."
    },
    {
      "start": 955.7,
      "end": 957.76,
      "text": "והיא מנצחת בתחרות."
    },
    {
      "start": 957.76,
      "end": 959.02,
      "text": "נכון?"
    },
    {
      "start": 959.02,
      "end": 963.1,
      "text": "אז מה שבעצם עשינו,"
    },
    {
      "start": 963.1,
      "end": 965.1,
      "text": "הבנו איך אני יכול לכתוב..."
    },
    {
      "start": 965.1,
      "end": 967.1,
      "text": "רגע, למה עכשיו אבל..."
    },
    {
      "start": 967.1,
      "end": 968.1,
      "text": "למה עכשיו..."
    },
    {
      "start": 968.1,
      "end": 969.1,
      "text": "אה, לא כן, סליחה."
    },
    {
      "start": 969.1,
      "end": 973.1,
      "text": "בעצם, הבנו איך אני יכול לכתוב קוד בזמן ריצה."
    },
    {
      "start": 973.1,
      "end": 974.1,
      "text": "מובן?"
    },
    {
      "start": 974.1,
      "end": 977.25,
      "text": "ואיך אני יכול לנצל את זה,"
    },
    {
      "start": 977.25,
      "end": 979.25,
      "text": "כדי לקבל תוכנית הרבה יותר רעילה."
    },
    {
      "start": 979.25,
      "end": 980.25,
      "text": "מובן?"
    },
    {
      "start": 980.25,
      "end": 981.25,
      "text": "חדושי."
    },
    {
      "start": 981.25,
      "end": 983.11,
      "text": "יופי."
    },
    {
      "start": 983.11,
      "end": 985.94,
      "text": "האם..."
    },
    {
      "start": 985.94,
      "end": 987.98,
      "text": "האם כולם הבינו?"
    },
    {
      "start": 987.98,
      "end": 990.87,
      "text": "יוזא, יש שאלה כלי."
    },
    {
      "start": 990.87,
      "end": 991.87,
      "text": "כאלה שאלה..."
    }
  ]
