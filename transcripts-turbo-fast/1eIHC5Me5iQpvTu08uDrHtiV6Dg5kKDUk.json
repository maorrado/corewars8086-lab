      "start": 728.69,
      "end": 731.25,
      "text": "ולכולם יש את יותר כמות זיכרון?"
    },
    {
      "start": 732.92,
      "end": 734.38,
      "text": "המילה כמות זיכרון לא מובנת"
    },
    {
      "start": 734.92,
      "end": 736.52,
      "text": "כולם עובדים בתוך הרב"
    },
    {
      "start": 736.52,
      "end": 738.06,
      "text": "שהוא שיש בו הרבה זיכרון"
    },
    {
      "start": 738.06,
      "end": 739.44,
      "text": "שישים וארבע אלף תקיד"
    },
    {
      "start": 739.44,
      "end": 743.44,
      "text": "ולכל אחד יש תוכנית"
    },
    {
      "start": 743.44,
      "end": 746.02,
      "text": "הוא פשוט תוקף בתוך הזיכרון"
    },
    {
      "start": 746.02,
      "end": 747.48,
      "text": "רגע"
    },
    {
      "start": 747.48,
      "end": 749.36,
      "text": "שאלה לא קשורת"
    },
    {
      "start": 749.36,
      "end": 750.96,
      "text": "לתכרויות הליי"
    },
    {
      "start": 750.96,
      "end": 753.36,
      "text": "אנחנו נבוא עם תוכנית מוכנה מרוב?"
    },
    {
      "start": 754.85,
      "end": 755.09,
      "text": "כן"
    },
    {
      "start": 755.09,
      "end": 756.13,
      "text": "לתכנות הליי"
    },
    {
      "start": 756.13,
      "end": 761.73,
      "text": "תוכלי רק לעשות"
    },
    {
      "start": 761.73,
      "end": 763.53,
      "text": "תוכלי רק לעשות תמיות"
    },
    {
      "start": 763.53,
      "end": 764.53,
      "text": "כמישהו שמריש"
    },
    {
      "start": 764.53,
      "end": 767.14,
      "text": "תודה"
    },
    {
      "start": 767.14,
      "end": 769.64,
      "text": "עכשיו אני רוצה לפתור"
    },
    {
      "start": 769.64,
      "end": 771.76,
      "text": "אז עכשיו אני רוצה לעבור אתכם למשהו"
    },
    {
      "start": 771.76,
      "end": 774.06,
      "text": "מאוד"
    },
    {
      "start": 774.06,
      "end": 775.46,
      "text": "שהיא הולך להיות"
    },
    {
      "start": 775.46,
      "end": 775.94,
      "text": "אוקיי"
    },
    {
      "start": 775.94,
      "end": 776.42,
      "text": "אז אני"
    },
    {
      "start": 776.42,
      "end": 777.96,
      "text": "רגע אנחנו בהקלטה בכלל?"
    },
    {
      "start": 779.72,
      "end": 779.9,
      "text": "לא"
    },
    {
      "start": 779.9,
      "end": 781.14,
      "text": "רק היו שאלות"
    },
    {
      "start": 781.14,
      "end": 781.88,
      "text": "אוקיי חבר"
    },
    {
      "start": 781.88,
      "end": 782.92,
      "text": "רגע"
    },
    {
      "start": 782.92,
      "end": 784.7,
      "text": "אז מה לא הקלטתי את הקטע הזה?"
    },
    {
      "start": 786.48,
      "end": 787.44,
      "text": "הקלטתי או לא הקלטתי?"
    },
    {
      "start": 787.52,
      "end": 788.06,
      "text": "כן הקלטתי"
    },
    {
      "start": 788.06,
      "end": 788.5,
      "text": "אבל בסדר"
    },
    {
      "start": 788.5,
      "end": 789.5,
      "text": "תודה רגע"
    },
    {
      "start": 789.5,
      "end": 790.5,
      "text": "תודה רגע"
    },
    {
      "start": 790.5,
      "end": 791.5,
      "text": "תודה רגע"
    },
    {
      "start": 791.5,
      "end": 792.5,
      "text": "תודה רגע"
    }
  ]
}