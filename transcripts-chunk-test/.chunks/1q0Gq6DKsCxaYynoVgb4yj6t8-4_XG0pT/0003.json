  "segments": [
    {
      "start": 180.0,
      "end": 183.0,
      "text": "אתם בבקרם החדמים, תגיד לי כמה יש מכל חדר."
    },
    {
      "start": 183.0,
      "end": 190.0,
      "text": "אה, אה, ותראיתו כמה להקליט, גם לבן להקליט ותאטם גם להקליט ולשלוח לי הכלטות."
    },
    {
      "start": 190.0,
      "end": 192.0,
      "text": "אוקיי."
    },
    {
      "start": 192.0,
      "end": 195.0,
      "text": "תסליחים להעלות את כל הכלטות אחר כך לתן."
    },
    {
      "start": 195.0,
      "end": 197.0,
      "text": "יאללה, ביי-ביי."
    }
  ]
}