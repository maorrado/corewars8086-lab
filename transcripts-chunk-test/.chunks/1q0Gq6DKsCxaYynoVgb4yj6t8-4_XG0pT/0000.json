{
  "source": "1q0Gq6DKsCxaYynoVgb4yj6t8-4_XG0pT.mp4",
  "source_sha256": "4f0568258126f4bbf1c2b32e800fe6bed11fe3baa8223b50396f78d9646464c2",
  "model": "small",
  "language": "he",
  "language_probability": 1,
  "start": 0.0,
  "end": 60.0,
  "elapsed_seconds": 20.29964780807495,
  "segments": [
    {
      "start": 0.0,
      "end": 2.0,
      "text": "נתקשתת. עוד תה."
    },
    {
      "start": 2.0,
      "end": 5.0,
      "text": "טוב. אני בן, אני..."
    },
    {
      "start": 5.0,
      "end": 9.0,
      "text": "גם שתתבתי בטחרות הזאת, בערך כאיפה שהוא באמצע,"
    },
    {
      "start": 9.0,
      "end": 11.0,
      "text": "אני שתתפולשתי גם, הפכתי לחלק מהצוות של התחרות,"
    },
    {
      "start": 11.0,
      "end": 14.0,
      "text": "ואני השנה השלישית שאני חלק מהצוות,"
    },
    {
      "start": 14.0,
      "end": 17.0,
      "text": "בעיקר על ההחשרות של הצעירים."
    },
    {
      "start": 17.0,
      "end": 20.0,
      "text": "במקביל, אני גם כמובן חייל בצל,"
    },
    {
      "start": 20.0,
      "end": 22.0,
      "text": "אני הייתי מפקד בקורס תיכנות בלבשמח,"
    },
    {
      "start": 22.0,
      "end": 24.0,
      "text": "במשך שנה וחצי שנתיים."
    },
    {
      "start": 24.0,
      "end": 26.0,
      "text": "עכשיו אני עשה שם איזשהו תפקיד רוחבי,"
    },
    {
      "start": 27.0,
      "end": 30.0,
      "text": "ובגדול, יהיה לנו נורא נורא כיף,"
    },
    {
      "start": 30.0,
      "end": 32.0,
      "text": "כי אנחנו נבין דברים ש..."
    },
    {
      "start": 32.0,
      "end": 34.0,
      "text": "בן אם זה קשור לתחרות, ובן אם לא,"
    },
    {
      "start": 34.0,
      "end": 39.0,
      "text": "דברים שהם בגדר חובה לכל מי שמתעסק לדעתי בטכנולוגיה,"
    },
    {
      "start": 39.0,
      "end": 42.0,
      "text": "קצת כזה על הברזלים, על איך המחשב עובד מאחורי הכליים,"
    },
    {
      "start": 42.0,
      "end": 47.0,
      "text": "וגם כמובן את הפאנה סייברי של כמה קל לנצל מבנה של מחשב,"
    },
    {
      "start": 47.0,
      "end": 49.0,
      "text": "או קוד שלא נכתב בצורה טובה,"
    },
    {
      "start": 49.0,
      "end": 51.0,
      "text": "להשתלת עליו, ולגורנו לעשות דברים שהוא לא יתכם,"
    },
    {
      "start": 51.0,
      "end": 52.0,
      "text": "אלא לעשות מלחד חילה."
    },
    {
      "start": 52.0,
      "end": 53.0,
      "text": "אז יקף."
    },
    {
      "start": 53.0,
      "end": 54.0,
      "text": "מגדיל."
    },
    {
      "start": 54.0,
      "end": 57.0,
      "text": "יונתן, בואו יונתן ויונתן, קודם יונתן,"
    },
    {
      "start": 57.0,
      "end": 58.0,
      "text": "בואו תציג את עצמתך."
    },
    {
      "start": 59.0,
      "end": 60.0,
      "text": "טובה ביי."
    }
  ]
}