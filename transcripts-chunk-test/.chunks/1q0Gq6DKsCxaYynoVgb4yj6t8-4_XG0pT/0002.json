{
  "source": "1q0Gq6DKsCxaYynoVgb4yj6t8-4_XG0pT.mp4",
  "source_sha256": "4f0568258126f4bbf1c2b32e800fe6bed11fe3baa8223b50396f78d9646464c2",
  "model": "small",
  "language": "he",
  "language_probability": 1,
  "start": 120.0,
  "end": 180.0,
  "elapsed_seconds": 14.124287366867065,
  "segments": [
    {
      "start": 120.0,
      "end": 122.5,
      "text": "אני גאי, אני תלמיד את קיטה ייעוד בקפר."
    },
    {
      "start": 123.5,
      "end": 127.0,
      "text": "וזהו, אני פחות יותר ריכול לזורכם במה שאתם צריכים ואני קל לעזור."
    },
    {
      "start": 127.8,
      "end": 132.5,
      "text": "גל טוב, הוא שם במוואטספין, נענות לכם על כל דבר, יחבי מצבט."
    },
    {
      "start": 133.2,
      "end": 136.3,
      "text": "זהו, אנחנו מתחלקים מחדרים, אני פתחתי ארבעה חדרים."
    },
    {
      "start": 136.3,
      "end": 139.0,
      "text": "בחדר מספר אחד יהיה בניבגי."
    },
    {
      "start": 139.8,
      "end": 146.1,
      "text": "אני ממליץ לכל מי שחדש ורוצה ככה מהבסיס ללכת לבין ניבגי,"
    },
    {
      "start": 146.1,
      "end": 153.4,
      "text": "כל מי שצריך עזרה, כל מי שהיה במפגש הקודם ורוצה להמשיך פחות יותר מאיפה שעינו,"
    },
    {
      "start": 153.4,
      "end": 160.1,
      "text": "להישער איתי, וכל מי שהוא קצת יותר מתקדם ללכת עם יונתן ויותם,"
    },
    {
      "start": 160.1,
      "end": 163.9,
      "text": "שאחר כך בחדר, שיונתן ויותם ייכנס חקר לחדר הזה,"
    },
    {
      "start": 163.9,
      "end": 165.9,
      "text": "שאחר פי יעשה דברים מאוד מתקדמים."
    },
    {
      "start": 166.4,
      "end": 168.79999999999998,
      "text": "בסדר? רותם לא מגיע היום."
    },
    {
      "start": 169.8,
      "end": 175.5,
      "text": "תודה? אז יונתן ויותם, אתם נכנסים לחדר מספר שתיים,"
    },
    {
      "start": 175.5,
      "end": 178.3,
      "text": "בין ניבגי לחדר מספר אחת."
    },
    {
      "start": 178.3,
      "end": 180.3,
      "text": "וגייטו, בבקשה."
    }
  ]
}