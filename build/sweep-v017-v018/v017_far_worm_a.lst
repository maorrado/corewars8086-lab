     3                                  start:
     4                                      ; Relocate a tiny recursive far-call worker.  Its pointer lives in the
     5                                      ; team-private ES block (used through DS), while SS is deliberately moved
     6                                      ; into the arena.  Every recursion scatters a return IP and CS pair.
     7 00000000 89C5                        mov bp, ax
     8 00000002 06                          push es
     9 00000003 5A                          pop dx
    10 00000004 0E                          push cs
    11 00000005 07                          pop es
    12 00000006 89EE                        mov si, bp
    13 00000008 83C62C                      add si, worker - start
    14 0000000B 89EB                        mov bx, bp
    15 0000000D 81C3132D                    add bx, 2D13h
    16 00000011 89DF                        mov di, bx
    17 00000013 B90400                      mov cx, (worker_end - worker + 1) / 2
    18 00000016 F3A5                        rep movsw
    19 00000018 52                          push dx
    20 00000019 1F                          pop ds
    21 0000001A 891E0000                    mov [0], bx
    22 0000001E 8C0E0200                    mov [2], cs
    23 00000022 0E                          push cs
    24 00000023 17                          pop ss
    25 00000024 89EC                        mov sp, bp
    26 00000026 81C4096A                    add sp, 6A09h
    27 0000002A FFE3                        jmp bx
    28                                  
    29                                  worker:
    30 0000002C 81ECFB01                    sub sp, 01FBh
    31 00000030 FF1E0000                    call far [0]
    32                                  worker_end:
    33 00000034 90                          nop
    34                                  
