     3                                  ; Phoenix A: copy a compact worker into the private stack, then use a
     4                                  ; controlled far-call cascade to turn an arena site into MOVSB/MOVSW code.
     5                                  ; A and B use separated target bands and pointer cells so both contribute.
     6                                  %define FAR_SEG  0FF8h
     7                                  %define PTR_CELL 00200h
     8                                  
     9                                  start:
    10 00000000 89C6                        mov si, ax
    11 00000002 B0A2                        mov al, 0A2h
    12 00000004 80C44D                      add ah, 04Dh
    13 00000007 83C640                      add si, worker - start
    14                                  
    15 0000000A 16                          push ss
    16 0000000B 07                          pop es
    17 0000000C 31FF                        xor di, di
    18 0000000E B90900                      mov cx, 9
    19 00000011 F3A5                        rep movsw
    20                                  
    21 00000013 16                          push ss
    22 00000014 1F                          pop ds
    23 00000015 0E                          push cs
    24 00000016 17                          pop ss
    25                                  
    26 00000017 BB0002                      mov bx, PTR_CELL
    27 0000001A 8907                        mov [bx], ax
    28 0000001C C74702F80F                  mov word [bx + 2], FAR_SEG
    29                                  
    30 00000021 31F6                        xor si, si
    31 00000023 89C7                        mov di, ax
    32 00000025 B8F80F                      mov ax, FAR_SEG
    33 00000028 8EC0                        mov es, ax
    34 0000002A 89FC                        mov sp, di
    35 0000002C 81C40005                    add sp, 00500h
    36 00000030 B90900                      mov cx, 9
    37 00000033 BA0036                      mov dx, 03600h
    38 00000036 BD003C                      mov bp, 03C00h
    39 00000039 B8FF1F                      mov ax, 01FFFh
    40 0000003C AB                          stosw
    41 0000003D 4F                          dec di
    42 0000003E FF1F                        call far [bx]
    43                                  
    44                                  worker:
    45 00000040 A5                          movsw
    46 00000041 F3A5                        rep movsw
    47 00000043 29D4                        sub sp, dx
    48 00000045 292F                        sub [bx], bp
    49 00000047 8B3F                        mov di, [bx]
    50 00000049 B109                        mov cl, 9
    51 0000004B 31F6                        xor si, si
    52 0000004D AB                          stosw
    53 0000004E 4F                          dec di
    54 0000004F FF1F                        call far [bx]
