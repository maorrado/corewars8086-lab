{
  "source": "1NSYW3wmGmiZeQqhRKJCzNUgW9ku6GxYD.mp4",
  "sha256": "764b2ace6476de33cd41d35bb0aa2151c34f78bd86ae869fbb000fa59da8d250",
  "model": "small",
  "language": "he",
  "language_probability": 1,
  "duration_seconds": 1041.8773125,
  "elapsed_seconds": 865.0516726970673,
  "segments": [
    {
      "start": 0.0,
      "end": 2.08,
      "text": "לבר על הכל, נפדיר את כל דברים המסודות."
    },
    {
      "start": 2.68,
      "end": 4.32,
      "text": "בסדר, קלטה, כן, סבב."
    },
    {
      "start": 4.88,
      "end": 9.52,
      "text": "אז יש נמצאים אותנו רוטם מנהל התחרות,"
    },
    {
      "start": 9.56,
      "end": 13.76,
      "text": "גייטוב, המפיק, קרסיק, זוכק עוד גורו Xtreme בעבר"
    },
    {
      "start": 15.92,
      "end": 18.44,
      "text": "וכולם תותחים ומגניבים מאוד."
    },
    {
      "start": 18.72,
      "end": 25.52,
      "text": "ואנחנו בעצם, ואני מעביר את המושחות לראותם שספיר לכם מה הולך להיות."
    },
    {
      "start": 25.64,
      "end": 26.64,
      "text": "בקשרות."
    },
    {
      "start": 27.58,
      "end": 31.38,
      "text": "טוב, אז שוב שלום לכולם, אני שלא מכיר, אני רואותם."
    },
    {
      "start": 31.42,
      "end": 35.42,
      "text": "אני מנהלת התחרות כבר כמה שנים טובות."
    },
    {
      "start": 36.85,
      "end": 39.77,
      "text": "מה שהולך לקרות היום בערב,"
    },
    {
      "start": 40.65,
      "end": 44.77,
      "text": "ואם חצת רחלילה לא נפליק היום בערב אז מחר."
    },
    {
      "start": 44.81,
      "end": 46.41,
      "text": "מתי היום בערב?"
    },
    {
      "start": 47.46,
      "end": 49.46,
      "text": "בחצות. עד חצות."
    },
    {
      "start": 49.78,
      "end": 55.22,
      "text": "עד חצות, בפועל כבר, כאילו, אם תגיעו לזה מחר, אז לא ירדת לסוף העולם."
    },
    {
      "start": 55.78,
      "end": 58.5,
      "text": "מה שאנחנו נפרסם זה את ההתגרים הראשונים."
    },
    {
      "start": 58.78,
      "end": 63.22,
      "text": "אנחנו נפרסם כמה זומבים, ממש כבר זומבים אמיתיים של התחרות,"
    },
    {
      "start": 63.58,
      "end": 66.3,
      "text": "לבוגרים וכמה זומבים לצעירים."
    },
    {
      "start": 68.06,
      "end": 74.34,
      "text": "ומה שאתם תצטרכו לעשות, זה לכתוב שני סורדים שננסם לנסחים בתחרות"
    },
    {
      "start": 74.38,
      "end": 79.06,
      "text": "וגם יודעים להשתלט על הזומבים ולהגיש אותם דרך מערכת ההגשות"
    },
    {
      "start": 79.86,
      "end": 82.62,
      "text": "עד יום חמישי בחצות בלילה."
    },
    {
      "start": 83.68,
      "end": 87.7,
      "text": "זה, זה בגדול הזה."
    },
    {
      "start": 88.38,
      "end": 93.66,
      "text": "רק אני אומר, רק אני אומר שהזומבים, בטח לצעירים,"
    },
    {
      "start": 94.22,
      "end": 97.46,
      "text": "אתם לא חייבים לפתור אותם."
    },
    {
      "start": 98.18,
      "end": 100.86,
      "text": "אתם יכולים ללמוד אותם, לנסות, להתמודד איתם."
    },
    {
      "start": 100.94,
      "end": 102.94,
      "text": "אתם יכולים להצליח, אתם יכולים לא."
    },
    {
      "start": 103.38,
      "end": 104.82,
      "text": "זה לא בגדיל."
    },
    {
      "start": 105.1,
      "end": 108.46,
      "text": "גם אם לא תצליחו להתמודד עם ההתגרים, זה לא בגדיל."
    },
    {
      "start": 109.14,
      "end": 109.9,
      "text": "אבל כשתגיעו לתחרות,"
    },
    {
      "start": 109.9,
      "end": 114.7,
      "text": "כאילו לתחרות, בעיקר הניקוד קורה בתחרות ולא בהתגרי."
    },
    {
      "start": 115.72,
      "end": 116.22,
      "text": "בדיוק."
    },
    {
      "start": 116.52,
      "end": 118.72,
      "text": "רגע, עושים שני סורדים או אחד, לא שמעתי כל כך טוב."
    },
    {
      "start": 118.82,
      "end": 119.32,
      "text": "שני סורדים."
    },
    {
      "start": 119.72,
      "end": 120.42,
      "text": "אה, אוקיי."
    },
    {
      "start": 120.72,
      "end": 122.22,
      "text": "תמיד אתם מגישים שני סורדים."
    },
    {
      "start": 122.82,
      "end": 124.72,
      "text": "כן, אלא אם נגיד אחר, אתה רגע מגישים."
    },
    {
      "start": 124.82,
      "end": 129.22,
      "text": "קודם כמובן לשחפל את הקוד של אחת, פשוט שני סורדים אותו דבר שעושים אותו דבר,"
    },
    {
      "start": 129.62,
      "end": 134.42,
      "text": "ומי שיודע גם לתקשר בין סורדים אז יכול לעשות את זה, אבל לא חובה."
    },
    {
      "start": 134.52,
      "end": 136.32,
      "text": "פשוט שת תכנרא."
    },
    {
      "start": 137.32,
      "end": 144.42,
      "text": "עושים את זה בקבוצה או כאילו כל אחד לרד?"
    },
    {
      "start": 144.52,
      "end": 145.42,
      "text": "בקבוצה."
    },
    {
      "start": 145.92,
      "end": 147.96,
      "text": "רגע, אבל עדיין לא למננו את הכל."
    },
    {
      "start": 148.06,
      "end": 149.46,
      "text": "יש לי מישהו לא קודלות אותו."
    },
    {
      "start": 150.46,
      "end": 151.96,
      "text": "נוסיימו את כל מה שצריך לימוד."
    },
    {
      "start": 152.46,
      "end": 152.96,
      "text": "נכון."
    },
    {
      "start": 153.46,
      "end": 153.96,
      "text": "נכון?"
    },
    {
      "start": 154.26,
      "end": 155.46,
      "text": "בסדר, גם הוא על שוב."
    },
    {
      "start": 155.56,
      "end": 156.46,
      "text": "לא לקחת."
    },
    {
      "start": 156.96,
      "end": 159.46,
      "text": "השלב הזה בתחרות זה השלב מאוד ראשוני,"
    },
    {
      "start": 159.96,
      "end": 161.46,
      "text": "אחריו יהו עוד שלבים,"
    },
    {
      "start": 162.96,
      "end": 165.46,
      "text": "אבל זה כבר כן השלב הראשון בתחרות."
    },
    {
      "start": 165.46,
      "end": 168.96,
      "text": "יש לזה בכלל ניקוד."
    },
    {
      "start": 169.46,
      "end": 171.96,
      "text": "יש לזה ניקוד קטן,"
    },
    {
      "start": 172.46,
      "end": 173.96,
      "text": "שנותן איזשהו בונוס,"
    },
    {
      "start": 174.06,
      "end": 176.16,
      "text": "אבל הכרע ירוע קורה בתחרות,"
    },
    {
      "start": 176.26,
      "end": 177.66,
      "text": "והתחרות יהיו הרבה מדריכים,"
    },
    {
      "start": 177.76,
      "end": 178.96,
      "text": "פשוט כרע עשי,"
    },
    {
      "start": 179.46,
      "end": 180.76,
      "text": "עוד אתם, ותפגיד,"
    },
    {
      "start": 180.86,
      "end": 182.96,
      "text": "הם יעזרו לכם בתוך התחרות,"
    },
    {
      "start": 183.06,
      "end": 184.96,
      "text": "והכול יהיה בסדר, נוון?"
    },
    {
      "start": 185.46,
      "end": 186.46,
      "text": "הניקוד הזה?"
    },
    {
      "start": 186.56,
      "end": 189.96,
      "text": "כמה אחוז מהניקוד הזה?"
    },
    {
      "start": 190.46,
      "end": 191.96,
      "text": "אנחנו נגדיר לכם."
    },
    {
      "start": 192.46,
      "end": 194.16,
      "text": "כן, אבל משהו קטן, לא."
    },
    {
      "start": 194.26,
      "end": 194.96,
      "text": "משהו קטן."
    },
    {
      "start": 194.96,
      "end": 195.96,
      "text": "ניקוד הזה, הכוונה היא אתם,"
    },
    {
      "start": 196.06,
      "end": 197.46,
      "text": "עדיין יכולים להגיע לגמר,"
    },
    {
      "start": 197.56,
      "end": 198.96,
      "text": "ואתם עדיין יכולים לרצח גם."
    },
    {
      "start": 199.06,
      "end": 199.76,
      "text": "נכון."
    },
    {
      "start": 199.86,
      "end": 200.96,
      "text": "גם אם לא הלך לכם טוב,"
    },
    {
      "start": 201.06,
      "end": 202.36,
      "text": "או משהו כזה עם השלב הזה,"
    },
    {
      "start": 202.46,
      "end": 203.36,
      "text": "השלב הזה..."
    },
    {
      "start": 203.46,
      "end": 205.66,
      "text": "תצטרו קטן מאוד, מאוד."
    },
    {
      "start": 205.76,
      "end": 207.46,
      "text": "אבל תשתמשו בזה כחימום,"
    },
    {
      "start": 207.56,
      "end": 209.26,
      "text": "כדי להבין, כדי ללמוד,"
    },
    {
      "start": 209.36,
      "end": 210.26,
      "text": "כדי לעשות,"
    },
    {
      "start": 210.36,
      "end": 212.46,
      "text": "עכשיו, שבועה בה נפתור את ההתגרים האלה,"
    },
    {
      "start": 212.56,
      "end": 214.66,
      "text": "אז אתם תוכלו להבין איך פתרו אותם."
    },
    {
      "start": 214.76,
      "end": 216.86,
      "text": "אז כדאי, אז תנסו לעשות את זה."
    },
    {
      "start": 216.96,
      "end": 217.86,
      "text": "גם הבוגרים,"
    },
    {
      "start": 217.96,
      "end": 219.46,
      "text": "גם הבוגרים, אותו דבר,"
    },
    {
      "start": 219.46,
      "end": 221.46,
      "text": "אל תיקחו את זה קשה,"
    },
    {
      "start": 221.56,
      "end": 222.96,
      "text": "תתמודדו עם הדברים,"
    },
    {
      "start": 223.06,
      "end": 224.46,
      "text": "ביתך, ביתך, אם אתם חדשים,"
    },
    {
      "start": 224.56,
      "end": 225.46,
      "text": "לתוך התחום,"
    },
    {
      "start": 225.56,
      "end": 227.46,
      "text": "פשוט תיפתחו לתוך התחום,"
    },
    {
      "start": 227.56,
      "end": 229.96,
      "text": "בתחרות עצמה, גם בתחרות עצמה,"
    },
    {
      "start": 230.06,
      "end": 231.06,
      "text": "הגיעו המון המון,"
    },
    {
      "start": 231.16,
      "end": 233.26,
      "text": "המון הרבה מדריכים שיעברו,"
    },
    {
      "start": 233.36,
      "end": 234.26,
      "text": "והעזרו,"
    },
    {
      "start": 234.36,
      "end": 235.06,
      "text": "המטרה שלנו,"
    },
    {
      "start": 235.16,
      "end": 236.76,
      "text": "שהיא בעברת התחרות הזאת,"
    },
    {
      "start": 236.86,
      "end": 237.86,
      "text": "שתלמדו,"
    },
    {
      "start": 237.96,
      "end": 239.26,
      "text": "שתלמדו,"
    },
    {
      "start": 239.36,
      "end": 241.26,
      "text": "ותחספו לעולם שלה,"
    },
    {
      "start": 241.36,
      "end": 243.06,
      "text": "ואוקיי?"
    },
    {
      "start": 243.16,
      "end": 244.46,
      "text": "כן, רותם."
    },
    {
      "start": 244.56,
      "end": 245.8,
      "text": "עכשיו, הבא."
    },
    {
      "start": 245.9,
      "end": 246.8,
      "text": "אה,"
    },
    {
      "start": 246.9,
      "end": 247.93,
      "text": "כול."
    },
    {
      "start": 247.93,
      "end": 250.13,
      "text": "הייתה פה שאלה גם, שראיתי בצ'ץ,"
    },
    {
      "start": 250.23,
      "end": 251.93,
      "text": "האם נפרסם את הסורדים אחרי הגשה?"
    },
    {
      "start": 252.03,
      "end": 252.93,
      "text": "כן."
    },
    {
      "start": 254.42,
      "end": 255.62,
      "text": "זאת אומרת, בסוף,"
    },
    {
      "start": 255.72,
      "end": 256.52,
      "text": "כולו בשבוע,"
    },
    {
      "start": 256.62,
      "end": 258.22,
      "text": "לתחילת השבוע,"
    },
    {
      "start": 258.32,
      "end": 259.42,
      "text": "לא אחרוב זה שאחריו,"
    },
    {
      "start": 259.52,
      "end": 261.12,
      "text": "אפשר שציימה הגשה,"
    },
    {
      "start": 261.22,
      "end": 263.12,
      "text": "נפרסם את הסורדים"
    },
    {
      "start": 263.22,
      "end": 264.92,
      "text": "שכל הקבוצות הגישו,"
    },
    {
      "start": 265.02,
      "end": 266.75,
      "text": "בשביל,"
    },
    {
      "start": 266.85,
      "end": 269.25,
      "text": "שתוכלו לראות מה הקבוצות האחרות עשו,"
    },
    {
      "start": 269.35,
      "end": 271.75,
      "text": "ולדעת להתמודד בהתאם."
    },
    {
      "start": 271.85,
      "end": 272.85,
      "text": "מבחינת,"
    },
    {
      "start": 272.95,
      "end": 275.85,
      "text": "ככל מיני פרטים טכנים על הדברים האלה,"
    },
    {
      "start": 275.95,
      "end": 277.55,
      "text": "אנחנו כמובן גם נשלח הכל במצודר"
    },
    {
      "start": 277.55,
      "end": 279.25,
      "text": "ביחד עם ההתגרים."
    },
    {
      "start": 279.35,
      "end": 282.15,
      "text": "אני אתחיל רגע מהבוגרים."
    },
    {
      "start": 284.35,
      "end": 287.55,
      "text": "לבוגרים הולך להיות נגבלה של"
    },
    {
      "start": 287.65,
      "end": 289.45,
      "text": "חמש מאות ושנבע שער ביטים,"
    },
    {
      "start": 289.55,
      "end": 291.85,
      "text": "בתים, כמליחה לכל סורד,"
    },
    {
      "start": 291.95,
      "end": 293.15,
      "text": "שוב מותר שני סורדים."
    },
    {
      "start": 293.25,
      "end": 294.55,
      "text": "גאי, גאי טוב, רק בבקשה,"
    },
    {
      "start": 294.65,
      "end": 296.25,
      "text": "תכתור את הדברים האלה אחר כך"
    },
    {
      "start": 296.35,
      "end": 297.45,
      "text": "ותשלח אותם מסודר וכמובן."
    },
    {
      "start": 297.55,
      "end": 298.75,
      "text": "אנחנו נשלח הכל במצודר,"
    },
    {
      "start": 298.85,
      "end": 299.95,
      "text": "לכל המתחרים,"
    },
    {
      "start": 300.05,
      "end": 301.75,
      "text": "שום דבר לא יצפס."
    },
    {
      "start": 302.85,
      "end": 303.65,
      "text": "סתה אבא."
    },
    {
      "start": 303.75,
      "end": 307.25,
      "text": "ואתם תצטרכו שכל 30 ותשעה בתים,"
    },
    {
      "start": 307.25,
      "end": 308.55,
      "text": "שוב הבוגרים,"
    },
    {
      "start": 308.65,
      "end": 311.75,
      "text": "יהיה נופ בסורד שלכם,"
    },
    {
      "start": 311.85,
      "end": 313.55,
      "text": "החל מהבית במקום ה-0."
    },
    {
      "start": 313.65,
      "end": 318.45,
      "text": "זאת אומרת, הסורדים במקום ה-0, 39 וכן הלאה"
    },
    {
      "start": 318.55,
      "end": 319.75,
      "text": "צריכים להיות נופ."
    },
    {
      "start": 320.65,
      "end": 322.35,
      "text": "רגע, סור, בצורדים,"
    },
    {
      "start": 322.45,
      "end": 323.55,
      "text": "האם הבנתם את זה?"
    },
    {
      "start": 323.65,
      "end": 324.25,
      "text": "מי של חדש?"
    },
    {
      "start": 324.35,
      "end": 325.65,
      "text": "האם הבנתם את זה?"
    },
    {
      "start": 325.75,
      "end": 326.95,
      "text": "שוב, זה לבוגרים."
    },
    {
      "start": 327.77,
      "end": 328.67,
      "text": "למה?"
    },
    {
      "start": 330.05,
      "end": 330.95,
      "text": "מה עושים פה?"
    },
    {
      "start": 331.05,
      "end": 332.25,
      "text": "אתה שואל איזה?"
    },
    {
      "start": 332.35,
      "end": 333.35,
      "text": "למה?"
    },
    {
      "start": 334.03,
      "end": 334.83,
      "text": "למה עושים את זה,"
    },
    {
