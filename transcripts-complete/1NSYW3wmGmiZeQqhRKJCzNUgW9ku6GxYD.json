      "start": 674.32,
      "end": 678.24,
      "text": "אז בהיקרון אני יכול לעשות לאחר עם קוד ולהגיש אותו בעצם כמה פעמים?"
    },
    {
      "start": 678.34,
      "end": 680.22,
      "text": "כאילו, לכמה התחריות שתפין?"
    },
    {
      "start": 680.32,
      "end": 683.14,
      "text": "עומדים להתבשף לכם כל מיני אתגרים וזומבים,"
    },
    {
      "start": 683.14,
      "end": 688.98,
      "text": "ודברים יכולים להשתנות, למשל אנחנו פתאום יכולים לשנות לכם את החתימה, כל מדברים יכולים לקרות."
    },
    {
      "start": 688.98,
      "end": 694.94,
      "text": "אז אתה כרגע מגיש ככה ואחר כך יהיו כל מיני חתולים בשק חדשים."
    },
    {
      "start": 695.7,
      "end": 697.18,
      "text": "שריש לו משהו קשור למדע."
    },
    {
      "start": 697.18,
      "end": 697.7,
      "text": "הלאה גשח."
    },
    {
      "start": 698.59,
      "end": 698.99,
      "text": "כן."
    },
    {
      "start": 699.94,
      "end": 704.26,
      "text": "זה משנה אם אני מריץ את הקודש שלי במנו המשחקו בגוגל כאילו."
    },
    {
      "start": 704.98,
      "end": 705.38,
      "text": "כן."
    },
    {
      "start": 706.46,
      "end": 707.94,
      "text": "כן, נשתנים משהו."
    },
    {
      "start": 708.22,
      "end": 708.94,
      "text": "נשתנים משהו."
    },
    {
      "start": 708.94,
      "end": 710.42,
      "text": "כן, אתה צריך להקוש במנו."
    },
    {
      "start": 710.98,
      "end": 717.18,
      "text": "אז אם הסורת שהם נצאים שרונים אחרים במנו המגוגל, אז יכול להיות שבמנו האמיתי זה הוא לא נצא?"
    },
    {
      "start": 717.18,
      "end": 717.82,
      "text": "נכון."
    },
    {
      "start": 717.82,
      "end": 726.26,
      "text": "אני אגיד גם שבא ימים הקרובים אנחנו נוריד גרסה הבשל המנווה שהוא לא האינטרנטי, לא למנווה בג'ווה,"
    },
    {
      "start": 726.26,
      "end": 730.3,
      "text": "ושיש בכל מיני תיכוני בג'ים שגם יכולים להשפיע עליו אותו."
    },
    {
      "start": 730.3,
      "end": 734.02,
      "text": "אז השתדלו לבדוק את השרונים שלכם גם ככה וגם ככה."
    },
    {
      "start": 735.02,
      "end": 736.34,
      "text": "יש לי עוד שאלה."
    },
    {
      "start": 736.34,
      "end": 736.9,
      "text": "כן."
    },
    {
      "start": 736.9,
      "end": 740.3,
      "text": "איך פותחים את האתגרים שאתם נותנים ואיזה מנוע?"
    },
    {
      "start": 740.3,
      "end": 746.85,
      "text": "כי היה איזה האתגרים שהבא התאר וניסיתי לפתוח אותם ולא עבד."
    },
    {
      "start": 746.85,
      "end": 748.69,
      "text": "כאילו, ויורד כקובל."
    },
    {
      "start": 748.69,
      "end": 750.57,
      "text": "מה שלא עובד לכם באתאר?"
    },
    {
      "start": 750.57,
      "end": 751.69,
      "text": "מה שלא עובד באתאר?"
    },
    {
      "start": 751.69,
      "end": 752.57,
      "text": "תעשו במנווה."
    },
    {
      "start": 753.79,
      "end": 757.39,
      "text": "זה עורד כקובל, אז אני פשוט פותח את זה, אבל אין איפה המנווה."
    },
    {
      "start": 759.23,
      "end": 760.75,
      "text": "יש בה, אתה נתן."
    },
    {
      "start": 760.75,
      "end": 761.91,
      "text": "שואלי לי קוקור."
    },
    {
      "start": 763.03,
      "end": 766.67,
      "text": "יונתן, יונתן אתה יכול לעשות מחר מפגש?"
    },
    {
      "start": 768.96,
      "end": 775.36,
      "text": "רגע, יונתן אתה הייתנו, ויונתן עלה, מחר יהיה לכם מפגע של המנווה, בסדר?"
    },
    {
      "start": 775.36,
      "end": 777.32,
      "text": "הלקול לכולם."
    },
    {
      "start": 777.32,
      "end": 779.36,
      "text": "זה אותו קישור? זה הקישור הזה?"
    },
    {
      "start": 779.36,
      "end": 781.98,
      "text": "יהיה לכם מחר מפגע של המנווה."
    },
    {
      "start": 781.98,
      "end": 783.02,
      "text": "זה אין לי sausages."
    },
    {
      "start": 783.02,
      "end": 788.86,
      "text": "כרסיק נמצא איתנו עכשיו, אז הוא מיד יוחל עכשיו לעשות לנו על המנווה."
    },
    {
      "start": 788.86,
      "end": 791.38,
      "text": "רגע, אבל זה הקישור הזה, כישור שאחשב הiks."
    },
    {
      "start": 791.38,
      "end": 796.7,
      "text": "תי, כמו שאני אומר עוד מעט כרסיק, כי קחת המושחות ועברי לכולם על המנווה."
    },
    {
      "start": 796.7,
      "end": 797.5,
      "text": "בסדר?"
    },
    {
      "start": 797.5,
      "end": 808.26,
      "text": "אפשר שאלה בגבי הנופים כן אמרת שכל שלושים ותשן לא פי כל שלושים ותשע ביתה אם צריך לעשות נופר איך זה בעצם מונם ממש אולי תיקות משנה קודמת."
    },
    {
      "start": 808.66,
      "end": 810.34,
      "text": "היא כל פעם על המשלות המספרים."
    },
    {
      "start": 811.54,
      "end": 814.26,
      "text": "היא בשנה קודמת לא היה שלושים ותשע היה משהו אחר."
    },
    {
      "start": 815.7,
      "end": 816.74,
      "text": "סבבה תודה."
    },
    {
      "start": 817.66,
      "end": 822.14,
      "text": "במנוע החדש שישוחר בעוד כמה ימים יהיה די בגר."
    },
    {
      "start": 822.78,
      "end": 825.26,
      "text": "הוא אותו דבר כבר במנוע הקודמת פשוט אם תיכוני בגר."
    },
    {
      "start": 827.18,
      "end": 832.46,
      "text": "יש לי כאלה על מתי מתי כיף אז מתי ההחקום לזה אתגר ראשון ומתי יש להגישות."
    },
    {
      "start": 833.43,
      "end": 835.11,
      "text": "עד היום חמישי בחתות."
    },
    {
      "start": 835.51,
      "end": 839.19,
      "text": "על הילה שלך חבישי בחתות ומתי אתם שלחים די אתגר?"
    },
    {
      "start": 839.75,
      "end": 840.95,
      "text": "עד היום בחתות."
    },
    {
      "start": 841.9,
      "end": 851.18,
      "text": "יש מקום שבו כתוב כל החוקים עצרם סודרת כי אנחנו נותנית הכל בעודם מסודרת שיה כל כתוב ממש עוד נעק משלחת לבורת."
    },
    {
      "start": 852.15,
      "end": 855.91,
      "text": "כאילו כל אלה כמה נו כאילו איך זה עושים כל מרות."
    },
    {
      "start": 857.45,
      "end": 866.41,
      "text": "דרך אגב כוח אני לא זוכר אם אמרתי לכולכם אבל אני שמח להודיע שהגמר עצמו יהיה בחברת מובילי."
    },
    {
      "start": 867.21,
      "end": 875.69,
      "text": "אחרי ההרציא הגמר עצמוי בחברת מובילי וזה ייתן לכם הרבה מאוד הזדמנויות נחמדות."
    },
    {
      "start": 875.69,
      "end": 885.21,
      "text": "מעצם עורדה אבל הוא יהיה גמר מאוד מפנק בחברת מובילי והוא ייתן למי שהגיע הגמר כל מיני הזדמנויות מעניינות."
    },
    {
      "start": 886.25,
      "end": 890.01,
      "text": "אני רוצה להעביר את המושחות למיחד."
    },
    {
      "start": 890.01,
      "end": 891.37,
      "text": "מה פרס מקום ראשון?"
    },
    {
      "start": 892.01,
      "end": 894.09,
      "text": "אנחנו נוגיע כשאני ידע."
    },
    {
      "start": 894.49,
      "end": 895.69,
      "text": "זה תלוי בתרומות."
    },
    {
      "start": 896.73,
      "end": 901.77,
      "text": "רגע אחרי השלב הראשון שאנחנו תמשולכים את גר אז יש אנשים שואלים ושואלים שלא עולים."
    },
    {
      "start": 901.77,
      "end": 905.53,
      "text": "כולם עולים לצי."
    },
    {
      "start": 906.31,
      "end": 911.34,
      "text": "ומתי מתחיים כבר להוריד מתחרים?"
    },
    {
      "start": 911.98,
      "end": 912.62,
      "text": "רק."
    },
    {
      "start": 912.62,
      "end": 913.26,
      "text": "רק כבר עצים."
    },
    {
      "start": 913.82,
      "end": 914.3,
      "text": "כן."
    },
    {
      "start": 915.24,
      "end": 916.52,
      "text": "רק בסופר."
    },
    {
      "start": 916.52,
      "end": 922.2,
      "text": "אמרתם של הבוגרים צריך כל 39 נופ."
    },
    {
      "start": 922.2,
      "end": 923.24,
      "text": "נכון."
    },
    {
      "start": 923.24,
      "end": 926.12,
      "text": "האם זה יכול להיות כל 38?"
    },
    {
      "start": 926.12,
      "end": 929.0,
      "text": "זה יכול להיות כל 39."
    },
    {
      "start": 929.0,
      "end": 932.44,
      "text": "המערכת בודקת את זה זה לא משהו שאנחנו בכלל."
    },
    {
      "start": 932.44,
      "end": 935.8,
      "text": "ואני עם ה-39 דוגמא הוא באמצע פקולה שלי אני אצא."
    },
    {
      "start": 935.8,
      "end": 938.12,
      "text": "אני יכול לעשות שיף את כזה נעשים כמה נופים למעלה."
    },
    {
      "start": 938.12,
      "end": 943.11,
      "text": "אתה צריך שהמערכת תראה כל 39 נופ."
    },
    {
      "start": 943.43,
      "end": 945.83,
      "text": "מה אתה עושה עם הפקולות שלך בן לבין זה כבר."
    },
    {
      "start": 945.83,
      "end": 946.79,
      "text": "אוקיי."
    },
    {
      "start": 946.79,
      "end": 948.5,
      "text": "זה כבר שלך."
    },
    {
      "start": 948.5,
      "end": 952.58,
      "text": "מתפרסמים הסורטים בין הגמר להרצית?"
    },
    {
      "start": 952.58,
      "end": 953.66,
      "text": "כן."
    },
    {
      "start": 953.66,
      "end": 962.46,
      "text": "זאת אומרת אתם בעצם כולכם תקבלו גישה לדרג של כל מה שכולם הגישו."
    },
    {
      "start": 962.46,
      "end": 964.46,
      "text": "זאת אומרת תוכלו עקרונית להתיק."
    },
    {
      "start": 964.46,
      "end": 966.3,
      "text": "אבל למה שאני לא יכול להתיק את זה?"
    },
    {
      "start": 966.3,
      "end": 968.22,
      "text": "כן, אתה תוכל להתיק."
    },
    {
      "start": 968.22,
      "end": 971.98,
      "text": "אבל אתה תראה שיהיה לך כאשל להשתמש במה שהם עשו אחר."
    },
    {
      "start": 971.98,
      "end": 974.94,
      "text": "מה עשה לכם טריק שלא תוכלו להשתמש בקלו."
    },
    {
      "start": 974.94,
      "end": 977.26,
      "text": "בסדר?"
    },
    {
      "start": 977.26,
      "end": 979.9,
      "text": "אבל תוכלו ללמוד מהמחשבה שלהם."
    },
    {
      "start": 979.9,
      "end": 981.5,
      "text": "תוכלו לעשות רבי הסינג'נרינג."
    },
    {
      "start": 981.5,
      "end": 983.7,
      "text": "תוכלו ללמוד מהקודם."
    },
    {
      "start": 983.7,
      "end": 984.5,
      "text": "תראה רגע."
    },
    {
      "start": 984.5,
      "end": 989.3,
      "text": "לבוגרים כרסמו כבר זומבים כאילו יהיה זומבים לבוגרים,"
    },
    {
      "start": 989.3,
      "end": 991.3,
      "text": "כאילו מה עם ההתגרים שלה הבוגרים?"
    },
    {
      "start": 991.3,
      "end": 995.62,
      "text": "אנחנו נפרסמת הזומבים במשך הערב עד אחתו."
    },
    {
      "start": 995.62,
      "end": 997.1,
      "text": "אוקיי."
    },
    {
      "start": 997.1,
      "end": 1001.18,
      "text": "וזה כאילו זה כמו שאנה שעברה עם הזומבים כאילו מגישים את זה בגישה הראשונה."
    },
    {
      "start": 1001.18,
      "end": 1003.18,
      "text": "אז זה לא כאילו איזה דגר מפרד ממש כזה נכון."
    },
    {
      "start": 1003.18,
      "end": 1003.98,
      "text": "נכון."
    },
    {
      "start": 1003.98,
      "end": 1004.78,
      "text": "סור."
    },
    {
      "start": 1004.78,
      "end": 1005.34,
      "text": "אוקיי."
    },
    {
      "start": 1005.34,
      "end": 1005.98,
      "text": "תודה."
    },
    {
      "start": 1005.98,
      "end": 1006.78,
      "text": "תרגיל."
    },
    {
      "start": 1006.78,
      "end": 1011.98,
      "text": "אם התוכנה נגיד כנראה שזה לא יקרה אבל אם היא קטנה משלושים ותשע הבית,"
    },
    {
      "start": 1011.98,
      "end": 1013.34,
      "text": "אז כאילו שזה יפה לוק."
    },
    {
      "start": 1013.34,
      "end": 1014.06,
      "text": "צריך שגע."
    },
    {
      "start": 1014.06,
      "end": 1015.02,
      "text": "אז אתה לא צריך."
    },
    {
      "start": 1015.02,
      "end": 1016.3,
      "text": "אז אתה לא צריך לדנוק."
    },
    {
      "start": 1016.3,
      "end": 1018.09,
      "text": "אוקיי."
    },
    {
      "start": 1018.09,
      "end": 1021.14,
      "text": "יאללה חבר'ה לזמן, אתם מפסידים."
    },
    {
      "start": 1021.14,
      "end": 1023.54,
      "text": "הם מפסידים זמן, זה לא אין לנו זמן לא מוגבל."
    },
    {
      "start": 1023.54,
      "end": 1027.62,
      "text": "אתם שואלים המון המון שאלות שהם כבר בכימומים שהם איזוטרים."
    },
    {
      "start": 1027.62,
      "end": 1029.22,
      "text": "ומכון להבין את זה לבד."
    },
    {
      "start": 1029.22,
      "end": 1031.78,
      "text": "מיכאל, בואו כך את המוצרות."
    },
    {
      "start": 1031.78,
      "end": 1034.58,
      "text": "אני רוצה שאני עלביר למהנועה, את מה שאת חלנתי."
    },
    {
      "start": 1034.58,
      "end": 1038.98,
      "text": "קודם כל תעשה על המהנועה, רק תסביר לכולם פה על איך משתמשים במנועה."
    },
    {
      "start": 1038.98,
      "end": 1041.86,
      "text": "ואני אעשה, בגלל, שקר רגע, אני עושה את צירת הקלט."
    }
  ]
}