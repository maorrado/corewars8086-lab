    },
    {
      "start": 396.47,
      "end": 397.47,
      "text": "על ה-IP."
    },
    {
      "start": 397.91,
      "end": 401.23,
      "text": "עקרונית, לאן ה-IP אמור לבוא, אמור לבוא לתה הזה, נכון?"
    },
    {
      "start": 401.31,
      "end": 402.31,
      "text": "נכון, כן."
    },
    {
      "start": 403.38,
      "end": 405.94,
      "text": "זאת אומרת, הוא היה אמור לקרוס, אבל בגלל שאנחנו נכתוב משהו,"
    },
    {
      "start": 406.02,
      "end": 407.82,
      "text": "הוא לא יקרוס, בואו נראה מה יקרה."
    },
    {
      "start": 408.3,
      "end": 410.58,
      "text": "אני עושה סטל ושלוש, ארבע ו..."
    },
    {
      "start": 410.94,
      "end": 411.94,
      "text": "אופ, מה קרה?"
    },
    {
      "start": 412.7,
      "end": 414.22,
      "text": "אתה עושה את האבי, תשעה..."
    },
    {
      "start": 414.3,
      "end": 416.18,
      "text": "אך עושה את עוד האבי, ואז זה..."
    },
    {
      "start": 416.26,
      "end": 417.98,
      "text": "עושה את האבי, אז מה התוכנית תעשה?"
    },
    {
      "start": 418.62,
      "end": 420.42,
      "text": "עוד פעם, איבי. עוד תוסטוס, W."
    },
    {
      "start": 420.58,
      "end": 422.38,
      "text": "אבל איפה דיאל, איפה דיאל נמצא?"
    },
    {
      "start": 423.17,
      "end": 424.17,
      "text": "אחרי התוכנית."
    },
    {
      "start": 424.29,
      "end": 425.29,
      "text": "נמצא על כלום."
    },
    {
      "start": 425.77,
      "end": 427.61,
      "text": "נמצא, נמצא קדימה."
    },
    {
      "start": 427.69,
      "end": 428.69,
      "text": "בסביב."
    },
    {
      "start": 428.85,
      "end": 429.69,
      "text": "אז איפה..."
    },
    {
      "start": 429.77,
      "end": 431.69,
      "text": "אז תוסטוס W הזה."
    },
    {
      "start": 431.77,
      "end": 434.37,
      "text": "אז תוסטוס W הזה."
    },
    {
      "start": 434.45,
      "end": 435.89,
      "text": "איפה הוא הולך לכתוב?"
    },
    {
      "start": 437.5,
      "end": 439.06,
      "text": "הוא הולך לכתוב פה, נכון?"
    },
    {
      "start": 439.14,
      "end": 441.42,
      "text": "חשת תוכנית עם מרת."
    },
    {
      "start": 442.1,
      "end": 444.06,
      "text": "כן, הוא הולך לכתוב פה שוב פעם, נכון?"
    },
    {
      "start": 444.99,
      "end": 445.99,
      "text": "כן."
    },
    {
      "start": 446.07,
      "end": 448.39,
      "text": "שול, גל, אתה מתפל בשון, שעכשיו יצטרף?"
    },
    {
      "start": 448.79,
      "end": 450.07,
      "text": "כן, כי כן, הרגע ישר דו."
    },
    {
      "start": 450.78,
      "end": 454.66,
      "text": "כן? אז תסתכלו, איבי, שלוש, ארבע וסטרף."
    },
    {
      "start": 455.94,
      "end": 457.42,
      "text": "בואו."
    },
    {
      "start": 457.5,
      "end": 459.78,
      "text": "מה קרה? מה נכתב לנו פה?"
    },
    {
      "start": 460.34,
      "end": 463.98,
      "text": "עוד איבי, תישים, ואז ישר אומר התחיים שלו ולא מתמעיר."
    },
    {
      "start": 464.54,
      "end": 466.42,
      "text": "נכון? שימו לב, הוא כתב..."
    },
    {
      "start": 466.78,
      "end": 467.62,
      "text": "הוא כתב איפה ש..."
    },
    {
      "start": 467.7,
      "end": 469.94,
      "text": "אבל מה קרה לדיאל? כל פעם דיאל נתקדם משתם,"
    },
    {
      "start": 470.02,
      "end": 471.66,
      "text": "אז עכשיו דיאל מצביע לפה, נכון?"
    },
    {
      "start": 472.18,
      "end": 474.55,
      "text": "אין."
    },
    {
      "start": 474.63,
      "end": 476.91,
      "text": "עכשיו, כשהוא עשה תישים, מה תישים אומר?"
    },
    {
      "start": 478.3,
      "end": 479.94,
      "text": "נו, תישים אומר לעשות כל."
    },
    {
      "start": 480.02,
      "end": 481.62,
      "text": "תשתכלו, אז הוא לא עושה כלום."
    },
    {
      "start": 482.22,
      "end": 483.66,
      "text": "ואז לענו מתקדם."
    },
    {
      "start": 483.98,
      "end": 485.78,
      "text": "לאיבי, לאה, לסוס W."
    },
    {
      "start": 485.86,
      "end": 487.46,
      "text": "לאיבי, מה איבי עושה?"
    },
    {
      "start": 487.9,
      "end": 488.7,
      "text": "סטוס W."
    },
    {
      "start": 488.78,
      "end": 489.78,
      "text": "כותיו ותשוב."
    },
    {
      "start": 489.78,
      "end": 490.78,
      "text": "כותיו ותשוב."
    },
    {
      "start": 493.94,
      "end": 495.02,
      "text": "מה קרה לנו?"
    },
    {
      "start": 495.3,
      "end": 497.38,
      "text": "שימו לתוכנית שאין לה בכלל."
    },
    {
      "start": 497.66,
      "end": 499.1,
      "text": "תוכנית שאין לה בכלל."
    },
    {
      "start": 499.18,
      "end": 501.1,
      "text": "יכול לעשות רזום ולהערות תהל."
    },
    {
      "start": 503.03,
      "end": 504.99,
      "text": "בום, תוכנית שפשוט תוקפת."
    },
    {
      "start": 506.01,
      "end": 506.93,
      "text": "מהר מאוד?"
    },
    {
      "start": 507.99,
      "end": 509.15,
      "text": "עוד שאין לך סלט."
    },
    {
      "start": 509.43,
      "end": 511.35,
      "text": "אה, היא לא עושה כמו פייה הלוחות."
    },
    {
      "start": 511.43,
      "end": 512.71,
      "text": "אז בשביל זה לא פזה,"
    },
    {
      "start": 512.79,
      "end": 515.47,
      "text": "אז בשביל זה לא פזה יכול לעזור, כי זה ממלא מקום."
    },
    {
      "start": 515.99,
      "end": 518.07,
      "text": "נכון, כי אני צריך, יפה, יפה."
    },
    {
      "start": 518.15,
      "end": 519.67,
      "text": "איך שתתביע בכמה שותר מקומות."
    },
    {
      "start": 519.75,
      "end": 522.67,
      "text": "כי הנה, פה למשל, אני צריך עוד קודה, נכון?"
    },
    {
      "start": 525.66,
      "end": 529.54,
      "text": "אבל, אתם מסכימים איתי שזה קצת בזבור זמן ש90"
    },
    {
      "start": 530.24,
      "end": 531.84,
      "text": "לא תוקפת,"
    },
    {
      "start": 531.92,
      "end": 535.16,
      "text": "כשאני עושה 90, אני מבזבז תור כל פעם, נכון?"
    },
    {
      "start": 535.72,
      "end": 537.04,
      "text": "כן."
    },
    {
      "start": 537.36,
      "end": 539.0,
      "text": "וזה טוב לנו לבזבז תור?"
    },
    {
      "start": 539.16,
      "end": 542.16,
      "text": "לא, נופ, נופ זה לא עושה כלום, אז זה לא שווה לברדבזה."
    },
    {
      "start": 542.6,
      "end": 543.68,
      "text": "יכול לעשות שם?"
    },
    {
      "start": 543.76,
      "end": 545.64,
      "text": "עוד סטור SW במקום ה-90?"
    },
    {
      "start": 546.38,
      "end": 548.26,
      "text": "תבוא, אם נעשה עוד סטור SW,"
    },
    {
      "start": 549.1,
      "end": 550.38,
      "text": "אז זה כבר פעמיים,"
    },
    {
      "start": 550.46,
      "end": 554.18,
      "text": "זה כבר פעמיים ואז ה-PELCC."
    },
    {
      "start": 554.9,
      "end": 557.06,
      "text": "תראו, אני עושה סטור SW,"
    },
    {
      "start": 557.14,
      "end": 558.54,
      "text": "ואני עושה ותראו מה יקרה."
    },
    {
      "start": 559.02,
      "end": 561.86,
      "text": "אני עושה עוד אחד,"
    },
    {
      "start": 562.68,
      "end": 564.04,
      "text": "עוד סטור SW,"
    },
    {
      "start": 566.9,
      "end": 567.98,
      "text": "המקרא לזה..."
    },
    {
      "start": 570.49,
      "end": 571.69,
      "text": "סטור SW שוב."
    },
    {
      "start": 571.77,
      "end": 572.89,
      "text": "סטור SW..."
    },
    {
      "start": 574.09,
      "end": 575.09,
      "text": "טופוינטו."
    },
    {
      "start": 575.9,
      "end": 576.9,
      "text": "טופו..."
    },
    {
      "start": 578.47,
      "end": 581.79,
      "text": "טופו שתיים, כי הוא בעצם יחיל שני איבי."
    },
    {
      "start": 582.35,
      "end": 583.7,
      "text": "נכון?"
    },
    {
      "start": 583.78,
      "end": 586.9,
      "text": "ואז אם אני הלך לתוכנית הזאת שכרון סטור SW,"
    },
    {
      "start": 587.59,
      "end": 588.75,
      "text": "אני אעתיק אותה,"
    },
    {
      "start": 589.62,
      "end": 592.42,
      "text": "קופי, אני הלך לסטור SW, קפולשטן,"
    },
    {
      "start": 592.5,
      "end": 594.06,
      "text": "אני אעתיק אותה, אבל פה..."
    },
    {
      "start": 594.14,
      "end": 595.54,
      "text": "אני מלך שני עובר ליונתן,"
    },
    {
      "start": 595.62,
      "end": 596.5,
      "text": "כי הוא בקשמני..."
    },
    {
      "start": 596.58,
      "end": 597.94,
      "text": "זה לא עלו לקפוץ החוצה?"
    },
    {
      "start": 598.6,
      "end": 600.08,
      "text": "תבוא, הוא עוד רגע, תראו מה קורה."
    },
    {
      "start": 600.16,
      "end": 602.08,
      "text": "אני אעשה פה, מה אמרת?"
    },
    {
      "start": 602.16,
      "end": 603.16,
      "text": "גאיתו."
    },
    {
      "start": 603.24,
      "end": 604.68,
      "text": "אני שני עובר ליונתן, הוא בקשמני,"
    },
    {
      "start": 604.76,
      "end": 605.76,
      "text": "זרה במה שהוא."
    },
    {
      "start": 605.84,
      "end": 606.84,
      "text": "בבקשה."
    },
    {
      "start": 607.44,
      "end": 608.92,
      "text": "אז הייתה א-A-A..."
    },
    {
      "start": 609.24,
      "end": 610.36,
      "text": "כן, כן, סליחה."
    },
    {
      "start": 610.98,
      "end": 614.22,
      "text": "א-A-B."
    },
    {
      "start": 615.14,
      "end": 618.02,
      "text": "יש פה איטאי, גאיתו, רק איטאי."
    },
    {
      "start": 619.39,
      "end": 621.39,
      "text": "אתה יכול להריץ משקר."
    },
    {
      "start": 621.47,
      "end": 623.75,
      "text": "רגע, איטאי הצטרף עלינו,"
    },
    {
      "start": 623.83,
      "end": 625.43,
      "text": "אם אתה ממתקדמים,"
    },
    {
      "start": 625.51,
      "end": 627.19,
      "text": "אתה צריך לעבור לחדר מספר שתיים."
    },
    {
      "start": 628.27,
      "end": 631.19,
      "text": "עכשיו תראו מה קורה, אני מבטא עליה להם,"
    },
    {
      "start": 631.27,
      "end": 632.27,
      "text": "ותראו מה קורה."
    },
    {
      "start": 632.96,
      "end": 634.36,
      "text": "יש לי, תראו את..."
    },
    {
      "start": 634.44,
      "end": 636.4,
      "text": "בוא נסגי הסטור SW, קפולשטן."
    },
    {
      "start": 636.72,
      "end": 637.72,
      "text": "אני עושה דיבג."
    },
    {
      "start": 638.58,
      "end": 640.38,
      "text": "רגע, אני מקם אותו,"
    },
    {
      "start": 640.46,
      "end": 642.38,
      "text": "אני מקם את SW, קפולשטן"
    },
    {
      "start": 642.46,
      "end": 644.9,
      "text": "באיזשהו מקום שאני יכולה לראות את התוכנית עצמה,"
    },
    {
      "start": 644.98,
      "end": 647.9,
      "text": "פיקס, נסים אותה ב-8, 8."
    },
    {
      "start": 648.76,
      "end": 650.76,
      "text": "עבדת מה עשיתי,"
    },
    {
      "start": 650.84,
      "end": 653.04,
      "text": "עשמת אותה ב-888."
    },
    {
      "start": 653.12,
      "end": 654.12,
      "text": "אני עושה דיבג."
    },
    {
      "start": 656.38,
      "end": 658.42,
      "text": "הנס, WKF2,"
    },
    {
      "start": 659.49,
      "end": 660.62,
      "text": "היא פה."
    },
    {
      "start": 660.86,
      "end": 662.06,
      "text": "עכשיו בוא נראה מה קורה."
    },
    {
      "start": 662.93,
      "end": 664.81,
      "text": "יושא, 1, 2, 3,"
    },
    {
      "start": 664.89,
      "end": 665.97,
      "text": "שלא ראש כבר אנחנו מבינים,"
    },
    {
      "start": 666.05,
      "end": 669.17,
      "text": "אבל עכשיו במקום לכתוב AB90, מה היא תכתוב?"
    },
    {
      "start": 669.49,
      "end": 671.25,
      "text": "AB80. AB80."
    },
    {
      "start": 671.53,
      "end": 673.53,
      "text": "אמנ, שתי פקודות AB, תכתוב,"
    },
    {
      "start": 673.61,
      "end": 674.65,
      "text": "נכון? BX."
    },
    {
      "start": 674.89,
      "end": 677.33,
      "text": "לא, אני עושה את המעזינה, אז לכתוב WKF2."
    },
    {
      "start": 677.81,
      "end": 679.37,
      "text": "עכשיו תראו, כשנעשה את זה,"
    },
    {
      "start": 679.93,
      "end": 680.85,
      "text": "התעשה AB,"
    },
    {
      "start": 681.57,
      "end": 683.85,
      "text": "ועוד AB, ועוד AB, ועוד AB,"
    },
    {
      "start": 684.25,
      "end": 687.09,
      "text": "אז בעצם כל פקודה היא תוקפת, נכון?"
    },
    {
      "start": 688.02,
      "end": 688.7,
      "text": "כן."
    },
    {
      "start": 689.26,
      "end": 692.82,
      "text": "אבל האם אתם רואים משהו שהוא נסוכן בתוכנית הזאת?"
    },
    {
      "start": 694.26,
      "end": 695.42,
      "text": "כן, נסוכן לתוכנית."
    },
    {
      "start": 695.5,
      "end": 696.54,
      "text": "בסופרי משהו להשמיד לכל מה?"
    },
    {
      "start": 696.78,
      "end": 699.22,
      "text": "לתוכנית עצמה, מה מסוכן לתוכנית?"
    },
    {
      "start": 699.58,
      "end": 700.34,
      "text": "שששששש משהו לתוכנית."
    },
    {
      "start": 700.42,
      "end": 703.62,
      "text": "נאמי, אפשר לפגוע ב-AB של לפני AB וה..."
    },
    {
      "start": 703.7,
      "end": 705.7,
      "text": "יפה, ביאמר את זה."
    },
    {
      "start": 706.22,
      "end": 707.14,
      "text": "אני מושג."
    },
    {
      "start": 707.14,
      "end": 709.14,
      "text": "משה פינסון כתוב שרפיץ"
    },
    {
      "start": 709.14,
      "end": 712.14,
      "text": "מפה משה חפה מאוד, צימו להם"
    },
    {
      "start": 712.14,
      "end": 714.14,
      "text": "התוכנית פגיעת יותר ויותר ארוכה"
    },
    {
      "start": 714.14,
      "end": 716.14,
      "text": "מה זאת אומרת?"
    },
    {
      "start": 716.14,
      "end": 720.14,
      "text": "זה יותר רצף, הספקו עם שירה פגעה בערוס שלך"
    },
    {
      "start": 720.14,
      "end": 723.14,
      "text": "אם היא שידפוק אותי פה"
    },
    {
      "start": 723.14,
      "end": 725.14,
      "text": "אז כשאני אסבב פעם"
    },
    {
      "start": 725.14,
      "end": 728.14,
      "text": "אז כשאייפי שלי יגיע לפה, בוא, הוא יפול"
    },
    {
      "start": 728.14,
      "end": 731.14,
      "text": "ואת התוכנית שלי מייעת יותר ויותר פגיעה עם הזמן, האם זה מובן?"
    },
    {
      "start": 731.14,
      "end": 732.14,
      "text": "כן"
    },
    {
      "start": 732.14,
      "end": 735.14,
      "text": "אבל למה אתה מטפק עם זה? אי בי זה יותר פגיע זה?"
    },
    {
      "start": 736.14,
      "end": 737.14,
      "text": "מחולית כל מספרות"
    },
    {
      "start": 737.14,
      "end": 739.14,
      "text": "לא טיפשות, או מין רצות"
    },
    {
      "start": 739.14,
      "end": 741.14,
      "text": "אתה מפגיע את כולה"
    },
    {
      "start": 741.14,
      "end": 743.14,
      "text": "לא, תרגילי מה ש�� הסתם"
    },
    {
      "start": 745.14,
      "end": 747.14,
      "text": "תוכנית, את הורך שהתוכנית זה"
    },
    {
      "start": 747.14,
      "end": 749.14,
      "text": "מכיתה הנוכחי עד הסוף שלה"
    },
    {
      "start": 749.14,
      "end": 751.14,
      "text": "עד הכשה שלה"
    },
    {
      "start": 751.14,
      "end": 753.14,
      "text": "אז התוכנית, זאת אומרת תוכנית מאוד מאוד ערוכה"
    },
    {
      "start": 753.14,
      "end": 755.14,
      "text": "שכה לפגועבה"
    },
    {
      "start": 755.14,
      "end": 757.65,
      "text": "תעשה אל תרזום"
    },
    {
      "start": 757.65,
      "end": 759.65,
      "text": "לא הבנתי איזה היה נעוקי"
    },
    {
      "start": 759.65,
      "end": 761.65,
      "text": "נמצא"
    },
    {
      "start": 761.65,
      "end": 763.65,
      "text": "你就 מרחד ממך"
    },
    {
      "start": 763.65,
      "end": 769.55,
      "text": "בוא נסתכל על הנופים, בוא נסתכל על הנופ, מי שאמר שהוא לא הביא, בואו תסתכלו"
    },
    {
      "start": 769.55,
      "end": 772.55,
      "text": "אם אני עשה רגע, למה זה לא עובד לי הערב?"
    },
    {
      "start": 772.55,
      "end": 775.75,
      "text": "הנופ זה יותר קצר, אז התרכונה פחות פגיעה"
    },
    {
      "start": 775.75,
      "end": 782.45,
      "text": "כי בגלל שפסנה יותר ארוכה, אז יש שיותר במה לפגוע"
    },
    {
      "start": 782.45,
      "end": 790.95,
      "text": "בוא נראה זה, התוכנית של 100W, ש100W שהמנוף היא עושה ככה"
    },
    {
      "start": 791.15,
      "end": 799.75,
      "text": "סטפ סטפ סטפ סטפ, והתראה מה קורה, התוכנית הסוף שלה, הסוף שלה קרוב תמיד לאיפי, האם זה מובן?"
    },
    {
      "start": 799.75,
      "end": 802.15,
      "text": "כן, כך שיותר קשה לפגוע בה"
    },
    {
      "start": 802.15,
      "end": 809.11,
      "text": "זאת אומרת, אורך התוכנית הגלובלי הוא שני בתים, זה מובן?"
    },
    {
      "start": 809.11,
      "end": 811.09,
      "text": "כן"
    },
    {
      "start": 811.09,
      "end": 816.79,
      "text": "הוא הפעם לא יהיה יותר משני בתים, אז כדי לפגוע בה צריך לבנות בשני בתים, אבל אם מבזבה זה טוב"
    },
    {
      "start": 817.45,
      "end": 825.0,
      "text": "אז אם אנחנו מסתכלים, אנחנו רואים שתוכנית אחת הרבה יותר מהירה, אבל תוכנית שני התוכנית"
    },
    {
      "start": 825.0,
      "end": 826.08,
      "text": "קודם צריך"
    },
    {
      "start": 826.08,
      "end": 831.48,
      "text": "אז עכשיו בוא נראה את זה, לא הרבה יותר מהירה, יותר יותר מבגיע"
    },
    {
      "start": 831.48,
      "end": 833.48,
      "text": "אם נצח בסוף"
    },
    {
      "start": 833.48,
      "end": 834.58,
      "text": "מה זה?"
    },
    {
      "start": 834.58,
      "end": 836.58,
      "text": "אם נצח בסוף וביניהם"
    },
    {
      "start": 836.58,
      "end": 838.58,
      "text": "בוא נבדוק הכי"
    },
    {
      "start": 838.58,
      "end": 840.58,
      "text": "בוא נכניס את כולם"
    },
    {
      "start": 840.58,
      "end": 843.58,
      "text": "אבל למה זה לא יותר מהירה? אני לא מבין, אתה עדיין מוהיך כאילו"
    },
    {
      "start": 843.58,
      "end": 845.68,
      "text": "אני אדיאט טקטני"
    },
    {
      "start": 845.68,
      "end": 847.68,
      "text": "‫אבי, אי-בי, אי-בי, ‫אז עוד רגע."
    },
    {
      "start": 847.76,
      "end": 849.68,
      "text": "‫אני אסביר את זה עוד רגע. ‫-כן."
    },
    {
      "start": 849.76,
      "end": 852.56,
      "text": "‫אבל אני רק רוצה לראות ‫את כולם מתחרים, בסדר?"
    },
    {
      "start": 852.64,
      "end": 854.36,
      "text": "‫אני רוצה לראות את כולם מתחרים."
    },
    {
      "start": 854.44,
      "end": 859.88,
      "text": "‫נודע, אבל אתה לא יכול לעשות רווחים ‫בין ה-90 אי-בי ואז כמה רווחים"
    },
    {
      "start": 859.96,
      "end": 862.0,
      "text": "‫ואז עוד פעם 90 אי-בי. ‫-כן."
    },
    {
      "start": 862.08,
      "end": 866.24,
      "text": "‫כי אז, הסתכלו. סתכלו, ‫אתם רואים מה קורה פה?"
    },
    {
      "start": 866.52,
      "end": 869.28,
      "text": "‫איזו סטוי ה-W לוקח?"
    },
    {
      "start": 869.28,
      "end": 871.56,
      "text": "‫אז איזשהו רק פעם ה-90. ‫-הראשון, קצר."
    },
    {
      "start": 871.64,
      "end": 874.24,
      "text": "‫היא מנות, כי הוא פחות מגיע. ‫-קצר, הקצר, היא מנות..."
    },
    {
      "start": 874.32,
      "end": 879.32,
      "text": "‫הנה, זה מנות מנצח את זה ‫עם השני אי-בי, נכון?"
    },
    {
      "start": 879.4,
      "end": 882.38,
      "text": "‫אבל הוא איתי יותר. ‫-נכון, אבל הוא פחות פגיע."
    },
    {
      "start": 882.46,
      "end": 885.78,
      "text": "‫כן, הוא פחות פגיע. ‫-אבל גם אירוץ זה יתרון"
    },
    {
      "start": 885.86,
      "end": 887.14,
      "text": "‫באיזשהו שלב, לא?"
    },
    {
      "start": 887.22,
      "end": 889.22,
      "text": "‫אבל הנה, עובדה, ‫מולה אינאים שלנו."
    },
    {
      "start": 889.3,
      "end": 892.34,
      "text": "‫אתה רואה שאתה... ‫אתה לא יכול להתפקר כנובדות, נכון?"
    },
    {
      "start": 892.34,
      "end": 895.62,
      "text": "‫אני שואלים בכלים מהירות והתרון."
    },
    {
      "start": 895.7,
      "end": 899.3,
      "text": "‫זה תלוי כמה מהירות ולשתמה... ‫-הירות והתרון, דדול."
    },
    {
      "start": 899.38,
      "end": 904.34,
      "text": "‫אבל אתה צריך לתעדף בין מהירות, ‫למרחק, לפגיעות, להרבה דברים."
    },
    {
      "start": 904.62,
      "end": 907.34,
      "text": "‫אבל כמו שאתם רואים, ‫ה-100W ‫הם הרבה יותר חזקות"
    },
    {
      "start": 907.42,
      "end": 910.94,
      "text": "‫משער התוכניות, אבל עדיין לתוכנית..."
    },
    {
      "start": 912.02,
      "end": 914.66,
      "text": "‫ל-100W הזאת יש התרון ‫על התוכנית הזגולה."
    },
    {
      "start": 914.74,
      "end": 916.82,
      "text": "‫זה לא היה רק מזל, ‫זה לא כאילו יהיה הובילה"
    },
    {
      "start": 916.9,
      "end": 918.66,
      "text": "‫לא, זה 500 משחקים. ‫-לא, זה 500 משחקים."
    },
    {
      "start": 918.66,
      "end": 921.38,
      "text": "‫-לא, זה 100 משחקים. ‫-כן, אם אני אעשה פה"
    },
    {
      "start": 921.46,
      "end": 924.14,
      "text": "‫-1,000 משחקים, ‫אתם תראו אותו דבר."
    },
    {
      "start": 924.22,
      "end": 927.91,
      "text": "‫-סטטיסטר. ‫-סטטיסטית,"
    },
    {
      "start": 927.99,
      "end": 930.59,
      "text": "‫הם מלאסות מנצחים הרבה יותר מאחרים."
    },
    {
      "start": 931.11,
      "end": 934.71,
      "text": "‫זה לא שריפומים לו מנצחים אותם, ‫אבל עדיין הם מנצחים אחי הרבה."
    },
    {
      "start": 935.15,
      "end": 937.63,
      "text": "‫נכון? ‫-אז נכון, כבר אתם אומרים"
    },
    {
      "start": 937.71,
      "end": 940.99,
      "text": "‫שבטחרות לא משנה, ‫מה אתה מדהיה פה כנתה למנט של מזל?"
    },
    {
      "start": 941.27,
      "end": 943.59,
      "text": "‫כאילו שגם תחרות חדשות ‫הוא נצח?"
    },
    {
      "start": 944.04,
      "end": 947.88,
      "text": "‫כן, נכון לנצח במשחקון אחד, ‫אבל שח הכל..."
    },
    {
      "start": 947.96,
      "end": 951.16,
      "text": "‫-משחקון אחד זה קודם. ‫-משחקון לנצח,"
    },
    {
      "start": 951.24,
      "end": 953.88,
      "text": "‫כאילו של התוכתות, ‫אבל משחקים."
    },
    {
      "start": 953.96,
      "end": 955.32,
      "text": "‫אבל מה? ‫-אבל משחקוניםים..."
    },
    {
      "start": 955.4,
      "end": 957.8,
      "text": "‫אל תדברו יחדיתי. ‫-אל תדברו יחדיתי."
    },
    {
      "start": 957.88,
      "end": 959.84,
      "text": "‫זה מבלבל את מי שמקשיד להקלטה."
    },
    {
      "start": 960.08,
      "end": 964.44,
      "text": "‫שח הכל נצחון הוא ‫מתוך השחקים על הפים משחקים."
    },
    {
      "start": 964.95,
      "end": 966.19,
      "text": "‫אז גם אם יש לך מזל,"
    },
    {
      "start": 966.27,
      "end": 969.11,
      "text": "‫ובכמה משחקים אתה מנצח, ‫זה לא יעזור לך"
    },
    {
      "start": 969.71,
      "end": 973.95,
      "text": "‫וניצחון עכשיו עשרת אלף ‫הים משחקים בבעת אחת."
    },
    {
      "start": 974.03,
      "end": 976.39,
      "text": "‫מי שניצח בסך הכל, ‫מובן?"
    },
    {
      "start": 976.47,
      "end": 978.39,
      "text": "‫ולא מי שניצח במשחקון אחד."
    },
    {
      "start": 979.81,
      "end": 983.83,
      "text": "‫אז בסופר הדבר המזל הולך, ‫פייפן, מזל אין לו משמעו."
    },
    {
      "start": 984.11,
      "end": 989.2,
      "text": "‫מובן? התוכנית היעילה ‫היא התוכנית שתן לצח."
    },
    {
      "start": 989.52,
      "end": 992.68,
      "text": "‫יודע, אז בתחרות אתם ‫פשוט לוקחים את כל התוכניות,"
    },
    {
      "start": 992.76,
      "end": 995.08,
      "text": "‫או שתיים שכל קבוצה עושה,"
    },
    {
      "start": 995.16,
      "end": 998.72,
      "text": "‫מכניסים אותם בסימולטר אחד ‫ועשים קומבי תשען."
    },
    {
      "start": 998.88,
      "end": 1000.72,
      "text": "‫מואפ בול, תשע רגע."
    },
    {
      "start": 1000.88,
      "end": 1009.46,
      "text": "‫מי יש לו עדיין שאלות לגבי ‫למה נופ אי בי יותר טובה מי אי בי אי בי?"
    },
    {
      "start": 1009.86,
      "end": 1011.98,
      "text": "‫לי, אני... ‫-לי..."
    },
    {
      "start": 1012.06,
      "end": 1014.74,
      "text": "‫לכו' ככה הבנתי מה נופסיקי."
    },
    {
      "start": 1014.82,
      "end": 1016.66,
      "text": "‫לא ממש צריך ללכת ביי."
    },
    {
      "start": 1017.13,
      "end": 1023.3,
      "text": "‫ביי משל, אז אתה רוצה ‫שאני אסביח היהודה?"
    },
    {
      "start": 1023.7,
      "end": 1026.87,
      "text": "‫יהודה? איפה אתה?"
    },
    {
      "start": 1027.27,
      "end": 1029.35,
      "text": "‫יש פה יהודה, שישאל אותי שאלה?"
    },
    {
      "start": 1029.88,
      "end": 1033.08,
      "text": "‫זה אני, לא קוראים ליהודה. ‫-אז מי זה?"
    },
    {
      "start": 1034.11,
      "end": 1037.63,
      "text": "‫אני שאלתי אותך מקודם, ‫אבל יהודה זה לא השם שלי, שאלך שלי."
    },
    {
      "start": 1038.03,
      "end": 1040.83,
      "text": "‫אוקיי, אז מי אתה? ‫-אני איתן."
    },
    {
      "start": 1041.26,
      "end": 1043.41,
      "text": "‫איתן, אתה לא יכול עשים ‫הצלמה?"
    },
    {
      "start": 1044.65,
      "end": 1046.01,
      "text": "‫כן, אני יכול, יכול."
    },
    {
      "start": 1046.17,
      "end": 1048.37,
      "text": "‫זה יהיה הרבה יותר נעים ‫עם תהיה עם הצלמה."
    },
    {
      "start": 1048.45,
      "end": 1050.81,
      "text": "‫אתה רוצה אזרע? ‫-כן."
    },
    {
      "start": 1050.89,
      "end": 1052.89,
      "text": "‫אני לא הבנתי למה נופ הוא יותר קטן."
    },
    {
      "start": 1052.97,
      "end": 1056.57,
      "text": "‫אז תלכתי צעד, צעד, ‫שההיה לא במיוט,"
    },
    {
      "start": 1056.65,
      "end": 1061.57,
      "text": "‫ותראה, תגיד לי ‫אתה מבין מה שאני מסביעת, בסדר?"
    },
    {
      "start": 1061.65,
      "end": 1063.1,
      "text": "‫-כן."
    },
    {
      "start": 1063.1,
      "end": 1073.28,
      "text": "‫אני אסשר לתוכנית ונסשר ובוא נדע."
    },
    {
      "start": 1073.56,
      "end": 1078.34,
      "text": "‫תסתכל. בוא נסתכל על התוכנית הראשונה,"
    },
    {
      "start": 1078.42,
      "end": 1081.78,
      "text": "‫התוכנית הזאת, בסדר? ‫אני אסל לדיבה."
    },
    {
      "start": 1082.44,
      "end": 1083.64,
      "text": "‫אז מה קרה?"
    },
    {
      "start": 1084.76,
      "end": 1090.28,
      "text": "‫אה, יש לי פה, אני אעיף אותם,"
    },
    {
      "start": 1090.64,
      "end": 1093.64,
      "text": "‫כי סמטי פיקסט אדרס דומה."
    },
    {
      "start": 1093.72,
      "end": 1096.84,
      "text": "‫כן, זה באותו מקום, ‫אז זה לא יכול לדיבה."
    },
    {
      "start": 1097.57,
      "end": 1099.85,
      "text": "‫אני עכשיו אין לה מפיקסט אדרס. בסדר?"
    },
    {
      "start": 1101.34,
      "end": 1104.02,
      "text": "‫אוקיי, בוא נסתכל על התוכנית הזאת."
    },
    {
      "start": 1104.3,
      "end": 1109.48,
      "text": "‫זו התוכנית שעושה רק נופ, ‫נופ, אי, B כותבת, נכון, הייתן?"
    },
    {
      "start": 1109.56,
      "end": 1111.72,
      "text": "‫כן. ‫-אז הסתכל."
    },
    {
      "start": 1112.5,
      "end": 1114.1,
      "text": "‫אי כותבת? ‫-לא."
    },
    {
      "start": 1114.22,
      "end": 1118.94,
      "text": "‫אי כותבת, היא כותבת, אי, B, ‫ואל זה כותבת נופ, אי, B, נכון?"
    },
    {
      "start": 1119.14,
      "end": 1121.5,
      "text": "‫מה נופ עושה רק? ‫לא, אבל תמיד לא עושה כבר."
    },
    {
      "start": 1121.58,
      "end": 1123.3,
      "text": "‫שום דבר, נופ זה אומר שום דבר."
    },
    {
      "start": 1123.38,
      "end": 1127.69,
      "text": "‫מה קורה? אי, B, ‫כמה בתים היא כותבת כל פעם?"
    },
    {
      "start": 1129.5,
      "end": 1132.78,
      "text": "‫אי, B כותבת שבתים, כן. ‫-שתי בתים."
    },
    {
      "start": 1132.86,
      "end": 1134.38,
      "text": "‫אי, זה בית אחד ביזה שתיים."
    },
    {
      "start": 1134.46,
      "end": 1137.58,
      "text": "‫כמה היפים מתקדם כשהוא עושה ‫את היבי כל פעם, B?"
    },
    {
      "start": 1138.69,
      "end": 1140.25,
      "text": "‫בשתי בתים. ‫-בית אחד."
    },
    {
      "start": 1140.65,
      "end": 1143.92,
      "text": "‫למה היפים? ‫-כי הי, B זה בית אחד,"
    },
    {
      "start": 1144.0,
      "end": 1147.28,
      "text": "‫היפי עצמו, היפי מתקדם, ‫בית-בית, נכון?"
    },
    {
      "start": 1148.7,
      "end": 1149.82,
      "text": "‫אז מה קורה?"
    },
    {
      "start": 1150.1,
      "end": 1153.86,
      "text": "‫עכשיו היפי יקפוץ בית אחד קדימה. ‫-כן."
    },
    {
      "start": 1154.14,
      "end": 1156.74,
      "text": "‫כמה בתים היבי תכתון?"
    },
    {
      "start": 1157.14,
      "end": 1158.82,
      "text": "‫שתיים. ‫-בים."
    },
    {
      "start": 1158.82,
      "end": 1162.82,
      "text": "‫אז יתחילי בצר מרחק אם לא היה פונאו."
    },
    {
      "start": 1162.9,
      "end": 1167.56,
      "text": "‫זאת אומרת, אם אני אעשה סטק, ‫האי-פי יקפוץ לפה,"
    },
    {
      "start": 1167.88,
      "end": 1171.36,
      "text": "‫אבל אי יקותף שני בתים, נכון? ‫-כן."
    },
    {
      "start": 1171.64,
      "end": 1175.68,
      "text": "‫מה מרחק בין היפי לסוף התכנית כרגע? ‫-שתי בתים."
    },
    {
      "start": 1176.12,
      "end": 1178.6,
      "text": "‫שתי בתים, שתיים בתים ‫למסעת הסיסי, נכון?"
    },
    {
      "start": 1178.68,
      "end": 1182.65,
      "text": "‫עכשיו, אם נופ לא יעשה כלום,"
    },
    {
      "start": 1183.13,
      "end": 1186.07,
      "text": "‫הוא יחסוך להתארכות של התכנית."
    },
    {
      "start": 1186.59,
      "end": 1189.11,
      "text": "‫אוקיי, נכון. ‫אבל מדלג על זה אפשר?"
    },
    {
      "start": 1189.19,
      "end": 1190.39,
      "text": "‫הוא מדלג על נופים?"
    },
    {
      "start": 1190.39,
      "end": 1192.31,
      "text": "‫הוא מדלג על זה ולא עושה כלום, ‫ובעט?"
    },
    {
      "start": 1192.51,
      "end": 1195.35,
      "text": "‫אז זה לא לנובתו רעי התנמות, ‫זה לא..."
    },
    {
      "start": 1195.43,
      "end": 1198.43,
      "text": "‫כן, אבל בגלל שהוא לא כותב ‫עוד שני בתים,"
    },
    {
      "start": 1198.51,
      "end": 1201.43,
      "text": "‫אז הוא לא מרחיק להתקצאת תכנית מהאיפי."
    },
    {
      "start": 1202.28,
      "end": 1203.72,
      "text": "‫אוקיי, כן."
    },
    {
      "start": 1203.84,
      "end": 1207.81,
      "text": "‫ואז כשאני עושה סטק, ‫אני לא מתרחק מה..."
    },
    {
      "start": 1207.89,
      "end": 1210.8,
      "text": "‫הדי-אי לא מתרחק מהאיפי, ‫אתה רואה, הדי-אי?"
    },
    {
      "start": 1211.24,
      "end": 1213.44,
      "text": "‫לא מתרחק מהאיפי, אתה רואה?"
    },
    {
      "start": 1215.24,
      "end": 1220.08,
      "text": "‫זאת אומרת, אורך התכנית שהפגיעה שלי ‫הוא שלושה בתים."
    },
    {
      "start": 1221.31,
      "end": 1224.35,
      "text": "‫90, אי בי 90, ‫במקסימום."
    },
    {
      "start": 1224.43,
      "end": 1226.67,
      "text": "‫או שני בתים, במקרה הזה."
    },
    {
      "start": 1227.39,
      "end": 1229.99,
      "text": "‫אי בי 90... ‫-בכל שהתכנית קטנה ‫היא פחות פגיעה,"
    },
    {
      "start": 1230.07,
      "end": 1233.39,
      "text": "‫כי צריך לתתפעות ביו-ו-ו. ‫-אורך התכנית קטנה פחות פגיעה, נכון?"
    },
    {
      "start": 1233.63,
      "end": 1236.15,
      "text": "‫לעומת זאת, אם נעבור לתכנית השנייה,"
    },
    {
      "start": 1237.04,
      "end": 1241.71,
      "text": "‫שעשתה פעמיים סטווס W, ‫בוא נעבור אליה,"
    },
    {
      "start": 1241.79,
      "end": 1245.24,
      "text": "‫ונעשה דיבג ולסתכל מה קורה איתה,"
    },
    {
      "start": 1245.6,
      "end": 1249.58,
      "text": "‫היא נבזועת תכנית הזאת, ‫אז מה והקורה?"
    },
    {
      "start": 1249.7,
      "end": 1253.86,
      "text": "‫ההבדל גודל, ואז אתה אוכל אותה, ‫כי קודשך גודל."
    },
    {
      "start": 1254.59,
      "end": 1259.15,
      "text": "‫כן, שיחה. אני אסס סטאפ סטאפ סטאפ. ‫רגע, אני הולך לפה."
    },
    {
      "start": 1259.39,
      "end": 1262.75,
      "text": "‫מה קורה? ‫בגלל שכתבנו ABAB,"
    },
    {
      "start": 1265.13,
      "end": 1267.01,
      "text": "‫אז מה שיושע יושע AB,"
    },
    {
      "start": 1267.21,
      "end": 1270.57,
      "text": "‫ולכל פעם כותבת שני בתים, ‫אבל היפים מתקדם באחד,"
    },
    {
      "start": 1270.65,
      "end": 1273.13,
      "text": "‫אז היפים מתרחק מהמעדייי, ‫אתה רואה?"
    },
    {
      "start": 1273.21,
      "end": 1274.85,
      "text": "‫זה הכי גרוע שיכול להיות לי בעצם."
    },
    {
      "start": 1274.93,
      "end": 1278.73,
      "text": "‫אז אמר... זה לא הכי גרוע, ‫כי ראיתה שהתכנית עדיין חזקה,"
    },
    {
      "start": 1278.89,
      "end": 1284.29,
      "text": "‫אבל ביחס לתוכנית אחרות, ‫אבל אתה רואה שהיא תגיע הרבה אותו..."
    },
    {
      "start": 1284.37,
      "end": 1287.09,
      "text": "‫זה לא נראה טוב, אבל... ‫-זה לא נראה טוב."
    },
    {
      "start": 1287.17,
      "end": 1290.89,
      "text": "‫אני מסכה, זה לא יעבוד טוב. ‫כן? תודה רבה."
    },
    {
      "start": 1290.97,
      "end": 1293.89,
      "text": "‫עכשיו אתה מבין? ‫עכשיו הסביר היה טוב, מבנת?"
    },
    {
      "start": 1293.97,
      "end": 1295.65,
      "text": "‫כן. ‫-מי הוא לא..."
    },
    {
      "start": 1295.73,
      "end": 1301.0,
      "text": "‫אז עכשיו אני רוצה לחזור ‫לתוכנית הזאת, ולהגיד, רגע,"
    },
    {
      "start": 1301.24,
      "end": 1306.4,
      "text": "‫האם אני יכול את התוכנית הזאת ‫לעשות יותר יעילה?"
    },
    {
      "start": 1306.4,
      "end": 1308.4,
      "text": "‫אני לא אוהב... ‫זה טוב שיקצרה,"
    },
    {
      "start": 1308.48,
      "end": 1314.14,
      "text": "‫אבל אני לא אוהב שימבזבה זה טוב. ‫בוואה?"
    },
    {
      "start": 1314.5,
      "end": 1317.78,
      "text": "‫עכשיו תראו מה אני מציע. ‫אני מציע עכשיו לעשות..."
    },
    {
      "start": 1317.86,
      "end": 1324.33,
      "text": "‫תראה לעשות במקומן הופ' מוב או..."
    },
    {
      "start": 1324.49,
      "end": 1331.08,
      "text": "‫אני מציע לעשות תוכנית נוספת ‫שאני קורא לה..."
    },
    {
      "start": 1334.38,
      "end": 1337.22,
      "text": "‫יודעת על הכותיה. ‫-ה, נכון."
    },
    {
      "start": 1342.12,
      "end": 1345.8,
      "text": "‫זווה באהבי... ‫-באהבי, יאלת לכל הכיבוד."
    },
    {
      "start": 1345.88,
      "end": 1347.6,
      "text": "‫תודה? בואו לראות."
    },
    {
      "start": 1347.6,
      "end": 1355.82,
      "text": "‫תראו, אם אני אכתוב פה פושייקס. ‫נוסדה? אני כדאה פושייקס."
    },
    {
      "start": 1357.56,
      "end": 1360.0,
      "text": "‫מה מספר שכתוב פה? ‫-50."
    },
    {
      "start": 1360.08,
      "end": 1361.4,
      "text": "‫-50. ‫-50."
    },
    {
      "start": 1361.48,
      "end": 1365.2,
      "text": "‫בואו נראה מישהו מצליח להביא ‫מה התוכנית הזאת עושה."
    },
    {
      "start": 1365.48,
      "end": 1369.04,
      "text": "‫אני אוריד את כל הבנים שלהלה. ‫בואו נראה מישהו נביא"
    },
    {
      "start": 1369.12,
      "end": 1370.4,
      "text": "‫מה התוכנית הזאת עושה."
    },
    {
      "start": 1370.64,
      "end": 1374.64,
      "text": "‫אני אעשה פושייקס הרבה פעמים, ‫כדי שכמו שעשינו בסטוי-ו,"
    },
    {
      "start": 1374.8,
      "end": 1376.68,
      "text": "‫בנישאה את עצמי... ‫-הי, אין איך זה המקום הראש"
    },
    {
      "start": 1376.68,
      "end": 1379.72,
      "text": "‫שאני שם אוכל מגיל מלאב, ‫אז זה המקום שהערכים."
    },
    {
      "start": 1380.24,
      "end": 1383.36,
      "text": "‫שנייה, אני בעצם אסיום ‫אתי את ההתגלתה."
    }
  ]
}