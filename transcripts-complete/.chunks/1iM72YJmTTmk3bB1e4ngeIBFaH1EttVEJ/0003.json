      "text": "אין"
    },
    {
      "start": 3075.0,
      "end": 3077.0,
      "text": "אין קודם"
    },
    {
      "start": 3077.0,
      "end": 3079.0,
      "text": "אני שולח לכת הקוד, בסדר?"
    },
    {
      "start": 3079.0,
      "end": 3081.0,
      "text": "תודה אבא, מיכאל"
    },
    {
      "start": 3081.0,
      "end": 3083.0,
      "text": "רק שתבין, אני אשלח לה עכשיו, אני אשלח לה סדרה של סורדים"
    },
    {
      "start": 3083.0,
      "end": 3085.0,
      "text": "יש שישה סורדים"
    },
    {
      "start": 3085.0,
      "end": 3087.0,
      "text": "וזה מאה הכי פשוט להכים מסובך"
    },
    {
      "start": 3087.0,
      "end": 3089.0,
      "text": "את מעדיפה את זה או שאני אשלח"
    },
    {
      "start": 3089.0,
      "end": 3091.0,
      "text": "לך רק את הערכים מסובך"
    },
    {
      "start": 3091.0,
      "end": 3093.0,
      "text": "לא, אני מעדיפה את כולם"
    },
    {
      "start": 3093.0,
      "end": 3095.0,
      "text": "אז יש לך את רואה מהכי פשוט להכים מסובך"
    },
    {
      "start": 3095.0,
      "end": 3097.0,
      "text": "ואת רוצה, אתם רוצים להעתיק את הערכים מסובך"
    },
    {
      "start": 3097.0,
      "end": 3099.0,
      "text": "זה יהיה הכי טוב לכם, כבר הכי טוב"
    },
    {
      "start": 3099.0,
      "end": 3101.0,
      "text": "בסדר?"
    },
    {
      "start": 3103.0,
      "end": 3105.0,
      "text": "כן, אז"
    },
    {
      "start": 3105.0,
      "end": 3107.0,
      "text": "עכשיו, כאילו מה שם"
    },
    {
      "start": 3107.0,
      "end": 3109.0,
      "text": "עכשיו תשער, עכשיו תשער אחיתי"
    },
    {
      "start": 3109.0,
      "end": 3111.0,
      "text": "אין לי שעכשיו 11"
    },
    {
      "start": 3111.0,
      "end": 3113.0,
      "text": "אז אנחנו עכשיו נשבע"
    },
    {
      "start": 3113.0,
      "end": 3115.0,
      "text": "ונעשה סורד"
    },
    {
      "start": 3115.0,
      "end": 3117.0,
      "text": "שעובד"
    },
    {
      "start": 3117.0,
      "end": 3119.0,
      "text": "עם 87"
    },
    {
      "start": 3119.0,
      "end": 3121.0,
      "text": "נשאב קצת על הסומבים שלתנו לנו"
    },
    {
      "start": 3121.0,
      "end": 3123.0,
      "text": "ונשלח 12"
    },
    {
      "start": 3123.0,
      "end": 3125.0,
      "text": "כי זה"
    },
    {
      "start": 3125.0,
      "end": 3127.0,
      "text": "עד יום 5-6 שיגיע"
    },
    {
      "start": 3127.0,
      "end": 3129.0,
      "text": "כי מחר אנחנו לא בא בי"
    },
    {
      "start": 3129.0,
      "end": 3131.0,
      "text": "נכון"
    },
    {
      "start": 3131.0,
      "end": 3133.0,
      "text": "נולה, התרועה שלשלחת לך"
    },
    {
      "start": 3133.0,
      "end": 3135.0,
      "text": "כן"
    },
    {
      "start": 3135.0,
      "end": 3137.0,
      "text": "יש לך איך להעביר את זה למחשב"
    },
    {
      "start": 3137.0,
      "end": 3139.0,
      "text": "זה בסדר ככה?"
    },
    {
      "start": 3139.0,
      "end": 3141.0,
      "text": "כן, אני עושה"
    },
    {
      "start": 3141.0,
      "end": 3143.0,
      "text": "סבא"
    },
    {
      "start": 3143.0,
      "end": 3145.0,
      "text": "קוק עבוד לכם"
    },
    {
      "start": 3145.0,
      "end": 3147.0,
      "text": "יש מרית המספר שתכתבי לי"
    },
    {
      "start": 3147.0,
      "end": 3149.0,
      "text": "גם אתה דוד"
    },
    {
      "start": 3149.0,
      "end": 3151.0,
      "text": "אתה זוכר את השם שלי?"
    },
    {
      "start": 3151.0,
      "end": 3153.0,
      "text": "כן, אני אמרת את השם שלך"
    },
    {
      "start": 3153.0,
      "end": 3155.0,
      "text": "זאת אומרת זכרתי"
    },
    {
      "start": 3155.0,
      "end": 3165.0,
      "text": "נביא את בקיטה ה"
    },
    {
      "start": 3165.0,
      "end": 3167.0,
      "text": "אבל גם אתה דופה"
    },
    {
      "start": 3167.0,
      "end": 3169.0,
      "text": "נכן גאונים"
    },
    {
      "start": 3169.0,
      "end": 3171.0,
      "text": "באמת שאתם גאונים"
    },
    {
      "start": 3171.0,
      "end": 3173.0,
      "text": "וחיים לא הבנתי שום דבר"
    },
    {
      "start": 3173.0,
      "end": 3175.0,
      "text": "באמת שאתם גאונים"
    },
    {
      "start": 3175.0,
      "end": 3177.0,
      "text": "אני מעל"
    },
    {
      "start": 3177.0,
      "end": 3179.0,
      "text": "תודה רבה מיכאלה אל הכל"
    },
    {
      "start": 3179.0,
      "end": 3181.0,
      "text": "אל הכל"
    }
  ]
}