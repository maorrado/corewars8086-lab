{
  "source": "1waEAQoBa8FlzUAddBbTOlS9qKsEu_QzK.mp4",
  "source_sha256": "678e967fc52976dd00f694e3b86558b4abf50edc1db4682e669517c3157ba31a",
  "model": "small",
  "language": "he",
  "language_probability": 1,
  "start": 3600.0,
  "end": 4500.0,
  "elapsed_seconds": 477.73862862586975,
  "segments": [
    {
      "start": 3600.0,
      "end": 3601.0,
      "text": "מה זה? הפך?"
    },
    {
      "start": 3601.0,
      "end": 3605.84,
      "text": "כן, אנחנו מפרסמים אוכל כך לקלטות. מה שכן?"
    },
    {
      "start": 3605.84,
      "end": 3606.84,
      "text": "איך?"
    },
    {
      "start": 3606.84,
      "end": 3608.84,
      "text": "איך עליה אותה שאלו? שזה הבא שם."
    },
    {
      "start": 3608.84,
      "end": 3610.84,
      "text": "לא, כן, איך עוד."
    },
    {
      "start": 3610.84,
      "end": 3615.24,
      "text": "יש קישור באטר, אני אראה לכם איזה רגע,"
    },
    {
      "start": 3615.24,
      "end": 3617.24,
      "text": "יש את האטר של CodeGuru Xtreme,"
    },
    {
      "start": 3617.24,
      "end": 3621.24,
      "text": "ואז יש הקלטות זום,"
    },
    {
      "start": 3621.24,
      "end": 3625.64,
      "text": "כשולחים לקישור של הקלטות זום, יש פה הכל,"
    },
    {
      "start": 3625.64,
      "end": 3627.64,
      "text": "זה ה-20 זה העמנה שלנו עכשיו,"
    },
    {
      "start": 3628.24,
      "end": 3630.24,
      "text": "ובתוך ה-20,"
    },
    {
      "start": 3630.24,
      "end": 3633.64,
      "text": "יש הקלטות שלי, יש הקלטות של יהודה,"
    },
    {
      "start": 3633.64,
      "end": 3637.64,
      "text": "יש הקלטות שלי אותם, ויונתן, וגם של יונתן השני, ושל שחרף,"
    },
    {
      "start": 3637.64,
      "end": 3639.64,
      "text": "יש פה מלא הקלטות."
    },
    {
      "start": 3639.64,
      "end": 3641.64,
      "text": "אההה,"
    },
    {
      "start": 3641.64,
      "end": 3643.64,
      "text": "סבבה."
    },
    {
      "start": 3643.64,
      "end": 3645.64,
      "text": "אז, מלא מלא מלא פקודות,"
    },
    {
      "start": 3645.64,
      "end": 3647.64,
      "text": "כל פקודה יש לה איזשהו מספר,"
    },
    {
      "start": 3647.64,
      "end": 3649.64,
      "text": "וכמו שאמרנו פה מקודם,"
    },
    {
      "start": 3649.64,
      "end": 3651.64,
      "text": "כל מספר יכול להיות ה-1."
    },
    {
      "start": 3651.64,
      "end": 3653.64,
      "text": "כן, איזה פייס?"
    },
    {
      "start": 3653.64,
      "end": 3655.64,
      "text": "עכשיו,"
    },
    {
      "start": 3655.64,
      "end": 3657.64,
      "text": "האם כולם מצליחים לראות"
    },
    {
      "start": 3657.64,
      "end": 3659.64,
      "text": "את המסך שלי"
    },
    {
      "start": 3659.64,
      "end": 3661.64,
      "text": "במחשב, באינטרנט,"
    },
    {
      "start": 3661.64,
      "end": 3663.64,
      "text": "האם כולם רואים?"
    },
    {
      "start": 3663.64,
      "end": 3665.64,
      "text": "כן, כן."
    },
    {
      "start": 3665.64,
      "end": 3667.64,
      "text": "מגניב."
    },
    {
      "start": 3667.64,
      "end": 3669.64,
      "text": "הדבר הזה שאתם רואים פה בצד,"
    },
    {
      "start": 3669.64,
      "end": 3671.64,
      "text": "ומלא מלא הפסים,"
    },
    {
      "start": 3671.64,
      "end": 3673.64,
      "text": "זה הזיכרון,"
    },
    {
      "start": 3675.64,
      "end": 3677.64,
      "text": "זאת אומרת, אני מצא באיזשהו אדם,"
    },
    {
      "start": 3677.64,
      "end": 3679.64,
      "text": "שזה סימולטור,"
    },
    {
      "start": 3679.64,
      "end": 3684.64,
      "text": "סוג של סימולטור לתחרות,"
    },
    {
      "start": 3684.64,
      "end": 3686.64,
      "text": "והוא מביאה את הזיכרון,"
    },
    {
      "start": 3686.64,
      "end": 3688.64,
      "text": "אני הולך לכתוב פה בצד קוד,"
    },
    {
      "start": 3688.64,
      "end": 3690.64,
      "text": "קוד בספה,"
    },
    {
      "start": 3690.64,
      "end": 3692.64,
      "text": "שאני קראת ספת הסיימלי,"
    },
    {
      "start": 3692.64,
      "end": 3694.64,
      "text": "זו ספה שהיא ממש ממש ממש,"
    },
    {
      "start": 3694.64,
      "end": 3696.64,
      "text": "למוחה, מה זה אומר שאין למוחה,"
    },
    {
      "start": 3696.64,
      "end": 3698.64,
      "text": "זה אומר שיחסית פשוטה,"
    },
    {
      "start": 3698.64,
      "end": 3700.64,
      "text": "לא פשוטה להבנה,"
    },
    {
      "start": 3700.64,
      "end": 3702.64,
      "text": "אבל אין בה הרבה פקודות"
    },
    {
      "start": 3702.64,
      "end": 3704.64,
      "text": "מסובכות,"
    },
    {
      "start": 3704.64,
      "end": 3706.64,
      "text": "והיא עוברת,"
    },
    {
      "start": 3706.64,
      "end": 3708.64,
      "text": "תרגום ישירות"
    },
    {
      "start": 3708.64,
      "end": 3710.64,
      "text": "להפסים ודאחדים."
    },
    {
      "start": 3710.64,
      "end": 3712.64,
      "text": "אני הולך לכתוב פה כל,"
    },
    {
      "start": 3712.64,
      "end": 3714.64,
      "text": "קוד,"
    },
    {
      "start": 3716.64,
      "end": 3718.64,
      "text": "זה הסורד הבסי?"
    },
    {
      "start": 3718.64,
      "end": 3720.64,
      "text": "עדיין לא,"
    },
    {
      "start": 3720.64,
      "end": 3722.64,
      "text": "אני אפילו לא הולך לכתוב עכשיו סופר,"
    },
    {
      "start": 3722.64,
      "end": 3724.64,
      "text": "אני הולך לכתוב עכשיו תוכנית,"
    },
    {
      "start": 3724.64,
      "end": 3726.64,
      "text": "שנניח"
    },
    {
      "start": 3728.64,
      "end": 3730.64,
      "text": "סופרת עד 10,"
    },
    {
      "start": 3730.64,
      "end": 3732.64,
      "text": "ואז סופרת"
    },
    {
      "start": 3732.64,
      "end": 3734.64,
      "text": "מ-10 ל-0,"
    },
    {
      "start": 3734.64,
      "end": 3736.64,
      "text": "בסלב, אבא?"
    },
    {
      "start": 3736.64,
      "end": 3738.64,
      "text": "אז עכשיו גם אמרנו את הופסים ואחדים,"
    },
    {
      "start": 3738.64,
      "end": 3740.64,
      "text": "והסקוט וספירה,"
    },
    {
      "start": 3740.64,
      "end": 3742.64,
      "text": "ואבאנו לכתיבת קוד?"
    },
    {
      "start": 3742.64,
      "end": 3744.64,
      "text": "כן,"
    },
    {
      "start": 3744.64,
      "end": 3746.64,
      "text": "עברנו לכתיבת קוד ממש בסיסית,"
    },
    {
      "start": 3746.64,
      "end": 3748.64,
      "text": "מה זה בכלל הסמבלי,"
    },
    {
      "start": 3748.64,
      "end": 3750.64,
      "text": "וכל הדברים האלה."
    },
    {
      "start": 3750.64,
      "end": 3752.64,
      "text": "אבל אני רוצה שזה בקורוו 886."
    },
    {
      "start": 3752.64,
      "end": 3754.64,
      "text": "ממשו?"
    },
    {
      "start": 3754.64,
      "end": 3756.64,
      "text": "למושים את זה"
    },
    {
      "start": 3756.64,
      "end": 3758.64,
      "text": "בסימולטר של הקוד גור?"
    },
    {
      "start": 3758.64,
      "end": 3760.64,
      "text": "למה אנחנו עושים את זה בסימולטר של הקוד גור?"
    },
    {
      "start": 3760.64,
      "end": 3762.64,
      "text": "התשובה היפה,"
    },
    {
      "start": 3762.64,
      "end": 3764.64,
      "text": "היא שאני רוצה שאתה צריכו לראות גם את הזיכרון,"
    },
    {
      "start": 3764.64,
      "end": 3766.64,
      "text": "התשובה האמיתית היא"
    },
    {
      "start": 3766.64,
      "end": 3768.64,
      "text": "גם זה, אבל גם כי"
    },
    {
      "start": 3768.64,
      "end": 3770.64,
      "text": "אני קצת אצל עליו,"
    },
    {
      "start": 3770.64,
      "end": 3772.64,
      "text": "ואני לא רוצה לפתוח קומפיילר של הסמבלי ביוחד בשביל זה."
    },
    {
      "start": 3772.64,
      "end": 3774.64,
      "text": "אוקיי."
    },
    {
      "start": 3780.64,
      "end": 3782.64,
      "text": "במולי אפליסייס."
    },
    {
      "start": 3782.64,
      "end": 3784.64,
      "text": "נכון?"
    },
    {
      "start": 3784.64,
      "end": 3786.64,
      "text": "יפה."
    },
    {
      "start": 3804.64,
      "end": 3806.64,
      "text": "כתבתי פה איזשהי תוכנית, היא לא מענית בפרמידה,"
    },
    {
      "start": 3806.64,
      "end": 3808.64,
      "text": "אני תראו שמה שייעושה,"
    },
    {
      "start": 3808.64,
      "end": 3810.64,
      "text": "אם תסתכלו על הקוריון צריכים לראות את החלוניית של BX,"
    },
    {
      "start": 3810.64,
      "end": 3812.64,
      "text": "זאת שאני מצביעה לפה?"
    },
    {
      "start": 3812.64,
      "end": 3818.2799999999997,
      "text": "קודם רואים אותה עזות של סומנת פה בכל כך או אהלפה שאחבר שלי?"
    },
    {
      "start": 3818.2799999999997,
      "end": 3819.64,
      "text": "יאללה."
    },
    {
      "start": 3819.64,
      "end": 3828.64,
      "text": "אוקיי. אז אתם תוכלו לראות את זה עולה לאחד, שתיים, שלוש, ארבע, חמש, שש, שבע, שמונה, תשע,"
    },
    {
      "start": 3828.64,
      "end": 3835.92,
      "text": "אי, אני עוב רגע סביר מהזה, ואז יורד לתשע, שמונה, שבע, שש, חמש, ארבע,"
    },
    {
      "start": 3835.92,
      "end": 3841.64,
      "text": "שלוש, שתיים, אחת, ואף איפה ס... כתובתי פתוחנית נורא, נורא, בסיסי ופשודה,"
    },
    {
      "start": 3842.2,
      "end": 3842.64,
      "text": "אבל..."
    },
    {
      "start": 3842.64,
      "end": 3844.12,
      "text": "מה זה כולי הדברים האלה?"
    },
    {
      "start": 3844.12,
      "end": 3852.2799999999997,
      "text": "יפה. זה קוד, בסופן, נורא, נורא, בסיסית, הקוד עצמו לא מעניין, כרגע, כי אני מבטיח לכם שתמטיב מדוע כל עוד רגע,"
    },
    {
      "start": 3852.2799999999997,
      "end": 3856.16,
      "text": "מה שמעניין אותי שתסתכלו זה הדבר הזה פה בצד."
    },
    {
      "start": 3856.16,
      "end": 3860.92,
      "text": "הדבר הזה שאתם רואים פה, כל שורה היא פקודה למעבד."
    },
    {
      "start": 3860.92,
      "end": 3866.44,
      "text": "הפקודה הזאת אומרת, ככה, ככה, משתנה BX ותגדיל את הערך שלו,"
    },
    {
      "start": 3866.44,
      "end": 3872.44,
      "text": "ביחד, תוסיף לו אחד. הפקודה הזאת אומרת, תבדוק האם BX ועשר שווים,"
    },
    {
      "start": 3872.44,
      "end": 3876.84,
      "text": "זאת אומרת, האם הערך שיש ב... BX זה איזשהו משתנה, כמו חופסה ששומרים בערך."
    },
    {
      "start": 3876.84,
      "end": 3881.2400000000002,
      "text": "אז השורה הזאת בעצם אומרת, תבדוק אם בתוך חופסה שקוראים לבי X,"
    },
    {
      "start": 3881.2400000000002,
      "end": 3883.2400000000002,
      "text": "מה, היינו נספר הוא עשר או לא?"
    },
    {
      "start": 3883.2400000000002,
      "end": 3884.2400000000002,
      "text": "השורה..."
    },
    {
      "start": 3884.2400000000002,
      "end": 3885.2400000000002,
      "text": "מה זה CMP?"
    },
    {
      "start": 3885.2400000000002,
      "end": 3889.2400000000002,
      "text": "מה זה CMP?"
    },
    {
      "start": 3889.2400000000002,
      "end": 3892.2400000000002,
      "text": "קיצור של המילה קונפרו. תשווה."
    },
    {
      "start": 3892.44,
      "end": 3894.2400000000002,
      "text": "ואם..."
    },
    {
      "start": 3894.2400000000002,
      "end": 3897.0400000000004,
      "text": "קיצור של אינקרמנט, שזה תגדיל באחד,"
    },
    {
      "start": 3897.0400000000004,
      "end": 3900.6400000000003,
      "text": "וJ and E זה בעצם JMP, not equal."
    },
    {
      "start": 3900.6400000000003,
      "end": 3903.84,
      "text": "תקפוץ אם זה לא נכון, תקפוץ אם הם לא שווים."
    },
    {
      "start": 3903.84,
      "end": 3907.84,
      "text": "זאת אומרת, תבדוק אם הם שווים לאפס ואז אם הם לא שווים,"
    },
    {
      "start": 3907.84,
      "end": 3911.6400000000003,
      "text": "תמשיך ותמשיך ותמשיך, ואז דק זה דקרמנט או דק ריסט,"
    },
    {
      "start": 3911.6400000000003,
      "end": 3914.84,
      "text": "לא איך אתם רוצים לסתכל על זה, תקטין את BX באחד,"
    },
    {
      "start": 3914.84,
      "end": 3917.44,
      "text": "תשוו אותו לאפס ואז אם הוא לא שווה לאפס,"
    },
    {
      "start": 3917.44,
      "end": 3918.84,
      "text": "תחזור על זה עוד פעם."
    },
    {
      "start": 3918.84,
      "end": 3920.84,
      "text": "איך הוא מובן שצריך להכתיל אותו באחד,"
    },
    {
      "start": 3920.84,
      "end": 3923.84,
      "text": "כי כתבת לו פשוט, אבדם, לא כתשת לו אכד."
    },
    {
      "start": 3924.84,
      "end": 3927.44,
      "text": "אז אינק, הבקודה הזאת,"
    },
    {
      "start": 3927.44,
      "end": 3930.44,
      "text": "היא בעצם מגדילה באחד."
    },
    {
      "start": 3931.44,
      "end": 3934.44,
      "text": "אינקרמנט ואנגלית זה בעצם להגדיל, להגדיל באחד."
    },
    {
      "start": 3934.44,
      "end": 3936.84,
      "text": "זה יודעת כמו קטינה באחד?"
    },
    {
      "start": 3936.84,
      "end": 3939.84,
      "text": "נכון, זה כמו אינקריס ודקריס, להגדיל ולהכתיל."
    },
    {
      "start": 3939.84,
      "end": 3940.84,
      "text": "אין."
    },
    {
      "start": 3941.84,
      "end": 3943.84,
      "text": "אבל מה שמעניין זה פחות הקוד הזה."
    },
    {
      "start": 3943.84,
      "end": 3946.84,
      "text": "הקוד הזה הוא ממש לא מעניין, הוא לא כזה חשוב."
    },
    {
      "start": 3946.84,
      "end": 3948.84,
      "text": "מה שחשוב לי, שתסתכלו זה פה הדבר הזה,"
    },
    {
      "start": 3948.84,
      "end": 3949.84,
      "text": "הדברים האלה בצב?"
    },
    {
      "start": 3949.84,
      "end": 3952.84,
      "text": "אה, יש צהר אחד שזה קוד ומה הצל השני שאתה עכשיו נקבע?"
    },
    {
      "start": 3952.84,
      "end": 3954.84,
      "text": "אלה הפקודות של המכונה."
    },
    {
      "start": 3954.84,
      "end": 3958.84,
      "text": "אלה הפסים והאחד היא פשוט קוד ובקודה, נכון?"
    },
    {
      "start": 3958.84,
      "end": 3959.84,
      "text": "ממשו."
    },
    {
      "start": 3959.84,
      "end": 3961.84,
      "text": "ושתי דברים שומעים קוד ובקודה."
    },
    {
      "start": 3961.84,
      "end": 3962.84,
      "text": "נכון."
    },
    {
      "start": 3962.84,
      "end": 3966.84,
      "text": "קוד ובקודה, זה שני דברים שונים,"
    },
    {
      "start": 3966.84,
      "end": 3968.84,
      "text": "הם קרובים מאוד אחד עכשיו."
    },
    {
      "start": 3968.84,
      "end": 3970.84,
