{
  "source": "1waEAQoBa8FlzUAddBbTOlS9qKsEu_QzK.mp4",
  "source_sha256": "678e967fc52976dd00f694e3b86558b4abf50edc1db4682e669517c3157ba31a",
  "model": "small",
  "language": "he",
  "language_probability": 1,
  "start": 8100.0,
  "end": 8485.525333,
  "elapsed_seconds": 176.73419165611267,
  "segments": [
    {
      "start": 8100.0,
      "end": 8104.0,
      "text": "אה, ואז אתה צריך לדעת את זה."
    },
    {
      "start": 8104.0,
      "end": 8106.0,
      "text": "קלוי פשוט לא ראש."
    },
    {
      "start": 8113.0,
      "end": 8118.0,
      "text": "אני חושב שאני מבין נכון, אני דעס מכצב תחלוד."
    },
    {
      "start": 8118.0,
      "end": 8120.0,
      "text": "נה, רון."
    },
    {
      "start": 8120.0,
      "end": 8126.0,
      "text": "אני רוצה שהקורבן יעשה את התוכנית PUSH-S-POP-S-TOSW."
    },
    {
      "start": 8126.0,
      "end": 8128.0,
      "text": "שהקורבן יעשה אותה?"
    },
    {
      "start": 8128.0,
      "end": 8130.0,
      "text": "כן."
    },
    {
      "start": 8130.0,
      "end": 8136.0,
      "text": "אתה אומר, בהנחה ואתה, אז תמוניד את הצודק."
    },
    {
      "start": 8136.0,
      "end": 8140.0,
      "text": "תהיה לו, זה הקודש של PUSH-S-POP-S-TOSW."
    },
    {
      "start": 8140.0,
      "end": 8143.0,
      "text": "אתה רוצה לדעת את זה תוכב שיודע איפה הקורבן."
    },
    {
      "start": 8143.0,
      "end": 8148.0,
      "text": "אוקיי, אז בהנחה ואתה יודע איפה קורבן, אז כן, אז זה יעבוד."
    },
    {
      "start": 8150.0,
      "end": 8155.0,
      "text": "בהנחה ואתה יודע איפה הוא, בוא נעשה את זה אפילו נורא לכל, נעשה וככה."
    },
    {
      "start": 8158.0,
      "end": 8170.0,
      "text": "Define Target location, ובוא נגיד שזה פדשם של השעה רבה."
    },
    {
      "start": 8170.0,
      "end": 8174.0,
      "text": "אז כן, בהנחה ואתה יודע איפה מקום הקורבן."
    },
    {
      "start": 8174.0,
      "end": 8179.0,
      "text": "התוכנית שכתבת פה עכשיו, דורסת את המקום של השוב ושוב ושוב,"
    },
    {
      "start": 8179.0,
      "end": 8185.0,
      "text": "עם הקוד פוש-S-POP-S-TOSW."
    },
    {
      "start": 8186.0,
      "end": 8192.0,
      "text": "מה שהיה חסר לך, זה הביתים שלך, היו הפוכים,"
    },
    {
      "start": 8192.0,
      "end": 8196.0,
      "text": "בגלל בעיות של מה שנקרא LITTLE-ND&VIG-ND&"
    },
    {
      "start": 8196.0,
      "end": 8201.0,
      "text": "וראשות צריך לשים להם שכשכותבים לזיכרון פקודות,"
    },
    {
      "start": 8201.0,
      "end": 8204.0,
      "text": "או כשכותבים מידע לזיכרון, אני כתב הפוך, כן?"
    },
    {
      "start": 8204.0,
      "end": 8209.0,
      "text": "אתה רואה שפה כתבתי 0.7, 0.E ופה נכתב 0.E, 0.7."
    },
    {
      "start": 8210.0,
      "end": 8217.0,
      "text": "נכון, אבל אם מוסיפים לפני זה 0.E, זה לא אמור כאילו כמו..."
    },
    {
      "start": 8217.0,
      "end": 8223.0,
      "text": "זה לא משהו רוקים, אני לא אשים 0.6 לפני, זה פשוט איתך דברים אחרים."
    },
    {
      "start": 8226.0,
      "end": 8230.0,
      "text": "זה פשוט איתך דברים 4.6.0."
    },
    {
      "start": 8232.0,
      "end": 8237.0,
      "text": "זאת אומרת, 0.6 מסמנתי של זה בסיס 16, LITTLE-ND&VIG-ND,"
    },
    {
      "start": 8237.0,
      "end": 8241.0,
      "text": "אני צריך לדעת לתמולד עם זה בלי קשר, אבל זה הבחנה חשובה,"
    },
    {
      "start": 8241.0,
      "end": 8247.0,
      "text": "כאילו, כן, אני יכול לכתוב על הלוח ממש קוד,"
    },
    {
      "start": 8247.0,
      "end": 8250.0,
      "text": "ולגרום להריצת אחרים להריצת לו, אני צריך לדעת איפה הם,"
    },
    {
      "start": 8250.0,
      "end": 8253.0,
      "text": "שזה כבר ממש לא אחר, ולכן דרך אגב,"
    },
    {
      "start": 8253.0,
      "end": 8258.0,
      "text": "לבואו אנשים פשוט מעדיפים לכתוב קוד נוכוקי במקום להתחיל לנסות לגרום לאחרים להריצת הכות שלהם,"
    },
    {
      "start": 8258.0,
      "end": 8260.0,
      "text": "חוץ מזומבים."
    },
    {
      "start": 8260.0,
      "end": 8264.0,
      "text": "זומבי אתה לא רוצה להרוג הרבה פעמים, אתה רוצה לחתוף עוד."
    },
    {
      "start": 8268.0,
      "end": 8270.0,
      "text": "אבל זה הייתה נקודה מאוד מאוד נהבה."
    },
    {
      "start": 8271.0,
      "end": 8273.0,
      "text": "האם יש למישהו פה עוד שאלות?"
    },
    {
      "start": 8275.0,
      "end": 8278.0,
      "text": "או שאנחנו ניפגש מה נפגש הבא?"
    },
    {
      "start": 8278.0,
      "end": 8279.0,
      "text": "יש פה כמה כש..."
    },
    {
      "start": 8279.0,
      "end": 8281.0,
      "text": "תגיד, אתה יכול לשאיר את זה בא לי להתאיק?"
    },
    {
      "start": 8281.0,
      "end": 8283.0,
      "text": "בסמך."
    },
    {
      "start": 8297.0,
      "end": 8313.0,
      "text": "בעיקרון, איך עוד שום זומבי?"
    },
    {
      "start": 8313.0,
      "end": 8314.0,
      "text": "איך איפה הוא נראה?"
    },
    {
      "start": 8314.0,
      "end": 8315.0,
      "text": "אוקיי?"
    },
    {
      "start": 8315.0,
      "end": 8317.0,
      "text": "בעיקרון, איך עוד שום זומבי?"
    },
    {
      "start": 8317.0,
      "end": 8318.0,
      "text": "או שאלה מטרו יחד."
    },
    {
      "start": 8319.0,
      "end": 8321.0,
      "text": "בעיקרון, לחתוף זומבי,"
    },
    {
      "start": 8321.0,
      "end": 8323.0,
      "text": "זה"
    },
    {
      "start": 8323.0,
      "end": 8325.0,
      "text": "למצוא את המקום שלו הזיכרון,"
    },
    {
      "start": 8325.0,
      "end": 8333.0,
      "text": "לדרוס את המקום הזה עם קוד שכשזומבי יבצע אותו זה יגרום לזומבי להריץ את הקוד שלך"
    },
    {
      "start": 8334.0,
      "end": 8341.0,
      "text": "עכשיו זה יכול להיות פיזית הקוד שלך, זאת אומרת זה יכול להיות ממש"
    },
    {
      "start": 8343.0,
      "end": 8345.0,
      "text": "אתה תתת טוב עליו קוד שאתה רוצה שהוא יבצע"
    },
    {
      "start": 8346.0,
      "end": 8349.0,
      "text": "או וזה השיטה הרבה יותר נפוצה לקחת את הזומבי"
    },
    {
      "start": 8350.0,
      "end": 8353.0,
      "text": "לקחת את המצביע של הזומבי"
    },
    {
      "start": 8354.0,
      "end": 8356.0,
      "text": "ולהגיד לו עכשיו אתה מצביע על הקוד שלך"
    },
    {
      "start": 8357.0,
      "end": 8359.0,
      "text": "ועכשיו יש שני מצביעים במקביל"
    },
    {
      "start": 8360.0,
      "end": 8361.0,
      "text": "שמריצים את הקוד שלך"
    },
    {
      "start": 8362.0,
      "end": 8363.0,
      "text": "ואז הקוד שלך פועל בפישתיים יותר מאירות"
    },
    {
      "start": 8364.0,
      "end": 8366.0,
      "text": "מחורר, הוא רץ פשוט פעמיים במקביל"
    },
    {
      "start": 8367.0,
      "end": 8368.0,
      "text": "אז איזה חזק"
    },
    {
      "start": 8369.0,
      "end": 8370.0,
      "text": "איך חוטפים אותם פרקטית"
    },
    {
      "start": 8371.0,
      "end": 8373.0,
      "text": "אז לגב זה כמו איזה שהיא חידה קטנה שצריך לפצח"
    },
    {
      "start": 8373.0,
      "end": 8379.0,
      "text": "בלרוב הזומבי כותב את המקום שלו לאיזשהו מקום בזירה"
    },
    {
      "start": 8380.0,
      "end": 8388.0,
      "text": "או שהזומבי יש לו חלק קטן בקוד שאפשר לתרגט אותו"
    },
    {
      "start": 8389.0,
      "end": 8393.0,
      "text": "או שהוא כותב, הוא עושה איזשהו, קורה איזשהו ערך"
    },
    {
      "start": 8394.0,
      "end": 8397.0,
      "text": "ואז מריץ אותו, זה תמיד יש איזשהו שטות קטנה איתו"
    },
    {
      "start": 8398.0,
      "end": 8399.0,
      "text": "שאפשר לפצח אותה"
    },
    {
      "start": 8400.0,
      "end": 8402.0,
      "text": "ואז המתחיל את משחק ממש ממש מגנים"
    },
    {
      "start": 8403.0,
      "end": 8407.0,
      "text": "של איך לוקחים את מה שהזום ביוסש"
    },
    {
      "start": 8407.0,
      "end": 8409.0,
      "text": "זה הרבה פעמים נורא נורא מגובל"
    },
    {
      "start": 8410.0,
      "end": 8412.0,
      "text": "הרבה פעמים זה משהו ממש שלוטי וקטן"
    },
    {
      "start": 8412.0,
      "end": 8413.0,
      "text": "איך מצליחים למצוא"
    },
    {
      "start": 8414.0,
      "end": 8416.0,
      "text": "דווקא את מה שאנשים אחרים כנראה לא חשבו עליו"
    },
    {
      "start": 8417.0,
      "end": 8418.0,
      "text": "ולהשתמש בזה"
    },
    {
      "start": 8427.0,
      "end": 8429.0,
      "text": "דווית תגידי כששיאמתם"
    },
    {
      "start": 8429.0,
      "end": 8430.0,
      "text": "ואני"
    },
    {
      "start": 8430.0,
      "end": 8431.0,
      "text": "אוקיי"
    },
    {
      "start": 8434.0,
      "end": 8435.0,
      "text": "עוד שירות מהקהל"
    },
    {
      "start": 8447.0,
      "end": 8448.0,
      "text": "בסדר"
    },
    {
      "start": 8448.0,
      "end": 8449.0,
      "text": "אז"
    },
    {
      "start": 8452.0,
      "end": 8453.0,
      "text": "ברגע שאתה ביזה יסיים להתיק את הקבועת"
    },
    {
      "start": 8453.0,
      "end": 8454.0,
      "text": "אני לא יסיים"
    },
    {
      "start": 8454.0,
      "end": 8455.0,
      "text": "סיימתם?"
    },
    {
      "start": 8455.0,
      "end": 8456.0,
      "text": "כן"
    },
    {
      "start": 8456.0,
      "end": 8457.0,
      "text": "מעולה"
    },
    {
      "start": 8457.0,
      "end": 8458.0,
      "text": "אז תודה רבה לכם"
    },
    {
      "start": 8458.0,
      "end": 8460.0,
      "text": "היה מפגש ממש ממש טוב"
    },
    {
      "start": 8461.0,
      "end": 8462.0,
      "text": "למדתם"
    },
    {
      "start": 8462.0,
      "end": 8463.0,
      "text": "מלא"
    },
    {
      "start": 8463.0,
      "end": 8465.0,
      "text": "כאילו, יקר את הספוצלנו היום היה בלהבין רגע טיאוריה"
    },
    {
      "start": 8465.0,
      "end": 8467.0,
      "text": "שאני מניח שאולי חלק איכם ככה נראה דתם את זה"
    },
    {
      "start": 8468.0,
      "end": 8469.0,
      "text": "אבל זה חשוב מאוד"
    },
    {
      "start": 8470.0,
      "end": 8471.0,
      "text": "נגדנו גם טיפה בפרקטיקה"
    },
    {
      "start": 8471.0,
      "end": 8473.0,
      "text": "נגדנו גם טיפה בערכב ממש את הכל"
    },
    {
      "start": 8473.0,
      "end": 8475.0,
      "text": "מפגשים הבאים יהיו הרבה הרבה יותר פרקטיים"
    },
    {
      "start": 8475.0,
      "end": 8476.0,
      "text": "זה היה הרבה יותר כתיבה של כל"
    },
    {
      "start": 8476.0,
      "end": 8478.0,
      "text": "ולמידה של טכנולוגיות"
    },
    {
      "start": 8478.0,
      "end": 8480.0,
      "text": "מפגש הבא כמו שאמרתי"
    },
    {
      "start": 8480.0,
      "end": 8482.0,
      "text": "ביום 5 ושעה 8 בערן"
    },
    {
      "start": 8482.0,
      "end": 8484.0,
      "text": "זהו, שיה לכם המון בהצלחה"
    },
    {
      "start": 8484.0,
      "end": 8485.0,
      "text": "ולילה טוב"
    }
  ]
}