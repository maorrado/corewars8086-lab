    },
    {
      "start": 5156.0,
      "end": 5157.0,
      "text": "שם זה הבית שלו,"
    },
    {
      "start": 5157.0,
      "end": 5158.0,
      "text": "נחורה."
    },
    {
      "start": 5159.0,
      "end": 5160.0,
      "text": "אנחנו הולכים."
    },
    {
      "start": 5162.0,
      "end": 5163.0,
      "text": "אה, זה מה שעושים"
    },
    {
      "start": 5163.0,
      "end": 5164.0,
      "text": "כאילו בתחרות,"
    },
    {
      "start": 5164.0,
      "end": 5165.0,
      "text": "צריך להמחוק אנשים?"
    },
    {
      "start": 5166.0,
      "end": 5167.0,
      "text": "נכון."
    },
    {
      "start": 5167.0,
      "end": 5168.0,
      "text": "אה, וואו,"
    },
    {
      "start": 5168.0,
      "end": 5169.0,
      "text": "אוקיי."
    },
    {
      "start": 5169.0,
      "end": 5170.0,
      "text": "אה, וואו, אוקיי."
    },
    {
      "start": 5172.0,
      "end": 5173.0,
      "text": "ואז מה שאני אעשה פה,"
    },
    {
      "start": 5175.0,
      "end": 5176.0,
      "text": "אני כותב קודש הוא קצת מסובך"
    },
    {
      "start": 5176.0,
      "end": 5177.0,
      "text": "להבנה,"
    },
    {
      "start": 5177.0,
      "end": 5178.0,
      "text": "ואני עוד רגע,"
    },
    {
      "start": 5178.0,
      "end": 5179.0,
      "text": "סביר אותו."
    },
    {
      "start": 5180.0,
      "end": 5181.0,
      "text": "אז כאילו מה שאנחנו"
    },
    {
      "start": 5181.0,
      "end": 5182.0,
      "text": "מעשה זה,"
    },
    {
      "start": 5182.0,
      "end": 5183.0,
      "text": "זה חולב ומתאמן,"
    },
    {
      "start": 5183.0,
      "end": 5184.0,
      "text": "כזה?"
    },
    {
      "start": 5188.0,
      "end": 5189.0,
      "text": "האם צריך כל הזמן"
    },
    {
      "start": 5189.0,
      "end": 5190.0,
      "text": "להתאמן,"
    },
    {
      "start": 5190.0,
      "end": 5191.0,
      "text": "עוד רגע נסביר,"
    },
    {
      "start": 5191.0,
      "end": 5192.0,
      "text": "ושאלות עובות?"
    },
    {
      "start": 5194.0,
      "end": 5195.0,
      "text": "שימו לב,"
    },
    {
      "start": 5195.0,
      "end": 5196.0,
      "text": "ארגת ידע."
    },
    {
      "start": 5196.0,
      "end": 5197.0,
      "text": "כן, אני אדום,"
    },
    {
      "start": 5197.0,
      "end": 5198.0,
      "text": "וזה היה רוק,"
    },
    {
      "start": 5198.0,
      "end": 5199.0,
      "text": "והוא מת."
    },
    {
      "start": 5199.0,
      "end": 5200.0,
      "text": "ואם אני הלך לפה עכשיו,"
    },
    {
      "start": 5200.0,
      "end": 5201.0,
      "text": "הוא מת."
    },
    {
      "start": 5201.0,
      "end": 5202.0,
      "text": "רואים את הדבר הזה,"
    },
    {
      "start": 5202.0,
      "end": 5203.0,
      "text": "זה אומר שהוא מת."
    },
    {
      "start": 5205.0,
      "end": 5207.0,
      "text": "זה אומר שהוא לא קייב יותר?"
    },
    {
      "start": 5208.0,
      "end": 5209.0,
      "text": "אז הוא,"
    },
    {
      "start": 5209.0,
      "end": 5211.0,
      "text": "הוא, הוא, הוא היה קייב לרגע אחד,"
    },
    {
      "start": 5212.0,
      "end": 5213.0,
      "text": "גם אחרי שאת הרסתי אותו,"
    },
    {
      "start": 5213.0,
      "end": 5214.0,
      "text": "ואז הוא,"
    },
    {
      "start": 5214.0,
      "end": 5215.0,
      "text": "הוא, הוא,"
    },
    {
      "start": 5215.0,
      "end": 5216.0,
      "text": "נכון אמרנו שמה צביעה זה בעצם,"
    },
    {
      "start": 5216.0,
      "end": 5217.0,
      "text": "מצביעה הפקודה,"
    },
    {
      "start": 5217.0,
      "end": 5218.0,
      "text": "מבצע את הפקודה שכתובה שם,"
    },
    {
      "start": 5218.0,
      "end": 5219.0,
      "text": "מה שעשיתי זה בעצם,"
    },
    {
      "start": 5219.0,
      "end": 5221.0,
      "text": "התמנתי בתוכו,"
    },
    {
      "start": 5222.0,
      "end": 5223.0,
      "text": "פקודה בלתי חוקית."
    },
    {
      "start": 5224.0,
      "end": 5225.0,
      "text": "הפקודה הזאת הייתה,"
    },
    {
      "start": 5225.0,
      "end": 5226.0,
      "text": "סייסים,"
    },
    {
      "start": 5226.0,
      "end": 5227.0,
      "text": "פקודה בלתי חוקית."
    },
    {
      "start": 5228.0,
      "end": 5229.0,
      "text": "אוקיי?"
    },
    {
      "start": 5231.0,
      "end": 5232.0,
      "text": "סייסים,"
    },
    {
      "start": 5232.0,
      "end": 5233.0,
      "text": "תראו,"
    },
    {
      "start": 5233.0,
      "end": 5235.0,
      "text": "ארגת אני אשתיש את תמיד למחוק."
    },
    {
      "start": 5235.0,
      "end": 5236.0,
      "text": "נכון,"
    },
    {
      "start": 5236.0,
      "end": 5237.0,
      "text": "אחד אחד 0,"
    },
    {
      "start": 5237.0,
      "end": 5238.0,
      "text": "אחד אחד 0,"
    },
    {
      "start": 5238.0,
      "end": 5239.0,
      "text": "אחד אחד 0,"
    },
    {
      "start": 5239.0,
      "end": 5240.0,
      "text": "אחד אחד 0,"
    },
    {
      "start": 5240.0,
      "end": 5241.0,
      "text": "למחוק."
    },
    {
      "start": 5241.0,
      "end": 5242.0,
      "text": "מת,"
    },
    {
      "start": 5242.0,
      "end": 5243.0,
      "text": "פקודה בלתי חוקית בעליל,"
    },
    {
      "start": 5243.0,
      "end": 5244.0,
      "text": "בכלל, בכלל, בכלל,"
    },
    {
      "start": 5244.0,
      "end": 5245.0,
      "text": "בכלל אי אפשר,"
    },
    {
      "start": 5245.0,
      "end": 5246.0,
      "text": "לסרול אותה."
    },
    {
      "start": 5247.0,
      "end": 5248.0,
      "text": "ברגע שקראתה אותה,"
    },
    {
      "start": 5248.0,
      "end": 5249.0,
      "text": "אתה מת."
    },
    {
      "start": 5249.0,
      "end": 5250.0,
      "text": "עכשיו,"
    },
    {
      "start": 5250.0,
      "end": 5251.0,
      "text": "על וי וזה היה כזה פשוט."
    },
    {
      "start": 5251.0,
      "end": 5252.0,
      "text": "הוא על עוד רגע ניגע בלם,"
    },
    {
      "start": 5252.0,
      "end": 5253.0,
      "text": "זה לא."
    },
    {
      "start": 5253.0,
      "end": 5254.0,
      "text": "אבל כן,"
    },
    {
      "start": 5254.0,
      "end": 5255.0,
      "text": "הוא מת."
    },
    {
      "start": 5255.0,
      "end": 5256.0,
      "text": "ניצחתי."
    },
    {
      "start": 5256.0,
      "end": 5258.0,
      "text": "אתם גם יכולים לראות ממש פה,"
    },
    {
      "start": 5258.0,
      "end": 5259.0,
      "text": "שאם אני אפיל את מצל תחרות,"
    },
    {
      "start": 5260.0,
      "end": 5261.0,
      "text": "ניצחתי."
    },
    {
      "start": 5261.0,
      "end": 5262.0,
      "text": "אה, בערך,"
    },
    {
      "start": 5263.0,
      "end": 5264.0,
      "text": "אתם שואלים את עצמכם,"
    },
    {
      "start": 5265.0,
      "end": 5266.0,
      "text": "למה זה מרק מוטקו?"
    },
    {
      "start": 5267.0,
      "end": 5268.0,
      "text": "אני לא אסביר לכם,"
    },
    {
      "start": 5268.0,
      "end": 5269.0,
      "text": "כי אתם"
    },
    {
      "start": 5269.0,
      "end": 5270.0,
      "text": "תתבאסו קצת."
    },
    {
      "start": 5271.0,
      "end": 5273.0,
      "text": "אבל רגע שאלות שלכם,"
    },
    {
      "start": 5274.0,
      "end": 5275.0,
      "text": "על כל מה שהיינו עד עכשיו,"
    },
    {
      "start": 5275.0,
      "end": 5277.0,
      "text": "על איך דורסים,"
    },
    {
      "start": 5277.0,
      "end": 5279.0,
      "text": "איך דורסים מקום בזיכרון,"
    },
    {
      "start": 5279.0,
      "end": 5280.0,
      "text": "על מה זה התחרות הזאת בפל,"
    },
    {
      "start": 5280.0,
      "end": 5281.0,
      "text": "ועל מה המטרה שלה."
    },
    {
      "start": 5281.0,
      "end": 5283.0,
      "text": "האם כולם הצליחים להבין,"
    },
    {
      "start": 5283.0,
      "end": 5284.0,
      "text": "שהמטרה היא לכתוב"
    },
    {
      "start": 5284.0,
      "end": 5285.0,
      "text": "וכוד,"
    },
    {
      "start": 5286.0,
      "end": 5287.0,
      "text": "שלא ידרסו אותו,"
    },
    {
      "start": 5287.0,
      "end": 5288.0,
      "text": "ושהוא ידרוס אחרים,"
    },
    {
      "start": 5288.0,
      "end": 5289.0,
      "text": "כמה שרקניתנו?"
    },
    {
      "start": 5290.0,
      "end": 5291.0,
      "text": "אני לא הבנתי,"
    },
    {
      "start": 5292.0,
      "end": 5293.0,
      "text": "תראו,"
    },
    {
      "start": 5293.0,
      "end": 5295.0,
      "text": "הקודש שאני הייתי צריך לדעת,"
    },
    {
      "start": 5295.0,
      "end": 5297.0,
      "text": "כשמדרוס אחרים זה,"
    },
    {
      "start": 5298.0,
      "end": 5299.0,
      "text": "ארתר יושים, נכון?"
    },
    {
      "start": 5300.0,
      "end": 5302.0,
      "text": "זה המידע שאתה צריך"
    },
    {
      "start": 5302.0,
      "end": 5303.0,
      "text": "לשים על אחרים,"
    },
    {
      "start": 5303.0,
      "end": 5304.0,
      "text": "כדי שהם,"
    },
    {
      "start": 5304.0,
      "end": 5305.0,
      "text": "כן."
    },
    {
      "start": 5305.0,
      "end": 5306.0,
      "text": "זה הקודש שאתה..."
    },
    {
      "start": 5306.0,
      "end": 5307.0,
      "text": "אני לא רואה את זה,"
    },
    {
      "start": 5307.0,
      "end": 5308.0,
      "text": "כל אחד זה האפס,"
    },
    {
      "start": 5308.0,
      "end": 5309.0,
      "text": "וזה, לך פשוט,"
    },
    {
      "start": 5309.0,
      "end": 5310.0,
      "text": "כאילו אני יכולים"
    },
    {
      "start": 5311.0,
      "end": 5312.0,
      "text": "ללכת,"
    },
    {
      "start": 5312.0,
      "end": 5314.0,
      "text": "ולחוץ עם ההכבר על"
    },
    {
      "start": 5314.0,
      "end": 5315.0,
      "text": "זה,"
    },
    {
      "start": 5315.0,
      "end": 5316.0,
      "text": "ולגשון סיסי-זזי,"
    },
    {
      "start": 5316.0,
      "end": 5317.0,
      "text": "וזה מחדכת."
    },
    {
      "start": 5317.0,
      "end": 5318.0,
      "text": "אתה שואל למה אני מטריתכם,"
    },
    {
      "start": 5318.0,
      "end": 5319.0,
      "text": "לך אתחיל לה את כל האפסים,"
    },
    {
      "start": 5319.0,
      "end": 5320.0,
      "text": "ואחרנים מהותברים האלה?"
    },
    {
      "start": 5320.0,
      "end": 5321.0,
      "text": "כן."
    },
    {
      "start": 5321.0,
      "end": 5322.0,
      "text": "או, שלמצאי,"
    },
    {
      "start": 5322.0,
      "end": 5323.0,
      "text": "בשביל ההבנה שלכם."
    },
    {
      "start": 5324.0,
      "end": 5325.0,
      "text": "כי,"
    },
    {
      "start": 5325.0,
      "end": 5327.0,
      "text": "כי זה נכון שאתם יכולים להשתמש"
    },
    {
      "start": 5327.0,
      "end": 5329.0,
      "text": "רק בסיסי-16,"
    },
    {
      "start": 5329.0,
      "end": 5330.0,
      "text": "ולהסתפק בזה,"
    },
    {
      "start": 5330.0,
      "end": 5331.0,
      "text": "ולא באמת לדעת,"
    },
    {
      "start": 5331.0,
      "end": 5332.0,
      "text": "אבל,"
    },
    {
      "start": 5332.0,
      "end": 5333.0,
      "text": "לא מגיעים ככה,"
    },
    {
      "start": 5333.0,
      "end": 5334.0,
      "text": "ארחוק,"
    },
    {
      "start": 5334.0,
      "end": 5335.0,
      "text": "אתם תוכלו לכתוב שם,"
    },
    {
      "start": 5335.0,
      "end": 5336.0,
      "text": "ככה טכנית שהיא בסדר,"
    },
    {
      "start": 5336.0,
      "end": 5337.0,
      "text": "אבל רק עם הבנה,"
    },
    {
      "start": 5337.0,
      "end": 5339.0,
      "text": "זה המוקה של מה זה המחשב,"
    },
    {
      "start": 5339.0,
      "end": 5340.0,
      "text": "מה זה המעבד,"
    },
    {
      "start": 5340.0,
      "end": 5341.0,
      "text": "איך נראה הזיכרון,"
    },
    {
      "start": 5341.0,
      "end": 5343.0,
      "text": "אפשר לנצח את התחרות הזאת."
    },
    {
      "start": 5344.0,
      "end": 5345.0,
      "text": "סעה, יש פה, יש פה התחרות הזאת"
    },
    {
      "start": 5345.0,
      "end": 5346.0,
      "text": "ממהשים נורא מוכשמים,"
    },
    {
      "start": 5346.0,
      "end": 5347.0,
      "text": "שמוצאים שיטו,"
    },
    {
      "start": 5347.0,
      "end": 5348.0,
      "text": "כשמבטיעות אותי,"
    },
    {
      "start": 5348.0,
      "end": 5350.0,
      "text": "שית כל כך חרות מחדש."
    },
    {
      "start": 5351.0,
      "end": 5352.0,
      "text": "וזה קורה רק"
    },
    {
      "start": 5352.0,
      "end": 5353.0,
      "text": "מטוך הבנה המוקה של"
    },
    {
      "start": 5353.0,
      "end": 5354.0,
      "text": "הלכת תוכנית הזאת,"
    },
    {
      "start": 5354.0,
      "end": 5356.0,
      "text": "ואיך המשחק הזה פובד."
    },
    {
      "start": 5356.0,
      "end": 5358.0,
      "text": "המשחק הזה הוא בסך הכל,"
    },
    {
      "start": 5358.0,
      "end": 5359.0,
      "text": "עוש לי סיכוי."
    },
    {
      "start": 5360.0,
      "end": 5362.0,
      "text": "יש לך סיכוי,"
    },
    {
      "start": 5362.0,
      "end": 5363.0,
      "text": "כי אני מבטיח לך,"
    },
    {
      "start": 5363.0,
      "end": 5364.0,
      "text": "שאיזה כיתה אתה?"
    },
    {
      "start": 5365.0,
      "end": 5366.0,
      "text": "אה, זיין."
    },
    {
      "start": 5367.0,
      "end": 5369.0,
      "text": "זיין, לא רק שיש לך סיכוי,"
    },
    {
      "start": 5369.0,
      "end": 5371.0,
      "text": "הקבוצה שזכתה"
    },
    {
      "start": 5372.0,
      "end": 5375.0,
      "text": "בתחרות השנייה שאני הייתי מדריך בה,"
    },
    {
      "start": 5375.0,
      "end": 5376.0,
      "text": "זו הייתה קבוצה שלדעתי,"
    },
    {
      "start": 5376.0,
      "end": 5378.0,
      "text": "לא היה לרכא,"
    },
    {
      "start": 5378.0,
      "end": 5380.0,
      "text": "הם יצטרפו לזומים שלי בתחרות,"
    },
    {
      "start": 5381.0,
      "end": 5383.0,
      "text": "הם למדו את הדברים מאפס,"
    },
    {
      "start": 5383.0,
      "end": 5384.0,
      "text": "הם השקיעו מאוד מאוד קשה,"
    },
    {
      "start": 5384.0,
      "end": 5386.0,
      "text": "והם הגיעו מקום ראשון."
    },
    {
      "start": 5387.0,
      "end": 5388.0,
      "text": "הכל אפשרי,"
    },
    {
      "start": 5388.0,
      "end": 5390.0,
      "text": "במיוחד בשלבים האלה,"
    },
    {
      "start": 5390.0,
      "end": 5392.0,
      "text": "בתחרויות שהם של הצהירים,"
    },
    {
      "start": 5392.0,
      "end": 5393.0,
      "text": "כי נכון,"
    },
    {
      "start": 5393.0,
      "end": 5394.0,
      "text": "יש פה קהילה נועה וגובשת,"
    },
