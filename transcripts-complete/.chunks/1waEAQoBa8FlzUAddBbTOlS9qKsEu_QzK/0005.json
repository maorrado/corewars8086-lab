{
  "source": "1waEAQoBa8FlzUAddBbTOlS9qKsEu_QzK.mp4",
  "source_sha256": "678e967fc52976dd00f694e3b86558b4abf50edc1db4682e669517c3157ba31a",
  "model": "small",
  "language": "he",
  "language_probability": 1,
  "start": 4500.0,
  "end": 5400.0,
  "elapsed_seconds": 2401.2403361797333,
  "segments": [
    {
      "start": 4500.0,
      "end": 4505.0,
      "text": "קדתי ספס, כל הדבר הזה הוא פשוט AB504."
    },
    {
      "start": 4506.0,
      "end": 4516.0,
      "text": "אוקיי? עכשיו, אז הסיבה שאנחנו מכירים את הבא סיס הזה, הסיבה שאנחנו מתעסקים איתו, זה פשוט כי הרבה יותר נרח לקרוא אותו מאשר לקרוא מספרים ממש ממש הרוקים."
    },
    {
      "start": 4516.0,
      "end": 4527.0,
      "text": "זה כמו צורה מקוצרת. עכשיו, אחרי שלמדו את הדבר הזה שאנחנו יודעים שאנחנו יכולים להמיר כל דבר, בוא נסתכל רגע על הפקודה הממש מסובכת הזאת,"
    },
    {
      "start": 4527.0,
      "end": 4532.0,
      "text": "שאומרת תשווה בין BX לבין 10, ובוא ננסה לפערק אותה."
    },
    {
      "start": 4534.0,
      "end": 4535.0,
      "text": "השאלה?"
    },
    {
      "start": 4535.0,
      "end": 4537.0,
      "text": "אפשר שאלה, בלוח."
    },
    {
      "start": 4537.0,
      "end": 4550.0,
      "text": "אתה יכול להגזיר לכל כאילו שאיפה שכתבתו על אופו, בשזבטו, כן, פה, אז נכון יש 10-10?"
    },
    {
      "start": 4550.0,
      "end": 4551.0,
      "text": "נכון."
    },
    {
      "start": 4551.0,
      "end": 4555.0,
      "text": "אז למה זה יהיה רק A1 מלא שתי A?"
    },
    {
      "start": 4555.0,
      "end": 4570.0,
      "text": "אוקיי, שאלה מצוינת, כי זה לא 10 רגיל שאנחנו מכירים, אלא זה בעצם 1,0,1,0, בבסיס 2, שאין להם עשה לפערק את זה, זה בעצם אומר 8, ועוד 2, למה?"
    },
    {
      "start": 4570.0,
      "end": 4582.0,
      "text": "כי זה בעצם 2.3, ועוד 2.1, כן יש לנו 2.0, לא רוצים אותו, 2.1 כן רוצים אותו כי יש שם 1, 2.2 לא רוצים אותו כי יש פה 0,"
    },
    {
      "start": 4582.0,
      "end": 4594.0,
      "text": "2.3 כן רוצים אותו כי יש פה 1, אז זה 2.3, ועוד 2.1, זה בעצם שווה 8 ועוד 2, של זה 10."
    },
    {
      "start": 4594.0,
      "end": 4596.0,
      "text": "אפשר."
    },
    {
      "start": 4596.0,
      "end": 4607.0,
      "text": "אוקיי, אז את הפקודה ממש מסובכת לקחנו משם, ועכשיו אנחנו ננסה להמיר אותה, להפסים ואחד עם סתם, אז זה בעצם 1,0,1,"
    },
    {
      "start": 4607.0,
      "end": 4610.0,
      "text": "8,3 נכון."
    },
    {
      "start": 4610.0,
      "end": 4620.0,
      "text": "זה 8,3 זה כמו ש, זה כמו ש12 זה לא, זה לא 1 כפול 2, אלא זה פשוט 12, זה 1, זה 1 כפול 10 ושתיים."
    },
    {
      "start": 4620.0,
      "end": 4624.0,
      "text": "אז אני ממיר את המספר הזה פה בשביל..."
    },
    {
      "start": 4624.0,
      "end": 4626.0,
      "text": "אני לא שם על השיחה, אני אוהב למכון."
    },
    {
      "start": 4626.0,
      "end": 4628.0,
      "text": "אני לא שם על השיחה."
    },
    {
      "start": 4628.0,
      "end": 4631.0,
      "text": "צריכים להיות לנו פה ששעה אני אוהב למכון?"
    },
    {
      "start": 4631.0,
      "end": 4632.0,
      "text": "אהה נכון."
    },
    {
      "start": 4633.0,
      "end": 4634.0,
      "text": "אוקיי."
    },
    {
      "start": 4641.0,
      "end": 4642.0,
      "text": "מגניב."
    },
    {
      "start": 4643.0,
      "end": 4648.0,
      "text": "אז הפקודה הזאת שראינו מקודם היא בסך הכל הפסים ואחד עם."
    },
    {
      "start": 4648.0,
      "end": 4653.0,
      "text": "אוקיי, תרגמתי את הפקוע בשבילנו עכשיו, והנה אני אומר לכם,"
    },
    {
      "start": 4655.0,
      "end": 4659.0,
      "text": "הכל הזה שכתבתי פה הוא בסך הכל הפסים ואחד עם,"
    },
    {
      "start": 4660.0,
      "end": 4665.0,
      "text": "כשמהבד קורה, הוא אומר, אה, סבבה, הבנתי מה אתה רוצה, אני אעשה את זה."
    },
    {
      "start": 4666.0,
      "end": 4670.0,
      "text": "וקצת יותר מזה, כל קודש שכתוב,"
    },
    {
      "start": 4670.0,
      "end": 4675.0,
      "text": "וואטסאפ, פייסבוק, יוטיוב, המערכת הפלש לטלפון שלכם,"
    },
    {
      "start": 4676.0,
      "end": 4679.0,
      "text": "התמונות, כיפת ברזל הכל,"
    },
    {
      "start": 4679.0,
      "end": 4681.0,
      "text": "בסוף הופך להפסים ואחד עם,"
    },
    {
      "start": 4681.0,
      "end": 4685.0,
      "text": "והמאבד מקבל את זה וקורה את זה."
    },
    {
      "start": 4686.0,
      "end": 4687.0,
      "text": "הכל, הכל הכל."
    },
    {
      "start": 4687.0,
      "end": 4693.0,
      "text": "זה שאלה, נפכנים במחשב מופיע איזשהו משך צדדי בימין או סמון,"
    },
    {
      "start": 4693.0,
      "end": 4696.0,
      "text": "ויש בו כל מיני כתבים מוזרים באנגלית,"
    },
    {
      "start": 4696.0,
      "end": 4699.0,
      "text": "וסגור לראו קטום ועדום."
    },
    {
      "start": 4700.0,
      "end": 4703.0,
      "text": "האם זה המסך שאתה נעברת עליו?"
    },
    {
      "start": 4704.0,
      "end": 4705.0,
      "text": "כן."
    },
    {
      "start": 4705.0,
      "end": 4706.0,
      "text": "מגניב."
    },
    {
      "start": 4707.0,
      "end": 4710.0,
      "text": "אז המסך הזה גם קשור, אבל לא בדיוק,"
    },
    {
      "start": 4710.0,
      "end": 4716.0,
      "text": "זה אתה שאתה נמצאת בו פשוט מפורק לקוד באיזשהי שפת יכנות."
    },
    {
      "start": 4716.0,
      "end": 4719.0,
      "text": "לא ניכנס לזה, כי זה ממש ממש ממש לא קשור."
    },
    {
      "start": 4719.0,
      "end": 4721.0,
      "text": "איך תלך לזה, בני."
    },
    {
      "start": 4721.0,
      "end": 4722.0,
      "text": "מה מה?"
    },
    {
      "start": 4722.0,
      "end": 4725.0,
      "text": "כן, אפשר לשמות שם, אני חושב שזה נראה בזה."
    },
    {
      "start": 4725.0,
      "end": 4727.0,
      "text": "נכון. אפשר לשמות שם את הקוד?"
    },
    {
      "start": 4727.0,
      "end": 4729.0,
      "text": "לא ניכנס לזה, כי זה באמת רחוק שנות אורוןיה."
    },
    {
      "start": 4729.0,
      "end": 4731.0,
      "text": "אבל למשל שאתה משנה זה עושה,"
    },
    {
      "start": 4731.0,
      "end": 4735.0,
      "text": "אם אתה כאילו הסוגרת החלון,"
    },
    {
      "start": 4735.0,
      "end": 4739.0,
      "text": "זה לא משהו וחלת השלום שיש לי זה."
    },
    {
      "start": 4740.0,
      "end": 4741.0,
      "text": "אני אמה, אני אמה."
    },
    {
      "start": 4741.0,
      "end": 4742.0,
      "text": "נכון."
    },
    {
      "start": 4744.0,
      "end": 4745.0,
      "text": "אוקיי."
    },
    {
      "start": 4745.0,
      "end": 4747.0,
      "text": "אז המסקנה שרציתי להביא אותכם,"
    },
    {
      "start": 4747.0,
      "end": 4749.0,
      "text": "ולקחנו עוד שם ועשרים,"
    },
    {
      "start": 4749.0,
      "end": 4751.0,
      "text": "אבל אני כל כך חושב שזה שווה את זה,"
    },
    {
      "start": 4751.0,
      "end": 4753.0,
      "text": "ובאינו על זה עכשיו שעה ועשרים,"
    },
    {
      "start": 4753.0,
      "end": 4755.0,
      "text": "ואני שמח שגשתם לי ואני שווה אתי בקשר,"
    },
    {
      "start": 4755.0,
      "end": 4759.0,
      "text": "כי שהכל, כל תוכנה שכתובה,"
    },
    {
      "start": 4759.0,
      "end": 4762.0,
      "text": "הכל, הופך נוסוף להפסים ואחדים."
    },
    {
      "start": 4762.0,
      "end": 4765.0,
      "text": "ואם הכל הופך להפסים ואחדים,"
    },
    {
      "start": 4765.0,
      "end": 4767.0,
      "text": "או אם אני אקפוץ קצת לפני זה,"
    },
    {
      "start": 4767.0,
      "end": 4769.0,
      "text": "אז אני אגיד שאני אגלל לכם גם בסוד"
    },
    {
      "start": 4769.0,
      "end": 4771.0,
      "text": "שאף אחד לא באמת כולתם להפסים ואחדים,"
    },
    {
      "start": 4771.0,
      "end": 4773.0,
      "text": "אלא כולי מדרך כלל,"
    },
    {
      "start": 4773.0,
      "end": 4775.0,
      "text": "כשמנסים לפריק משהו לרמה הכי בסיסית,"
    },
    {
      "start": 4775.0,
      "end": 4777.0,
      "text": "ופרקים אותו להסמלי,"
    },
    {
      "start": 4777.0,
      "end": 4779.0,
      "text": "ספת התכנות הזאת, שהיא נורא פשוטה,"
    },
    {
      "start": 4779.0,
      "end": 4781.0,
      "text": "כל כך פשוטה, שזה ממש כמו מילון,"
    },
    {
      "start": 4781.0,
      "end": 4783.0,
      "text": "יש לנו פודה, ויש לנו מספר,"
    },
    {
      "start": 4783.0,
      "end": 4785.0,
      "text": "פודה, מספר."
    },
    {
      "start": 4785.0,
      "end": 4789.0,
      "text": "אז בגדול, הכל מתפרק בסוף להסמלי,"
    },
    {
      "start": 4789.0,
      "end": 4793.0,
      "text": "ואם אתם יודעים לקרוא הסמלי,"
    },
    {
      "start": 4793.0,
      "end": 4797.0,
      "text": "ברגע שאתם מצליחים להבין מה הכל שכתוב,"
    },
    {
      "start": 4797.0,
      "end": 4800.0,
      "text": "כל תוכנה שנכתמה בעולם,"
    },
    {
      "start": 4800.0,
      "end": 4802.0,
      "text": "לא יכולה להתחבר מכם,"
    },
    {
      "start": 4802.0,
      "end": 4804.0,
      "text": "היא לא יכולה, אתם לא..."
    },
    {
      "start": 4804.0,
      "end": 4806.0,
      "text": "יש לכם את הקובץ של התוכנה,"
    },
    {
      "start": 4806.0,
      "end": 4808.0,
      "text": "את הקובץ הרצה, שזה הקובץ שלכם על הרוחשם,"
    },
    {
      "start": 4808.0,
      "end": 4811.0,
      "text": "אי אפשר להסתיר מכם מה כתוב בתוכון,"
    },
    {
      "start": 4811.0,
      "end": 4813.0,
      "text": "אם אתם מבינים הסמלי."
    },
    {
      "start": 4814.0,
      "end": 4816.0,
      "text": "ובעצם הסמלי זה..."
    },
    {
      "start": 4816.0,
      "end": 4818.0,
      "text": "אני לא מבין בין טיימו..."
    },
    {
      "start": 4818.0,
      "end": 4820.0,
      "text": "מה?"
    },
    {
      "start": 4821.0,
      "end": 4823.0,
      "text": "בין טיימו אני לא מבין."
    },
    {
      "start": 4823.0,
      "end": 4825.0,
      "text": "אוקיי, זה בסדר, אנחנו לעת להפמלמד,"
    },
    {
      "start": 4825.0,
      "end": 4827.0,
      "text": "מופתיח לכם."
    },
    {
      "start": 4827.0,
      "end": 4830.0,
      "text": "אני כן אגיד שאנחנו לא נלמד פה מה שנקרא הסמלי פיתוחי,"
    },
    {
      "start": 4830.0,
      "end": 4832.0,
      "text": "אנחנו לא נלמד פה לבנות תוכניות והסמלי,"
    },
    {
      "start": 4832.0,
      "end": 4834.0,
      "text": "לא נלמד לכתוב משחקים, עוד מרים כאלה,"
    },
    {
      "start": 4834.0,
      "end": 4836.0,
      "text": "אנחנו נורא טראקטים."
    },
    {
      "start": 4836.0,
      "end": 4839.0,
      "text": "אנחנו הולכים ללמוד איך לכתוב תוכנות שסורדו את התאחרות."
    },
    {
      "start": 4839.0,
      "end": 4840.0,
      "text": "איך?"
    },
    {
      "start": 4840.0,
      "end": 4842.0,
      "text": "עכשיו, רגע לפני זה,"
    },
    {
      "start": 4842.0,
      "end": 4843.0,
      "text": "בואו נביא מה זאת."
    },
    {
      "start": 4843.0,
      "end": 4846.0,
      "text": "אז אני מבחין לצחור את כל ההפסים באיחדים..."
    },
    {
      "start": 4846.0,
      "end": 4847.0,
      "text": "לא,"
    },
    {
      "start": 4847.0,
      "end": 4848.0,
      "text": "באסיס 16."
    },
    {
      "start": 4848.0,
      "end": 4853.0,
      "text": "ונכתוב גם את הסורדים לתוכנה עצמה של הקודרור."
    },
    {
      "start": 4853.0,
      "end": 4855.0,
      "text": "אז אתם תכתבו את הסורדים באסמלי,"
    },
    {
      "start": 4855.0,
      "end": 4857.0,
      "text": "ולא באסיסים באיחדים,"
    },
    {
      "start": 4857.0,
      "end": 4859.0,
      "text": "אבל תהיה לכם המון התעסקות עם הערכים"
    },
    {
      "start": 4859.0,
      "end": 4861.0,
      "text": "שתקובעים בבסיס של אסמלי."
    },
    {
      "start": 4861.0,
      "end": 4865.0,
      "text": "ממוב והג'מפ והסטוו-ווי ובכל השאר?"
    },
    {
      "start": 4865.0,
      "end": 4866.0,
      "text": "נכון."
    },
    {
      "start": 4866.0,
      "end": 4868.0,
      "text": "כל הדברים האלה של רגע נגע בעג."
    },
    {
      "start": 4868.0,
      "end": 4869.0,
      "text": "אוקיי."
    },
    {
      "start": 4869.0,
      "end": 4870.0,
      "text": "אז..."
    },
    {
      "start": 4870.0,
      "end": 4873.0,
      "text": "רגע אני רוצה להורות לכם,"
    },
    {
      "start": 4873.0,
      "end": 4874.0,
      "text": "הדגמה קצרה,"
    },
    {
      "start": 4874.0,
      "end": 4876.0,
      "text": "למה זה בכלל קודרור?"
    },
    {
      "start": 4876.0,
      "end": 4877.0,
      "text": "אוקיי, והחצה קשר לקראש דיבר,"
    },
    {
      "start": 4877.0,
      "end": 4878.0,
      "text": "לא, לא, לא, לא, לא, עכשיו."
    },
    {
      "start": 4878.0,
      "end": 4879.0,
      "text": "יש."
    },
    {
      "start": 4879.0,
      "end": 4881.0,
      "text": "ואני מזכיר לכם,"
    },
    {
      "start": 4881.0,
      "end": 4882.0,
      "text": "לצורך,"
    },
    {
      "start": 4882.0,
      "end": 4885.0,
      "text": "לצורך זה שאתם תזכרו"
    },
    {
      "start": 4885.0,
      "end": 4887.0,
      "text": "על מה אנחנו מדברים פה,"
    },
    {
      "start": 4888.0,
      "end": 4890.0,
      "text": "כל פעם שאתם רואים בסיס 16,"
    },
    {
      "start": 4890.0,
      "end": 4894.0,
      "text": "בכל פעם שאתם תראו בסיס 16,"
    },
    {
      "start": 4894.0,
      "end": 4895.0,
      "text": "בהתעסקות שלכם פה,"
    },
    {
      "start": 4895.0,
      "end": 4896.0,
      "text": "בכל גורו,"
    },
    {
      "start": 4896.0,
      "end": 4897.0,
      "text": "תזכרו שבסוף,"
    },
    {
      "start": 4897.0,
      "end": 4898.0,
      "text": "בסוף, בסוף, בסוף,"
    },
    {
      "start": 4898.0,
      "end": 4899.0,
      "text": "זה מנורות,"
    },
    {
