{
  "source": "1waEAQoBa8FlzUAddBbTOlS9qKsEu_QzK.mp4",
  "source_sha256": "678e967fc52976dd00f694e3b86558b4abf50edc1db4682e669517c3157ba31a",
  "model": "small",
  "language": "he",
  "language_probability": 1,
  "start": 0.0,
  "end": 900.0,
  "elapsed_seconds": 594.8409013748169,
  "segments": [
    {
      "start": 0.0,
      "end": 4.0,
      "text": "בכיר בכל התחום של..."
    },
    {
      "start": 5.24,
      "end": 9.6,
      "text": "בבשמח, בצבא, כרגע פעיל,"
    },
    {
      "start": 9.64,
      "end": 14.32,
      "text": "ויהבים לכם את הראשונה, הכשרה מ-0."
    },
    {
      "start": 15.08,
      "end": 16.88,
      "text": "שודה? יאללה, גאו."
    },
    {
      "start": 17.32,
      "end": 18.32,
      "text": "טוב."
    },
    {
      "start": 20.32,
      "end": 23.96,
      "text": "אז בגדול, אנחנו פה ממש, ממש הולכים מ-0,"
    },
    {
      "start": 24.28,
      "end": 27.36,
      "text": "אז אני אעשה קצת שחזור שם בגלל שקודם שהיה לנו."
    },
    {
      "start": 27.759999999999998,
      "end": 30.8,
      "text": "נתקדם לפי המהירות שלכם, כמה שכם,"
    },
    {
      "start": 30.84,
      "end": 34.08,
      "text": "צריכים לקלוט, אחרי חשוב שאתה צריכו להבין הכי טוב."
    },
    {
      "start": 36.16,
      "end": 38.16,
      "text": "נתחיל רגע עם איזה שאלה."
    },
    {
      "start": 40.6,
      "end": 42.12,
      "text": "עשה שם, רגע."
    },
    {
      "start": 43.84,
      "end": 44.84,
      "text": "אופה."
    },
    {
      "start": 45.56,
      "end": 46.56,
      "text": "אוקיי."
    },
    {
      "start": 47.120000000000005,
      "end": 49.0,
      "text": "כולם צריכים לראות את המסך שלי?"
    },
    {
      "start": 49.44,
      "end": 50.44,
      "text": "כן."
    },
    {
      "start": 50.480000000000004,
      "end": 51.480000000000004,
      "text": "בבקשה? כן."
    },
    {
      "start": 52.480000000000004,
      "end": 53.480000000000004,
      "text": "אוקיי."
    },
    {
      "start": 53.480000000000004,
      "end": 58.00000000000001,
      "text": "אז רגע כמה דברים קצרים לפני שאתה תחיל."
    },
    {
      "start": 58.040000000000006,
      "end": 62.440000000000005,
      "text": "אתם אומנם לא המון, המון, שזה מעולה,"
    },
    {
      "start": 62.480000000000004,
      "end": 65.96000000000001,
      "text": "כי זה אומר שמצליח לעשות זה קצת יותר ראשי ואחד על אחד,"
    },
    {
      "start": 66.0,
      "end": 68.04,
      "text": "אבל אתם עדיין הרבה יותר ממני, ולכן,"
    },
    {
      "start": 68.24000000000001,
      "end": 70.80000000000001,
      "text": "אם יש לכם שאלות, אני אשלתי על הכל,"
    },
    {
      "start": 70.84,
      "end": 73.80000000000001,
      "text": "פעם כלום נשלתי פה עד עשר וחצי בלילה כדי להנותר שאלות,"
    },
    {
      "start": 73.84,
      "end": 75.64,
      "text": "אני מוכן לי שאלה רבה מהוור לזה,"
    },
    {
      "start": 76.08000000000001,
      "end": 77.92,
      "text": "אבל אם יש לכם שאלות, זה יצרק נתבעצמה,"
    },
    {
      "start": 77.96000000000001,
      "end": 79.84,
      "text": "כדי שאני לא אף אספסת אחת מהן, כזה,"
    },
    {
      "start": 79.88000000000001,
      "end": 81.28,
      "text": "וזה ייבלה בין האנשים."
    },
    {
      "start": 81.64,
      "end": 84.4,
      "text": "וגם תשתפוע הרבה, כי זה כיף."
    },
    {
      "start": 85.12,
      "end": 88.08,
      "text": "טוב, אז השאלה הראשונה שבכם היא כזאת."
    },
    {
      "start": 89.28,
      "end": 92.68,
      "text": "אם הייתם רוצים, שמישהו יבל לכם תפוח,"
    },
    {
      "start": 92.72,
      "end": 94.28,
      "text": "איך הייתם מבקשים ממנו?"
    },
    {
      "start": 97.08,
      "end": 98.96000000000001,
      "text": "איזה אפשר מבקשה תפוח?"
    },
    {
      "start": 99.68,
      "end": 102.48,
      "text": "מגניב, נשמע די נכון."
    },
    {
      "start": 102.92,
      "end": 103.92,
      "text": "אז..."
    },
    {
      "start": 106.0,
      "end": 107.0,
      "text": "נמנה."
    },
    {
      "start": 107.84,
      "end": 108.84,
      "text": "מה משהו?"
    },
    {
      "start": 109.68,
      "end": 111.08,
      "text": "לא לצחת משמע?"
    },
    {
      "start": 114.76,
      "end": 116.08,
      "text": "שקט פתאום, בגלל."
    },
    {
      "start": 118.80000000000001,
      "end": 119.96000000000001,
      "text": "אתה צריכים לשמוע אותי?"
    },
    {
      "start": 120.52000000000001,
      "end": 122.24000000000001,
      "text": "כן, כן, כן."
    },
    {
      "start": 122.28,
      "end": 125.72,
      "text": "אז כמו שאמרו פה, מכלנו, לדעתי לוקה במדעת זה,"
    },
    {
      "start": 126.44,
      "end": 128.92000000000002,
      "text": "אם בני אדם, אם מדובר בבני אדם,"
    },
    {
      "start": 128.96,
      "end": 131.44,
      "text": "כשאני פשוט תשאל, שאלו בבקשה תפוח."
    },
    {
      "start": 132.8,
      "end": 136.28,
      "text": "אתה יכול להביא לי תפוח, וכן הלאה וכן הלאה וכן הלאה."
    },
    {
      "start": 136.28,
      "end": 137.28,
      "text": "וכן הלאה."
    },
    {
      "start": 139.08,
      "end": 142.12,
      "text": "לעמד, כי בני אדם מבינים, יבורית או שפה, כן,"
    },
    {
      "start": 142.16,
      "end": 145.48,
      "text": "זה לא חייב להיות ביבורית, אבל זה יהיה בספה רגילה לך, וכן."
    },
    {
      "start": 149.24,
      "end": 151.08,
      "text": "איך הייתם מבקשים ממך שב?"
    },
    {
      "start": 151.12,
      "end": 153.24,
      "text": "שאלה, לכם תפוח, בהרמת יד."
    },
    {
      "start": 153.28,
      "end": 157.84,
      "text": "יכול להיות משלמש בה, ריאקט המגניב הזה של הריזהנד,"
    },
    {
      "start": 157.88,
      "end": 160.2,
      "text": "ואז זה גם מגניב, כן, כזה."
    },
    {
      "start": 162.72,
      "end": 164.48,
      "text": "הפסים ובהחדים."
    },
    {
      "start": 164.48,
      "end": 166.48,
      "text": "יש פה על כל שפשוט שאומרות,"
    },
    {
      "start": 166.51999999999998,
      "end": 170.84,
      "text": "תביא לי במקשה את התפוח, בערבה איפה שבאחת."
    },
    {
      "start": 171.84,
      "end": 174.51999999999998,
      "text": "לא הייתי יכול להגיד את זה יותר טוב בעשמי. זה נכון."
    },
    {
      "start": 174.56,
      "end": 175.83999999999997,
      "text": "אבולה, זה יכול להיות..."
    },
    {
      "start": 175.88,
      "end": 179.35999999999999,
      "text": "אני לדעתי, תפוח לא יכול להביא לי כלום,"
    },
    {
      "start": 179.39999999999998,
      "end": 180.48,
      "text": "כי..."
    },
    {
      "start": 181.56,
      "end": 184.95999999999998,
      "text": "אני חושב לא יכול להביא לי תפוח, כי הוא מקשם."
    },
    {
      "start": 186.67999999999998,
      "end": 188.28,
      "text": "על זה כבר אפשר להתפקח."
    },
    {
      "start": 188.88,
      "end": 190.16,
      "text": "אני לא יודע מה זה עמר."
    },
    {
      "start": 190.2,
      "end": 192.51999999999998,
      "text": "אני מקשם, הוא לא יכול לעצמי את תפוח."
    },
    {
      "start": 192.56,
      "end": 193.95999999999998,
      "text": "כן. להצליח תפוח על תפוח."
    },
    {
      "start": 193.96,
      "end": 195.84,
      "text": "אני יכול לציין לך אותה."
    },
    {
      "start": 196.24,
      "end": 200.4,
      "text": "אבל כן, זה יהיה רצף נורא מוזר של הפסים וחדים,"
    },
    {
      "start": 200.44,
      "end": 202.32,
      "text": "שיהיה לנו מאוד מאוד קשה להרדים."
    },
    {
      "start": 203.60000000000002,
      "end": 206.0,
      "text": "החלק הראשון, הצהר הראשון שלנו,"
    },
    {
      "start": 207.56,
      "end": 212.12,
      "text": "כדי להצליח בכל מה שנגיע בתחרות הזאת,"
    },
    {
      "start": 212.16,
      "end": 216.20000000000002,
      "text": "הוא להבין מה זה הפסים והאחדים האלה,"
    },
    {
      "start": 216.24,
      "end": 219.96,
      "text": "למה משתמשים בהם, כאילו, מה משמעות של כל זה,"
    },
    {
      "start": 219.96,
      "end": 224.8,
      "text": "מהר מאוד ובמהר מאוד אני מתקווה לרבע שעה 20 דקות,"
    },
    {
      "start": 224.84,
      "end": 228.52,
      "text": "אתם תצליחו להבין למה זה נקרא הפסים ואחדים,"
    },
    {
      "start": 228.56,
      "end": 231.24,
      "text": "מה הם משמלים, אם מישהו פה יודע, בלי ספיירים."
    },
    {
      "start": 233.08,
      "end": 236.04000000000002,
      "text": "ותצליחו להבין איך בגדול,"
    },
    {
      "start": 236.08,
      "end": 238.72,
      "text": "כל דבר שמכירים על כל מחשיר טכנולוגי,"
    },
    {
      "start": 238.76000000000002,
      "end": 241.4,
      "text": "הוא בסוף הפסים ואחדים, וזה לא כזה נורא."
    },
    {
      "start": 241.76000000000002,
      "end": 244.72,
      "text": "ועל שתסיימו את התחרות הזאת,"
    },
    {
      "start": 244.76000000000002,
      "end": 246.32,
      "text": "שזה עוד חודשיים ומשהו,"
    },
    {
      "start": 246.36,
      "end": 248.92000000000002,
      "text": "אז אתם גם יהיה בחיים איזשהו חלק,"
    },
    {
      "start": 248.92000000000002,
      "end": 252.48000000000002,
      "text": "שגם יביא את הפסים והאחדים האלה בצורה שהיא לא שותפת,"
    },
    {
      "start": 252.52,
      "end": 253.4,
      "text": "אבל די טובה."
    },
    {
      "start": 254.08,
      "end": 256.92,
      "text": "סבבו, אז בואו להבין מה זה הפסים והאחדים האלה."
    },
    {
      "start": 257.24,
      "end": 260.92,
      "text": "מישהו בערמת יד יודע איך מחשבים להחסנים מהידע?"
    },
    {
      "start": 261.64000000000004,
      "end": 263.04,
      "text": "כן, במשתנים."
    },
    {
      "start": 263.92,
      "end": 266.24,
      "text": "אוקיי, מעניין, מה זה משתנים?"
    },
    {
      "start": 267.24,
      "end": 271.04,
      "text": "זה מין תי לבל, שאתה קורא לו בשם כלשהו,"
    },
    {
      "start": 271.08000000000004,
      "end": 276.92,
      "text": "ואתה יכול לשמור באו מהידע, או משתפה, או מילה,"
    },
    {
      "start": 276.96000000000004,
      "end": 277.92,
      "text": "כל משתפה."
    },
    {
      "start": 278.40000000000003,
      "end": 279.12,
      "text": "מה השם?"
    },
    {
      "start": 279.72,
      "end": 280.52000000000004,
      "text": "אלן."
    },
    {
      "start": 280.72,
      "end": 285.92,
      "text": "אלן. אז אלן מדברתי לנו על משתנים, אוקיי?"
    },
    {
      "start": 286.8,
      "end": 288.72,
      "text": "אנחנו לא רואים את המשך שלך."
    },
    {
      "start": 289.32,
      "end": 291.32,
      "text": "לא רואים אותם בכלל? לא רואים אותם בכלל?"
    },
    {
      "start": 292.96000000000004,
      "end": 293.8,
      "text": "אני רואה."
    },
    {
      "start": 294.76,
      "end": 295.64,
      "text": "אני גם."
    },
    {
      "start": 296.88,
      "end": 298.76,
      "text": "אני אנסה רגע..."
    },
    {
      "start": 299.68,
      "end": 302.28000000000003,
      "text": "אני רואה מסך של מישהו."
    },
    {
      "start": 304.68,
      "end": 306.44,
      "text": "שני, נעשה ככה."
    },
    {
      "start": 308.92,
      "end": 309.92,
      "text": "אוקיי."
    },
    {
      "start": 309.96000000000004,
      "end": 311.2,
      "text": "אלן, השם אני רואה."
    },
    {
      "start": 311.24,
      "end": 312.24,
      "text": "נגולה."
    },
    {
      "start": 313.8,
      "end": 317.8,
      "text": "אז כשאנחנו רואים על משתנים, מדובר בגדול, על..."
    },
    {
      "start": 319.04,
      "end": 320.48,
      "text": "אזור ומחשב..."
    },
    {
      "start": 320.52000000000004,
      "end": 323.32,
      "text": "וואו, זה ממש חתום בזר. בסדר, טוב, זה ככה."
    },
    {
      "start": 323.84000000000003,
      "end": 328.20000000000005,
      "text": "משתנים, אזור ומחשב, שמעכסן מהידע."
    },
    {
      "start": 330.12,
      "end": 332.76,
      "text": "אז משתנה זה, זה בעצם..."
    },
    {
      "start": 333.08000000000004,
      "end": 335.64,
      "text": "יש מקום במחשב, אני יודע מה זה המקום הזה,"
    },
    {
      "start": 335.68,
      "end": 337.6,
      "text": "שאלר הם מתקדים, דרך אגב."
    },
    {
      "start": 338.88,
      "end": 341.36,
      "text": "איך אני זוכר איפה שמתי כל אחד מהמשתנים?"
    },
    {
      "start": 343.76,
      "end": 345.92,
      "text": "את הזוכרו גם בשמות שלהם."
    },
    {
      "start": 346.68,
      "end": 348.08000000000004,
      "text": "אוקיי, מגניב, פרול."
    },
    {
      "start": 348.12,
      "end": 349.92,
      "text": "אולי פרושת מהנפסי של התסמת שלו."
    },
    {
      "start": 350.76,
      "end": 353.52000000000004,
      "text": "נכון, אז יש לי את השמות של המשתרים,"
    },
    {
      "start": 353.56,
      "end": 355.96000000000004,
      "text": "והם עוזרים לי בקוד לזכור"
    },
    {
      "start": 356.0,
      "end": 357.8,
      "text": "לאיזו משתנה אני צריך לפנות כל פעם,"
    },
    {
      "start": 357.84000000000003,
      "end": 359.6,
      "text": "אבל מה זה אומר פרקטית?"
    },
    {
      "start": 359.64,
      "end": 361.44,
      "text": "כאילו, איך באמת באמת באמת,"
    },
    {
      "start": 361.48,
      "end": 364.28000000000003,
      "text": "המחשב זוכר איפה שמתי את המספר שלוש?"
    },
    {
      "start": 364.32,
      "end": 365.76,
      "text": "כששמתי אותו בתוך משתנה X,"
    },
    {
      "start": 365.8,
      "end": 367.76,
      "text": "איך הוא באמת ידע איפה זה המספר שלוש?"
    },
    {
      "start": 367.76,
      "end": 369.32,
      "text": "בתוך המחשב."
    },
    {
      "start": 369.36,
      "end": 373.4,
      "text": "למספר שלא שיש מן סדרה רוקע שלפסים ואחת,"
    },
    {
      "start": 373.44,
      "end": 379.15999999999997,
      "text": "שמסקרת בתוך המחשב ברגע שאתה מנסה להעביר לשם משהו"
    },
    {
      "start": 379.2,
      "end": 381.15999999999997,
      "text": "או להוציא משהו משהו."
    },
    {
      "start": 381.68,
      "end": 382.68,
      "text": "מגניב."
    },
    {
      "start": 383.2,
      "end": 385.88,
      "text": "אנחנו מתקדמים לשם, זה נכון."
    },
    {
      "start": 386.48,
      "end": 390.24,
      "text": "יש כל הזיכרון של המחשב, כן."
    },
    {
      "start": 392.48,
      "end": 397.2,
      "text": "זיכרון מהאזור המחשב שבו מאוכסן מידע,"
    },
    {
      "start": 398.64,
      "end": 400.36,
      "text": "אם מצלנו במוח,"
    },
    {
      "start": 400.4,
      "end": 402.88,
      "text": "המוח הוא קצת עבר אחד שעושה את כל הדברים האלה,"
    },
    {
      "start": 402.92,
      "end": 405.44,
      "text": "במחשב ממש יש חלוקה לזיכרון,"
    },
    {
      "start": 405.48,
      "end": 407.36,
      "text": "ולחלק שעושה דברים, כן?"
    },
    {
      "start": 407.4,
      "end": 408.71999999999997,
      "text": "במוח יש לנו את מה ש..."
    },
    {
      "start": 408.76,
      "end": 410.44,
      "text": "חושב מחשבות עושה חישובים,"
    },
    {
      "start": 410.48,
      "end": 413.48,
      "text": "שואלים אותנו כמה זה 2 ו2, ואנחנו יודעים לענות שזה 4,"
    },
    {
      "start": 414.4,
      "end": 416.2,
      "text": "במחשב זה טיפה מחולק."
    },
    {
      "start": 416.24,
      "end": 417.36,
      "text": "יש לנו את הזיכרון,"
    },
    {
      "start": 417.4,
      "end": 418.76,
      "text": "יש שני חלקים שירה זיכרון,"
    },
    {
      "start": 418.8,
      "end": 420.76,
      "text": "אבל אנחנו לא נגע בזה עכשיו כל כך."
    },
    {
      "start": 423.24,
      "end": 425.28,
      "text": "ושם, כמו שאלה נוממת,"
    },
    {
      "start": 425.28000000000003,
      "end": 427.40000000000003,
      "text": "יש לנו סדרה עורכה של הפסים ואחדים."
    },
    {
      "start": 428.08000000000004,
      "end": 431.04,
      "text": "איך במציאות נראים מהפסים ואחדים האלה,"
    },
    {
      "start": 431.08000000000004,
      "end": 432.64000000000004,
      "text": "אני אשמח לשמוע ממישהו שעדיין גלשתת,"
    },
    {
      "start": 432.68,
      "end": 435.04,
      "text": "אפתי, אני רואה שיש פה לא נעת המשים."
    },
    {
      "start": 440.88000000000005,
      "end": 441.52000000000004,
      "text": "איך בב..."
    },
    {
      "start": 441.56000000000006,
      "end": 443.44000000000005,
      "text": "1, 0, 0, 0, 0, 0."
    },
    {
      "start": 443.92,
      "end": 444.92,
      "text": "מה, מעוד פעם?"
    },
    {
      "start": 446.16,
      "end": 447.76000000000005,
      "text": "אחד ואז מלא הפסים."
    },
    {
      "start": 447.8,
      "end": 449.6,
      "text": "קטניב, אבל מה זה אומר..."
    },
    {
      "start": 449.64000000000004,
      "end": 451.72,
      "text": "אתה אומר לי, אתם כולכם אומרים לי,"
    },
    {
      "start": 451.76000000000005,
      "end": 453.20000000000005,
      "text": "יש שם הפסים ואחדים."
    },
    {
      "start": 453.24,
      "end": 455.0,
      "text": "איך במציאות פיזית?"
    },
    {
      "start": 455.0,
      "end": 456.44,
      "text": "מה זה הפסים ואחדים האלה?"
    },
    {
      "start": 456.48,
      "end": 458.0,
      "text": "מה זה 0, מה זה..."
    },
    {
      "start": 459.16,
      "end": 460.0,
      "text": "זה השפה..."
    },
    {
      "start": 460.04,
      "end": 461.44,
      "text": "אחד זה כאילו קיבוי,"
    },
    {
      "start": 461.8,
      "end": 465.76,
      "text": "ואיך... לא, אפס זה קיבוי, ואחד זה דלוק."
    },
    {
      "start": 466.04,
      "end": 467.4,
      "text": "מה זה קיבוי, מה זה דלוק?"
    },
    {
      "start": 467.8,
      "end": 469.12,
      "text": "שקיבוי של מעד, לא..."
    },
    {
      "start": 469.16,
      "end": 471.12,
      "text": "יש לך מנורות,"
    },
    {
      "start": 471.96,
      "end": 475.56,
      "text": "אם אנחנו מדברים עכשיו על שפה ב-16,"
    },
    {
      "start": 475.72,
      "end": 479.4,
      "text": "אז יש לך נורות של 0, 1, 2, 3,"
    },
    {
      "start": 479.44,
      "end": 481.72,
      "text": "משהו ב-7, 8, 9,"
    },
    {
      "start": 481.84,
      "end": 483.8,
      "text": "ואז ABCDEF,"
    },
    {
      "start": 483.96000000000004,
      "end": 485.96000000000004,
      "text": "אז אתה יכול לשום את זה גם ביותר קל"
    },
    {
      "start": 486.0,
      "end": 488.56,
      "text": "באותיות באנגלית מ-A-DF,"
    },
    {
      "start": 489.08,
      "end": 491.72,
      "text": "ואז להשתמש במספרים,"
    },
    {
      "start": 493.12,
      "end": 494.12,
      "text": "ו..."
    },
    {
      "start": 495.8,
      "end": 500.04,
      "text": "או לרשום את זה ב-248, 16,"
    },
    {
      "start": 500.52,
      "end": 501.52,
      "text": "נכון."
    },
    {
      "start": 502.0,
      "end": 504.04,
      "text": "אני לא יודע איך זלגנו לבסיס הספירה,"
    },
    {
      "start": 504.08000000000004,
      "end": 505.32,
      "text": "אבל זה גם נכון,"
    },
    {
      "start": 505.40000000000003,
      "end": 508.24,
      "text": "ואמרת בדיוק את מה שקיבדתי עליו."
    },
    {
      "start": 509.52,
      "end": 511.52,
      "text": "בתוך המחשב, יש מנורות,"
    },
    {
      "start": 514.68,
      "end": 515.68,
      "text": "כן."
    },
    {
      "start": 515.7199999999999,
      "end": 518.3599999999999,
      "text": "יש המון המון המון המוןוג tickets."
    },
    {
      "start": 520.0,
      "end": 521.5999999999999,
      "text": "בכל 다음 יש אור,"
    },
    {
      "start": 522.4399999999999,
      "end": 524.0,
      "text": "וחלקם אין אור."
    },
    {
      "start": 525.4399999999999,
      "end": 526.4399999999999,
      "text": "כן,"
    },
    {
      "start": 526.4799999999999,
      "end": 527.76,
      "text": "במנורות שאין בהם אור,"
    },
    {
      "start": 527.8,
      "end": 529.7199999999999,
      "text": "אנחנו נוהגים לקרוא להם"
    },
    {
      "start": 529.76,
      "end": 531.28,
      "text": "מנורות קוויות,"
    },
    {
      "start": 531.3199999999999,
      "end": 533.42,
      "text": "מנורות שמייצגות 0,"
    },
    {
      "start": 533.4399999999999,
      "end": 534.2199999999999,
      "text": "ובמנורות הדתותות,"
    },
    {
      "start": 534.24,
      "end": 535.68,
      "text": "במינורות שיש בהם אור,"
    },
    {
      "start": 535.7199999999999,
      "end": 537.26,
      "text": "אנחנו נוהגים לקרוא להם"
    },
    {
      "start": 537.28,
      "end": 539.9799999999999,
      "text": "אחד בסוף,"
    },
    {
      "start": 540.0999999999999,
      "end": 541.3,
      "text": "הזיכרון,"
    },
    {
      "start": 541.3399999999999,
      "end": 543.1999999999999,
      "text": "או לפחות חלק נכבד ממנו,"
    },
    {
      "start": 543.2,
      "end": 545.2,
      "text": "שקרה גם הלם,"
    },
    {
      "start": 546.2,
      "end": 548.2,
      "text": "random axis memory,"
    },
    {
      "start": 548.2,
      "end": 549.2,
      "text": "random axis memory."
    },
    {
      "start": 549.2,
      "end": 553.2,
      "text": "יש לנו פה אנשים שיודעים רשת עברות וזה מפחיד אותי."
    },
    {
      "start": 558.2,
      "end": 559.2,
      "text": "אוקיי, סבבה."
    },
    {
      "start": 559.2,
      "end": 563.2,
      "text": "בתוך הלם, הלם ספציפי מורכב מהמון המון המון המון המון,"
    },
    {
      "start": 563.2,
      "end": 566.2,
      "text": "מנוראות קטנות לאן שיעור, קטנתנות, אוקיי?"
    },
    {
      "start": 566.2,
      "end": 567.2,
      "text": "אבל מנוראות."
    },
    {
      "start": 567.2,
      "end": 570.2,
      "text": "וכשמנוראות גוקה זה אחד, וכשמנוראה קבוי הזה אפס,"
    },
    {
      "start": 570.2,
      "end": 572.2,
      "text": "וככה עכשיו יודע מידה."
    },
    {
      "start": 572.2,
      "end": 573.2,
      "text": "עכשיו,"
    },
    {
      "start": 574.2,
      "end": 578.2,
      "text": "זה חלק אחד קטנתן שהיא גאה רער, אנחנו עדיין לא יודעים איך המחשב יודע לה, ולהתאפוח,"
    },
    {
      "start": 578.2,
      "end": 582.2,
      "text": "אבל אנחנו כן יודעים איך המחשב יודע להכסן מידה, שזה השלב הראשון."
    },
    {
      "start": 583.2,
      "end": 584.2,
      "text": "עד פה,"
    },
    {
      "start": 585.2,
      "end": 586.2,
      "text": "כן, אמר."
    },
    {
      "start": 587.2,
      "end": 592.2,
      "text": "אני וחברה שבשתי סוף מן הנה נומסג מה התאחרות הזאת בכלל תיכולה את הסביר,"
    },
    {
      "start": 592.2,
      "end": 593.2,
      "text": "כאילו על התאחרות."
    },
    {
      "start": 593.2,
      "end": 594.2,
      "text": "איתך, ביתך, פהו."
    },
    {
      "start": 595.2,
      "end": 597.2,
      "text": "המטרה של התאחרות הזאת היא בגדול,"
    },
    {
      "start": 597.2,
      "end": 599.2,
      "text": "וואי אני אוהב להשתמש במונחים נורא מפוצצים,"
    },
    {
      "start": 599.2,
      "end": 603.2,
      "text": "בגדול, ללמוד איפה איך לך תוכניות או וירוסים,"
    },
    {
      "start": 603.2,
      "end": 605.2,
      "text": "או אפשר לקרוא לזה איך שאתם רוצים,"
    },
    {
      "start": 605.2,
      "end": 607.2,
      "text": "כי זה תוכנות שיש לה איזשהי כמון הסדונית,"
    },
    {
      "start": 607.2,
      "end": 609.2,
      "text": "שרצות על הזיכרון של המחשב,"
    },
    {
      "start": 609.2,
      "end": 611.2,
      "text": "רצות על המחשב עצמו."
    },
    {
      "start": 611.2,
      "end": 615.2,
      "text": "התוכניות האלה, התוכנות הקצרות שכל אחד מהם משתתפים כותב,"
    },
    {
      "start": 615.2,
      "end": 618.2,
      "text": "צריכות לישרול הכי הרבה זמן בזיכרון,"
    },
    {
      "start": 618.2,
      "end": 620.2,
      "text": "שזה אומר, לרוץ,"
    },
    {
      "start": 621.2,
      "end": 623.2,
      "text": "ושאף אחד אחר ביחמיד אותם,"
    },
    {
      "start": 623.2,
      "end": 624.2,
      "text": "וכמובן שבמקביל,"
    },
    {
      "start": 624.2,
      "end": 626.2,
      "text": "זה אומר שאתם צריכים לתוכנות,"
    },
    {
      "start": 626.2,
      "end": 629.2,
      "text": "שיודעות להרוס תוכנות של אנשים אחרים."
    },
    {
      "start": 629.2,
      "end": 631.2,
      "text": "אנחנו בגדול לוקחים את כל הקוד,"
    },
    {
      "start": 631.2,
      "end": 634.2,
      "text": "שכל אחד מהם משתתפים כותב,"
    },
    {
      "start": 634.2,
      "end": 636.2,
      "text": "כמובן בחלוקה מסוימת של כאילו,"
    },
    {
      "start": 636.2,
      "end": 639.2,
      "text": "בתים ושמונה פה, שמונה פה, אבל לא משנה."
    },
    {
      "start": 639.2,
      "end": 641.2,
      "text": "לוקחים את התוכניות שכתבתם,"
    },
    {
      "start": 641.2,
      "end": 643.2,
      "text": "את הוירוסים, את הסורדים,"
    },
    {
      "start": 643.2,
      "end": 644.2,
      "text": "תקראו לזה איך שאתם רוצים,"
    },
    {
      "start": 644.2,
      "end": 646.2,
      "text": "מריצים אותם ביחד, באותו זיכרון משותף,"
    },
    {
      "start": 646.2,
      "end": 649.2,
      "text": "זאת אומרת, אנחנו לוקחים איזור במחשב,"
    },
    {
      "start": 649.2,
      "end": 651.2,
      "text": "וסתמים את כולם שהמורים להנכות הסדרוס,"
    },
    {
      "start": 651.2,
      "end": 654.2,
      "text": "היום אותם בבקומות הקראיים במחשב,"
    },
    {
      "start": 656.2,
      "end": 658.2,
      "text": "הוירוס, מהתוכנה,"
    },
    {
      "start": 658.2,
      "end": 660.2,
      "text": "שמצליחה לסרוד אחר בזמן,"
    },
    {
      "start": 660.2,
      "end": 662.2,
      "text": "שמצליחה שגם אחרי דקה,"
    },
    {
      "start": 662.2,
      "end": 665.2,
      "text": "שכל התוכניות רצות,"
    },
    {
      "start": 667.2,
      "end": 669.2,
      "text": "אף אחד לא דרס אותה על העין,"
    },
    {
      "start": 669.2,
      "end": 670.2,
      "text": "אף אחד לא הרג אותה."
    },
    {
      "start": 670.2,
      "end": 671.2,
      "text": "כדי להבין מה זה דרס,"
    },
    {
      "start": 671.2,
      "end": 673.2,
      "text": "מה זה הרג, איך הורגים תוכניות אחרות,"
    },
    {
      "start": 673.2,
      "end": 674.2,
      "text": "וכל הדברים האלה,"
    },
    {
      "start": 674.2,
      "end": 676.2,
      "text": "זה כבר צריך כאילו,"
    },
    {
      "start": 676.2,
      "end": 680.2,
      "text": "להבין קצת יותר את התחרות,"
    },
    {
      "start": 680.2,
      "end": 682.2,
      "text": "ואת זה אנחנו נעשה."
    },
    {
      "start": 682.2,
      "end": 684.2,
      "text": "רגועות, תודה."
    },
    {
      "start": 684.2,
      "end": 685.2,
      "text": "בבקשה."
    },
    {
      "start": 685.2,
      "end": 687.2,
      "text": "רגע לפני שאנחנו מתקדמים"
    },
    {
      "start": 687.2,
      "end": 689.2,
      "text": "מהחלק שבו אנחנו מבינים,"
    },
    {
      "start": 689.2,
      "end": 691.2,
      "text": "למה אנשים מדברים על הפסים ואחדים,"
    },
    {
      "start": 691.2,
      "end": 693.2,
      "text": "כן אמרנו שזה בכלל מנוראות לוקוד וקוויר,"
    },
    {
      "start": 693.2,
      "end": 695.2,
      "text": "זה פשוט יותר נורח."
    },
    {
      "start": 695.2,
      "end": 697.2,
      "text": "רגע לפני שאנחנו מתקדמים"
    },
    {
      "start": 697.2,
      "end": 699.2,
      "text": "משם לחלק שעוזר לנו להבין"
    },
    {
      "start": 699.2,
      "end": 700.2,
      "text": "איך מחשבים עובדים,"
    },
    {
      "start": 700.2,
      "end": 702.2,
      "text": "כאילו איך הם עושים את מה שהם עושים,"
    },
    {
      "start": 702.2,
      "end": 704.2,
      "text": "שאלות,"
    },
    {
      "start": 704.2,
      "end": 706.2,
      "text": "דברים שעדיין לא יצאה אתם להבין."
    },
    {
      "start": 709.2,
      "end": 711.2,
      "text": "שום דבר?"
    },
    {
      "start": 712.2,
      "end": 715.2,
      "text": "בסדר, נעולה."
    },
    {
      "start": 715.2,
      "end": 717.2,
      "text": "רשתם נוראים כאילו."
    },
    {
      "start": 717.2,
      "end": 719.2,
      "text": "נעולה."
    },
    {
      "start": 719.2,
      "end": 721.2,
      "text": "סבבה."
    },
    {
      "start": 721.2,
      "end": 723.2,
      "text": "אז הצלחנו להבין"
    },
    {
      "start": 723.2,
      "end": 725.2,
      "text": "את כל החלק הראשון"
    },
    {
      "start": 725.2,
      "end": 727.2,
      "text": "שיש מספרים, יש הפסים ואחדים"
    },
    {
      "start": 727.2,
      "end": 729.2,
      "text": "על הפסים,"
    },
    {
      "start": 729.2,
      "end": 731.2,
      "text": "אפס זה נורא קבויה, אחד זה נורא לוקה,"
    },
    {
      "start": 731.2,
      "end": 733.2,
      "text": "מלא מלא מנורות קטרות בתוך המחשב,"
    },
    {
      "start": 733.2,
      "end": 735.2,
      "text": "שעוזרנו להכסן מידע."
    },
    {
      "start": 735.2,
      "end": 737.2,
      "text": "מה זה אומר להכסן מידע?"
    },
    {
      "start": 737.2,
      "end": 739.2,
      "text": "בואו רגע נובילי."
    },
    {
      "start": 739.2,
      "end": 741.2,
      "text": "בגדול,"
    },
    {
      "start": 741.2,
      "end": 743.2,
      "text": "כל מידע,"
    },
    {
      "start": 743.2,
      "end": 745.2,
      "text": "באמת הכל, אפשר להביע כמספר."
    },
    {
      "start": 745.2,
      "end": 747.2,
      "text": "אוקיי, נתחיל מזה."
    },
    {
      "start": 747.2,
      "end": 749.2,
      "text": "מה זה אומר?"
    },
    {
      "start": 749.2,
      "end": 751.2,
      "text": "אז לדובמה,"
    },
    {
      "start": 751.2,
      "end": 753.2,
      "text": "אם אני רוצה להביע"
    },
    {
      "start": 753.2,
      "end": 755.2,
      "text": "סבע,"
    },
    {
      "start": 755.2,
      "end": 757.2,
      "text": "אז אני לא יודע אם אתם מכירים,"
    },
    {
      "start": 757.2,
      "end": 759.2,
      "text": "אבל יש מפלט קרא rgb."
    },
    {
      "start": 759.2,
      "end": 761.2,
      "text": "rgb זה בעצם,"
    },
    {
      "start": 761.2,
      "end": 763.2,
      "text": "כמה סבע זה אדום, כן?"
    },
    {
      "start": 763.2,
      "end": 765.2,
      "text": "כמה הוא ירוק?"
    },
    {
      "start": 765.2,
      "end": 767.2,
      "text": "וכמה חולים?"
    },
    {
      "start": 767.2,
      "end": 769.2,
      "text": "כמה זה בעצם,"
    },
    {
      "start": 769.2,
      "end": 771.2,
      "text": "ואני לא שומע,"
    },
    {
      "start": 771.2,
      "end": 773.2,
      "text": "רגע אני אגביר לכם דיבר, כן."
    },
    {
      "start": 773.2,
      "end": 777.2,
      "text": "זה הצבאים שהמחשב מראה."
    },
    {
      "start": 777.2,
      "end": 779.2,
      "text": "נכון, כשהמחשב רוצה להרות,"
    },
    {
      "start": 779.2,
      "end": 781.2,
      "text": "זה מה?"
    },
    {
      "start": 781.2,
      "end": 783.2,
      "text": "אלא היא נמראה לדוגמה אדום"
    },
    {
      "start": 783.2,
      "end": 785.2,
      "text": "ושחור קצת,"
    },
    {
      "start": 785.2,
      "end": 787.2,
      "text": "ואלה זה לזמן."
    },
    {
      "start": 787.2,
      "end": 789.2,
      "text": "נכון, מעולה."
    },
    {
      "start": 789.2,
      "end": 791.2,
      "text": "אז במקרה הזה,"
    },
    {
      "start": 793.2,
      "end": 795.2,
      "text": "0,0,"
    },
    {
      "start": 795.2,
      "end": 797.2,
      "text": "0,0,0 זה שחור,"
    },
    {
      "start": 799.2,
      "end": 801.2,
      "text": "255, 255, 255,"
    },
    {
      "start": 801.2,
      "end": 803.2,
      "text": "255,"
    },
    {
      "start": 803.2,
      "end": 805.2,
      "text": "זה לבן,"
    },
    {
      "start": 805.2,
      "end": 807.2,
      "text": "ואפשר להרכיב כל צהיר מהככה."
    },
    {
      "start": 807.2,
      "end": 809.2,
      "text": "סתם, ודוגמא,"
    },
    {
      "start": 809.2,
      "end": 811.2,
      "text": "איך אתה יודע את זה?"
    },
    {
      "start": 813.2,
      "end": 815.2,
      "text": "עוד פעם?"
    },
    {
      "start": 815.2,
      "end": 817.2,
      "text": "איך אתה יודע את זה?"
    },
    {
      "start": 817.2,
      "end": 819.2,
      "text": "יש לי שנים רבות של התכנות מהחוריי"
    },
    {
      "start": 819.2,
      "end": 821.2,
      "text": "והייתי צריך להתעסק עם צוויין."
    },
    {
      "start": 821.2,
      "end": 823.2,
      "text": "סתם, זה כמו ש,"
    },
    {
      "start": 823.2,
      "end": 825.2,
      "text": "כשמארביבים את כל הצווים,"
    },
    {
      "start": 825.2,
      "end": 827.2,
      "text": "יוצא לבן,"
    },
    {
      "start": 827.2,
      "end": 829.2,
      "text": "לא באמת, לא באמצעיות,"
    },
    {
      "start": 829.2,
      "end": 831.2,
      "text": "אבל בתיאוריה,"
    },
    {
      "start": 831.2,
      "end": 833.2,
      "text": "כאילו, קרן אור לבנה מכילה"
    },
    {
      "start": 833.2,
      "end": 835.2,
      "text": "בתוך ההתכנת, בגלל זה 255,"
    },
    {
      "start": 835.2,
      "end": 837.2,
      "text": "זה שילוב של הכל,"
    },
    {
      "start": 837.2,
      "end": 839.2,
      "text": "וזה מה שנותנו לבן."
    },
    {
      "start": 839.2,
      "end": 841.2,
      "text": "אם יש לנו 255,"
    },
    {
      "start": 841.2,
      "end": 843.2,
      "text": "ואז 0,0"
    },
    {
      "start": 843.2,
      "end": 845.2,
      "text": "זה אומר רק מהראשון,"
    },
    {
      "start": 845.2,
      "end": 847.2,
      "text": "ולא מהשני והשפישי,"
    },
    {
      "start": 847.2,
      "end": 849.2,
      "text": "רוצים לנחש את זה?"
    },
    {
      "start": 849.2,
      "end": 851.2,
      "text": "איפור, זה לבן שחור שחור."
    },
    {
      "start": 851.2,
      "end": 853.2,
      "text": "אוקיי, אז זה כסוג של לבן שחור שחור,"
    },
    {
      "start": 853.2,
      "end": 855.2,
      "text": "זה הרבה ואז קצת וקצת,"
    },
    {
      "start": 855.2,
      "end": 857.2,
      "text": "אבל תזכרו, מה אומר כל אחד מהמספרים, כן?"
    },
    {
      "start": 857.2,
      "end": 859.2,
      "text": "אמרנו שזה בעצם זה."
    },
    {
      "start": 859.2,
      "end": 861.2,
      "text": "זה רד גרין בלוב."
    },
    {
      "start": 861.2,
      "end": 863.2,
      "text": "אז מה זה אומר שיש לנו?"
    },
    {
      "start": 863.2,
      "end": 865.2,
      "text": "אז יש פה, יש פה, יש פה,"
    },
    {
      "start": 865.2,
      "end": 867.2,
      "text": "אז זה אדום,"
    },
    {
      "start": 867.2,
      "end": 869.2,
      "text": "זה אדום."
    },
    {
      "start": 869.2,
      "end": 871.2,
      "text": "נעולה, זה אדום."
    },
    {
      "start": 871.2,
      "end": 873.2,
      "text": "אז זה אדום, דרך אגב,"
    },
    {
      "start": 873.2,
      "end": 875.2,
      "text": "ורות זה נגיד 255"
    },
    {
      "start": 875.2,
      "end": 877.2,
      "text": "200, 200 לדוגמה,"
    },
    {
      "start": 877.2,
      "end": 879.2,
      "text": "וכן הלאה וכן הלאה,"
    },
    {
      "start": 879.2,
      "end": 881.2,
      "text": "וכן הלאה וכן הלאה וכן הלאה."
    },
    {
      "start": 883.2,
      "end": 885.2,
      "text": "אבל זה לא, כאילו זה מגניב,"
    },
    {
      "start": 885.2,
      "end": 887.2,
      "text": "אבל הדוגמה הכרישה, זה מבעלה עבוד,"
    },
    {
      "start": 887.2,
      "end": 889.2,
      "text": "זה שכל דבר, הכל, גם צבאים,"
    },
    {
      "start": 889.2,
      "end": 891.2,
      "text": "גם אותיות, גם מספרים,"
    },
    {
      "start": 891.2,
      "end": 893.2,
      "text": "הכל אפשר להביע,"
    },
    {
      "start": 893.2,
      "end": 895.2,
      "text": "כמספרים בעצם,"
    },
    {
      "start": 895.2,
      "end": 897.2,
      "text": "הכל אפשר להביע כערך שהוא מספרי,"
    },
    {
      "start": 897.2,
      "end": 899.2,
      "text": "אפילו..."
    },
    {
      "start": 899.2,
      "end": 901.2,
      "text": "אני לא חייגה את זה בעברי."
    }
  ]
}