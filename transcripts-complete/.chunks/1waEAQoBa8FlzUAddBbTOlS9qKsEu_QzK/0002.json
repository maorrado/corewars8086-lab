    },
    {
      "start": 1811.56,
      "end": 1814.0,
      "text": "עכשיו, מה שאנחנו מנסים להוכיח זה,"
    },
    {
      "start": 1814.96,
      "end": 1816.48,
      "text": "האם אפשר,"
    },
    {
      "start": 1820.12,
      "end": 1823.4,
      "text": "האם אפשר להכסן כל מספר"
    },
    {
      "start": 1825.04,
      "end": 1827.28,
