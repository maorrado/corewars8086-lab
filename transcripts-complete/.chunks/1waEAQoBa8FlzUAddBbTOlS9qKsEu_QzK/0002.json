    {
      "start": 1851.0,
      "end": 1852.0,
      "text": "רם."
    },
    {
      "start": 1854.6,
      "end": 1855.6,
      "text": "לא, זהו."
    },
    {
      "start": 1856.6000000000001,
      "end": 1857.6000000000001,
      "text": "רגע."
    },
    {
      "start": 1861.6000000000001,
      "end": 1862.6000000000001,
      "text": "אוקיי."
    },
    {
      "start": 1865.6000000000001,
      "end": 1866.6000000000001,
      "text": "אוקיי."
    },
    {
      "start": 1867.6000000000001,
      "end": 1871.0800000000002,
      "text": "לא כזה רואים את זה פה, אבל מלא, מלא, מלא, מלא מנורות."
    },
    {
