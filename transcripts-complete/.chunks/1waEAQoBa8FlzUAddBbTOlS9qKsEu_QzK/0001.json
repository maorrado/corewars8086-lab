    {
      "start": 1612.96,
      "end": 1616.64,
      "text": "סבמא, וכשמדברים על הפסים ואחדים, לא יודעים, ראיתם מטריקס,"
    },
    {
      "start": 1616.68,
      "end": 1619.0800000000002,
      "text": "כל מיני סרטים הגדימים, כאלה, שחווים את כל העקרים,"
    },
    {
      "start": 1619.1200000000001,
      "end": 1621.6000000000001,
      "text": "ומפסים לאחדים על הרוסח, זה בסך הכל,"
    },
    {
      "start": 1622.16,
      "end": 1626.4800000000002,
      "text": "הדבר הזה, זה כאילו לציין שמנורת לוקאו קבויה, זה הפסים ואחדים."
    },
    {
      "start": 1626.5200000000002,
      "end": 1627.44,
      "text": "אם זה אתה מסכים?"
    },
    {
      "start": 1627.8400000000001,
      "end": 1628.4800000000002,
      "text": "כן."
    },
    {
      "start": 1628.5200000000002,
      "end": 1629.2,
      "text": "מבניב."
    },
    {
      "start": 1629.72,
      "end": 1637.2,
      "text": "כל מידע בעולם, כל מידע, תמונות, צרטונים, סאונד, הכל אפשר להביע בתור מספרים."
    },
    {
      "start": 1637.2400000000002,
      "end": 1641.6000000000001,
      "text": "קצת נראה לא קשור, אבל כאילו, זה גם נכון, אתה מסכים איתי?"
    },
    {
      "start": 1641.92,
      "end": 1642.5200000000002,
      "text": "כן."
    },
    {
      "start": 1642.5600000000002,
      "end": 1645.6000000000001,
      "text": "אנחנו חיים בידע הנדיגיטלי, הכל זה מידע."
    },
    {
      "start": 1646.1200000000001,
      "end": 1650.0800000000002,
      "text": "עכשיו, אם אנחנו רוצים שמחשב שיודע רק הפסים ואחדים,"
    },
    {
      "start": 1650.08,
      "end": 1653.28,
      "text": "ידע להחסן כל מידע שבעולם, ואנחנו יודעים שזה קורה,"
    },
    {
      "start": 1653.32,
      "end": 1656.6799999999998,
      "text": "כי תראה אותנו מסתובבים עם טלפונים ומחשבים בטלפיזיה."
    },
    {
      "start": 1656.72,
      "end": 1659.84,
      "text": "עכשיו אנחנו רק צריכים להבין איך אפשר להחזיק כל מידע,"
    },
    {
      "start": 1660.56,
      "end": 1662.56,
      "text": "כי רצף של הפסים ואחדים, נכון?"
    },
    {
      "start": 1664.08,
      "end": 1666.1999999999998,
      "text": "אבל למה דווקא 0 ואחדים?"
    },
    {
      "start": 1666.56,
      "end": 1667.9199999999998,
      "text": "למה 0 ואחדים?"
    },
    {
      "start": 1667.96,
      "end": 1672.32,
      "text": "כי הרבה הרבה יותר זול להחזיק מלא מלא מנורות,"
    },
    {
      "start": 1672.36,
      "end": 1675.6,
      "text": "שהם או 0 ואחד, שאלה מתורפת,"
    },
    {
      "start": 1675.6399999999999,
      "end": 1677.6399999999999,
      "text": "דרך אגב, שאלה מעולה שלא הרבה אנשים שואלים,"
    },
    {
      "start": 1677.64,
      "end": 1680.92,
      "text": "וגם ניסו בעבר לא לעשות את היו הפסים ואחדים,"
    },
    {
      "start": 1682.1200000000001,
      "end": 1685.96,
      "text": "זה בגלל שהרבה הרבה יותר קשה להחסנת זה באופן אחרות,"
    },
    {
      "start": 1686.0,
      "end": 1690.4,
      "text": "שהוא נגיד 1 עד 10 או 1 עד 3 או 1 עד 8,"
    },
    {
      "start": 1690.72,
      "end": 1695.24,
      "text": "הרבה יותר קשה להחזיק רמת חשמל שישונה,"
    },
    {
      "start": 1695.3600000000001,
      "end": 1697.5600000000002,
      "text": "מאז שלא פשוט להגיד, זה דנוק, זה קבוע."
    },
    {
      "start": 1698.48,
      "end": 1700.8400000000001,
      "text": "ואז אמרו סבבה, אז יש לנו רק מנורת,"
    },
    {
      "start": 1701.0800000000002,
      "end": 1703.1200000000001,
      "text": "אנחנו יודעים שהם מנורת קבועייה זה כמו 0,"
    },
    {
      "start": 1703.16,
      "end": 1704.4,
      "text": "ובמנורת לוקה זה כמו 1,"
    },
    {
      "start": 1704.44,
      "end": 1706.76,
      "text": "יש לנו רק 0 ואחד זה מה יש ואם זה נעבוד."
    },
    {
      "start": 1706.76,
      "end": 1710.92,
      "text": "ואז הם צריכים להבין איך ממירים מנורות לוקות ומנורות קבויות,"
    },
    {
      "start": 1710.96,
      "end": 1713.0,
      "text": "שזה כל מה שהיה עליהם, הם לא יכולים לעשות"
    },
    {
      "start": 1713.04,
      "end": 1715.64,
      "text": "דרך אחרת להחזיק מידה שאי לא עם מנורות,"
    },
    {
      "start": 1715.68,
      "end": 1717.76,
      "text": "אבל זה מנורא פיזית?"
    },
    {
      "start": 1717.8,
      "end": 1720.08,
      "text": "כן, זה פיזית מנורא כמו שיש לך בבית,"
    },
    {
      "start": 1720.12,
      "end": 1721.52,
      "text": "רק הרבה הרבה יותר קטנה."
    },
    {
      "start": 1721.96,
      "end": 1725.28,
      "text": "אה, כאילו, מה שמורכב המסך?"
    },
    {
      "start": 1725.72,
      "end": 1727.84,
      "text": "נכון, זה כמו עלנים שיש לך משך,"
    },
    {
      "start": 1727.8799999999999,
      "end": 1729.8799999999999,
      "text": "זה ממש כמו עלנים שיש לך משך,"
    },
    {
      "start": 1729.92,
      "end": 1731.56,
      "text": "רק שהם לא בצבעים שונים,"
    },
    {
      "start": 1731.6,
      "end": 1733.36,
      "text": "זה רק מנורא רגילה לחלוטי,"
    },
    {
      "start": 1733.4,
      "end": 1734.44,
      "text": "או שקבוייה או שי לוקה,"
    },
    {
      "start": 1734.48,
      "end": 1736.44,
      "text": "וימוק בתוך המחשב שלך יקטן טונת."
    },
    {
      "start": 1736.96,
      "end": 1739.44,
      "text": "אה, כמו פסלד."
    },
    {
      "start": 1739.48,
      "end": 1740.0800000000002,
      "text": "כן."
    },
    {
      "start": 1740.1200000000001,
      "end": 1741.8,
      "text": "נכון, כמו פסלד, עכשיו,"
    },
    {
      "start": 1741.8400000000001,
      "end": 1743.48,
      "text": "דרך אגב, גם פסלד,"
    },
    {
      "start": 1743.52,
      "end": 1745.96,
      "text": "גם המסך שלך מאכסן מידה."
    },
    {
      "start": 1746.0,
      "end": 1748.96,
      "text": "גם המסך שלכם, הוא אזור במחשב,"
    },
    {
      "start": 1749.0,
      "end": 1750.1200000000001,
      "text": "יש אזור בזיכרון,"
    },
    {
      "start": 1750.16,
      "end": 1755.28,
      "text": "שבעצם על כל מנורא במסך שלכם, על כל פיקסל,"
    },
    {
      "start": 1755.3200000000002,
      "end": 1756.8,
      "text": "צריך להגיד לו מה להציב,"
    },
    {
      "start": 1756.8400000000001,
      "end": 1758.0800000000002,
      "text": "ואז זה גם מידה,"
    },
    {
      "start": 1758.1200000000001,
      "end": 1760.16,
      "text": "דיבלמן, זה כן, גם תמונות זה מידה."
    },
    {
      "start": 1760.2,
      "end": 1763.24,
      "text": "אז זה מנורות שיש בתוך המחשב,"
    },
    {
      "start": 1763.24,
      "end": 1765.48,
      "text": "לא המסך, אבל ממש דומה לזה."
    },
    {
      "start": 1765.52,
      "end": 1768.08,
      "text": "ועכשיו, אנחנו צריכים להבין"
    },
    {
      "start": 1768.1200000000001,
      "end": 1769.6,
      "text": "איך אנחנו לוקחים את המנורות,"
    },
    {
      "start": 1769.64,
      "end": 1771.48,
      "text": "שזה מה שאמרו לנו, כך, זה מנורות,"
    },
    {
      "start": 1771.52,
      "end": 1773.52,
      "text": "זה מה יש, את עשים, זה מה שאתה יכול."
    },
    {
      "start": 1773.56,
      "end": 1775.6,
      "text": "איך אנחנו משתמשים בהם לטובתנו"
    },
    {
      "start": 1775.64,
      "end": 1778.28,
      "text": "כדי להחזיק כל מידה שיש בעולם?"
    },
    {
      "start": 1778.32,
      "end": 1780.24,
      "text": "עכשיו, את החלק הקהל כבר עשינו."
    },
    {
      "start": 1780.28,
      "end": 1781.04,
      "text": "אמרנו,"
    },
    {
      "start": 1784.44,
      "end": 1785.96,
      "text": "כל מידה שיש בעולם"
    },
    {
      "start": 1789.8,
      "end": 1792.76,
      "text": "אפשר להחזיק בתור מספר."
    },
    {
      "start": 1793.24,
      "end": 1799.24,
      "text": "יפה, עכשיו, אנחנו יודעים שכל דבר שמור..."
    }
  ]
}