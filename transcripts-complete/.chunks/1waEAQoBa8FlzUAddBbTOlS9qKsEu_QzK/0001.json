{
  "source": "1waEAQoBa8FlzUAddBbTOlS9qKsEu_QzK.mp4",
  "source_sha256": "678e967fc52976dd00f694e3b86558b4abf50edc1db4682e669517c3157ba31a",
  "model": "small",
  "language": "he",
  "language_probability": 1,
  "start": 900.0,
  "end": 1800.0,
  "elapsed_seconds": 547.5813746452332,
  "segments": [
    {
      "start": 900.0,
      "end": 902.0,
      "text": "זה נתשאל יותר קל."
    },
    {
      "start": 902.0,
      "end": 906.0,
      "text": "בטח. אז..."
    },
    {
      "start": 908.0,
      "end": 910.0,
      "text": "נסימטיבית את החלק של RGB?"
    },
    {
      "start": 910.0,
      "end": 912.0,
      "text": "כן."
    },
    {
      "start": 912.0,
      "end": 914.0,
      "text": "אני יכול..."
    },
    {
      "start": 914.0,
      "end": 920.0,
      "text": "הכל ניתן להביע מספרים"
    },
    {
      "start": 920.0,
      "end": 927.0,
      "text": "למה RGB, שירות, סבילה..."
    },
    {
      "start": 927.0,
      "end": 931.0,
      "text": "זה הזום של הרובוטיקה?"
    },
    {
      "start": 931.0,
      "end": 935.0,
      "text": "זה הזום של CodeGuru, של הסמרי."
    },
    {
      "start": 937.0,
      "end": 943.0,
      "text": "כן, אז זום הזה הוא רק של הסמרי, רק של סייבר."
    },
    {
      "start": 943.0,
      "end": 945.0,
      "text": "בסדר?"
    },
    {
      "start": 945.0,
      "end": 947.0,
      "text": "לא של רובוטיקה."
    },
    {
      "start": 947.0,
      "end": 953.0,
      "text": "מי שרוצה להיכנס לתחרות, שבטחום הסייבר."
    },
    {
      "start": 954.0,
      "end": 956.0,
      "text": "אבל..."
    },
    {
      "start": 956.0,
      "end": 958.0,
      "text": "אוקיי."
    },
    {
      "start": 960.0,
      "end": 963.0,
      "text": "ובדרך אגב..."
    },
    {
      "start": 963.0,
      "end": 966.0,
      "text": "אז כמו שאמרו, הכל אפשר להביע כמספרים,"
    },
    {
      "start": 966.0,
      "end": 969.0,
      "text": "תמונות איך יציבו אותם דרך אגב, פשוט תמון מספרים,"
    },
    {
      "start": 969.0,
      "end": 972.0,
      "text": "כשכל שלושה מספרים זה פיקסל אחד בתמונה."
    },
    {
      "start": 972.0,
      "end": 973.0,
      "text": "אז בעצם יהיה לי..."
    },
    {
      "start": 973.0,
      "end": 975.0,
      "text": "הצבעים של הפיקסל הראשון של השני של השלישי,"
    },
    {
      "start": 975.0,
      "end": 978.0,
      "text": "ככה מלא מלא מלא מספרים, אבל בסוף זה רק מספרים."
    },
    {
      "start": 978.0,
      "end": 981.0,
      "text": "גם מילה בג'יבריש?"
    },
    {
      "start": 981.0,
      "end": 984.0,
      "text": "גם מילה בג'יבריש, אם תבחר עכשיו מילה בג'יבריש,"
    },
    {
      "start": 984.0,
      "end": 987.0,
      "text": "יהיה אפשר להביע אותם כמספרים."
    },
    {
      "start": 987.0,
      "end": 989.0,
      "text": "איך עושים את זה? יש תבלה נורא מדליבה,"
    },
    {
      "start": 989.0,
      "end": 992.0,
      "text": "שבא לכל עוד יש ערך מספרי,"
    },
    {
      "start": 992.0,
      "end": 994.0,
      "text": "ואז בעצם כותבים את המספרים..."
    },
    {
      "start": 994.0,
      "end": 995.0,
      "text": "גימטריה."
    },
    {
      "start": 995.0,
      "end": 997.0,
      "text": "לא שמעתי?"
    },
    {
      "start": 997.0,
      "end": 999.0,
      "text": "לא, גימטריה."
    },
    {
      "start": 999.0,
      "end": 1001.0,
      "text": "אז זה ממש דומה לגימטריה."
    },
    {
      "start": 1001.0,
      "end": 1003.0,
      "text": "מה זה?"
    },
    {
      "start": 1003.0,
      "end": 1005.0,
      "text": "זה ממש דומה לגימטריה, רק שזה לא מתחיל מאחת."
    },
    {
      "start": 1005.0,
      "end": 1008.0,
      "text": "זה לא שאלף זה אחת, בעצם שאתה הגימץ ושלוש."
    },
    {
      "start": 1008.0,
      "end": 1010.0,
      "text": "אלא..."
    },
    {
      "start": 1010.0,
      "end": 1012.0,
      "text": "באנגלית נגיד, הגדולה זה..."
    },
    {
      "start": 1012.0,
      "end": 1016.0,
      "text": "60 ומשהו, קטנה זה 91, דברים כאלה."
    },
    {
      "start": 1016.0,
      "end": 1020.0,
      "text": "אין, אבל בסופן יש קוד שונה."
    },
    {
      "start": 1020.0,
      "end": 1024.0,
      "text": "נגיד, א' בעזרי תלו, לא דומה לאבן גלית..."
    },
    {
      "start": 1024.0,
      "end": 1026.0,
      "text": "נכון, כי אנחנו רוצים להבדיל."
    },
    {
      "start": 1026.0,
      "end": 1028.0,
      "text": "כי אם אני עכשיו כותב..."
    },
    {
      "start": 1028.0,
      "end": 1030.0,
      "text": "אם אני עכשיו ייקח קודס מהעכשיו,"
    },
    {
      "start": 1030.0,
      "end": 1032.0,
      "text": "נגיד, אני אכתוב מסמך בוורד,"
    },
    {
      "start": 1032.0,
      "end": 1034.0,
      "text": "ואני אכתוב בו מלא מלא פעמים את האות א'"
    },
    {
      "start": 1034.0,
      "end": 1036.0,
      "text": "ואז אני אצאו מסמך אחר,"
    },
    {
      "start": 1036.0,
      "end": 1037.0,
      "text": "שאני אכתוב בו מלא פעמים את האות א'"
    },
    {
      "start": 1037.0,
      "end": 1039.0,
      "text": "זה לא אותו מסמך."
    },
    {
      "start": 1039.0,
      "end": 1041.0,
      "text": "הם לא עושבים אחד לשני."
    },
    {
      "start": 1041.0,
      "end": 1043.0,
      "text": "יש בו את כל ספות בעולם."
    },
    {
      "start": 1043.0,
      "end": 1044.0,
      "text": "מה מה?"
    },
    {
      "start": 1044.0,
      "end": 1047.0,
      "text": "יש כל ספות בעולם, לכל עוד בכל ספה."
    },
    {
      "start": 1047.0,
      "end": 1049.0,
      "text": "נכון, וזה נקרא יוני קורד."
    },
    {
      "start": 1049.0,
      "end": 1054.0,
      "text": "גם אם יש נגיד את אי וואנגלית..."
    },
    {
      "start": 1054.0,
      "end": 1056.0,
      "text": "גם בערבית, גם בסינית, גם בנורבגית,"
    },
    {
      "start": 1056.0,
      "end": 1058.0,
      "text": "יש שם הכל, מופתיח לך."
    },
    {
      "start": 1058.0,
      "end": 1061.0,
      "text": "אבל אם יש את אותה עוד,"
    },
    {
      "start": 1061.0,
      "end": 1063.0,
      "text": "היא באותה צורה,"
    },
    {
      "start": 1063.0,
      "end": 1065.0,
      "text": "אבל היא בשתי ספות שונות."
    },
    {
      "start": 1065.0,
      "end": 1067.0,
      "text": "אז היא תופיע רק פעם אחת."
    },
    {
      "start": 1067.0,
      "end": 1069.0,
      "text": "זה שאלה ממש טובה."
    },
    {
      "start": 1069.0,
      "end": 1071.0,
      "text": "אי באנגלית,"
    },
    {
      "start": 1071.0,
      "end": 1073.0,
      "text": "ואר ברוסית?"
    },
    {
      "start": 1073.0,
      "end": 1075.0,
      "text": "נכון,"
    },
    {
      "start": 1075.0,
      "end": 1077.0,
      "text": "באמת שזה גם באיזו ספיסית, אני לא יודע,"
    },
    {
      "start": 1077.0,
      "end": 1079.0,
      "text": "אבל לגיד ספות לתאימיה, ספתי,"
    },
    {
      "start": 1079.0,
      "end": 1080.0,
      "text": "זה יהיה אותו לבר,"
    },
    {
      "start": 1080.0,
      "end": 1082.0,
      "text": "אבל אני כודאי, לגמרי זה,"
    },
    {
      "start": 1082.0,
      "end": 1084.0,
      "text": "אפשר להביע כל אות בעולם,"
    },
    {
      "start": 1084.0,
      "end": 1086.0,
      "text": "כל תמונה, אפילו כל."
    },
    {
      "start": 1086.0,
      "end": 1087.0,
      "text": "אני לא אכנס לסאונד,"
    },
    {
      "start": 1087.0,
      "end": 1089.0,
      "text": "כי זה ממש, ממש מסובך,"
    },
    {
      "start": 1089.0,
      "end": 1091.0,
      "text": "אבל הכל אפשר להביע כמספרים."
    },
    {
      "start": 1091.0,
      "end": 1092.0,
      "text": "וברגע שהבנו את זה,"
    },
    {
      "start": 1092.0,
      "end": 1093.0,
      "text": "אז עכשיו צריך לשאול,"
    },
    {
      "start": 1093.0,
      "end": 1095.0,
      "text": "מגניב, יש מספרים."
    },
    {
      "start": 1095.0,
      "end": 1097.0,
      "text": "ואפסים והאחדים המזרים האלה שערת עלנו,"
    },
    {
      "start": 1097.0,
      "end": 1100.0,
      "text": "כי זה לא, אין מצב שפלם להביע כל כשני מספרים."
    },
    {
      "start": 1100.0,
      "end": 1102.0,
      "text": "נכון? שווה שלא באמת,"
    },
    {
      "start": 1102.0,
      "end": 1104.0,
      "text": "אבל נראה לכם איזשהו..."
    },
    {
      "start": 1104.0,
      "end": 1106.0,
      "text": "מה זה יוניקוד?"
    },
    {
      "start": 1106.0,
      "end": 1108.0,
      "text": "מה זה יוניקוד? יוניקוד,"
    },
    {
      "start": 1108.0,
      "end": 1110.0,
      "text": "זה דרך להביע כל אות,"
    },
    {
      "start": 1110.0,
      "end": 1112.0,
      "text": "כל אות שקיים את בעולם."
    },
    {
      "start": 1112.0,
      "end": 1113.0,
      "text": "עוד יוד ביו רית, באנגלית, בסינית, ברוסית,"
    },
    {
      "start": 1113.0,
      "end": 1115.0,
      "text": "בערבית, הכל."
    },
    {
      "start": 1116.0,
      "end": 1118.0,
      "text": "סלב."
    },
    {
      "start": 1118.0,
      "end": 1119.0,
      "text": "אז עכשיו כשהבנו את זה,"
    },
    {
      "start": 1119.0,
      "end": 1121.0,
      "text": "בואו ננסה להבין,"
    },
    {
      "start": 1121.0,
      "end": 1123.0,
      "text": "רגע, אפילו איתן כות עבוד"
    },
    {
      "start": 1123.0,
      "end": 1125.0,
      "text": "ולכם עדות,"
    },
    {
      "start": 1126.0,
      "end": 1128.0,
      "text": "נעידה בתור מספרים."
    },
    {
      "start": 1130.0,
      "end": 1132.0,
      "text": "ועכשיו פה,"
    },
    {
      "start": 1134.0,
      "end": 1136.0,
      "text": "מהרה, פשוט מספרים,"
    },
    {
      "start": 1136.0,
      "end": 1138.0,
      "text": "זה, פסרון."
    },
    {
      "start": 1140.0,
      "end": 1142.0,
      "text": "כל מה זה גם בינרי, אוקיי?"
    },
    {
      "start": 1143.0,
      "end": 1145.0,
      "text": "אני לא נותן לי שאתה משפה מונח הזה."
    },
    {
      "start": 1145.0,
      "end": 1147.0,
      "text": "טוב, ואני רוצה..."
    },
    {
      "start": 1147.0,
      "end": 1149.0,
      "text": "שוב, לשאול, עוד איך?"
    },
    {
      "start": 1149.0,
      "end": 1151.0,
      "text": "אני רוצה לא..."
    },
    {
      "start": 1151.0,
      "end": 1153.0,
      "text": "אני רוצה להשתמש את רובוטיקה."
    },
    {
      "start": 1153.0,
      "end": 1155.0,
      "text": "אוקיי, שמח שאני שאתה לכל זאת."
    },
    {
      "start": 1157.0,
      "end": 1158.0,
      "text": "אז..."
    },
    {
      "start": 1158.0,
      "end": 1160.0,
      "text": "יודה, אני לא מבין..."
    },
    {
      "start": 1161.0,
      "end": 1163.0,
      "text": "אתה שלחת בקבוצה,"
    },
    {
      "start": 1165.0,
      "end": 1168.0,
      "text": "תקישור הזה, אני לא מבין אם זה לרובוטיקה"
    },
    {
      "start": 1168.0,
      "end": 1170.0,
      "text": "או סייבר."
    },
    {
      "start": 1170.0,
      "end": 1172.0,
      "text": "זה לסייבר, המפגש הזה ספציטי..."
    },
    {
      "start": 1172.0,
      "end": 1175.0,
      "text": "לא רק סייבר, התחרות הזאת ספציטית היא סייבר."
    },
    {
      "start": 1175.0,
      "end": 1177.0,
      "text": "אבל אני יכול להרשם לשתיהם."
    },
    {
      "start": 1177.0,
      "end": 1179.0,
      "text": "כן, יכול להשתמש..."
    },
    {
      "start": 1179.0,
      "end": 1183.0,
      "text": "אני מציע לך את זה, אני מציע לך, אני מציע לך"
    },
    {
      "start": 1183.0,
      "end": 1185.0,
      "text": "אני נתתף גם בזה וגם בזה."
    },
    {
      "start": 1186.0,
      "end": 1189.0,
      "text": "ההכירות שההבנה שלכם של איך מחשב עובד"
    },
    {
      "start": 1189.0,
      "end": 1191.0,
      "text": "תעניק לכם הרבה מתנות."
    },
    {
      "start": 1191.0,
      "end": 1194.0,
      "text": "יודה, מה זאת אומרת רובוטיקה?"
    },
    {
      "start": 1194.0,
      "end": 1196.0,
      "text": "מה זה הרובוטיקה?"
    },
    {
      "start": 1196.0,
      "end": 1197.0,
      "text": "רובוטיקה זה משהו אחר,"
    },
    {
      "start": 1197.0,
      "end": 1198.0,
      "text": "זה משהו שהוא לא..."
    },
    {
      "start": 1198.0,
      "end": 1201.0,
      "text": "יש פה ילדים שאני לא יכול להציע להם את זה עדיין."
    },
    {
      "start": 1202.0,
      "end": 1205.0,
      "text": "אז רובוטיקה זה לחלק קטן פה מהילדים"
    },
    {
      "start": 1205.0,
      "end": 1209.0,
      "text": "שהייתי אצלם בבית ספר ועזרתי להם להרגם את זה."
    },
    {
      "start": 1210.0,
      "end": 1211.0,
      "text": "אני נתתכנס גם..."
    },
    {
      "start": 1211.0,
      "end": 1213.0,
      "text": "אני תתכנס לקהל הרובוטיקה פה"
    },
    {
      "start": 1213.0,
      "end": 1215.0,
      "text": "ואני אגיד שרובוטיקה"
    },
    {
      "start": 1215.0,
      "end": 1218.0,
      "text": "או כמו שקוראים לה בעולם של הילדים הגדולים"
    },
    {
      "start": 1218.0,
      "end": 1220.0,
      "text": "פתוח עם בידד,"
    },
    {
      "start": 1220.0,
      "end": 1222.0,
      "text": "זה אחד התחומים שהבנה של הזיכרון"
    },
    {
      "start": 1222.0,
      "end": 1223.0,
      "text": "מה שאנחנו עושים פה עכשיו,"
    },
    {
      "start": 1223.0,
      "end": 1225.0,
      "text": "זה הכי חשוב לא בעולם."
    },
    {
      "start": 1226.0,
      "end": 1230.0,
      "text": "להבין איך אני מנהל את המנורות האלה"
    },
    {
      "start": 1230.0,
      "end": 1232.0,
      "text": "הקטנות, את ההפסים ואת האחדים,"
    },
    {
      "start": 1232.0,
      "end": 1234.0,
      "text": "כשהמשבים שלי באיך אנחנו קבלים"
    },
    {
      "start": 1234.0,
      "end": 1236.0,
      "text": "כי אני עובד על משהו שהוא לא מחשב ענה"
    },
    {
      "start": 1236.0,
      "end": 1239.0,
      "text": "כאלה הוא רכיר קטן של איזשהו רובוט."
    },
    {
      "start": 1240.0,
      "end": 1242.0,
      "text": "אז סופר חשוב וסופר שימושים."
    },
    {
      "start": 1242.0,
      "end": 1244.0,
      "text": "אני יכול גם להגיד שחברים"
    },
    {
      "start": 1244.0,
      "end": 1246.0,
      "text": "שיצא להם להשתתם בתחרות רובוטיקה"
    },
    {
      "start": 1246.0,
      "end": 1248.0,
      "text": "לומדים את זה תוך כדי שהם"
