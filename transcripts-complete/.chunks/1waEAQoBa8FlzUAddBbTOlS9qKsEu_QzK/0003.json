  "segments": [
    {
      "start": 2700.0,
      "end": 2702.66,
      "text": "עוד 4 שזה 36 בודשם."
    },
    {
      "start": 2702.66,
      "end": 2703.66,
      "text": "למה?"
    },
    {
      "start": 2703.66,
      "end": 2707.16,
      "text": "אבל איפה כתוב לחס 32? לא כתוב לחס 32."
    },
    {
      "start": 2707.16,
      "end": 2715.66,
      "text": "אני זוכר שכל אחד מהמקומים, בעצם בתוך המספר, כל אחד מהמקומים זוכרים פה, זה בעצם חזקה."
    },
    {
      "start": 2718.0,
      "end": 2721.0,
      "text": "כן 32 זה 2, בחזקת 5."
    },
    {
      "start": 2721.0,
      "end": 2728.5,
      "text": "נכון, אז שימו לב, יש לי פה, אם אני הציב את המספר שעשינו בגודם, אני הציב אותו פה,"
    },
    {
      "start": 2728.5,
      "end": 2737.5,
      "text": "אז בעצם יש לי 1, 0, 0, 1, 1, 0."
    },
    {
      "start": 2737.5,
      "end": 2742.5,
      "text": "עכשיו תנסו לחבר אותו לפי מה שיש למטת, אתם תראו שזה 2 ועוד 4, שזה 6."
    },
    {
      "start": 2742.5,
      "end": 2745.5,
      "text": "ו-6 בודשם 32 זה 32."
    },
    {
      "start": 2745.5,
      "end": 2748.5,
      "text": "אפשר לעשות עוד 1 אחרון כזה?"
    },
    {
      "start": 2748.5,
      "end": 2753.5,
      "text": "אבל יש 1, איך אתה יודע להבדיל עם זה 4 או 2?"
    },
    {
      "start": 2753.5,
      "end": 2756.5,
      "text": "מה זאת אומרת איך אני יודע להבדיל עם זה 4 או 2?"
    },
    {
      "start": 2757.5,
      "end": 2760.5,
      "text": "לא הבנתי את מה אתה הסופר פה כאילו."
    },
    {
      "start": 2760.5,
      "end": 2768.5,
      "text": "בעצם בשיטה הזאת, אני מקבל מספר שכל ספרה בו מי ימי לסמול,"
    },
    {
      "start": 2768.5,
      "end": 2773.5,
      "text": "אומרת לי איזה חזקה של 2 אני צריך, אז אם יש לי נגיד 1, 1, 1,"
    },
    {
      "start": 2773.5,
      "end": 2777.5,
      "text": "אני יודע שאני צריך 2 וחזקת 0, 2 וחזקת 1 ו2 וחזקת 2,"
    },
    {
      "start": 2777.5,
      "end": 2784.5,
      "text": "אם היה לי פה מספר כזה, אז הייתי צריך 2 וחזקת 0, 2 וחזקת 1,"
    },
    {
      "start": 2784.5,
      "end": 2788.5,
      "text": "2 וחזקת 2, 2 וחזקת 3, לא הייתי מחברת 2 וחזקת 4"
    },
    {
      "start": 2788.5,
      "end": 2792.5,
      "text": "וכן הייתי בוחרת 2 וחזקת 5, אז היה בעצם 1,"
    },
    {
      "start": 2792.5,
      "end": 2796.5,
      "text": "ועוד 2, ועוד 4, ועוד 8, ועוד 16,"
    },
    {
      "start": 2796.5,
      "end": 2802.5,
      "text": "1, 2, 3, 4, לא עוד 16, 1, 2, 3, 4, ועוד 32,"
    },
    {
      "start": 2802.5,
      "end": 2804.5,
      "text": "הייתי מדלגל 16,"
    },
    {
      "start": 2804.5,
      "end": 2807.5,
      "text": "כי יש לי 0 במקום שבו הוא אמר לי עוד."
    },
    {
      "start": 2807.5,
      "end": 2810.5,
      "text": "אבל 0 זה מה זה נחשב?"
    },
    {
      "start": 2810.5,
      "end": 2813.5,
      "text": "0 זה בעצם, אל תוסיף את החזקה הזאת."
    },
    {
      "start": 2813.5,
      "end": 2817.5,
      "text": "כן, נרשימה את החזקות, אל תוסיף את החזקה שנמצא במקום הזה."
    },
    {
      "start": 2817.5,
      "end": 2823.5,
      "text": "אם יש לי, אז זה בעצם 1, 1, 1, 1, 0, 1,"
    },
    {
      "start": 2823.5,
      "end": 2824.5,
      "text": "תוסיף את המספר הזאת."
    },
    {
      "start": 2824.5,
      "end": 2828.5,
      "text": "יש לי אפשר רגע לעצור על התבלה הזאת, אני רוצה להעתיק אותם."
    },
    {
      "start": 2828.5,
      "end": 2832.5,
      "text": "אפשר, אבל אתה יכול פשוט לחפש באינטרנט את תבלה את החזקות של 2."
    },
    {
      "start": 2832.5,
      "end": 2834.5,
      "text": "אה, אוק."
    },
    {
      "start": 2834.5,
      "end": 2838.5,
      "text": "אולי לעשות, בעצם, קוראות על הבא, כל פעם פשוט להחפיל את המספר בשני."
    },
    {
      "start": 2838.5,
      "end": 2842.5,
      "text": "כן, סתום על ית אחד, כפול שתיים זה שתיים, כפול שתיים זה ארבע, כפול שתיים זה שמונה, כפול שתיים זה שש עשרה."
    },
    {
      "start": 2842.5,
      "end": 2845.5,
      "text": "רגע, נעשה עוד פעם את מה שעזינו עכשיו."
    },
    {
      "start": 2845.5,
      "end": 2848.5,
      "text": "לא תכנעתי, אבל בגלל שביקשת כל כך חיפה, אז כן."
    },
    {
      "start": 2848.5,
      "end": 2852.5,
      "text": "ילו, סליחה שאני לא, אני פשוט עכשיו גם בלי כדורים וזה קצת קשה."
    },
    {
      "start": 2852.5,
      "end": 2854.5,
      "text": "לא, קצת בסדר."
    },
    {
      "start": 2855.5,
      "end": 2862.5,
      "text": "המספר שלך הוא 31, ובכלל תהיה בו מסיבה מאוד דוי נקרבת."
    },
    {
      "start": 2863.5,
      "end": 2864.5,
      "text": "אוקיי."
    },
    {
      "start": 2864.5,
      "end": 2865.5,
      "text": "יאללה."
    },
    {
      "start": 2866.5,
      "end": 2871.5,
      "text": "אז עכשיו 31, בחזקת שתיים, כאילו חלקי שתיים."
    },
    {
      "start": 2872.5,
      "end": 2873.5,
      "text": "כמה זה?"
    },
    {
      "start": 2873.5,
      "end": 2876.5,
      "text": "זה 15 שירית אחד."
    },
    {
      "start": 2876.5,
      "end": 2884.5,
      "text": "רגע, אחד, 0, 1, 1, 1, זה יהיה מה שרשמת בשורה הראשונה,"
    },
    {
      "start": 2884.5,
      "end": 2889.5,
      "text": "כי זה לפי נוראות הדלקות, אבל מה אתה עושה עכשיו?"
    },
    {
      "start": 2889.5,
      "end": 2891.5,
      "text": "עכשיו אני עושה עוד תרגבו אחד,"
    },
    {
      "start": 2891.5,
      "end": 2895.5,
      "text": "שוב בעצם המטרה שלו זה פשוט לסגור את הנושא הזה,"
    },
    {
      "start": 2895.5,
      "end": 2899.5,
      "text": "כדי שנובחל כזה לעשות עליו שאלות אחרונה."
    },
    {
      "start": 2899.5,
      "end": 2900.5,
      "text": "אוקיי."
    },
    {
      "start": 2900.5,
      "end": 2904.5,
      "text": "אנחנו עושים עוד תרגול, כמו שעשינו 45 פעם אחד ופעם אחת עשינו 38,"
    },
    {
      "start": 2904.5,
      "end": 2906.5,
      "text": "כאילו נעשה את זה ככה."
    },
    {
      "start": 2907.5,
      "end": 2910.5,
      "text": "רגע, אני אעשה לכם פותרת."
    },
    {
      "start": 2912.5,
      "end": 2913.5,
      "text": "אה?"
    },
    {
      "start": 2914.5,
      "end": 2915.5,
      "text": "רגע."
    },
    {
      "start": 2915.5,
      "end": 2918.5,
      "text": "שמיל שירי אס אחד זה פשוט הכל אחד."
    },
    {
      "start": 2919.5,
      "end": 2920.5,
      "text": "לא, זה..."
    },
    {
      "start": 2921.5,
      "end": 2924.5,
      "text": "זה לא יכול להיות ככה גם 32."
    },
    {
      "start": 2925.5,
      "end": 2926.5,
      "text": "אה?"
    },
    {
      "start": 2926.5,
      "end": 2929.5,
      "text": "מי שיש לו ספויילרים שישמור אותם לעצמו?"
    },
    {
      "start": 2930.5,
      "end": 2932.5,
      "text": "נהיה, ספת, תלך."
    },
    {
      "start": 2933.5,
      "end": 2934.5,
      "text": "נעשה."
    },
    {
      "start": 2934.5,
      "end": 2937.5,
      "text": "טוב, 15 לחלק לשתיים."
    },
    {
      "start": 2939.5,
      "end": 2944.5,
      "text": "אה, רגע, 15 לחלק לשתיים זה 7 שירי 1."
    },
    {
      "start": 2944.5,
      "end": 2945.5,
      "text": "נכון."
    },
    {
      "start": 2947.5,
      "end": 2949.5,
      "text": "זה איפה אתה חשבו של..."
    },
    {
      "start": 2949.5,
      "end": 2952.5,
      "text": "כן, אבל נחלת כפי 2 זה 3 שירי 1."
    },
    {
      "start": 2953.5,
      "end": 2954.5,
      "text": "אה."
    },
    {
      "start": 2957.5,
      "end": 2958.5,
      "text": "אוקיי."
    },
    {
      "start": 2958.5,
      "end": 2959.5,
      "text": "איזה חלק?"
    },
    {
      "start": 2959.5,
      "end": 2961.5,
      "text": "זה חלק 1 שירי 1 את עצמם?"
    },
    {
      "start": 2962.5,
      "end": 2966.5,
      "text": "אוקיי, אז רגע, 15 לחלק לשתיים שירי 1 שירי 1, ו..."
    },
    {
      "start": 2966.5,
      "end": 2968.5,
      "text": "1 לחלק לאחד זה..."
    },
    {
      "start": 2969.5,
      "end": 2971.5,
      "text": "1 לחלק בשתיים זה יחצי."
    },
    {
      "start": 2972.5,
      "end": 2973.5,
      "text": "זה 0."
    },
    {
      "start": 2974.5,
      "end": 2975.5,
      "text": "נכון."
    },
    {
      "start": 2976.5,
      "end": 2977.5,
      "text": "אוקיי, מגניב."
    },
    {
      "start": 2977.5,
      "end": 2978.5,
      "text": "עכשיו..."
    },
    {
      "start": 2978.5,
      "end": 2980.5,
      "text": "איך אני משיר את החלק?"
    },
    {
      "start": 2980.5,
      "end": 2981.5,
      "text": "מה מה?"
    },
    {
      "start": 2981.5,
      "end": 2984.5,
      "text": "למה 0 משיר את החלק?"
    },
    {
      "start": 2984.5,
      "end": 2985.5,
      "text": "כי בעצם..."
    },
    {
      "start": 2986.5,
      "end": 2988.5,
      "text": "מזכיר כזה איך שירי תובדת,"
    },
    {
      "start": 2988.5,
      "end": 2991.5,
      "text": "כשאנחנו לא רוצים להתעסק עם מספרים שבורים,"
    },
    {
      "start": 2991.5,
      "end": 2994.5,
      "text": "עם מספרים שהם חצאים או שבישים או שברים באופן קטרים,"
    },
    {
      "start": 2994.5,
      "end": 2996.5,
      "text": "אנחנו יכולים בעצם..."
    },
    {
      "start": 2996.5,
      "end": 2998.5,
      "text": "כל פעם להחסיר אחד מהמספר,"
    },
    {
      "start": 2998.5,
      "end": 3001.5,
      "text": "עד שאנחנו מגיעים לספר שכן מתחלק לדוגמה."
    },
    {
      "start": 3001.5,
      "end": 3004.5,
      "text": "15 לחלק לשתיים, אז 15 לחלק שתיים זה לא מספר שלהם,"
    },
    {
      "start": 3004.5,
      "end": 3007.5,
      "text": "אבל 4 לחלק לשתיים זה כן."
    },
    {
      "start": 3007.5,
      "end": 3011.5,
      "text": "אז 5 לחלק לשתיים זה כמו 4 לחלק לשתיים, עם אחד בצד."
    },
    {
      "start": 3013.5,
      "end": 3016.5,
      "text": "אני לא הבנתי איך כל אחד עם דוקים,"
    },
    {
      "start": 3016.5,
      "end": 3018.5,
      "text": "כי יש לך חסה הכל 5 שע אחדים,"
    },
    {
      "start": 3018.5,
      "end": 3023.5,
      "text": "זאת אומר 32, 16, 18, 4 ו-2."
    },
    {
      "start": 3023.5,
      "end": 3024.5,
      "text": "אוקיי."
    },
    {
      "start": 3024.5,
      "end": 3025.5,
      "text": "אז זה..."
    },
    {
      "start": 3025.5,
      "end": 3027.5,
      "text": "אבל שם זה דוגמה 30 משהו."
    },
    {
      "start": 3027.5,
      "end": 3028.5,
      "text": "מה מה?"
    },
    {
      "start": 3028.5,
      "end": 3029.5,
      "text": "מאיפה הביאו 16 עכשיו?"
    },
    {
      "start": 3029.5,
      "end": 3031.5,
      "text": "איך זה קשור לטבלה?"
    },
    {
      "start": 3031.5,
      "end": 3032.5,
      "text": "רגע, רגע, רגע. אני אספר."
    },
    {
      "start": 3033.5,
      "end": 3035.5,
      "text": "זו שאלה שהיא טובה, והיא נובעת ממה שהוא,"
    },
    {
      "start": 3035.5,
      "end": 3038.5,
      "text": "שאם מישהו ניכנס יותר עמוק לא עלה אותי חנות,"
    },
    {
      "start": 3038.5,
      "end": 3039.5,
      "text": "פה יחבות המון פעמים."
    },
    {
      "start": 3039.5,
      "end": 3041.5,
      "text": "כשאנחנו סופרים בתכנות,"
    },
    {
      "start": 3041.5,
      "end": 3044.5,
      "text": "הרבה פעמים, לא בהכרח כי זה קשור,"
    },
    {
      "start": 3044.5,
      "end": 3047.5,
      "text": "אבל זה קובע המון פעמים, מתחילים מ-0 ולא מ-1."
    },
    {
      "start": 3047.5,
      "end": 3048.5,
      "text": "אוקיי."
    },
    {
      "start": 3048.5,
      "end": 3052.5,
      "text": "אז מ-1,21,24,16?"
    },
    {
      "start": 3052.5,
      "end": 3054.5,
      "text": "זה..."
    },
    {
      "start": 3055.5,
      "end": 3057.5,
      "text": "לא מ-1,21,24,16,"
    },
    {
      "start": 3057.5,
      "end": 3059.5,
      "text": "אלא זה 2 חזקת 0,"
    },
    {
      "start": 3059.5,
      "end": 3061.5,
      "text": "2 חזקת 1, 2 חזקת 2, 2 חזקת 1,"
    },
    {
      "start": 3061.5,
      "end": 3064.5,
      "text": "1 חזקת 1, 2 חזקת 0."
    },
    {
      "start": 3064.5,
      "end": 3066.5,
      "text": "אז זה בעצם 1,"
    },
    {
      "start": 3066.5,
      "end": 3068.5,
      "text": "כי זה 2 חזקת 0,"
    },
    {
      "start": 3068.5,
      "end": 3070.5,
      "text": "1,21,16,"
    },
    {
      "start": 3071.5,
      "end": 3072.5,
      "text": "מה להבנה?"
    },
    {
      "start": 3072.5,
      "end": 3074.5,
      "text": "כאילו, הבנתי את הכל,"
    },
    {
      "start": 3074.5,
      "end": 3076.5,
      "text": "כאילו, עד השלב הזה."
    },
    {
      "start": 3076.5,
      "end": 3077.5,
      "text": "מהו לך?"
    },
    {
      "start": 3077.5,
      "end": 3080.5,
      "text": "עכשיו, כאילו, מה עושים?"
    },
    {
      "start": 3080.5,
      "end": 3081.5,
      "text": "מגניב."
    },
    {
      "start": 3081.5,
      "end": 3083.5,
      "text": "אז יש לך פה מלא 1ים, 1,21,24,15,"
    },
    {
      "start": 3083.5,
      "end": 3085.5,
      "text": "המספר הזה,"
    },
    {
      "start": 3085.5,
      "end": 3087.5,
      "text": "הוא שווה ל-30 מ-1,"
    },
    {
      "start": 3088.5,
      "end": 3090.5,
      "text": "אה,"
    },
    {
      "start": 3090.5,
      "end": 3091.5,
      "text": "כי זה כאילו, אני חושבת,"
    },
    {
      "start": 3091.5,
      "end": 3093.5,
      "text": "פעם ממנו, וזה הקודש,"
    },
    {
      "start": 3093.5,
      "end": 3094.5,
      "text": "שתאילו נוצר."
    },
    {
      "start": 3094.5,
      "end": 3096.5,
      "text": "ואם אני אי פעם ארצה לדעת,"
    },
    {
      "start": 3096.5,
      "end": 3098.5,
      "text": "אם מישהו יעביר לי את המספר הזה,"
    },
    {
