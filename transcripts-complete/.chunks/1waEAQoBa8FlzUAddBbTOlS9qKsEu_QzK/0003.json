      "start": 3516.5,
      "end": 3518.5,
      "text": "המעבל הוא פשוט"
    },
    {
      "start": 3518.5,
      "end": 3520.5,
      "text": "אני מביא לו מספר"
    },
    {
      "start": 3520.5,
      "end": 3522.5,
      "text": "והוא מבצע פקודה, קצת כמו מילון"
    },
    {
      "start": 3522.5,
      "end": 3524.5,
      "text": "כן, במילון יש"
    },
    {
      "start": 3524.5,
      "end": 3528.5,
      "text": "הגדרה, אתה מחפש את ההגדרה, מצאתה את ההגדרה, מגניב"
    },
    {
      "start": 3528.5,
      "end": 3530.5,
      "text": "הוא יגיד לך מה היא אומרת"
    },
    {
      "start": 3530.5,
      "end": 3532.5,
      "text": "אז אותו דבר בדיוק פה רכן"
    },
    {
      "start": 3532.5,
      "end": 3534.5,
      "text": "כמו מספר את טלפון, אפילו"
    },
    {
      "start": 3534.5,
      "end": 3536.5,
      "text": "יש לי בעצם ספר"
    },
    {
      "start": 3536.5,
      "end": 3540.5,
      "text": "של מספרים, אני מעביר למעבד מספר"
    },
    {
      "start": 3540.5,
      "end": 3542.5,
      "text": "אההה"
    },
    {
      "start": 3542.5,
      "end": 3546.5,
      "text": "אני יודע, זה פשוט לא קופץ לי מי שומר"
    },
    {
      "start": 3546.5,
      "end": 3548.5,
      "text": "אני לא מצליח לך את הקצת"
    },
    {
      "start": 3548.5,
      "end": 3550.5,
      "text": "אני יכול להיות שאתה קצת בקרקטיפ, אני פרדת אבל"
    },
    {
      "start": 3550.5,
      "end": 3552.5,
      "text": "אני יכול להיות שיש לי איזשהי תקע"
    },
    {
      "start": 3552.5,
      "end": 3554.5,
      "text": "בסדר"
    },
    {
      "start": 3554.5,
      "end": 3556.5,
      "text": "אהה"
    },
    {
      "start": 3556.5,
      "end": 3558.5,
      "text": "אז"
    },
    {
      "start": 3558.5,
      "end": 3560.5,
      "text": "יש לי את הרשימת הפקודות כמו שאמרתי"
    },
    {
      "start": 3560.5,
      "end": 3564.5,
      "text": "ובאבד כל מה שהוא צריך, זה לקבל פקודה"
    },
    {
      "start": 3564.5,
      "end": 3568.5,
      "text": "הוא רק אומר לי, תביא לי את המספר את פקודה שאתה רוצה שאני אבצע, ואני אבצע אותה"
    },
    {
      "start": 3568.5,
      "end": 3570.5,
      "text": "מצליחי להבין את פה?"
    },
    {
      "start": 3570.5,
      "end": 3572.5,
      "text": "כן"
    },
    {
      "start": 3572.5,
      "end": 3574.5,
      "text": "אוקיי, מולה"
    },
    {
      "start": 3574.5,
      "end": 3578.5,
      "text": "אני אספח לשמוע במדשים ששאדע אני לא יש תתפוק"
    },
    {
      "start": 3578.5,
      "end": 3582.5,
      "text": "כי כרגע יש את הקזה 3-4, 5-6, שיש תתפוק איתה הרבה עד עכשיו"
    },
    {
      "start": 3582.5,
      "end": 3584.5,
      "text": "אבל אני רוצה לדעת שאתהם בושר"
    },
    {
      "start": 3584.5,
      "end": 3588.5,
      "text": "אולי כאלה אני חושב בנשים פשוט שמו על הקלטה"
    },
    {
      "start": 3588.5,
      "end": 3590.5,
      "text": "ואנחנו רוצים לשמוע את זה אחר כך"
    },
    {
      "start": 3590.5,
      "end": 3594.5,
      "text": "אז אנחנו, אני בטше אמרתי גם, אפיצים את הקלטות האלה אחר כך"
    },
    {
      "start": 3594.5,
      "end": 3596.5,
      "text": "אז הם גם מכלו לצפות בזה ביקשר"
    },
    {
      "start": 3596.5,
      "end": 3598.5,
      "text": "אבל אוקיי"
    },
    {
      "start": 3598.5,
      "end": 3600.5,
      "text": "אה כן, אפשר להתנצפות בזון"
    }
  ]
}