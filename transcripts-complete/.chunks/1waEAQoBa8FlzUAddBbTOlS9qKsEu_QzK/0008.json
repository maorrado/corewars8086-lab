{
  "source": "1waEAQoBa8FlzUAddBbTOlS9qKsEu_QzK.mp4",
  "source_sha256": "678e967fc52976dd00f694e3b86558b4abf50edc1db4682e669517c3157ba31a",
  "model": "small",
  "language": "he",
  "language_probability": 1,
  "start": 7200.0,
  "end": 8100.0,
  "elapsed_seconds": 426.5306704044342,
  "segments": [
    {
      "start": 7200.0,
      "end": 7204.16,
      "text": "בן אדמה שאני כתוב בו, אז לכאורה זה נראה כאילו פיצחנו לנו על החרות."
    },
    {
      "start": 7204.16,
      "end": 7212.0,
      "text": "אבל הסודו שבתחרות אמיתית, שני הסורדים מוצבים במקומות הקראיים במלוח."
    },
    {
      "start": 7212.0,
      "end": 7217.68,
      "text": "ולכן, אני לא יכול פשוט לכתוב לאיזשהו מקום ולהגיד,"
    },
    {
      "start": 7217.68,
      "end": 7219.16,
      "text": "אה, אני יודע שהוא יהיה שם."
    },
    {
      "start": 7219.16,
      "end": 7224.24,
      "text": "יש לך אורתה בהסוד, נגיד, מוב, אורד רנדום?"
    },
    {
      "start": 7225.24,
      "end": 7228.4,
      "text": "אז אפשר, אבל זה לא רכה אחרי אותו הרנדום."
    },
    {
      "start": 7228.400000000001,
      "end": 7231.88,
      "text": "נגיד, אני הולך תזרקים מספר הנדומלים, ואתה תגידי לחמש, ואני דרך מגניב."
    },
    {
      "start": 7231.88,
      "end": 7235.240000000001,
      "text": "הסורד נמצא ב-32, אבל שני מספר הנדומלים."
    },
    {
      "start": 7235.240000000001,
      "end": 7238.200000000001,
      "text": "האם יש לך דרך לדעת בדיוק איפה הסורד השני נמצא? לא."
    },
    {
      "start": 7238.200000000001,
      "end": 7240.4800000000005,
      "text": "ובגלל זה, כשאנחנו..."
    },
    {
      "start": 7240.4800000000005,
      "end": 7247.400000000001,
      "text": "אני לא יכול לנהרוג אותם בדחרות עם כל סבב, כאילו זה בעצם כל פעולה של מישהו, המקום משתנה."
    },
    {
      "start": 7247.400000000001,
      "end": 7249.8,
      "text": "אז זה לא כל פעולה המקום משתנה."
    },
    {
      "start": 7249.8,
      "end": 7252.8,
      "text": "זה כל סבב, כאילו כל..."
    },
    {
      "start": 7252.8,
      "end": 7254.040000000001,
      "text": "אה, זה סבב."
    },
    {
      "start": 7254.4,
      "end": 7258.04,
      "text": "עד שכולם נפסלים חוץ מבן אדם אחד,"
    },
    {
      "start": 7258.04,
      "end": 7260.72,
      "text": "או עד שנגמר הסבב, שזה כאילו קבלות מטורות מטורלת?"
    },
    {
      "start": 7260.72,
      "end": 7263.48,
      "text": "איך אני יכולה לכתוב בזמן שפועלת..."
    },
    {
      "start": 7263.48,
      "end": 7264.84,
      "text": "אוקיי, שאלה ממורה."
    },
    {
      "start": 7265.4,
      "end": 7271.24,
      "text": "איך בכלל אמורים להצליח, להרוג אחרים, אם אני לא יודע איפה הם נמצאים,"
    },
    {
      "start": 7271.24,
      "end": 7273.04,
      "text": "איך אני אמור להשמיד אותו תמונות שלו?"
    },
    {
      "start": 7273.04,
      "end": 7289.04,
      "text": "איך אני יכולה לעשות מוב ב-x סיק 0, ואז לעשות תפוס, ואז מוב בית ב-x, 0x1, ואז עד ב-x2, ואז ג'ק תפוס."
    },
    {
      "start": 7290.04,
      "end": 7292.04,
      "text": "זה נפס לי על כל הלוח."
    },
    {
      "start": 7292.04,
      "end": 7294.04,
      "text": "נכון, זה נכון."
    },
    {
      "start": 7294.04,
      "end": 7300.04,
      "text": "זה לדרוס את כל הלוח, אבל זה כבר חומר של המפגש הבא שלנו עוד יומיים,"
    },
    {
      "start": 7300.04,
      "end": 7302.04,
      "text": "כי אני רוצה שכולם יהיו פה כדי לשמוע את זה."
    },
    {
      "start": 7303.04,
      "end": 7307.04,
      "text": "חמישי אנחנו כנראה לא נוכל להיות, כי אנחנו לא בבית."
    },
    {
      "start": 7307.04,
      "end": 7308.04,
      "text": "אוקיי, שאלה."
    },
    {
      "start": 7308.04,
      "end": 7312.04,
      "text": "אנחנו נוכל להיות, אבל אני אצטרף כזה חצי שעה, כאילו, בשמוע לבחצי."
    },
    {
      "start": 7312.04,
      "end": 7320.04,
      "text": "אז או שאתה יצלח פה בשמוע לבחצי, או שאתה יכולה להתמיד לצפות בסרטונים, כמובן לשתה על כבר המעקודמת."
    },
    {
      "start": 7320.04,
      "end": 7323.04,
      "text": "עדיף לי עוד וזה מצמוק איזה אפשר לשאול שלו."
    },
    {
      "start": 7323.04,
      "end": 7324.04,
      "text": "נכון."
    },
    {
      "start": 7325.04,
      "end": 7328.04,
      "text": "ובמקרה, במיקר, כן."
    },
    {
      "start": 7328.04,
      "end": 7331.04,
      "text": "אתה בכוונה על הכלותה?"
    },
    {
      "start": 7331.04,
      "end": 7336.04,
      "text": "נכון, אני בכוונה על הכלותה כדי שגם את המפגש הזה אין אוכל להקליט."
    },
    {
      "start": 7338.04,
      "end": 7346.04,
      "text": "אז נכון, עדיף את המפגש, במיקרה הכי גרוע, אינותם מגיעים קצת מאוחר,"
    },
    {
      "start": 7346.04,
      "end": 7349.04,
      "text": "תישארו לסוף, ואני אשלם לכם את השאלות."
    },
    {
      "start": 7349.04,
      "end": 7354.04,
      "text": "אנחנו בגדול סיימנו, אם למישהו ישאלות קצת יותר מקדמות,"
    },
    {
      "start": 7354.04,
      "end": 7357.04,
      "text": "או שאלות שלא כל תחשורות לחומר, הוא יכול להישאר פה ו..."
    },
    {
      "start": 7357.04,
      "end": 7360.04,
      "text": "איך כותב את המשך שהסביבה הפועל?"
    },
    {
      "start": 7360.04,
      "end": 7365.04,
      "text": "כי המוש שזה פשוט תוכנית בבצע את התפעולה הראשונה של כל קבוצה,"
    },
    {
      "start": 7365.04,
      "end": 7367.04,
      "text": "והשופה מתפעולה השני של כל קבוצה."
    },
    {
      "start": 7367.04,
      "end": 7368.04,
      "text": "נכון."
    },
    {
      "start": 7368.04,
      "end": 7369.04,
      "text": "אז עוד ואז עוד."
    },
    {
      "start": 7369.04,
      "end": 7371.04,
      "text": "אוקיי, מה השאלה?"
    },
    {
      "start": 7371.04,
      "end": 7375.04,
      "text": "אז איך אני אמורה לכתוב בזמן שזה פועל?"
    },
    {
      "start": 7375.04,
      "end": 7379.04,
      "text": "אז אנחנו כותבת בזמן שזה פועל,"
    },
    {
      "start": 7379.04,
      "end": 7383.04,
      "text": "אנחנו כותבת מראש תוכנית, שולחת אותה."
    },
    {
      "start": 7384.04,
      "end": 7387.04,
      "text": "אני שולחת את התוכנית שלך לדחרות,"
    },
    {
      "start": 7387.04,
      "end": 7390.04,
      "text": "ואז מקווה שכתבת קוד מספיק טוב,"
    },
    {
      "start": 7390.04,
      "end": 7395.04,
      "text": "שגם אם הדברים יבחוקצת לרעתך,"
    },
    {
      "start": 7395.04,
      "end": 7397.04,
      "text": "ואולי למישהו תהיה סטרטגיה אחרת,"
    },
    {
      "start": 7397.04,
      "end": 7401.04,
      "text": "אתה עדיין תהיה מספיק טובה כדי להשמיד את כל השאר ולסבוד."
    },
    {
      "start": 7401.04,
      "end": 7405.04,
      "text": "אז בזמן התוכנות אני לא יכול להלכת טוב."
    },
    {
      "start": 7405.04,
      "end": 7409.04,
      "text": "כרגע שבאה לא שולחתי מהקומביטיישן, זה מתחיל לשבוע, אני לא יכולה..."
    },
    {
      "start": 7409.04,
      "end": 7411.04,
      "text": "כן, את לא יכולה לשמות את הקוד בלייבר."
    },
    {
      "start": 7412.04,
      "end": 7416.04,
      "text": "אוקיי, ואם מושיטנו את החידות על הזומבים,"
    },
    {
      "start": 7416.04,
      "end": 7421.04,
      "text": "אז על הזומבים איך קוד עם את הקוד על הזומבים, אם נותנים אותו?"
    },
    {
      "start": 7422.04,
      "end": 7427.04,
      "text": "אז לגבי ההגשות הייתי מתייאצ בקבוצים יהודה,"
    },
    {
      "start": 7427.04,
      "end": 7431.04,
      "text": "לגבי פתרון של זומבים, אני אשתדה שרגיע לזה כמה שיותר מה יקדש שתסקיקו."
    },
    {
      "start": 7431.04,
      "end": 7437.04,
      "text": "אה, את הפתרון של זומבים התחלנו עם יהודה, עם האחוז דפיים,"
    },
    {
      "start": 7437.04,
      "end": 7441.04,
      "text": "אבל זה לא עבד,"
    },
    {
      "start": 7441.04,
      "end": 7446.04,
      "text": "כן, אבל זה לא עבד, אבל הוא שולח איך לזה פתרון שבמקום ה-BXDX,"
    },
    {
      "start": 7446.04,
      "end": 7450.04,
      "text": "ואז זה AXCX, זה המולות AXBXCX."
    },
    {
      "start": 7450.04,
      "end": 7453.04,
      "text": "הבנתי, אוקיי, זכור מרקצב מתקדם, נעדיין."
    },
    {
      "start": 7453.04,
      "end": 7456.04,
      "text": "השתם השתם בהפצצה חכבה,"
    },
    {
      "start": 7456.04,
      "end": 7459.04,
      "text": "זה, אני אמור להימד את זה במפגש הבא, אז..."
    },
    {
      "start": 7459.04,
      "end": 7461.04,
      "text": "ב-50?"
    },
    {
      "start": 7461.04,
      "end": 7465.04,
      "text": "נכון, ב-50 אני אמור לגעת בטכנולוגיה הזאת,"
    },
    {
      "start": 7465.04,
      "end": 7467.04,
      "text": "שדימן..."
    },
    {
      "start": 7467.04,
      "end": 7471.04,
      "text": "כן, אז ב-5 שלך נהצטרף, כי זה יכול לומר שלך מה זה."
    },
    {
      "start": 7471.04,
      "end": 7473.04,
      "text": "אני אככן, זה גם, כי זה גם יהיה כאן,"
    },
    {
      "start": 7473.04,
      "end": 7477.04,
      "text": "יותר לקראת הסוף של המפגש, אז גם אתם תספיקו לזה, נכון?"
    },
    {
      "start": 7477.04,
      "end": 7480.04,
      "text": "ומה עם הפעוש והפופ?"
    },
    {
      "start": 7480.04,
      "end": 7484.04,
      "text": "גם, מה חכה למה את זה, כן, חלק מהאחוריה."
    },
    {
      "start": 7484.04,
      "end": 7492.04,
      "text": "בזמן שזברת את המובוורד ואיפה שזה,"
    },
    {
      "start": 7492.04,
      "end": 7497.04,
      "text": "אנחנו יודעים את החומר הזה, אז כתבתי קוד,"
    },
    {
      "start": 7497.04,
      "end": 7499.04,
      "text": "שכאילו,"
    },
    {
      "start": 7500.04,
      "end": 7504.04,
      "text": "השכן כותב לשני קוד."
    },
    {
      "start": 7505.04,
      "end": 7507.04,
      "text": "מעניין, מה זה אומר שעכשיו..."
    },
    {
      "start": 7507.04,
      "end": 7510.04,
      "text": "עכשיו לעשות שישי סקרין."
    },
    {
      "start": 7510.04,
      "end": 7512.04,
      "text": "בוא נראה אם אני יכול להפשר לך..."
    },
    {
      "start": 7512.04,
      "end": 7515.04,
      "text": "זה יכול פשוט לאורידת שלך ואז כל אחד יכול לעשות."
    },
    {
      "start": 7515.04,
      "end": 7517.04,
      "text": "אוקיי, אז בוא תעשה."
    },
    {
      "start": 7517.04,
      "end": 7520.04,
      "text": "שישי סקרין, שאלה קוויסט."
    },
    {
      "start": 7522.04,
      "end": 7524.04,
      "text": "רואים?"
    },
    {
      "start": 7524.04,
      "end": 7526.04,
      "text": "תנסה רגשו, כי אני לא רואה לך עכשיו."
    },
    {
      "start": 7527.04,
      "end": 7529.04,
      "text": "אוקיי, עכשיו."
    },
    {
      "start": 7529.04,
      "end": 7532.04,
      "text": "שישי סקרין."
    },
    {
      "start": 7533.04,
      "end": 7535.04,
      "text": "תן לי שני."
    },
    {
      "start": 7536.04,
      "end": 7538.04,
      "text": "רואים ככה."
    },
    {
      "start": 7538.04,
      "end": 7540.04,
      "text": "אוקיי, אז זה..."
    },
    {
      "start": 7553.04,
      "end": 7556.04,
      "text": "זה לא נותן איזה בקדאות עצמה."
    },
    {
      "start": 7561.04,
      "end": 7563.04,
      "text": "אוקיי."
    },
    {
      "start": 7563.04,
      "end": 7566.04,
      "text": "רגש, הוא מבקש את הדסק טוב."
    },
    {
      "start": 7566.04,
      "end": 7569.04,
      "text": "אוקיי, אז אני אומע לתקוד."
    },
    {
      "start": 7570.04,
      "end": 7572.04,
      "text": "בסקרין."
    },
    {
      "start": 7573.04,
      "end": 7575.04,
      "text": "אומע לתקוד בבדם."
    },
    {
      "start": 7575.04,
      "end": 7577.04,
      "text": "הוא פתוח לך."
    },
    {
      "start": 7578.04,
      "end": 7580.04,
      "text": "אוקיי."
    },
    {
      "start": 7580.04,
      "end": 7582.04,
      "text": "אוקיי, אל תראוי מה."
    },
    {
      "start": 7593.04,
      "end": 7596.04,
      "text": "שאתה יכול לפתור את הקוד?"
    },
    {
      "start": 7598.04,
      "end": 7601.04,
      "text": "כן, תגיד לי אותו ואני... כמה אוכל?"
    },
    {
      "start": 7603.04,
      "end": 7607.04,
      "text": "הוא בגודל של ארבע שורות."
    },
    {
      "start": 7607.04,
      "end": 7609.04,
      "text": "יאללה, תגיד לי אותו."
    },
    {
      "start": 7609.04,
      "end": 7613.04,
      "text": "בשורה הראשונה, יו-יו נקודותיים."
    },
    {
      "start": 7615.04,
      "end": 7619.04,
      "text": "אחרי זה בשורה השנייה."
    },
    {
      "start": 7621.04,
      "end": 7623.04,
      "text": "מוב ב-x,"
    },
    {
      "start": 7624.04,
      "end": 7626.04,
      "text": "פסיק,"
    },
    {
      "start": 7626.04,
      "end": 7630.04,
      "text": "רווח, 0x, 0a."
    },
    {
      "start": 7634.04,
      "end": 7637.04,
      "text": "ואז בשורה השלישית."
    },
    {
      "start": 7640.04,
      "end": 7643.04,
      "text": "מוב... מוב וורד."
    },
    {
      "start": 7645.04,
      "end": 7647.04,
      "text": "ב-x,"
    },
    {
      "start": 7647.04,
      "end": 7649.04,
      "text": "בסוגרים של נרובה."
    },
    {
      "start": 7651.04,
      "end": 7652.04,
      "text": "פסיק,"
    },
    {
      "start": 7652.04,
      "end": 7654.04,
      "text": "fsx,"
    },
    {
      "start": 7656.04,
      "end": 7658.04,
      "text": "fs-e, fs-7,"
    },
    {
      "start": 7659.04,
      "end": 7661.04,
      "text": "ab,"
    },
    {
      "start": 7663.04,
      "end": 7665.04,
      "text": "ו-jump,"
    },
    {
      "start": 7665.04,
      "end": 7667.04,
      "text": "ובשורה הערבית,"
    },
    {
      "start": 7667.04,
      "end": 7669.04,
      "text": "ו-jump,"
    },
    {
      "start": 7669.04,
      "end": 7671.04,
      "text": "רגע, מה עשית?"
    },
    {
      "start": 7671.04,
      "end": 7675.04,
      "text": "אתה מוב וורד ב-fsi, fs-7,"
    },
    {
      "start": 7675.04,
      "end": 7677.04,
      "text": "מוב וורד,"
    },
    {
      "start": 7677.04,
