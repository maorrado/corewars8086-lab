      "end": 1697.0,
      "text": "ליצור עודות עקים של עצמי"
    },
    {
      "start": 1697.0,
      "end": 1700.0,
      "text": "אז זאת הבקודה מובס-W"
    },
    {
      "start": 1700.0,
      "end": 1701.0,
      "text": "עניון שנייה"
    },
    {
      "start": 1701.0,
      "end": 1703.0,
      "text": "נסביר עליה בצורה פרקטית"
    },
    {
      "start": 1703.0,
      "end": 1705.0,
      "text": "ונראה באמת איך היא עובדת"
    },
    {
      "start": 1705.0,
      "end": 1707.0,
      "text": "יש שאלות וקשר"
    },
    {
      "start": 1707.0,
      "end": 1709.0,
      "text": "לתפעול הבסיסי של הבקודה"
    },
    {
      "start": 1711.0,
      "end": 1713.0,
      "text": "סבבה אז אין בעיה"
    },
    {
      "start": 1713.0,
      "end": 1715.0,
      "text": "אז יפה"
    },
    {
      "start": 1715.0,
      "end": 1717.0,
      "text": "אנחנו יכולים כאן לראות"
    },
    {
      "start": 1717.0,
      "end": 1719.0,
      "text": "שמעתחלה אנחנו עושים"
    },
    {
      "start": 1719.0,
      "end": 1721.0,
      "text": "פוש ל-D-S"
    },
    {
      "start": 1721.0,
      "end": 1723.0,
      "text": "פה פל-E-S"
    },
    {
      "start": 1723.0,
      "end": 1725.0,
      "text": "זה כמו שאמרתי כי אנחנו צריכים"
    },
    {
      "start": 1725.0,
      "end": 1727.0,
      "text": "ש-E-S עצמי על הקוד סגמנט"
    },
    {
      "start": 1727.0,
      "end": 1729.0,
      "text": "כמה הבקודה מובס-W עושה"
    },
    {
      "start": 1729.0,
      "end": 1731.0,
      "text": "אם מעטיקה מד-E-S"
    },
    {
      "start": 1731.0,
      "end": 1733.0,
      "text": "לא מצביע לקוד סגמנט"
    },
    {
      "start": 1733.0,
      "end": 1735.0,
      "text": "אנחנו לא באמת יכולים להשתמש בזה נכון"
    },
    {
      "start": 1735.0,
      "end": 1737.0,
      "text": "אז"
    },
    {
      "start": 1737.0,
      "end": 1739.0,
      "text": "טכנית אנחנו יכולים להשתמש בזה"
    },
    {
      "start": 1739.0,
      "end": 1741.0,
      "text": "זה קונצמציה שנקרא תקשורת בין סורדים"
    },
    {
      "start": 1741.0,
      "end": 1743.0,
      "text": "נדבר על הבא המשך"
    },
    {
      "start": 1743.0,
      "end": 1745.0,
      "text": "אבל הכוונה שלי זה בסנירו שלנו"
    },
    {
      "start": 1745.0,
      "end": 1747.0,
      "text": "שאנחנו רוצים לשכפל קוד"
    },
    {
      "start": 1747.0,
      "end": 1749.0,
      "text": "לתוך הקוד סגמנט"
    },
    {
      "start": 1749.0,
      "end": 1751.0,
      "text": "אז בואו שנייה נעשה את"
    },
    {
      "start": 1751.0,
      "end": 1753.0,
      "text": "העליך האפר הזה אנחנו יכולים לראות כאן"
    },
    {
      "start": 1753.0,
      "end": 1755.0,
      "text": "בהרגיסטרים"
    },
    {
      "start": 1755.0,
      "end": 1757.0,
      "text": "שה-E-S מצביע על הזירה שלנו"
    },
    {
      "start": 1757.0,
      "end": 1759.0,
      "text": "ואנחנו עושים"
    },
    {
      "start": 1759.0,
      "end": 1761.0,
      "text": "בין A-X ל-DI"
    },
    {
      "start": 1761.0,
      "end": 1763.0,
      "text": "אני מניח שעברתם על זה שבוע שעבר"
    },
    {
      "start": 1763.0,
      "end": 1765.0,
      "text": "אבל A-X הוא בעצם"
    },
    {
      "start": 1765.0,
      "end": 1767.0,
      "text": "מתחיל את המשחק תמיד במנוע"
    },
    {
      "start": 1767.0,
      "end": 1769.0,
      "text": "עם הכתוב את ההתחלתית שלכם"
    },
    {
      "start": 1769.0,
      "end": 1771.0,
      "text": "מה שאני עושה כאן"
    },
    {
      "start": 1771.0,
      "end": 1773.0,
      "text": "בין A-X ל-DI אני שם ב-DI"
    },
    {
      "start": 1773.0,
      "end": 1775.0,
      "text": "את הכתוב את ההתחלתית שלי"
    },
    {
      "start": 1775.0,
      "end": 1777.0,
      "text": "ואני מוסיף ל-DI"
    },
    {
      "start": 1777.0,
      "end": 1779.0,
      "text": "את הערך 12"
    },
    {
      "start": 1779.0,
      "end": 1781.0,
      "text": "למה 12?"
    },
    {
      "start": 1781.0,
      "end": 1783.0,
      "text": "אני שמח ששאלתם"
    },
    {
      "start": 1783.0,
      "end": 1785.0,
      "text": "בעצם 12 זה מאיפה"
    },
    {
      "start": 1785.0,
      "end": 1787.0,
      "text": "שאני רוצה להתחיל את"
    },
    {
      "start": 1787.0,
      "end": 1789.0,
      "text": "התקדת מרות שאני שם את"
    },
    {
      "start": 1789.0,
      "end": 1791.0,
      "text": "את ה-12 זה בתוך"
    },
    {
      "start": 1791.0,
      "end": 1793.0,
      "text": "S-I ובואו נספר"
    },
    {
      "start": 1793.0,
      "end": 1795.0,
      "text": "אופקודים ונראה מאיפה אני מתחיל להעתיק"
    },
    {
      "start": 1795.0,
      "end": 1797.0,
      "text": "אז יש לנו כאן אופקוד 1"
    },
    {
      "start": 1797.0,
      "end": 1799.0,
      "text": "2,3,4"
    }
