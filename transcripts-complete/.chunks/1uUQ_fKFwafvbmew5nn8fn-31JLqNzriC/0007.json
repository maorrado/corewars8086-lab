{
  "source": "1uUQ_fKFwafvbmew5nn8fn-31JLqNzriC.mp4",
  "source_sha256": "ba901f95f6250bda4a21d4aba24504786994d213c63590b89e705ee6905c6488",
  "model": "small",
  "language": "he",
  "language_probability": 1,
  "start": 6300.0,
  "end": 7200.0,
  "elapsed_seconds": 745.1012244224548,
  "segments": [
    {
      "start": 6300.0,
      "end": 6302.5,
      "text": "ו-Rap, MW, אתה צריך שזה יהיה גם..."
    },
    {
      "start": 6302.5,
      "end": 6304.0,
      "text": "מרחבי חמיש."
    },
    {
      "start": 6304.0,
      "end": 6305.0,
      "text": "מובל."
    },
    {
      "start": 6305.0,
      "end": 6311.5,
      "text": "אז אם תדרוש את הצבחיים זה, יהיה לך הרבה יותר קל, כי אתה יכול לשלוט כאילו רק בבית הנמוך של הכתובת."
    },
    {
      "start": 6311.5,
      "end": 6317.0,
      "text": "כאילו, את רעיון הוא שניסה מובל-W ששולח RAP, MW."
    },
    {
      "start": 6317.0,
      "end": 6319.0,
      "text": "מובל-W ששולח בול."
    },
    {
      "start": 6319.0,
      "end": 6321.0,
      "text": "כי אם תסתכל על זה שני הכך,"
    },
    {
      "start": 6322.0,
      "end": 6327.0,
      "text": "אז כאילו יש לך כתובת הזאת, שהיא כביכול משהו עם ה-5 נניח,"
    },
    {
      "start": 6327.0,
      "end": 6331.0,
      "text": "ואז גם זה משהו עם ה-5, וגם זה משהו עם ה-5, וגם זה משהו עם ה-5."
    },
    {
      "start": 6332.0,
      "end": 6333.0,
      "text": "אהה."
    },
    {
      "start": 6335.0,
      "end": 6336.0,
      "text": "לגור?"
    },
    {
      "start": 6336.0,
      "end": 6342.0,
      "text": "כי כביכול, כביגל שזה X, אז כאילו גם שור ותכתור וגם שורה."
    },
    {
      "start": 6342.0,
      "end": 6345.0,
      "text": "כן, זה נכון, בגלל שיש שורה פה עם ה-256."
    },
    {
      "start": 6345.0,
      "end": 6347.0,
      "text": "אז זה תביא לי שיער ל-5."
    },
    {
      "start": 6347.0,
      "end": 6348.0,
      "text": "נכון."
    },
    {
      "start": 6349.0,
      "end": 6350.0,
      "text": "נכון, אה, יש לך שם?"
    },
    {
      "start": 6350.0,
      "end": 6351.0,
      "text": "כן, בטח."
    },
    {
      "start": 6351.0,
      "end": 6355.0,
      "text": "אני ראיתי הרבה קודם שהיא שמשו במובל-W,"
    },
    {
      "start": 6355.0,
      "end": 6357.0,
      "text": "ולא מובל-W."
    },
    {
      "start": 6358.0,
      "end": 6361.0,
      "text": "וכאילו, גם סבתי לב שזה יותר יעיל, לא יודע למה."
    },
    {
      "start": 6362.0,
      "end": 6364.0,
      "text": "כאילו מובל-W ואז מובל-W."
    },
    {
      "start": 6365.0,
      "end": 6366.0,
      "text": "אז זה לא בהכתר יעיל."
    },
    {
      "start": 6366.0,
      "end": 6367.0,
      "text": "אתה דורס את עצמך."
    },
    {
      "start": 6368.0,
      "end": 6370.0,
      "text": "אז זה לא בהכתר יעיל, זה כן מאפשר,"
    },
    {
      "start": 6371.0,
      "end": 6373.0,
      "text": "זה מאפשר כאילו,"
    },
    {
      "start": 6373.0,
      "end": 6376.0,
      "text": "במקום להיות בטור, שנקרא לזה טור,"
    },
    {
      "start": 6376.0,
      "end": 6378.0,
      "text": "שהוא מתרגם ל-A5,"
    },
    {
      "start": 6378.0,
      "end": 6380.0,
      "text": "זה מאפשר לך להיות ב-A3,"
    },
    {
      "start": 6380.0,
      "end": 6381.0,
      "text": "נכון שזה ישרש."
    },
    {
      "start": 6382.0,
      "end": 6383.0,
      "text": "אבל מה זה משנה כל כך?"
    },
    {
      "start": 6383.0,
      "end": 6384.0,
      "text": "יאללה."
    },
    {
      "start": 6384.0,
      "end": 6386.0,
      "text": "אוקיי, אז למה זה משנה?"
    },
    {
      "start": 6386.0,
      "end": 6388.0,
      "text": "בשנה שלי אני אכנתי איזשהו סורד."
    },
    {
      "start": 6389.0,
      "end": 6390.0,
      "text": "זה השנה האחרונה שהשתתפתי,"
    },
    {
      "start": 6390.0,
      "end": 6392.0,
      "text": "והיא קצת תצבנתי שכולם"
    },
    {
      "start": 6392.0,
      "end": 6394.0,
      "text": "כל הזמן נמצאים בטור A5."
    },
    {
      "start": 6394.0,
      "end": 6395.0,
      "text": "תבוא?"
    },
    {
      "start": 6395.0,
      "end": 6396.0,
      "text": "ראיתי, אז שנית הצייס,"
    },
    {
      "start": 6396.0,
      "end": 6398.0,
      "text": "ואתה רואה בישר בטור,"
    },
    {
      "start": 6398.0,
      "end": 6400.0,
      "text": "אתה רואה בישר בשורה."
    },
    {
      "start": 6400.0,
      "end": 6401.0,
      "text": "אז אפילו לא,"
    },
    {
      "start": 6401.0,
      "end": 6402.0,
      "text": "כאילו זה גם מנסתם עשיתי,"
    },
    {
      "start": 6402.0,
      "end": 6404.0,
      "text": "אבל מה שעשיתי זה לקחת את כל התורים"
    },
    {
      "start": 6404.0,
      "end": 6405.0,
      "text": "שהם A5"
    },
    {
      "start": 6406.0,
      "end": 6409.0,
      "text": "ולהפציץ כאילו בקפיצות של 256."
    },
    {
      "start": 6410.0,
      "end": 6411.0,
      "text": "אוקיי?"
    },
    {
      "start": 6414.0,
      "end": 6415.0,
      "text": "סגור?"
    },
    {
      "start": 6415.0,
      "end": 6416.0,
      "text": "כן."
    },
    {
      "start": 6416.0,
      "end": 6419.0,
      "text": "וזה בגדול היה אוריג את כל החבר'ה"
    },
    {
      "start": 6419.0,
      "end": 6420.0,
      "text": "שלא עשו,"
    },
    {
      "start": 6421.0,
      "end": 6423.0,
      "text": "שלא סכקו עם הסגמנט"
    },
    {
      "start": 6423.0,
      "end": 6425.0,
      "text": "או עשו מובסבי."
    },
    {
      "start": 6425.0,
      "end": 6427.0,
      "text": "אז מובסבי זה פשוט הדרך שלך,"
    },
    {
      "start": 6427.0,
      "end": 6429.0,
      "text": "כאילו לשחק עם הכתובץ שאתה נמצא."
    },
    {
      "start": 6429.0,
      "end": 6430.0,
      "text": "אפשר לסתכל לבגן לביא"
    },
    {
      "start": 6430.0,
      "end": 6432.0,
      "text": "שמסכקים עם הסגמנט, נכון?"
    },
    {
      "start": 6432.0,
      "end": 6433.0,
      "text": "כי אז אני..."
    },
    {
      "start": 6433.0,
      "end": 6434.0,
      "text": "אז אני אכנתי לך."
    },
    {
      "start": 6434.0,
      "end": 6435.0,
      "text": "נחשת את הקוודל,"
    },
    {
      "start": 6435.0,
      "end": 6436.0,
      "text": "על השורה שלי חמש."
    },
    {
      "start": 6436.0,
      "end": 6437.0,
      "text": "בדיוק, פשוט עם הסגמנט"
    },
    {
      "start": 6437.0,
      "end": 6438.0,
      "text": "אתה אין חגבולות,"
    },
    {
      "start": 6438.0,
      "end": 6440.0,
      "text": "אתה יכול כל פעם להוריד כאילו עוד, עוד, עוד, עוד."
    },
    {
      "start": 6440.0,
      "end": 6442.0,
      "text": "כאילו אתה יכול להיות תכנס בכל תור שאתה רוצה"
    },
    {
      "start": 6442.0,
      "end": 6443.0,
      "text": "אם אתה מסכק עם הסגמנט."
    },
    {
      "start": 6443.0,
      "end": 6445.0,
      "text": "כן, כי אז אתה כל פעם להוריד מהסגמנט כאילו?"
    },
    {
      "start": 6446.0,
      "end": 6448.0,
      "text": "כן, אתה מוריד אחד ומוסיף ששרה לאופסץ"
    },
    {
      "start": 6448.0,
      "end": 6449.0,
      "text": "ואתה בוא תוקטורי."
    },
    {
      "start": 6449.0,
      "end": 6450.0,
      "text": "אוקיי, כן."
    },
    {
      "start": 6450.0,
      "end": 6451.0,
      "text": "אתה..."
    },
    {
      "start": 6451.0,
      "end": 6452.0,
      "text": "תודה."
    },
    {
      "start": 6454.0,
      "end": 6455.0,
      "text": "עוד שאלות?"
    },
    {
      "start": 6469.0,
      "end": 6470.0,
      "text": "נתנכם לחשוב."
    },
    {
      "start": 6472.0,
      "end": 6474.0,
      "text": "טוב, גם יש לך משאול שאולי כבר אנו עליהם"
    },
    {
      "start": 6474.0,
      "end": 6475.0,
      "text": "ולא הבנתם,"
    },
    {
      "start": 6475.0,
      "end": 6478.0,
      "text": "או משהו גם זה ממש בקטנה שאתם חושבים,"
    },
    {
      "start": 6478.0,
      "end": 6480.0,
      "text": "תרגיש לך אופשי לשאול בשביל זה אנחנו כאן,"
    },
    {
      "start": 6480.0,
      "end": 6481.0,
      "text": "בשביל לעזור לכם,"
    },
    {
      "start": 6481.0,
      "end": 6482.0,
      "text": "בשביל לעזור לכם,"
    },
    {
      "start": 6482.0,
      "end": 6484.0,
      "text": "בנות צורדים טובים יותר כדי שתבינו,"
    },
    {
      "start": 6484.0,
      "end": 6485.0,
      "text": "כדי שתחבוע,"
    },
    {
      "start": 6485.0,
      "end": 6486.0,
      "text": "אז באמת,"
    },
    {
      "start": 6486.0,
      "end": 6487.0,
      "text": "שאם יש משהו,"
    },
    {
      "start": 6487.0,
      "end": 6488.0,
      "text": "הם המליצתי שלו."
    },
    {
      "start": 6488.0,
      "end": 6490.0,
      "text": "עדיף עכשיו, מהחפם."
    },
    {
      "start": 6490.0,
      "end": 6492.0,
      "text": "אתה יכול להעסביר עוד פעם,"
    },
    {
      "start": 6492.0,
      "end": 6493.0,
      "text": "תאמו וסבי?"
    },
    {
      "start": 6494.0,
      "end": 6495.0,
      "text": "אוקיי,"
    },
    {
      "start": 6495.0,
      "end": 6496.0,
      "text": "אני אכנתי לך,"
    },
    {
      "start": 6496.0,
      "end": 6497.0,
      "text": "מובס בי?"
    },
    {
      "start": 6498.0,
      "end": 6499.0,
      "text": "למה מובס בי?"
    },
    {
      "start": 6501.0,
      "end": 6502.0,
      "text": "מה זו עוסף?"
    },
    {
      "start": 6503.0,
      "end": 6504.0,
      "text": "מה זה מובס בי?"
    },
    {
      "start": 6506.0,
      "end": 6507.0,
      "text": "כן."
    },
    {
      "start": 6508.0,
      "end": 6509.0,
      "text": "טוב, אהבה."
    },
    {
      "start": 6509.0,
      "end": 6511.0,
      "text": "אז מובס דבלו אתה מכיר?"
    },
    {
      "start": 6512.0,
      "end": 6514.0,
      "text": "או נפתח לך את זה גם?"
    },
    {
      "start": 6514.0,
      "end": 6515.0,
      "text": "מי רואה?"
    },
    {
      "start": 6515.0,
      "end": 6516.0,
      "text": "מובס דבלו,"
    },
    {
      "start": 6516.0,
      "end": 6518.0,
      "text": "אני חוונה פותח את זה פה,"
    },
    {
      "start": 6518.0,
      "end": 6519.0,
      "text": "כדי להראות לך שגם אתה יכול,"
    },
    {
      "start": 6519.0,
      "end": 6521.0,
      "text": "תמיד לפתוח את הלכו מטאזו,"
    },
    {
      "start": 6521.0,
      "end": 6522.0,
      "text": "וזה קל ממש."
    },
    {
      "start": 6522.0,
      "end": 6523.0,
      "text": "בגדול,"
    },
    {
      "start": 6523.0,
      "end": 6525.0,
      "text": "זה לוקח וורד,"
    },
    {
      "start": 6525.0,
      "end": 6526.0,
      "text": "שתי בתים,"
    },
    {
      "start": 6526.0,
      "end": 6528.0,
      "text": "מדי ססי,"
    },
    {
      "start": 6528.0,
      "end": 6531.0,
      "text": "ודי ססי פלוס אחד,"
    },
    {
      "start": 6531.0,
      "end": 6533.0,
      "text": "ושם אותם בתוך אייס,"
    },
    {
      "start": 6533.0,
      "end": 6535.0,
      "text": "נקודתי עם די,"
    },
    {
      "start": 6535.0,
      "end": 6536.0,
      "text": "ואייס די פלוס אחד,"
    },
    {
      "start": 6536.0,
      "end": 6537.0,
      "text": "תגידו?"
    },
    {
      "start": 6538.0,
      "end": 6539.0,
      "text": "אוקיי."
    },
    {
      "start": 6539.0,
      "end": 6540.0,
      "text": "אז בסוף גם,"
    },
    {
      "start": 6540.0,
      "end": 6541.0,
      "text": "מוסיף שתיים,"
    },
    {
      "start": 6541.0,
      "end": 6542.0,
      "text": "או מחסיר משתיים,"
    },
    {
      "start": 6542.0,
      "end": 6544.0,
      "text": "אתה לא ייבא דגי אל כאילו,"
    },
    {
      "start": 6544.0,
      "end": 6546.0,
      "text": "שאני משתיבהנו עליו קודם."
    },
    {
      "start": 6549.0,
      "end": 6550.0,
      "text": "תגידו?"
    },
    {
      "start": 6550.0,
      "end": 6551.0,
      "text": "שובה."
    },
    {
      "start": 6551.0,
      "end": 6552.0,
      "text": "יש את זה,"
    },
    {
      "start": 6552.0,
      "end": 6554.0,
      "text": "אתה מבין או להסביר שוב?"
    },
    {
      "start": 6555.0,
      "end": 6557.0,
      "text": "אני אשמח לראות,"
    },
    {
      "start": 6557.0,
      "end": 6559.0,
      "text": "שסבר כאילו,"
    },
    {
      "start": 6559.0,
      "end": 6560.0,
      "text": "דוגמה,"
    },
    {
      "start": 6560.0,
      "end": 6561.0,
      "text": "בקוד."
    },
    {
      "start": 6562.0,
      "end": 6564.0,
      "text": "בוא נראה אם יש לי פה בשלוף."
    },
    {
      "start": 6565.0,
      "end": 6566.0,
      "text": "יש לך בשלוף משהו?"
    },
    {
      "start": 6566.0,
      "end": 6567.0,
      "text": "בוא נראה."
    },
    {
      "start": 6568.0,
      "end": 6569.0,
      "text": "זה הרבה."
    },
    {
      "start": 6572.0,
      "end": 6573.0,
      "text": "לא, זה לא."
    },
    {
      "start": 6574.0,
      "end": 6576.0,
      "text": "סבב, אמוולה."
    },
    {
      "start": 6576.0,
      "end": 6577.0,
      "text": "ממש איפה ככה."
    },
    {
      "start": 6580.0,
      "end": 6581.0,
      "text": "נדיר."
    },
    {
      "start": 6582.0,
      "end": 6583.0,
      "text": "מאוולה."
    },
    {
      "start": 6583.0,
      "end": 6584.0,
      "text": "אז אמרנו,"
    },
    {
      "start": 6584.0,
      "end": 6586.0,
      "text": "DSSI,"
    },
    {
      "start": 6586.0,
      "end": 6587.0,
      "text": "לוקח שתי בתים,"
    },
    {
      "start": 6587.0,
      "end": 6588.0,
      "text": "DSSI,"
    },
    {
      "start": 6589.0,
      "end": 6590.0,
      "text": "DS זה,"
    },
    {
      "start": 6591.0,
      "end": 6592.0,
      "text": "זה השרד,"
    },
    {
      "start": 6592.0,
      "end": 6594.0,
      "text": "זה מצביע על השרד ממורי."
    },
    {
      "start": 6594.0,
      "end": 6596.0,
      "text": "SI פה הוא 0,"
    },
    {
      "start": 6596.0,
      "end": 6597.0,
      "text": "אתה אומר את זה,"
    },
    {
      "start": 6597.0,
      "end": 6598.0,
      "text": "יקח את שתי בתים האלה,"
    },
    {
      "start": 6598.0,
      "end": 6599.0,
      "text": "D322,"
    },
    {
      "start": 6599.0,
      "end": 6601.0,
      "text": "וישים אותם בתוך ES."
    },
    {
      "start": 6604.0,
      "end": 6605.0,
      "text": "רגע."
    },
    {
      "start": 6609.0,
      "end": 6611.0,
