      "text": "הנה אם אתם מריצים ויט פעמיים,"
    },
    {
      "start": 6972.0,
      "end": 6974.0,
      "text": "זה מעלה לכם איזשהו קאונטר,"
    },
    {
      "start": 6976.0,
      "end": 6978.0,
      "text": "ואז הקאונטר הזה הוא"
    },
    {
      "start": 6978.0,
      "end": 6980.0,
      "text": "סטטיסטית כאילו"
    },
    {
      "start": 6982.0,
      "end": 6984.0,
      "text": "כאילו זה אחוז שלכם,"
    },
    {
      "start": 6984.0,
      "end": 6986.0,
      "text": "זה הסיכוי שלכם"
    },
    {
      "start": 6986.0,
      "end": 6988.0,
      "text": "להריץ שתי"
    },
    {
      "start": 6988.0,
      "end": 6990.0,
      "text": "עוקודים בתוך תור אחד."
    },
    {
      "start": 6990.0,
      "end": 6992.0,
      "text": "אז למה, למה זה טוב?"
    },
    {
      "start": 6992.0,
      "end": 6994.0,
      "text": "זה הכי שוב,"
    },
    {
      "start": 6994.0,
      "end": 6996.0,
      "text": "למה מהירות שלכם,"
    },
    {
      "start": 6996.0,
      "end": 6998.0,
      "text": "ואז הסיכוי שסורד יקבל"
    },
    {
      "start": 6998.0,
      "end": 7000.0,
      "text": "תור נוסף זה המהירות עצמך על כשעשה."
    },
    {
      "start": 7004.0,
      "end": 7006.0,
      "text": "למה מה?"
    },
    {
      "start": 7006.0,
      "end": 7008.0,
      "text": "איך אפשר להשתמש בזה,"
    },
    {
      "start": 7008.0,
      "end": 7010.0,
      "text": "מה ההתרון שלי השתמש בזה?"
    },
    {
      "start": 7010.0,
      "end": 7012.0,
      "text": "אז אני אכווה,"
    },
    {
      "start": 7012.0,
      "end": 7014.0,
      "text": "ויש לכם"
    },
    {
      "start": 7014.0,
      "end": 7016.0,
      "text": "קטע קולט שאתם צריכים,"
    },
    {
      "start": 7016.0,
      "end": 7018.0,
      "text": "לא יודע, לחקות לזומבי או משהו בסגנון,"
    },
    {
      "start": 7018.0,
      "end": 7020.0,
      "text": "לחקות כדי שזומבי יעשה משהו,"
    },
    {
      "start": 7020.0,
      "end": 7022.0,
      "text": "כי אתם כזה,"
    },
    {
      "start": 7022.0,
      "end": 7024.0,
      "text": "כי אתם זיהיתם שבתור ה-80"
    },
    {
      "start": 7024.0,
      "end": 7026.0,
      "text": "זומבי מכניס את"
    },
    {
      "start": 7026.0,
      "end": 7028.0,
      "text": "הכתורת של הזירה או משהו בסגנון הזה,"
    },
    {
      "start": 7028.0,
      "end": 7030.0,
      "text": "אתם יכולים להריץ,"
    },
    {
      "start": 7030.0,
      "end": 7032.0,
      "text": "עד אז זה עדיף מה שלהריץ טאמנופים."
    },
    {
      "start": 7032.0,
      "end": 7034.0,
      "text": "למרוב אני אגיד"
    },
    {
      "start": 7034.0,
      "end": 7036.0,
      "text": "שעדיף להתחיל להפציץ"
    },
    {
      "start": 7036.0,
      "end": 7038.0,
      "text": "או לעשות צטאפ להפצצות,"
    },
    {
      "start": 7038.0,
      "end": 7040.0,
      "text": "אבל לפעמים זה שימושי."
    },
    {
      "start": 7040.0,
      "end": 7042.0,
      "text": "זה עדיף על סתם לעשות נופ, בדרך כלל."
    },
    {
      "start": 7044.0,
      "end": 7046.0,
      "text": "תמיד אולי אפשר נגיד"
    },
    {
      "start": 7046.0,
      "end": 7048.0,
      "text": "לעשות קולפ, אפשר לעשות מובסדה,"
    },
    {
      "start": 7048.0,
      "end": 7050.0,
      "text": "תמיד יש דרך להפציץ את הזירה?"
    },
    {
      "start": 7050.0,
      "end": 7052.0,
      "text": "נכון."
    },
    {
      "start": 7052.0,
      "end": 7054.0,
      "text": "אז למה לבסבז את הזמן"
    },
    {
      "start": 7054.0,
      "end": 7056.0,
      "text": "לעשות וייט?"
    },
    {
      "start": 7058.0,
      "end": 7060.0,
      "text": "כאילו, בגדול זה ממש לא להספרטגיה,"
    },
    {
      "start": 7060.0,
      "end": 7062.0,
      "text": "כן? כאילו, יכול להיות שאתי"
    },
    {
      "start": 7062.0,
      "end": 7064.0,
      "text": "ככה היא נגיד"
    },
    {
      "start": 7068.0,
      "end": 7070.0,
      "text": "הרבה תורות עשי וייט,"
    },
    {
      "start": 7070.0,
      "end": 7072.0,
      "text": "ואז תגיד למסקנה שזה טוב לך,"
    },
    {
      "start": 7072.0,
      "end": 7074.0,
      "text": "כאילו,"
    },
    {
      "start": 7074.0,
      "end": 7076.0,
      "text": "באותם מדע אני יכול לשאול למה לעשות מובס"
    },
    {
      "start": 7076.0,
      "end": 7078.0,
      "text": "ולא לעשות רק אול פער."
    },
    {
      "start": 7078.0,
      "end": 7080.0,
      "text": "נכון, למה?"
    },
    {
      "start": 7080.0,
      "end": 7082.0,
      "text": "מה? למה?"
    },
    {
      "start": 7084.0,
      "end": 7086.0,
      "text": "אני אישית בן הזם של קולפארים,"
    },
    {
      "start": 7086.0,
      "end": 7088.0,
      "text": "אבל מובס דאבלו"
    },
    {
      "start": 7088.0,
      "end": 7090.0,
      "text": "אני אולי נותן בדרך על קצת יותר"
    },
    {
      "start": 7090.0,
      "end": 7092.0,
      "text": "גמישות"
    },
    {
      "start": 7094.0,
      "end": 7096.0,
      "text": "והוא יותר פשוט"
    },
    {
      "start": 7098.0,
      "end": 7100.0,
      "text": "אתה יכולה לסבר בקצרה"
    },
    {
      "start": 7100.0,
      "end": 7102.0,
      "text": "עוד פעם כל פער"
    },
    {
      "start": 7102.0,
      "end": 7104.0,
      "text": "כי לא הייתי בזום"
    },
    {
      "start": 7106.0,
      "end": 7108.0,
      "text": "כן, אני לא חושב שכדאי"
    },
    {
      "start": 7108.0,
      "end": 7110.0,
      "text": "שאני תעשה כשאני קנס את זה מהתחלה,"
    },
    {
      "start": 7110.0,
      "end": 7112.0,
      "text": "אני כן חושב ששווה"
    },
    {
      "start": 7112.0,
      "end": 7114.0,
      "text": "היא קחת המצגת והיתה קוד"
    },
    {
      "start": 7114.0,
      "end": 7116.0,
      "text": "מהמצגת פה"
    },
    {
      "start": 7118.0,
      "end": 7120.0,
      "text": "ותנסה להעריץ אותו"
    },
    {
      "start": 7120.0,
      "end": 7122.0,
      "text": "שורה שורה ככה איזה חצי שעה שבע זה"
    },
    {
      "start": 7122.0,
      "end": 7124.0,
      "text": "ונראה לזה ילך כבר מובן"
    },
    {
      "start": 7124.0,
      "end": 7126.0,
      "text": "אבל בגדול, הקונספט"
    },
    {
      "start": 7126.0,
      "end": 7128.0,
      "text": "זה שכל פער בשונה מכל"
    },
    {
      "start": 7128.0,
      "end": 7130.0,
      "text": "הוא לוקח"
    },
    {
      "start": 7130.0,
      "end": 7132.0,
      "text": "הוא כאילו דוחף למחסנית 4 הבתים"
    },
    {
      "start": 7132.0,
      "end": 7134.0,
      "text": "ולא רק שתי בתים, הוא גדוחף גם סגמנט"
    },
    {
      "start": 7134.0,
      "end": 7136.0,
      "text": "וגם אופסט"
    },
    {
      "start": 7136.0,
      "end": 7138.0,
      "text": "וככה, אם אנחנו שמים את המחסנית על הזירה"
    },
    {
      "start": 7138.0,
      "end": 7140.0,
      "text": "את הסטק סגמנט אנחנו בעצם"
    },
    {
      "start": 7140.0,
      "end": 7142.0,
      "text": "דורסים אותו עם קוד סגמנט"
    },
    {
      "start": 7142.0,
      "end": 7144.0,
      "text": "אז אנחנו הם מתחוף בתור אחד"
    },
    {
      "start": 7144.0,
      "end": 7146.0,
      "text": "4 הבתים במקום רקשני"
    },
    {
      "start": 7148.0,
      "end": 7150.0,
      "text": "שאלה"
    },
    {
      "start": 7150.0,
      "end": 7152.0,
      "text": "השתלש עברה"
    },
    {
      "start": 7152.0,
      "end": 7154.0,
      "text": "אני השתמשתי"
    },
    {
      "start": 7154.0,
      "end": 7156.0,
      "text": "בלוניקה שלנו"
    },
    {
      "start": 7156.0,
      "end": 7158.0,
      "text": "של סטוס W"
    },
    {
      "start": 7158.0,
      "end": 7160.0,
      "text": "שאני משתמש בסטוס W"
    },
    {
      "start": 7160.0,
      "end": 7162.0,
      "text": "כאילו כדי ממיועת סוג של טנק כזה"
    },
    {
      "start": 7164.0,
      "end": 7166.0,
      "text": "מה שנה עברתי"
    },
    {
      "start": 7166.0,
      "end": 7168.0,
      "text": "לכולפר"
    },
    {
      "start": 7168.0,
      "end": 7170.0,
      "text": "אבל"
    },
    {
      "start": 7170.0,
      "end": 7172.0,
      "text": "שמה שעברה אני ניסיתי הרבה"
    },
    {
      "start": 7172.0,
      "end": 7174.0,
      "text": "ולא הצלחתי להגיע למצב"
    },
    {
      "start": 7174.0,
      "end": 7176.0,
      "text": "שהסטוס W שליורים רווחים"
    },
    {
      "start": 7176.0,
      "end": 7178.0,
      "text": "ולא הייתי יכול להציג"
    },
    {
      "start": 7178.0,
      "end": 7180.0,
      "text": "דרך לעשות את זה"
    },
    {
      "start": 7182.0,
      "end": 7184.0,
      "text": "שסטוס W יסם רווחים"
    },
    {
      "start": 7184.0,
      "end": 7186.0,
      "text": "כן"
    },
    {
      "start": 7186.0,
      "end": 7188.0,
      "text": "אתה כאילו עשית הרפ סטוס W"
    },
    {
      "start": 7188.0,
      "end": 7190.0,
      "text": "או סטוס W שכל פעם"
    },
    {
      "start": 7190.0,
      "end": 7192.0,
      "text": "אז עשיתי כזה סטוס W"
    },
    {
      "start": 7192.0,
      "end": 7194.0,
      "text": "שבתוכו יש"
    },
    {
      "start": 7194.0,
      "end": 7196.0,
      "text": "אי בי וסתם פוש די"
    },
    {
      "start": 7196.0,
      "end": 7198.0,
      "text": "קסופו שייק, זה משהו כזה"
    },
    {
      "start": 7198.0,
      "end": 7200.0,
      "text": "ותקדול כנירי"
    }
  ]
}