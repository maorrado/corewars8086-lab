{
  "source": "1uUQ_fKFwafvbmew5nn8fn-31JLqNzriC.mp4",
  "source_sha256": "ba901f95f6250bda4a21d4aba24504786994d213c63590b89e705ee6905c6488",
  "model": "small",
  "language": "he",
  "language_probability": 1,
  "start": 4500.0,
  "end": 5400.0,
  "elapsed_seconds": 2355.3792295455933,
  "segments": [
    {
      "start": 4500.0,
      "end": 4509.44,
      "text": "VS, ו-POP, SS, סגור."
    },
    {
      "start": 4509.44,
      "end": 4514.3,
      "text": "ואז מה שיקרה זה שה-SS, הסטקסגמנט שם, הוא הולך להצביע על הכל סגמנט, על הזירה."
    },
    {
      "start": 4514.3,
      "end": 4518.54,
      "text": "ואז נעשה כל פער, ואופ, דחף נוער בבתים לתור אחד."
    },
    {
      "start": 4518.54,
      "end": 4525.12,
      "text": "זה הפתצה והכי הרבה בבתים שאיפה לתחוף בקודגור בעולם של הששרה ויאסרוית."
    },
    {
      "start": 4525.12,
      "end": 4527.62,
      "text": "סגור? נעדיר."
    },
    {
      "start": 4528.599999999999,
      "end": 4532.9,
      "text": "עכשיו בוא נחשוב על איך לוקחים את הטאם כל פער שעשינו,"
    },
    {
      "start": 4532.9,
      "end": 4537.04,
      "text": "באופכים את זה לשליטת הפתצה ולא רק לפעם אחת לתרוף ארבעה בתים."
    },
    {
      "start": 4537.04,
      "end": 4543.74,
      "text": "ובשביל זה אנחנו נלך, לא, שני אני שער בפיינט."
    },
    {
      "start": 4543.74,
      "end": 4551.24,
      "text": "למישהו יש רעיון איך לגרום לזה שאני אריץ אין סוף פעמים את ה..."
    },
    {
      "start": 4551.24,
      "end": 4555.24,
      "text": "או המון פעמים אני אריץ את הקולפאר הזה."
    },
    {
      "start": 4555.98,
      "end": 4559.08,
      "text": "אני לא נקפוץ בקודג של הקולפאר עצמה."
    },
    {
      "start": 4559.08,
      "end": 4562.92,
      "text": "בול אז בעצם אני אעשה כל למקום של עצמי."
    },
    {
      "start": 4562.92,
      "end": 4569.219999999999,
      "text": "ואז מה שיקרה זה שאני אריץ כל פער פה, סליחה, אני אריץ את הקולפאר,"
    },
    {
      "start": 4569.219999999999,
      "end": 4571.219999999999,
      "text": "ואז אני תרוף סגמנט ואופסט."
    },
    {
      "start": 4571.219999999999,
      "end": 4578.62,
      "text": "ה-SP שלי ירד, שבו נגיד שזה כבר הזירה כי כדרסנו את ה-SS ב-SES."
    },
    {
      "start": 4578.62,
      "end": 4584.12,
      "text": "ה-SP שלי ירד לפה ואז אני אעשה עוד קולפאר כי אני כפצתי כבר למקום של עצמי."
    },
    {
      "start": 4584.5,
      "end": 4587.0,
      "text": "אז אני תרוף עוד פעם סג באופסט."
    },
    {
      "start": 4587.0,
      "end": 4593.5,
      "text": "ה-SP ירד לפה ואני ככה אעשה אין סוף פעמים עד שאני אדרוס את עצמי בגודל."
    },
    {
      "start": 4593.5,
      "end": 4596.0,
      "text": "ועכשיו בוא נראה קודם כל כזה."
    },
    {
      "start": 4598.0,
      "end": 4600.0,
      "text": "רק שנייהן."
    },
    {
      "start": 4601.5,
      "end": 4603.5,
      "text": "שתבתי לכם קודם פה."
    },
    {
      "start": 4603.5,
      "end": 4606.0,
      "text": "שאלה בגדול ממה משה את זה."
    },
    {
      "start": 4606.0,
      "end": 4612.0,
      "text": "ועכשיו אנחנו שנייהן לעבור על הקודם ואז נראה איך זה בפועל."
    },
    {
      "start": 4612.0,
      "end": 4613.5,
      "text": "תראו מה קורה בפועל."
    },
    {
      "start": 4614.5,
      "end": 4619.5,
      "text": "אם שנייה נדבר על מה אנחנו רוצים בקודם בגדול אנחנו רוצים כמה דברים פשוטים."
    },
    {
      "start": 4619.5,
      "end": 4621.5,
      "text": "דבר ראשון שאנחנו רוצים."
    },
    {
      "start": 4621.5,
      "end": 4628.0,
      "text": "זה שהכתובת שאנחנו עושים אליה קולפאר יהיה הכתובת של הכולפאר עצמו."
    },
    {
      "start": 4628.0,
      "end": 4630.5,
      "text": "זאת אומרת אנחנו רוצים בסוף להרית הזה בלולה."
    },
    {
      "start": 4630.5,
      "end": 4634.5,
      "text": "ואנחנו נצטרך שסוגריים BX,"
    },
    {
      "start": 4634.5,
      "end": 4640.0,
      "text": "שהוא יצביע על פשוט הכתובת של השורה הזאת בזמן ריצה."
    },
    {
      "start": 4640.0,
      "end": 4645.0,
      "text": "ובשביל זה מישהו יודע איך נחשב איך נכתובת של השורה הזאת בזמן ריצה."
    },
    {
      "start": 4653.0,
      "end": 4655.0,
      "text": "אני לא רואים את הקודשי הסופטים."
    },
    {
      "start": 4656.0,
      "end": 4658.0,
      "text": "אה זה כאילו עשיתי שני טוב שלכם."
    },
    {
      "start": 4659.0,
      "end": 4660.0,
      "text": "יפה."
    },
    {
      "start": 4661.0,
      "end": 4662.0,
      "text": "טוב נדיר."
    },
    {
      "start": 4662.0,
      "end": 4664.0,
      "text": "אז אוקיי, סהר, מהתחלה."
    },
    {
      "start": 4664.0,
      "end": 4668.0,
      "text": "בגדול תחלס נדבר שנייה על הדברים שאנחנו צריכים כדי שהכול שם יעבוד."
    },
    {
      "start": 4668.0,
      "end": 4672.0,
      "text": "והדבר הראשון שאנחנו רוצים שאנחנו צריכים כדי שהכול שלנו יעבוד."
    },
    {
      "start": 4672.0,
      "end": 4676.0,
      "text": "זה שהכול פאר עצמו יקפיץ אותנו חזרה לשורה שאנחנו מריצים."
    },
    {
      "start": 4676.0,
      "end": 4679.0,
      "text": "כדי שנריץ כל פאר ואז נחזור לאותה שורה."
    },
    {
      "start": 4679.0,
      "end": 4684.0,
      "text": "ואז נריץ שוב פעם כל פאר וככה נוכל להפציץ בלולה."
    },
    {
      "start": 4686.0,
      "end": 4687.0,
      "text": "עכשיו,"
    },
    {
      "start": 4689.0,
      "end": 4695.0,
      "text": "מישהו יודע איך אני יכול לעשות שמה שהשורה הזאת הכול פאר הזה יעשה בסוף,"
    },
    {
      "start": 4695.0,
      "end": 4697.0,
      "text": "זה יקפוץ חזרה לאותה שורה."
    },
    {
      "start": 4697.0,
      "end": 4704.0,
      "text": "וככה אני בסוף מה שאני צריך לעשות זה כדי שפה יהיה את המקום של השורה שלי."
    },
    {
      "start": 4704.0,
      "end": 4706.0,
      "text": "של השורה עצמה של הכל פעם."
    },
    {
      "start": 4706.0,
      "end": 4709.0,
      "text": "מישהו יכול לחשוב איך לחשב אותך בזמן ריצה?"
    },
    {
      "start": 4713.0,
      "end": 4716.0,
      "text": "אז רק כמו שהם גדלנו לה."
    },
    {
      "start": 4716.0,
      "end": 4717.0,
      "text": "עוד פעם?"
    },
    {
      "start": 4717.0,
      "end": 4722.0,
      "text": "עכשיו, גדלנו לה להוספת זה כאילו ל-A, זה AX או משהו לא."
    },
    {
      "start": 4722.0,
      "end": 4723.0,
      "text": "כמה, מולה."
    },
    {
      "start": 4723.0,
      "end": 4725.0,
      "text": "אז זה בדיוק מה שעושים בשורה הראשון."
    },
    {
      "start": 4725.0,
      "end": 4729.0,
      "text": "וגדול לוקחים את AX, שאני מזכיר שהוא מצביע על הכתובץ של,"
    },
    {
      "start": 4729.0,
      "end": 4732.0,
      "text": "שתחלנו להרוץ בה, כאילו שהסורת שלנו להתקיל להרוץ בה."
    },
    {
      "start": 4733.0,
      "end": 4737.0,
      "text": "ומוסיפים את עורך של הכות שלנו עד השורה שאנחנו רוצים."
    },
    {
      "start": 4737.0,
      "end": 4742.0,
      "text": "זאת אומרת, לוקחים את הכתובץ של כל פאר ומורידים את הכתובץ של הסטארט."
    },
    {
      "start": 4742.0,
      "end": 4744.0,
      "text": "ובגדול מה שיצא לנו זה נגיד,"
    },
    {
      "start": 4744.0,
      "end": 4748.0,
      "text": "אם כל זה נגיד 15 בתים, בהרחה גסה,"
    },
    {
      "start": 4748.0,
      "end": 4751.0,
      "text": "אז כל פאר מינוס סטארט,"
    },
    {
      "start": 4751.0,
      "end": 4754.0,
      "text": "יתן לנו את ה-15, 15 פה,"
    },
    {
      "start": 4754.0,
      "end": 4758.0,
      "text": "ואז נוסיף את הכתובת האתחרתית שניתנו על הבזירה,"
    },
    {
      "start": 4758.0,
      "end": 4759.0,
      "text": "נוסיף לחמסר,"
    },
    {
      "start": 4759.0,
      "end": 4763.0,
      "text": "ונקבל את הכתובץ של השורה כל פאר."
    },
    {
      "start": 4763.0,
      "end": 4765.0,
      "text": "שאלות עד כאן,"
    },
    {
      "start": 4766.0,
      "end": 4768.0,
      "text": "לא הולפחת לשאול."
    },
    {
      "start": 4769.0,
      "end": 4773.0,
      "text": "ייקח לי מטי הרגמא, נכון, אחרי כך להבין את זה לבד."
    },
    {
      "start": 4775.0,
      "end": 4777.0,
      "text": "תה, בבה, אז אני ממשיך."
    },
    {
      "start": 4777.0,
      "end": 4781.0,
      "text": "אחר כך, מה שאני רוצה לעשות,"
    },
    {
      "start": 4781.0,
      "end": 4784.0,
      "text": "זה שניהן דלג על השתי שורת הבאות,"
    },
    {
      "start": 4785.0,
      "end": 4789.0,
      "text": "זה להחסן את הסגמנט"
    },
    {
      "start": 4789.0,
      "end": 4791.0,
      "text": "ואת הכתובץ עצמה,"
    },
    {
      "start": 4791.0,
      "end": 4793.0,
      "text": "בסוף אנחנו עושים כל פאר,"
    },
    {
      "start": 4793.0,
      "end": 4795.0,
      "text": "אז אמרנו שאנחנו לא קוראים רק לכתובץ,"
    },
    {
      "start": 4795.0,
      "end": 4798.0,
      "text": "אנחנו קוראים, אנחנו לא קוראים רק לאוכסט,"
    },
    {
      "start": 4798.0,
      "end": 4800.0,
      "text": "אנחנו קוראים גם לסגמנט."
    },
    {
      "start": 4800.0,
      "end": 4804.0,
      "text": "ולכן אנחנו נצטרך לשים בביקס פלוס שתיים,"
    },
    {
      "start": 4804.0,
      "end": 4806.0,
      "text": "כי אנחנו קוראים אחרי זה לסוגרים ביקס,"
    },
    {
      "start": 4806.0,
      "end": 4808.0,
      "text": "אנחנו עושים לשים בביקס פלוס שתיים"
    },
    {
      "start": 4808.0,
      "end": 4810.0,
      "text": "את הסגמנט שאנחנו רוצים לחזור אליו,"
    },
    {
      "start": 4810.0,
      "end": 4812.0,
      "text": "שמינוס טעם בקולט סגמנט,"
    },
    {
      "start": 4812.0,
      "end": 4814.0,
      "text": "ואנחנו רוצים לשים בסוגרים ביקס"
    },
    {
      "start": 4814.0,
      "end": 4817.0,
      "text": "את האופסט של השורה עצמה,"
    },
    {
      "start": 4817.0,
      "end": 4819.0,
      "text": "בתוך הקולט סגמנט."
    },
    {
      "start": 4819.0,
      "end": 4822.0,
      "text": "סגור, שאלות, למה אנחנו עושים את זה?"
    },
    {
      "start": 4824.0,
      "end": 4826.0,
      "text": "היא, דרך אצל ראשון, אני לא עושים את זה,"
    },
    {
      "start": 4826.0,
      "end": 4827.0,
      "text": "לא לא לא, מה שאתה נראית."
    },
    {
      "start": 4827.0,
      "end": 4829.0,
      "text": "ביתה, אז בגדול מה שקורה,"
    },
    {
      "start": 4829.0,
      "end": 4833.0,
      "text": "זה שאנחנו אחרי עושים כל פאר סוגרים ביקס, נכון?"
    },
    {
      "start": 4834.0,
      "end": 4835.0,
      "text": "כן."
    },
    {
      "start": 4835.0,
      "end": 4838.0,
      "text": "מעולה, מה כל פאר סוגרים ביקס עושה?"
    },
    {
      "start": 4838.0,
      "end": 4841.0,
      "text": "הוא לוקח מביקס פלוס שתיים,"
    },
    {
      "start": 4841.0,
      "end": 4843.0,
      "text": "כאילו את הסגמנט עצמו,"
    },
    {
      "start": 4844.0,
      "end": 4846.0,
      "text": "לוקח מביקס את האופסט,"
    },
    {
      "start": 4846.0,
      "end": 4848.0,
      "text": "ואז קופץ ל..."
    },
    {
      "start": 4848.0,
      "end": 4850.0,
      "text": "הוא כאילו, הכתובת שהוא יקפוץ עליו,"
    },
    {
      "start": 4850.0,
      "end": 4851.0,
      "text": "זה בסוף"
    },
    {
      "start": 4852.0,
      "end": 4856.0,
      "text": "ביקס פלוס שתיים,"
    },
    {
      "start": 4857.0,
      "end": 4859.0,
      "text": "נשים פה גורד,"
    },
    {
      "start": 4860.0,
      "end": 4861.0,
      "text": "נכון?"
    },
    {
      "start": 4861.0,
      "end": 4863.0,
      "text": "נקודותיים ביקס."
    },
    {
      "start": 4863.0,
      "end": 4865.0,
      "text": "תגעו?"
    },
    {
      "start": 4865.0,
      "end": 4866.0,
      "text": "כן."
    },
    {
      "start": 4866.0,
      "end": 4868.0,
      "text": "זה בסוף כאילו לא מה שיקרם בפורי הקליים,"
    },
    {
      "start": 4868.0,
      "end": 4871.0,
      "text": "קודס מה... זה, סבב, יש?"
    },
    {
      "start": 4872.0,
      "end": 4874.0,
      "text": "כן, אז תראו בזה."
    },
    {
      "start": 4874.0,
      "end": 4875.0,
      "text": "מה?"
    },
    {
      "start": 4875.0,
      "end": 4876.0,
      "text": "נדי, עכשיו,"
    },
    {
      "start": 4877.0,
      "end": 4879.0,
      "text": "בשביל,"
    },
    {
      "start": 4879.0,
      "end": 4881.0,
      "text": "שאנחנו לא..."
    },
    {
      "start": 4881.0,
      "end": 4883.0,
      "text": "אמר פה, נראה לי רון פודם,"
    },
    {
      "start": 4883.0,
      "end": 4886.0,
      "text": "בשביל שאנחנו לא נשמור את הכתובת שלנו,"
    },
    {
      "start": 4886.0,
      "end": 4888.0,
      "text": "את ה-CSAX הזה,"
    },
    {
      "start": 4888.0,
      "end": 4889.0,
      "text": "בתוך הזירה,"
    },
    {
      "start": 4889.0,
      "end": 4892.0,
      "text": "אנחנו נצטרך שה-DS שלנו"
    },
    {
      "start": 4892.0,
      "end": 4894.0,
      "text": "יצביע על איזשהו אזור פרטי."
    },
    {
      "start": 4894.0,
      "end": 4897.0,
      "text": "פה ספציפית, בחרנו לשמור את הכתובת"
    },
    {
      "start": 4897.0,
      "end": 4898.0,
      "text": "שאנחנו רוצים לקפוץ עליה,"
    },
    {
      "start": 4898.0,
      "end": 4901.0,
      "text": "בחרנו לשמור את ה-BXTASEGMAN,"
    },
    {
      "start": 4901.0,
      "end": 4904.0,
      "text": "באזור זיכרון המשותף של בין הסורדים,"
    },
    {
      "start": 4904.0,
      "end": 4905.0,
      "text": "שהוא גם פרטי לנו."
    },
    {
      "start": 4905.0,
      "end": 4907.0,
      "text": "אז מה שעושים פה זה שעושים PUSH-IS,"
    },
    {
      "start": 4907.0,
      "end": 4909.0,
      "text": "POP-DS,"
    },
    {
      "start": 4910.0,
      "end": 4912.0,
      "text": "MOVE-BIX-50, זה סתם"
    },
    {
      "start": 4912.0,
      "end": 4914.0,
      "text": "לשמור את זה בקטובת 50,"
    },
    {
      "start": 4914.0,
      "end": 4916.0,
      "text": "לא באמת צריך לך לדבר הזה,"
    },
    {
      "start": 4916.0,
      "end": 4918.0,
      "text": "אפילו נוריד את זה."
    },
    {
      "start": 4919.0,
      "end": 4921.0,
      "text": "אז PUSH-IS POP-DS,"
    },
    {
      "start": 4921.0,
      "end": 4923.0,
      "text": "ואז בעצם פה אנחנו מחסנים"
    },
    {
      "start": 4923.0,
      "end": 4925.0,
      "text": "בשארד ממורי שלנו"
    },
    {
      "start": 4925.0,
      "end": 4927.0,
      "text": "את הכתובת וה-Segman"
    },
    {
      "start": 4927.0,
      "end": 4929.0,
      "text": "של השורה הזאת."
    },
    {
      "start": 4929.0,
      "end": 4931.0,
      "text": "תגור?"
    },
    {
      "start": 4934.0,
      "end": 4935.0,
      "text": "רגע,"
    },
    {
      "start": 4935.0,
      "end": 4937.0,
      "text": "אם אני בעצם כותב כל הזמן"
    },
    {
      "start": 4937.0,
      "end": 4939.0,
      "text": "את המקום שלי על המקרה שלך,"
    },
    {
      "start": 4939.0,
      "end": 4941.0,
      "text": "מה זה איך פתלים, אני כותב אותו בפעם."
    },
    {
      "start": 4942.0,
      "end": 4945.0,
      "text": "אז הסיבה היא שבזמן ריצה"
    },
    {
      "start": 4945.0,
      "end": 4948.0,
      "text": "אתה כל פעם תפנה לכתובת סוגריים BX,"
    },
    {
      "start": 4948.0,
      "end": 4949.0,
      "text": "אוקיי?"
    },
    {
      "start": 4950.0,
      "end": 4952.0,
      "text": "ואם במקרה מישהו ידרוס לך"
    },
    {
      "start": 4952.0,
      "end": 4954.0,
      "text": "את מה שעשית פה,"
    },
    {
      "start": 4954.0,
      "end": 4956.0,
      "text": "אז תקפוץ פשוט למקום לא טוב."
    },
    {
      "start": 4956.0,
      "end": 4957.0,
      "text": "אתה רוצה לשמור?"
    },
    {
      "start": 4957.0,
      "end": 4958.0,
      "text": "אוקיי."
    },
    {
      "start": 4960.0,
      "end": 4962.0,
      "text": "כן, כאילו זה בסוף מה שאתה הולך להעריץ,"
    },
    {
      "start": 4962.0,
      "end": 4964.0,
      "text": "זה כאילו, הרבה בתים האלה."
    },
    {
      "start": 4965.0,
      "end": 4966.0,
      "text": "וייתה דבר."
    },
    {
      "start": 4966.0,
      "end": 4967.0,
      "text": "נדיע."
    },
    {
      "start": 4968.0,
      "end": 4970.0,
      "text": "לבסוף, אחרי שנשמור באמת"
    },
    {
      "start": 4970.0,
      "end": 4972.0,
      "text": "את ה-CSAX שלנו,"
    },
    {
      "start": 4972.0,
      "end": 4974.0,
      "text": "אנחנו נצליח להכין"
    },
    {
      "start": 4974.0,
      "end": 4976.0,
      "text": "את הסטאפ"
    },
    {
      "start": 4976.0,
      "end": 4978.0,
      "text": "CSAX שלנו,"
    },
    {
      "start": 4978.0,
      "end": 4980.0,
      "text": "כך אנחנו נצליח להפוך את ה-SS"
    },
    {
      "start": 4980.0,
      "end": 4981.0,
      "text": "שלנו לצביע על CSAX,"
    },
    {
      "start": 4981.0,
      "end": 4982.0,
      "text": "כדי שההפצצות שלנו,"
    },
    {
      "start": 4982.0,
      "end": 4984.0,
      "text": "הרבה בתים שאנחנו תרפים כל פעם,"
    },
    {
      "start": 4984.0,
      "end": 4985.0,
      "text": "שזה הסגמנט אופסט,"
    },
    {
      "start": 4985.0,
      "end": 4987.0,
      "text": "ילכו לזירה במקום לסטאפ סגמנט."
    },
    {
      "start": 4987.0,
      "end": 4989.0,
      "text": "זה מה שדיברנו קודם,"
    },
    {
      "start": 4989.0,
      "end": 4991.0,
      "text": "כשחלפנו את הסטאפ סגמנט"
    },
    {
      "start": 4991.0,
      "end": 4993.0,
      "text": "בערך של CSAX."
    },
    {
      "start": 4993.0,
      "end": 4995.0,
      "text": "ואז מה שקורה,"
    },
    {
      "start": 4995.0,
      "end": 4997.0,
      "text": "זה שעושים פוש CSAX"
    },
    {
      "start": 4997.0,
      "end": 4998.0,
      "text": "פופ-SS,"
    },
    {
      "start": 4998.0,
      "end": 4999.0,
      "text": "ואז בעצם הסטאפ"
    },
    {
      "start": 4999.0,
      "end": 5001.0,
      "text": "מצביע על הזירה עצמה."
    },
    {
      "start": 5002.0,
      "end": 5005.0,
      "text": "ועושים מוב SP-AX"
    },
    {
      "start": 5005.0,
      "end": 5006.0,
      "text": "ולמה עושים את זה?"
    },
    {
      "start": 5006.0,
      "end": 5008.0,
      "text": "מישהו יכול לחשוב על למה לעשות דבר כזה?"
    },
    {
      "start": 5013.0,
      "end": 5015.0,
      "text": "מה ISP בפועל,"
    },
    {
      "start": 5015.0,
      "end": 5018.0,
      "text": "על מה ISP משפיע בדולמות של כל פעם,"
    },
    {
      "start": 5018.0,
      "end": 5019.0,
      "text": "של הפצצות?"
    },
    {
      "start": 5021.0,
      "end": 5022.0,
      "text": "איפה מתחילי כתוב?"
    },
    {
      "start": 5023.0,
      "end": 5025.0,
      "text": "מה זה אומר בפועל?"
    },
    {
      "start": 5026.0,
      "end": 5027.0,
      "text": "הוא עושה מחשב..."
    },
    {
      "start": 5027.0,
      "end": 5030.0,
      "text": "אני רוצה שהוא יצביע על הראש של ההתחלה של חסות."
    },
    {
      "start": 5030.0,
      "end": 5031.0,
      "text": "למה עבור על AX?"
    },
    {
      "start": 5031.0,
      "end": 5034.0,
      "text": "למה לא על AX-plus הגודל של הקוד?"
    },
    {
      "start": 5035.0,
      "end": 5037.0,
      "text": "כסת דרך טובה, כושב שכחן."
    },
    {
      "start": 5037.0,
      "end": 5038.0,
      "text": "למה אבל?"
    },
    {
      "start": 5039.0,
      "end": 5040.0,
      "text": "אתה רוצה להתחיל מתחילי את הקודשך"
    },
    {
      "start": 5040.0,
      "end": 5042.0,
      "text": "והמחסנית הולך עצמו לה."
    },
    {
      "start": 5042.0,
      "end": 5043.0,
      "text": "המחסנית בידיוק."
    },
    {
      "start": 5043.0,
      "end": 5045.0,
      "text": "ISP כל פעם יורד בעבר."
    },
    {
      "start": 5046.0,
      "end": 5047.0,
      "text": "וכשעושים כל פעם,"
    },
    {
      "start": 5047.0,
      "end": 5048.0,
      "text": "ISP כל פעם ירד בעבר,"
    },
    {
      "start": 5048.0,
      "end": 5050.0,
      "text": "כי אנחנו דוחפים עבר בתים כל פעם."
    },
    {
      "start": 5052.0,
      "end": 5053.0,
      "text": "ואז מה שיקרה זה,"
    },
    {
      "start": 5053.0,
      "end": 5055.0,
      "text": "שאנחנו נשים את ISP"
    },
    {
      "start": 5055.0,
      "end": 5056.0,
      "text": "על התחלה של הקודש שלנו,"
    },
    {
      "start": 5056.0,
      "end": 5058.0,
      "text": "ואז אנחנו נתחיל להפתיד זכורה."
    },
    {
      "start": 5058.0,
      "end": 5060.0,
      "text": "ובוא נראה שנייה איך הדבר הזה מתפקד."
    },
    {
      "start": 5061.0,
      "end": 5062.0,
      "text": "באמת,"
    },
    {
      "start": 5062.0,
      "end": 5064.0,
      "text": "לוקרים את AX"
    },
    {
      "start": 5064.0,
      "end": 5065.0,
      "text": "אוקיי?"
    },
    {
      "start": 5065.0,
      "end": 5067.0,
      "text": "AX מצביע על FFF9,"
    },
    {
      "start": 5067.0,
      "end": 5071.0,
      "text": "שזה באמת התחלה של הקודש שלנו."
    },
    {
      "start": 5071.0,
      "end": 5074.0,
      "text": "מוסיפים לו כל פעם מינוס start,"
    },
    {
      "start": 5074.0,
      "end": 5077.0,
      "text": "שזה עכשיו F1 F7"
    },
    {
      "start": 5077.0,
      "end": 5079.0,
      "text": "וזה באמת הכתובת"
    },
    {
      "start": 5080.0,
      "end": 5082.0,
      "text": "של הכול פעם עצמו."
    },
    {
      "start": 5082.0,
      "end": 5084.0,
      "text": "ועכשיו AX בעצם מצביע,"
    },
    {
      "start": 5084.0,
      "end": 5086.0,
      "text": "יש לו תארך של הכתובת של כל פעם."
    },
    {
      "start": 5086.0,
      "end": 5088.0,
      "text": "ואז בעצם לוקרים את IS,"
    },
    {
      "start": 5088.0,
      "end": 5090.0,
      "text": "דוחפים אותו לדיס."
    },
    {
      "start": 5090.0,
      "end": 5091.0,
      "text": "עכשיו,"
    },
    {
      "start": 5091.0,
      "end": 5093.0,
      "text": "הDS שאני מצביע על ה-SharedMemory."
    },
    {
      "start": 5093.0,
      "end": 5096.0,
      "text": "ואז אנחנו מחסנים בתוך ה-SharedMemory,"
    },
    {
      "start": 5096.0,
      "end": 5097.0,
      "text": "זה ממש תכף יראו את זה פה,"
    },
    {
      "start": 5097.0,
      "end": 5099.0,
      "text": "אנחנו מחסנים פעם ראשון לטסי-S,"
    },
    {
      "start": 5099.0,
      "end": 5100.0,
      "text": "אופ,"
    },
    {
      "start": 5100.0,
      "end": 5101.0,
      "text": "ופעם שנייה,"
    },
    {
      "start": 5101.0,
      "end": 5102.0,
      "text": "מחסנים את AX."
    },
    {
      "start": 5102.0,
      "end": 5103.0,
      "text": "וע הנה פה,"
    },
    {
      "start": 5103.0,
      "end": 5105.0,
      "text": "יש לנו גם את הסגמנט בבי X פלוש 2,"
    },
    {
      "start": 5106.0,
      "end": 5108.0,
      "text": "ויש לנו את ה-Offset"
    },
    {
      "start": 5108.0,
      "end": 5110.0,
      "text": "ב..."
    },
    {
      "start": 5110.0,
      "end": 5112.0,
      "text": "בי X פשוט."
    },
    {
      "start": 5112.0,
      "end": 5113.0,
      "text": "עכשיו ה-Offset,"
    },
    {
      "start": 5113.0,
      "end": 5114.0,
      "text": "זה מולב,"
    },
    {
      "start": 5114.0,
      "end": 5115.0,
      "text": "שזה ה-Offset,"
    },
    {
      "start": 5115.0,
      "end": 5117.0,
      "text": "זה ממש הערך של השורה כל פעם."
    },
    {
      "start": 5117.0,
      "end": 5118.0,
      "text": "זכר זה כשאנחנו נקרא לזה,"
    },
    {
      "start": 5118.0,
      "end": 5120.0,
      "text": "זה כפוץ חזרה לפה."
    },
    {
      "start": 5120.0,
      "end": 5121.0,
      "text": "מאולה."
    },
    {
      "start": 5121.0,
      "end": 5123.0,
      "text": "עכשיו אנחנו ניקח את ה-CS,"
    },
    {
      "start": 5123.0,
      "end": 5124.0,
      "text": "נדרוס אותו באסס,"
    },
    {
      "start": 5124.0,
      "end": 5127.0,
      "text": "ובעצם הנה עכשיו האסס שאני מצביע על ההזירה,"
    },
    {
      "start": 5127.0,
      "end": 5129.0,
      "text": "על איך יש איקס אלה."
    },
    {
      "start": 5129.0,
      "end": 5132.0,
      "text": "נשים את ה-AX,"
    },
    {
      "start": 5132.0,
      "end": 5134.0,
      "text": "נעשה לו סטה פלטך לה."
    },
    {
      "start": 5134.0,
      "end": 5136.0,
      "text": "עכשיו AX יצביע ממש על החלק פה."
    },
    {
      "start": 5136.0,
      "end": 5138.0,
      "text": "אבל לא עדיף לעשות המובס ב-AX,"
    },
    {
      "start": 5138.0,
      "end": 5140.0,
      "text": "לפני שאני משנה את AX."
    },
    {
      "start": 5141.0,
      "end": 5143.0,
      "text": "למה את חלם?"
    },
    {
      "start": 5143.0,
      "end": 5144.0,
      "text": "יש מישהו יצלו,"
    },
    {
      "start": 5144.0,
      "end": 5147.0,
      "text": "שאני לא רוצה להתקוף את הקוד של עצמי."
    },
    {
      "start": 5148.0,
      "end": 5150.0,
      "text": "אז א' כל תצודק,"
    },
    {
      "start": 5150.0,
      "end": 5152.0,
      "text": "יש לך רעון אפילו איך לעזוב את זה עוד יותר טוב?"
    },
    {
      "start": 5153.0,
      "end": 5154.0,
      "text": "למכינת..."
    },
    {
      "start": 5154.0,
      "end": 5156.0,
      "text": "כשאנחנו נעשה לה איקס,"
    },
    {
      "start": 5156.0,
      "end": 5158.0,
      "text": "זה לא יודע,"
    },
    {
      "start": 5158.0,
      "end": 5159.0,
      "text": "לאוריד מן הוא,"
    },
    {
      "start": 5159.0,
      "end": 5161.0,
      "text": "איזה שווה מותר שוק הזה לא."
    },
    {
      "start": 5161.0,
      "end": 5163.0,
      "text": "אז בגדול כן,"
    },
    {
      "start": 5163.0,
      "end": 5166.0,
      "text": "לאוריד את המרחק שלך"
    },
    {
      "start": 5166.0,
      "end": 5168.0,
      "text": "שמובטח לך בין סורד של הדתי,"
    },
    {
      "start": 5168.0,
      "end": 5169.0,
      "text": "א' א' 24,"
    },
    {
      "start": 5169.0,
      "end": 5170.0,
      "text": "פלוס ה-12 של הקוד?"
    },
    {
      "start": 5170.0,
      "end": 5172.0,
      "text": "המבטח שמורחק,"
    },
    {
      "start": 5172.0,
      "end": 5174.0,
      "text": "זה 5.12 בין סורדים,"
    },
    {
      "start": 5174.0,
      "end": 5176.0,
      "text": "פלוס הגודל של הקוד,"
    },
    {
      "start": 5176.0,
      "end": 5178.0,
      "text": "מהוולי שרוצים לדעת?"
    },
    {
      "start": 5178.0,
      "end": 5180.0,
      "text": "מהוולי, אז אפשר באמת"
    },
    {
      "start": 5180.0,
      "end": 5181.0,
      "text": "לחשב את זה,"
    },
    {
      "start": 5181.0,
      "end": 5183.0,
      "text": "כאילו הרבה יותר אופטימלי"
    },
    {
      "start": 5183.0,
      "end": 5185.0,
      "text": "ולעשות את זה יותר טוב."
    },
    {
      "start": 5185.0,
      "end": 5187.0,
      "text": "עכשיו, אם אנחנו"
    },
    {
      "start": 5188.0,
      "end": 5190.0,
      "text": "נסתכל שנייה,"
    },
    {
      "start": 5190.0,
      "end": 5192.0,
      "text": "נעשה זום קצת במפה,"
    },
    {
      "start": 5193.0,
      "end": 5195.0,
      "text": "ונתחיל להפסיץ,"
    },
    {
      "start": 5195.0,
      "end": 5196.0,
      "text": "אנחנו נראה שאינס,"
    },
    {
      "start": 5196.0,
      "end": 5197.0,
      "text": "סצנו פה,"
    },
    {
      "start": 5197.0,
      "end": 5200.0,
      "text": "ממש אתכם להפסיץ את..."
    },
    {
      "start": 5200.0,
      "end": 5202.0,
      "text": "את זה הסגמנט,"
    },
    {
      "start": 5202.0,
      "end": 5204.0,
      "text": "זה האופסצ,"
    },
    {
      "start": 5204.0,
      "end": 5206.0,
      "text": "ואז נעשה עוד צעד,"
    },
    {
      "start": 5206.0,
      "end": 5208.0,
      "text": "וזה ידרוס גם פה,"
    },
    {
      "start": 5208.0,
      "end": 5210.0,
      "text": "וגם,"
    },
    {
      "start": 5210.0,
      "end": 5212.0,
      "text": "נזיז פה את זה,"
    },
    {
      "start": 5212.0,
      "end": 5214.0,
      "text": "ואם נתחיל להפסיץ"
    },
    {
      "start": 5214.0,
      "end": 5216.0,
      "text": "ברצף,"
    },
    {
      "start": 5216.0,
      "end": 5217.0,
      "text": "אז בגלל זה יראה ככה,"
    },
    {
      "start": 5217.0,
      "end": 5219.0,
      "text": "כשכל פעם אנחנו עושים כל פר,"
    },
    {
      "start": 5220.0,
      "end": 5221.0,
      "text": "אגן,"
    },
    {
      "start": 5221.0,
      "end": 5223.0,
      "text": "אנחנו עושים לפה,"
    },
    {
      "start": 5223.0,
      "end": 5224.0,
      "text": "אנחנו עושים כל פר,"
    },
    {
      "start": 5224.0,
      "end": 5225.0,
      "text": "אנחנו עושים כל פר"
    },
    {
      "start": 5225.0,
      "end": 5227.0,
      "text": "לסוגרים BX,"
    },
    {
      "start": 5227.0,
      "end": 5229.0,
      "text": "סוגרים BX זה בגלל,"
    },
    {
      "start": 5229.0,
      "end": 5230.0,
      "text": "מצביע,"
    },
    {
      "start": 5230.0,
      "end": 5231.0,
      "text": "כאילו הוא לוקח בגלל"
    },
    {
      "start": 5231.0,
      "end": 5233.0,
      "text": "סגמנט,"
    },
    {
      "start": 5233.0,
      "end": 5234.0,
      "text": "הוא לוקח פה F6-0,"
    },
    {
      "start": 5234.0,
      "end": 5235.0,
      "text": "ו-0.7, F1,"
    },
    {
      "start": 5235.0,
      "end": 5237.0,
      "text": "שזה הכתובת של הכל פער עצמו,"
    },
    {
      "start": 5237.0,
      "end": 5240.0,
      "text": "וממשיך להפסיץ פשוט"
    },
    {
      "start": 5240.0,
      "end": 5241.0,
      "text": "כופץ לעצמו,"
    },
    {
      "start": 5241.0,
      "end": 5243.0,
      "text": "כל פעם כותב 4 בתים בזירה,"
    },
    {
      "start": 5243.0,
      "end": 5245.0,
      "text": "שאם נסתכל מה בתים שהוא כותב,"
    },
    {
      "start": 5245.0,
      "end": 5247.0,
      "text": "אז זה בעצם,"
    },
    {
      "start": 5247.0,
      "end": 5248.0,
      "text": "אגן, הנה,"
    },
    {
      "start": 5248.0,
      "end": 5249.0,
      "text": "זה בעצם F6-0"
    },
    {
      "start": 5249.0,
      "end": 5250.0,
      "text": "בליטלנדיאן,"
    },
    {
      "start": 5250.0,
      "end": 5253.0,
      "text": "ואז F1-F9,"
    },
    {
      "start": 5253.0,
      "end": 5254.0,
      "text": "שזה כאילו,"
    },
    {
      "start": 5254.0,
      "end": 5255.0,
      "text": "בגלל שעושים כל פר,"
    },
    {
      "start": 5255.0,
      "end": 5256.0,
      "text": "אז הערך שנתחוף"
    },
    {
      "start": 5256.0,
      "end": 5257.0,
      "text": "לא יהיה בדיוק"
    },
    {
      "start": 5257.0,
      "end": 5258.0,
      "text": "הכתובת של הפקודה שלנו,"
    },
    {
      "start": 5258.0,
      "end": 5259.0,
      "text": "היה הפקודה שלנו,"
    },
    {
      "start": 5259.0,
      "end": 5260.0,
      "text": "פלוס,"
    },
    {
      "start": 5260.0,
      "end": 5261.0,
      "text": "כאילו,"
    },
    {
      "start": 5261.0,
      "end": 5262.0,
      "text": "הפקודתי,"
    },
    {
      "start": 5262.0,
      "end": 5263.0,
      "text": "בפתובת שאליה,"
    },
    {
      "start": 5263.0,
      "end": 5264.0,
      "text": "אם יכול היינו,"
    },
    {
      "start": 5264.0,
      "end": 5265.0,
      "text": "אמורים לחזור,"
    },
    {
      "start": 5265.0,
      "end": 5266.0,
      "text": "אם זה היה פונקציה אמיתית."
    },
    {
      "start": 5266.0,
      "end": 5267.0,
      "text": "זה בעצם,"
    },
    {
      "start": 5267.0,
      "end": 5269.0,
      "text": "הפקוד אחד אחרין."
    },
    {
      "start": 5269.0,
      "end": 5272.0,
      "text": "שאלות עד כאן?"
    },
    {
      "start": 5272.0,
      "end": 5274.0,
      "text": "כן, שיש שעת,"
    },
    {
      "start": 5274.0,
      "end": 5276.0,
      "text": "יכול להוראות רגע את הקוד?"
    },
    {
      "start": 5276.0,
      "end": 5278.0,
      "text": "בטח."
    },
    {
      "start": 5281.0,
      "end": 5282.0,
      "text": "הבנתי, כאילו,"
    },
    {
      "start": 5282.0,
      "end": 5283.0,
      "text": "את הקוד,"
    },
    {
      "start": 5283.0,
      "end": 5284.0,
      "text": "אבל הבנתי,"
    },
    {
      "start": 5284.0,
      "end": 5285.0,
      "text": "למה הוא בעצם,"
    },
    {
      "start": 5285.0,
      "end": 5286.0,
      "text": "מתחיל שום אחר?"
    },
    {
      "start": 5287.0,
      "end": 5289.0,
      "text": "נדיר, מעולה."
    },
    {
      "start": 5289.0,
      "end": 5290.0,
      "text": "מה קורה?"
    },
    {
      "start": 5290.0,
      "end": 5292.0,
      "text": "מה קורה כשאני עושה כל פר?"
    },
    {
      "start": 5296.0,
      "end": 5297.0,
      "text": "הוא הולך לבייקס,"
    },
    {
      "start": 5297.0,
      "end": 5298.0,
      "text": "וכאילו, קורא ממנו?"
    },
    {
      "start": 5300.0,
      "end": 5301.0,
      "text": "כשאני עושה כל פר,"
    },
    {
      "start": 5301.0,
      "end": 5302.0,
      "text": "אגן,"
    },
    {
      "start": 5302.0,
      "end": 5303.0,
      "text": "ככה תחתו לכם לפיינט,"
    },
    {
      "start": 5303.0,
      "end": 5304.0,
      "text": "אז הוא הולך לבייקס,"
    },
    {
      "start": 5304.0,
      "end": 5305.0,
      "text": "מה הוא קורה ממנו?"
    },
    {
      "start": 5307.0,
      "end": 5309.0,
      "text": "את הכתובת,"
    },
    {
      "start": 5309.0,
      "end": 5310.0,
      "text": "כאילו."
    },
    {
      "start": 5311.0,
      "end": 5312.0,
      "text": "כמה קורה?"
    },
    {
      "start": 5312.0,
      "end": 5313.0,
      "text": "כאילו,"
    },
    {
      "start": 5314.0,
      "end": 5315.0,
      "text": "עושתי מוער בה."
    },
    {
      "start": 5315.0,
      "end": 5316.0,
      "text": "עושתי מוער בה."
    },
    {
      "start": 5316.0,
      "end": 5317.0,
      "text": "עושפי, לא?"
    },
    {
      "start": 5317.0,
      "end": 5318.0,
      "text": "עוד פעם?"
    },
    {
      "start": 5318.0,
      "end": 5319.0,
      "text": "עושפי, לא?"
    },
    {
      "start": 5321.0,
      "end": 5322.0,
      "text": "אז, אז שני, רגע,"
    },
    {
      "start": 5322.0,
      "end": 5323.0,
      "text": "כשאני עושה, רגע,"
    },
    {
      "start": 5323.0,
      "end": 5324.0,
      "text": "נחזר שני על הקוד,"
    },
    {
      "start": 5324.0,
      "end": 5325.0,
      "text": "כי זה אני הרבה, כן חשוב."
    },
    {
      "start": 5326.0,
      "end": 5328.0,
      "text": "כשאני עושה כל פר לבייקס,"
    },
    {
      "start": 5328.0,
      "end": 5330.0,
      "text": "אמרנו שהוא יקרא לא שתי בתים,"
    },
    {
      "start": 5330.0,
      "end": 5331.0,
      "text": "שתי בתים הוא יקרא כשאנחנו עושים"
    },
    {
      "start": 5331.0,
      "end": 5332.0,
      "text": "כל רגיל,"
    },
    {
      "start": 5332.0,
      "end": 5333.0,
      "text": "ופה אנחנו..."
    },
    {
      "start": 5333.0,
      "end": 5334.0,
      "text": "אז ארבע."
    },
    {
      "start": 5334.0,
      "end": 5335.0,
      "text": "פה בידיוק,"
    },
    {
      "start": 5335.0,
      "end": 5336.0,
      "text": "אנחנו עושים לעשות כל סגמנטחף."
    },
    {
      "start": 5336.0,
      "end": 5338.0,
      "text": "אנחנו נעשה ארבע בתים,"
    },
    {
      "start": 5339.0,
      "end": 5340.0,
      "text": "ורגע, רק שני,"
    },
    {
      "start": 5340.0,
      "end": 5341.0,
      "text": "אני אמשיך פה."
    },
    {
      "start": 5344.0,
      "end": 5345.0,
      "text": "רגע, סליחה."
    },
    {
      "start": 5351.0,
      "end": 5352.0,
      "text": "נדיר."
    },
    {
      "start": 5352.0,
      "end": 5353.0,
      "text": "נצא רגע."
    },
    {
      "start": 5353.0,
      "end": 5355.0,
      "text": "אז בעצם ארבע בתים,"
    },
    {
      "start": 5355.0,
      "end": 5357.0,
      "text": "ותזכיר לי שני עמאי את השאלה,"
    },
    {
      "start": 5357.0,
      "end": 5359.0,
      "text": "למה עושה את זה אחורה, כאילו?"
    },
    {
      "start": 5359.0,
      "end": 5360.0,
      "text": "כן."
    },
    {
      "start": 5360.0,
      "end": 5361.0,
      "text": "מעולה."
    },
    {
      "start": 5361.0,
      "end": 5362.0,
      "text": "לאנו יתרוף,"
    },
    {
      "start": 5362.0,
      "end": 5363.0,
      "text": "עכשיו כשאנחנו עושים כל פר,"
    },
    {
      "start": 5363.0,
      "end": 5365.0,
      "text": "אמרנו שהוא יתרוף לסגמנט,"
    },
    {
      "start": 5365.0,
      "end": 5368.0,
      "text": "את השייתרוף סליחה,"
    },
    {
      "start": 5368.0,
      "end": 5370.0,
      "text": "לסתאק הוא יתרוף גם את הסגמנט,"
    },
    {
      "start": 5370.0,
      "end": 5372.0,
      "text": "וגם את האופצת שלו, נכון?"
    },
    {
      "start": 5373.0,
      "end": 5374.0,
      "text": "כן."
    },
    {
      "start": 5374.0,
      "end": 5375.0,
      "text": "מעולה,"
    },
    {
      "start": 5375.0,
      "end": 5376.0,
      "text": "לאנו יתרוף את זה."
    },
    {
      "start": 5376.0,
      "end": 5377.0,
      "text": "עכשיו אני מחזיר אותנו,"
    },
    {
      "start": 5377.0,
      "end": 5378.0,
      "text": "חזרה לפיינד."
    },
    {
      "start": 5378.0,
      "end": 5379.0,
      "text": "בוא נהיה שזה הסתאק שלנו,"
    },
    {
      "start": 5379.0,
      "end": 5380.0,
      "text": "אוקיי?"
    },
    {
      "start": 5381.0,
      "end": 5383.0,
      "text": "נהניח ש-SP מצביע לפה."
    },
    {
      "start": 5386.0,
      "end": 5387.0,
      "text": "אז להתרוף את זה,"
    },
    {
      "start": 5387.0,
      "end": 5388.0,
      "text": "לאף או שה-SP מצביע, נכון?"
    },
    {
      "start": 5392.0,
      "end": 5393.0,
      "text": "מסכים איתי?"
    },
    {
      "start": 5396.0,
      "end": 5397.0,
      "text": "אילי?"
    }
  ]
}