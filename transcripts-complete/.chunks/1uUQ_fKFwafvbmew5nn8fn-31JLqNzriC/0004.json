      "start": 4081.0,
      "end": 4084.0,
      "text": "כשאנחנו נעשה כל פאר בx,"
    },
    {
      "start": 4084.0,
      "end": 4086.0,
      "text": "ושהוא ילך לאפה,"
    },
    {
      "start": 4086.0,
      "end": 4088.0,
      "text": "לקטוב את זיכרון שבx מצביער,"
    },
    {
      "start": 4088.0,
      "end": 4090.0,
      "text": "והיא כך משם 4 בתים,"
    },
    {
      "start": 4090.0,
      "end": 4092.0,
      "text": "הוא ייקח גם סגמנט,"
    },
    {
      "start": 4093.0,
      "end": 4096.0,
      "text": "זה נניח ו..."
    },
    {
      "start": 4097.0,
      "end": 4100.0,
      "text": "נניח ובדיס, dsbx יהיה"
    },
    {
      "start": 4101.0,
      "end": 4104.0,
      "text": "fx1, fx2,"
    },
    {
      "start": 4104.0,
      "end": 4108.0,
      "text": "fx3,"
    },
    {
      "start": 4108.0,
      "end": 4110.0,
      "text": "fx4,"
    },
    {
      "start": 4110.0,
      "end": 4113.0,
      "text": "זה סמטיו איתי כאילו לצורך ההדגמה,"
    },
    {
      "start": 4115.0,
      "end": 4119.0,
      "text": "אז בפאל כשאנחנו נעשה כל לבx,"
    },
    {
      "start": 4119.0,
      "end": 4121.0,
      "text": "אז מה שהיא קרה,"
    },
    {
      "start": 4121.0,
      "end": 4123.0,
      "text": "זה"
    },
    {
      "start": 4123.0,
      "end": 4126.0,
      "text": "כל fx2, 2, 2, 1,"
    },
    {
      "start": 4126.0,
      "end": 4128.0,
      "text": "כילית אלנביאן,"
    },
    {
      "start": 4128.0,
      "end": 4131.0,
      "text": "זה מה שיהיה בפאל כשאנחנו נעשה כל בx,"
    },
    {
      "start": 4131.0,
      "end": 4133.0,
      "text": "ואם אנחנו נעשה כל פאר בx,"
    },
    {
      "start": 4133.0,
      "end": 4135.0,
      "text": "אז מה שהיא קרה בפאל,"
    },
    {
      "start": 4135.0,
      "end": 4137.0,
      "text": "זה כל 4x4,"
    },
    {
      "start": 4138.0,
      "end": 4140.0,
      "text": "3x3,"
    },
    {
      "start": 4143.0,
      "end": 4145.0,
      "text": "ו..."
    },
    {
      "start": 4146.0,
      "end": 4148.0,
      "text": "הקנות אם אני תואל רגע,"
    },
    {
      "start": 4148.0,
      "end": 4150.0,
      "text": "ו2x2,"
    },
    {
      "start": 4150.0,
      "end": 4152.0,
      "text": "כך לכך."
    },
    {
      "start": 4152.0,
      "end": 4154.0,
      "text": "כאילו הנקודה היא שמה שהיא קרה פה,"
    },
    {
      "start": 4154.0,
      "end": 4156.0,
      "text": "זה גם יקרה סגמנט,"
    },
    {
      "start": 4156.0,
      "end": 4158.0,
      "text": "וגם יקרה איזשהו אופסט."
    },
    {
      "start": 4158.0,
      "end": 4162.0,
      "text": "תגור? עד לכאן יש לי שאלות על ההבדל בין כל לכל פעם,"
    },
    {
      "start": 4163.0,
      "end": 4166.0,
      "text": "קצת קשה לכבלנו,"
    },
    {
      "start": 4166.0,
      "end": 4168.0,
      "text": "יקן חיווי, כי אף אחד באים מצלמים פה."
    },
    {
      "start": 4168.0,
      "end": 4170.0,
      "text": "כן, אם מי שיכול לפתוח מסלמה,"
    },
    {
      "start": 4170.0,
      "end": 4172.0,
      "text": "לשאול שאלות להיות אקטיביים,"
    },
    {
      "start": 4172.0,
      "end": 4174.0,
      "text": "באמת שאנחנו פה בשבילכם,"
    },
    {
      "start": 4174.0,
      "end": 4176.0,
      "text": "חבל נוראים לא תהיו כאן,"
    },
    {
      "start": 4176.0,
      "end": 4178.0,
      "text": "והתאנו ותהיו אקטיביים,"
    },
    {
      "start": 4178.0,
      "end": 4181.0,
      "text": "או תשאלו שאלות, כי בשביל זה אנחנו כאן בעצם."
    },
    {
      "start": 4185.0,
      "end": 4187.0,
      "text": "שאלות על מה ההבדל בין כל פאר לכל רגיל?"
    },
    {
      "start": 4187.0,
      "end": 4190.0,
      "text": "כולך, כול אחד מכם יודע כרגע להסביר לי,"
    },
    {
      "start": 4191.0,
      "end": 4193.0,
      "text": "מה כל פאר עושה בשביל נמכל רגיל?"
    },
    {
      "start": 4194.0,
      "end": 4196.0,
      "text": "אתה יכול להסביר את זה?"
    },
    {
      "start": 4196.0,
      "end": 4198.0,
      "text": "עוד פעם?"
    },
    {
      "start": 4198.0,
      "end": 4200.0,
      "text": "אתה יכול להסביר את זה?"
    },
    {
      "start": 4200.0,
      "end": 4202.0,
      "text": "בית, אני אסביר את זה שוב."
    },
    {
      "start": 4202.0,
      "end": 4206.0,
      "text": "בגדול, כל פאר מאפשר לנו לקרוא לקוד"
    },
    {
      "start": 4206.0,
      "end": 4208.0,
      "text": "שנמצא בסגмент אחר."
    },
    {
      "start": 4208.0,
      "end": 4210.0,
      "text": "עכשיו, איך נקרא לקוד שנמצא בסגмент אחר?"
    },
    {
      "start": 4210.0,
      "end": 4214.0,
      "text": "אנחנו בגדול, ניקח גם את הסגמנט,"
    },
    {
      "start": 4214.0,
      "end": 4215.0,
      "text": "וגם את האופסט,"
    },
    {
      "start": 4215.0,
      "end": 4216.0,
      "text": "ולא רק איזשהו אופסט,"
    },
    {
      "start": 4216.0,
      "end": 4217.0,
      "text": "בתוך הסגמנט שאנחנו נמצאים בו."
    },
    {
      "start": 4217.0,
      "end": 4219.0,
      "text": "זאת אומרת כשאנחנו עושים,"
    },
    {
      "start": 4219.0,
      "end": 4226.1,
      "text": "כל ביקס ככה אנחנו נורחים למה שיש ב, מה שיש בתובת של פה."
    },
    {
      "start": 4227.1,
      "end": 4233.14,
      "text": "שזה נניחי יש 2211 כי נגיד שזה הזיכרון ואז אנחנו נקרא פשוט לאופסט."
    },
    {
      "start": 4233.52,
      "end": 4235.28,
      "text": "אנחנו נקפוץ פשוט לאופסט."
    },
    {
      "start": 4235.52,
      "end": 4236.52,
      "text": "תגור?"
    },
    {
      "start": 4238.44,
      "end": 4239.44,
      "text": "כן."
    },
    {
      "start": 4239.72,
      "end": 4240.72,
      "text": "מהוולה."
    },
    {
      "start": 4240.84,
      "end": 4247.12,
      "text": "וכשאנחנו נעשה כל פאר כאילו לסגמנט שאנחנו לא נמצאים בו אנחנו נצטרך לקרוא."
    },
    {
      "start": 4247.84,
      "end": 4257.24,
      "text": "נגיד נאסנרית הזה, אנחנו נתן לקרוא מהכתובת שביקס מצביע עליה, לקרוא גם סגמנט וגם אופסט כי אנחנו נצטרך לקפוץ את הסגמנט מרוחה."
    },
    {
      "start": 4259.88,
      "end": 4260.88,
      "text": "אוקיי."
    },
    {
      "start": 4261.08,
      "end": 4262.08,
      "text": "מהוולה?"
    },
    {
      "start": 4262.08,
      "end": 4263.08,
      "text": "נו, נו."
    },
    {
      "start": 4264.08,
      "end": 4271.68,
      "text": "עכשיו אני צריך איזשהו מתנדב שיגיד לי מה כל הדברים שקוראים כשאנחנו עושים כל לקתובת מסוימי."
    },
    {
      "start": 4272.24,
      "end": 4273.24,
      "text": "מה קורה מאחורי הכליים?"
    },
    {
      "start": 4274.24,
      "end": 4275.24,
      "text": "עכשיו."
    },
    {
      "start": 4276.24,
      "end": 4277.24,
      "text": "עוד פעם?"
    },
    {
      "start": 4278.24,
      "end": 4279.24,
      "text": "אני נהניח לכל אגיד."
    },
    {
      "start": 4280.24,
      "end": 4281.24,
      "text": "יאללה בטח."
    },
    {
      "start": 4282.24,
      "end": 4287.24,
      "text": "אז הדבר ראשון שקורה, אנחנו כותבים את ה-IP שלנו,"
    },
    {
      "start": 4289.24,
      "end": 4293.24,
      "text": "ובקום בסוים בעזירה, אני לא זוכר להגיד כרגע."
    },
    {
      "start": 4294.24,
      "end": 4295.24,
      "text": "למה בעזירה?"
    },
    {
      "start": 4296.24,
      "end": 4299.24,
      "text": "אפשר גם בהסתק, זה תלוי בנו."
    },
    {
      "start": 4299.24,
      "end": 4300.24,
      "text": "בהסתק סגמנט."
    },
    {
      "start": 4301.24,
      "end": 4302.24,
      "text": "בהסתק סגמנט נכון, אוקיי."
    },
    {
      "start": 4303.24,
      "end": 4308.24,
      "text": "אז בואו אני אעשה אותו בקוד רגיל שלא שהיא נינו את הסתק סגמנט, זה לדרפנו אותו והוא מצביע בתראה לקפוץ שלנו מרסנים."
    },
    {
      "start": 4309.24,
      "end": 4310.24,
      "text": "כן."
    },
    {
      "start": 4311.24,
      "end": 4312.24,
      "text": "הם במלום."
    },
    {
      "start": 4313.24,
      "end": 4315.24,
      "text": "ואו גם נו,"
    },
    {
      "start": 4316.24,
      "end": 4320.24,
      "text": "הוא גם קופץ לאיזשהו מקום שאתה מוכר."
    },
    {
      "start": 4322.24,
      "end": 4324.24,
      "text": "ובגיד זה אין לי איזשהו קפוץ,"
    },
    {
      "start": 4325.24,
      "end": 4327.24,
      "text": "ואו אני אעשה לי איזשהו קפוץ,"
    },
    {
      "start": 4328.24,
      "end": 4331.24,
      "text": "בגיד אם אתה, זה משל, עושה כל פער BX,"
    },
    {
      "start": 4332.24,
      "end": 4335.24,
      "text": "זה הוא קפוץ ל... כל פער לרף של BX,"
    },
    {
      "start": 4336.24,
      "end": 4337.24,
      "text": "וקפוץ לרף של BX,"
    },
    {
      "start": 4338.24,
      "end": 4342.24,
      "text": "אם אתה עושה כל פער F-S3, הוא קפוץ ל-1-3 ושנה לה."
    },
    {
      "start": 4343.24,
      "end": 4344.24,
      "text": "מהו להם?"
    },
    {
      "start": 4345.24,
      "end": 4348.24,
      "text": "את הסייסייפי ולא רק את האיפי."
    },
    {
      "start": 4349.24,
      "end": 4351.24,
      "text": "מהו להם, נדיר. אז באמת בכל רגיל,"
    },
    {
      "start": 4352.24,
      "end": 4354.24,
      "text": "מה שאם עשינו כל איזשהו אדרס,"
    },
    {
      "start": 4354.24,
      "end": 4356.24,
      "text": "אז ידחף"
    },
    {
      "start": 4358.24,
      "end": 4360.24,
      "text": "הכתובת חזרה שלנו,"
    },
    {
      "start": 4361.24,
      "end": 4363.24,
      "text": "אני חושב פה זה איזה אדרס פלושתיים, אבל זה לא מחייב,"
    },
    {
      "start": 4364.24,
      "end": 4366.24,
      "text": "ידחף הכתובת שאנחנו נצטרך לחזור אליה אחרי הפונקציה"
    },
    {
      "start": 4367.24,
      "end": 4369.24,
      "text": "ולמה חסנית עצמה, ואז אנחנו נעשה"
    },
    {
      "start": 4370.24,
      "end": 4372.24,
      "text": "ג'מפ למקום הזה שעשינו אליו כל."
    },
    {
      "start": 4373.24,
      "end": 4375.24,
      "text": "בכל פער, המצב טיפה שונה."
    },
    {
      "start": 4376.24,
      "end": 4379.24,
      "text": "בגלל שאנחנו קופצים אל מחוץ לסגמנט שלנו,"
    },
    {
      "start": 4380.24,
      "end": 4382.24,
      "text": "נניח קפץנו ל-IS-Funk2,"
    },
    {
      "start": 4382.24,
      "end": 4384.24,
      "text": "אז כשאנחנו עושים ריטרם בסוף הפונקציה,"
    },
    {
      "start": 4385.24,
      "end": 4389.24,
      "text": "אנחנו נצטרך פה יהיה כמה קצת קוד, ואז יהיה פה רט."
    },
    {
      "start": 4393.24,
      "end": 4395.24,
      "text": "אז אנחנו נצטרך לקחת,"
    },
    {
      "start": 4396.24,
      "end": 4398.24,
      "text": "זה אטי אפילו יקרה רט פר אבל אני לא קל זה בטוח,"
    },
    {
      "start": 4399.24,
      "end": 4401.24,
      "text": "קצת לא יסמבלר."
    },
    {
      "start": 4402.24,
      "end": 4403.24,
      "text": "אז אנחנו נצטרך פשוט במקום,"
    },
    {
      "start": 4404.24,
      "end": 4405.24,
      "text": "בגלל שאנחנו עוזרים לסגמנט אחרי,"
    },
    {
      "start": 4406.24,
      "end": 4408.24,
      "text": "אנחנו נצטרך לקחת מהמחסנית גם סגמנט וגם אופסט."
    },
    {
      "start": 4409.24,
      "end": 4411.24,
      "text": "אז מה שיקרה כשאנחנו עושים כל פר,"
    },
    {
      "start": 4412.24,
      "end": 4417.24,
      "text": "אנחנו נדחוף פה את הסגמנט,"
    },
    {
      "start": 4421.24,
      "end": 4423.24,
      "text": "פה יהיה איזשהו סג,"
    },
    {
      "start": 4424.24,
      "end": 4426.24,
      "text": "ומתחת היא כנס האופסט."
    },
    {
      "start": 4430.24,
      "end": 4431.24,
      "text": "סגור?"
    },
    {
      "start": 4432.24,
      "end": 4433.24,
      "text": "שאלות מישהו על זה?"
    },
    {
      "start": 4434.24,
      "end": 4438.24,
      "text": "ולמה צריך, למה צריך להתאכח רק הסגמנט וגם אופסט?"
    },
    {
      "start": 4442.24,
      "end": 4445.24,
      "text": "אחיאה, אם אתה עם הצלמה אני אתפל אליך."
    },
    {
      "start": 4446.24,
      "end": 4448.24,
      "text": "אתה יודע להגיד לי למה צריך שיקנס גם הסגמנט זה גם אופסט?"
    },
    {
      "start": 4449.24,
      "end": 4452.24,
      "text": "היא הלכנו לסגמנט אחרי אז אנחנו צריכים לדעת לזה סגמנט החזור."
    },
    {
      "start": 4453.24,
      "end": 4455.24,
      "text": "מדהים, מדהים, מולה, אש, תמידתי."
    },
    {
      "start": 4456.24,
      "end": 4458.24,
      "text": "סבבה, אז מה קרה בפול פה?"
    },
    {
      "start": 4459.24,
      "end": 4461.24,
      "text": "מי שככה מזהה את ההזדמנות תפצצה פה,"
    },
    {
      "start": 4462.24,
      "end": 4464.24,
      "text": "מה שקרה בפול זה שהכנסנו לסגמנט שלא סטאק,"
    },
    {
      "start": 4465.24,
      "end": 4467.24,
      "text": "הכנסנו במקום שתי פתים,"
    },
    {
      "start": 4468.24,
      "end": 4469.24,
      "text": "שאני מזכיר שקום יש בזה שתיים,"
    },
    {
      "start": 4470.24,
      "end": 4471.24,
      "text": "כי הוא יצא ששרה ביץ כאילו,"
    },
    {
      "start": 4472.24,
      "end": 4474.24,
      "text": "במקום שאנחנו נשתי בתים מה שהיינו עושים בכל,"
    },
    {
      "start": 4475.24,
      "end": 4477.24,
      "text": "אנחנו מכניסים הרבה בתים, מכניסים גם את הסגמנט שלנו"
    },
    {
      "start": 4478.24,
      "end": 4479.24,
      "text": "וגם את האופסט שלנו,"
    },
    {
      "start": 4480.24,
      "end": 4483.24,
      "text": "ובתחנת בבקודה אחת, רק בזה שירחסנו כל פאפ."
    },
    {
      "start": 4484.24,
      "end": 4485.24,
      "text": "מהו לך?"
    },
    {
      "start": 4487.24,
      "end": 4489.24,
      "text": "אז שנייה אם ניקח את זה לעולם של הכותבורו,"
    },
    {
      "start": 4490.24,
      "end": 4493.24,
      "text": "אנחנו יכולים בהכחת את הסטאק סגמנט לעשות פוש,"
