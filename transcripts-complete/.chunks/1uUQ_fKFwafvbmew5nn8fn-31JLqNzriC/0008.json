      "end": 8075.4800000000005,
      "text": "איפה לא ריקור להתקשור את"
    },
    {
      "start": 8075.4800000000005,
      "end": 8077.4800000000005,
      "text": "בין סורדים גם"
    },
    {
      "start": 8077.4800000000005,
      "end": 8079.4800000000005,
      "text": "לא ריקה שדיברתי על האכודים"
    },
    {
      "start": 8079.4800000000005,
      "end": 8081.4800000000005,
      "text": "מיוסטוס W"
    },
    {
      "start": 8081.4800000000005,
      "end": 8083.4800000000005,
      "text": "סטוס W, אתה מדבר לסטוס W"
    },
    {
      "start": 8083.4800000000005,
      "end": 8085.4800000000005,
      "text": "מובלס W שמישהו אמר קודם"
    },
    {
      "start": 8085.4800000000005,
      "end": 8087.4800000000005,
      "text": "קב העית"
    },
    {
      "start": 8087.4800000000005,
      "end": 8089.4800000000005,
      "text": "כן זה אני אמרתי את הקב העית"
    },
    {
      "start": 8089.4800000000005,
      "end": 8091.4800000000005,
      "text": "אבל כן גם זה"
    },
    {
      "start": 8091.4800000000005,
      "end": 8093.4800000000005,
      "text": "זהו, אתה מדשק קב העית"
    },
    {
      "start": 8093.4800000000005,
      "end": 8095.4800000000005,
      "text": "זה ספציפית, סורד של שליש לי"
    },
    {
      "start": 8095.4800000000005,
      "end": 8097.4800000000005,
      "text": "הרבה ניסיון מולו"
    },
    {
      "start": 8097.4800000000005,
      "end": 8099.4800000000005,
      "text": "למה אני עשיתי הגירס"
