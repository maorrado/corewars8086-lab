{
  "source": "1uUQ_fKFwafvbmew5nn8fn-31JLqNzriC.mp4",
  "source_sha256": "ba901f95f6250bda4a21d4aba24504786994d213c63590b89e705ee6905c6488",
  "model": "small",
  "language": "he",
  "language_probability": 1,
  "start": 2700.0,
  "end": 3600.0,
  "elapsed_seconds": 472.85743856430054,
  "segments": [
    {
      "start": 2700.0,
      "end": 2705.0,
      "text": "את המפציצה, את הטמר ראשונה שירועה."
    },
    {
      "start": 2705.0,
      "end": 2710.64,
      "text": "זאת אומרת, אם חיפשתי את הדברים האלה, בפעם הראשונה שירועה את הרכים האלה,"
    },
    {
      "start": 2710.64,
      "end": 2711.64,
      "text": "היא תפציץ שם."
    },
    {
      "start": 2711.64,
      "end": 2716.4,
      "text": "אז אם אני עשה כאן jump בתוך מין ואז מעל מין, אני העתיק את הקוד שלי,"
    },
    {
      "start": 2716.4,
      "end": 2722.6,
      "text": "במיתחת למין, אני עתיק שוב את הקוד שלי, ועד נגיד כאן זה לא משנה,"
    },
    {
      "start": 2722.6,
      "end": 2723.6,
      "text": "כי אני חוזר לפה."
    },
    {
      "start": 2723.6,
      "end": 2727.4,
      "text": "מה יקרה עכשיו אם מצצח אחר כמה תחפש אותי, מי שיודע?"
    },
    {
      "start": 2730.72,
      "end": 2732.0,
      "text": "אוקיי, שם."
    },
    {
      "start": 2732.0,
      "end": 2739.8,
      "text": "נכון, באמת תעלו מה די-ריקשן פלגומר, היא עוד התקוף את האחד שמעלי,"
    },
    {
      "start": 2739.8,
      "end": 2742.36,
      "text": "או את האחד שמתחתי."
    },
    {
      "start": 2742.36,
      "end": 2746.92,
      "text": "וזה בעצם סוד נורא חשוב בלתחהות מה שסיפרתי לכם עכשיו."
    },
    {
      "start": 2746.92,
      "end": 2752.56,
      "text": "אני מאוד ממליץ שתזכרו אותו, למה הוא יכול להיות באמת game changer ומציל לחיים."
    },
    {
      "start": 2752.56,
      "end": 2756.0,
      "text": "אם יש לכם קטק קריטי בקוד או עם הסורת שלכם קטן,"
    },
    {
      "start": 2756.0,
      "end": 2760.16,
      "text": "תצרו אותכים של עצמכם, תעשו פדינג הזה, ריפוד יפה,"
    },
    {
      "start": 2760.16,
      "end": 2765.2,
      "text": "כדי שאם מישהו יתקוף אתכם חס וחלילה, לא יצפסו אתכם באחדתה."
    },
    {
      "start": 2765.2,
      "end": 2769.4,
      "text": "אז בעצם יש כאן את האותכים האלה, שם אתה ראה יחידה שלהם בחיים,"
    },
    {
      "start": 2769.4,
      "end": 2773.04,
      "text": "היא לבדש שצרח החמה לא תוכל להגיע אליי."
    },
    {
      "start": 2773.04,
      "end": 2776.48,
      "text": "יש שאלות על פדינג על המגנים האלה?"
    },
    {
      "start": 2776.48,
      "end": 2779.04,
      "text": "כן, לי יש שאלות אם זה משנה,"
    },
    {
      "start": 2779.04,
      "end": 2783.72,
      "text": "אם אני בסך פשוט אסתובת הקוד שלי עוד פעם בדיקו,"
    },
    {
      "start": 2783.8,
      "end": 2786.6400000000003,
      "text": "אז לא שאני פשוט יכול לכתוב נופ נופ נופ נופ נופ נופ נגיד,"
    },
    {
      "start": 2786.6400000000003,
      "end": 2789.2400000000002,
      "text": "הוא סתם איזה בפתר אבומלי."
    },
    {
      "start": 2789.2400000000002,
      "end": 2793.28,
      "text": "בטח שזה משנה, כן, כי הבצע שח החמה מה שיושא,"
    },
    {
      "start": 2793.28,
      "end": 2795.4,
      "text": "היא מחפשת רצף בתים, נכון?"
    },
    {
      "start": 2795.4,
      "end": 2799.32,
      "text": "אז אם מישהו תוקף לי את הרצף בתים הזה, סבבה,"
    },
    {
      "start": 2799.32,
      "end": 2801.6400000000003,
      "text": "אתה מזכים איתי שאתה מחפש את הרצף בתים הזה?"
    },
    {
      "start": 2801.6400000000003,
      "end": 2802.6000000000004,
      "text": "כן."
    },
    {
      "start": 2802.6000000000004,
      "end": 2807.4800000000005,
      "text": "יפה, אז אם אני אכתוב כאן, נופ נופ נופ נופ נופ,"
    },
    {
      "start": 2807.4800000000005,
      "end": 2809.88,
      "text": "האם אחד מהם שביל הרצף בתים הזה?"
    },
    {
      "start": 2810.88,
      "end": 2811.6000000000004,
      "text": "לא."
    },
    {
      "start": 2811.6,
      "end": 2813.6,
      "text": "אבל אם אני אצור את עקמת הקוד שלי,"
    },
    {
      "start": 2813.6,
      "end": 2815.88,
      "text": "האם אחד מהם שביל הרצף בתים שהוא מחפש?"
    },
    {
      "start": 2817.16,
      "end": 2818.24,
      "text": "כן."
    },
    {
      "start": 2818.24,
      "end": 2821.88,
      "text": "יפה, אז זה למה נופ נופ ימי לצערי לא יעזור?"
    },
    {
      "start": 2821.88,
      "end": 2823.88,
      "text": "אתה תצטרך להשתמש בנופ ימי,"
    },
    {
      "start": 2823.88,
      "end": 2827.08,
      "text": "יש קונסטט אצלנו אם כבר ישתתפת בעבר,"
    },
    {
      "start": 2827.08,
      "end": 2829.0,
      "text": "יש קרום לא חתימה צורד,"
    },
    {
      "start": 2829.0,
      "end": 2833.56,
      "text": "שאנחנו בעצם יוצרים אותו כדי לבד שאין התקע בין סורדים,"
    },
    {
      "start": 2833.56,
      "end": 2835.8399999999997,
      "text": "ושכל אחד כתב באמת את הסורד שלו,"
    },
    {
      "start": 2835.8399999999997,
      "end": 2839.04,
      "text": "שזה נופ ימי מעורבים בדבר הזה,"
    },
    {
      "start": 2839.04,
      "end": 2842.04,
      "text": "יותם גם בכל המשתתפים המשעבר,"
    },
    {
      "start": 2842.04,
      "end": 2845.52,
      "text": "יודעים איזה כיף זה לחתום סורדים,"
    },
    {
      "start": 2845.52,
      "end": 2850.7599999999998,
      "text": "אז תקע, אז אתם תואבו את זה שאתה גיב לזה."
    },
    {
      "start": 2850.7599999999998,
      "end": 2854.72,
      "text": "אז בעצם כן, אני לא יכול סתם לשים נופ ימי איפה שבא לי,"
    },
    {
      "start": 2854.72,
      "end": 2857.56,
      "text": "אז זה למה אני רוצה להתקעים או של כל הקוד,"
    },
    {
      "start": 2857.56,
      "end": 2860.12,
      "text": "או של קטעים שאני יודע שהם קריטים בקוד,"
    },
    {
      "start": 2860.12,
      "end": 2861.44,
      "text": "לטרביטחון."
    },
    {
      "start": 2861.44,
      "end": 2863.2799999999997,
      "text": "עוד שאלות בנושא?"
    },
    {
      "start": 2864.08,
      "end": 2865.92,
      "text": "לא, דיון, תודה."
    },
    {
      "start": 2865.92,
      "end": 2872.64,
      "text": "אגב, בחיסרון של קוד,"
    },
    {
      "start": 2872.64,
      "end": 2878.08,
      "text": "שהאיפה שלו תמיד בורח כי בכל תמיד ממשיך,"
    },
    {
      "start": 2878.08,
      "end": 2882.64,
      "text": "ממחד בכל פערים, כשאולי אני מדבר עליהם שבוע הבא,"
    },
    {
      "start": 2883.52,
      "end": 2890.56,
      "text": "זה שקל מאוד בסוף לערוסת זה כי כל פער זה איזשהו אופקוד"
    },
    {
      "start": 2890.56,
      "end": 2894.6800000000003,
      "text": "שהוא מאוד מוכר במשחק פה."
    },
    {
      "start": 2894.68,
      "end": 2897.9199999999996,
      "text": "אז מי שעושה אף תוצאי החכמה של כל פער,"
    },
    {
      "start": 2897.9199999999996,
      "end": 2900.8399999999997,
      "text": "ואתה עם כל פער תמיד מתקדם ולא יכול,"
    },
    {
      "start": 2900.8399999999997,
      "end": 2903.64,
      "text": "אין לך קוד שיסטיר את,"
    },
    {
      "start": 2903.64,
      "end": 2905.6,
      "text": "כאילו שיש לך גם אף תוצאי החכמה,"
    },
    {
      "start": 2905.6,
      "end": 2907.68,
      "text": "כי אתה תמיד מתקדם עם הכל פער,"
    },
    {
      "start": 2907.68,
      "end": 2910.9199999999996,
      "text": "אז בגלל זה אף תוצאי חכמה תנצח כל פער"
    },
    {
      "start": 2910.9199999999996,
      "end": 2914.8799999999997,
      "text": "וזה חיסרון בכל שורד שמצליח להתקדם."
    },
    {
      "start": 2915.6,
      "end": 2917.3999999999996,
      "text": "גם מובסדה בלו אותו דבר,"
    },
    {
      "start": 2917.3999999999996,
      "end": 2921.68,
      "text": "כי בסוף אני יכול לשלוח אף תוצאי חכמה שמובסדה בלו אחורה,"
    },
    {
      "start": 2921.68,
      "end": 2925.8399999999997,
      "text": "ואם מי שמיתקדם אליי מובסדה בלו, אז זה יפציץ אותו."
    },
    {
      "start": 2925.8399999999997,
      "end": 2930.2799999999997,
      "text": "אבל מצד שני, כל השאר שאם יש מישהו עכשיו שקרוב יותר לבצע צער,"
    },
    {
      "start": 2930.2799999999997,
      "end": 2933.3599999999997,
      "text": "אם יש שם שבי מובסדה בלו יכול שזה יתפוס אותו בלו אותי,"
    },
    {
      "start": 2933.3599999999997,
      "end": 2936.08,
      "text": "אז זה גם משהו שאפשר לחשוב עליו."
    },
    {
      "start": 2936.08,
      "end": 2942.16,
      "text": "כן, ויש בזה כשתי חיסרון בזה בסוף תמיד אפשר למצוא,"
    },
    {
      "start": 2942.16,
      "end": 2946.3999999999996,
      "text": "יש לכם בסורד הכי טוב שאין להצלח את כולום."
    },
    {
      "start": 2946.3999999999996,
      "end": 2948.7599999999998,
      "text": "זה תמיד אפשר למצוא פרצות,"
    },
    {
      "start": 2948.7599999999998,
      "end": 2950.3199999999997,
      "text": "זה מה שאנחנו מועודים כאן,"
    },
    {
      "start": 2950.4,
      "end": 2953.6000000000004,
      "text": "בתחרות תמיד יש איפה לפרוץ, איפה טיפה יותר להתחכם,"
    },
    {
      "start": 2953.6000000000004,
      "end": 2955.48,
      "text": "איפה לחשוב מחוץ לקופסה,"
    },
    {
      "start": 2955.48,
      "end": 2957.2000000000003,
      "text": "זה מה שאנחנו מועודים כאן,"
    },
    {
      "start": 2957.2000000000003,
      "end": 2959.88,
      "text": "זה מה שאנחנו בעצם המטרה של הדרכות האלה,"
    },
    {
      "start": 2959.88,
      "end": 2963.36,
      "text": "היא באמת לגרות החשיבה הזאת, לגרום לכם לחשוב,"
    },
    {
      "start": 2963.36,
      "end": 2965.56,
      "text": "למה איך זה עובד, איך אני יכול לנצל את זה,"
    },
    {
      "start": 2965.56,
      "end": 2967.84,
      "text": "אולי יש כאן בתקטיקה הזאת איזה בעיה."
    },
    {
      "start": 2968.4,
      "end": 2971.92,
      "text": "אנחנו כאן גם בשביל למדכם וגם בשביל באמת לגרום לכם לחשוב"
    },
    {
      "start": 2971.92,
      "end": 2973.8,
      "text": "ולקחת את הצד אקסטרה."
    },
    {
      "start": 2973.8,
      "end": 2978.8,
      "text": "אז אם באמת שלוט כאלה עברות גם כמו שאותם אמר,"
    },
    {
      "start": 2979.36,
      "end": 2981.8,
      "text": "כמו שצריך זה באמת מה שאנחנו מחפשים,"
    },
    {
      "start": 2981.8,
      "end": 2983.44,
      "text": "אם אתם יכולים עכשיו לתפוס ממש,"
    },
    {
      "start": 2983.44,
      "end": 2987.84,
      "text": "יש בכל שנה מטה שיטת צורדים שכולם משתמשים בה,"
    },
    {
      "start": 2987.84,
      "end": 2991.1200000000003,
      "text": "אם אתם יכולים לתפוס את השיטה הזאת ולנצל אותה,"
    },
    {
      "start": 2991.1200000000003,
      "end": 2994.92,
      "text": "המקום הראשון לא רחוק מכם כמו שאתם חושבים."
    },
    {
      "start": 2995.44,
      "end": 2997.84,
      "text": "אז יפה מאוד, יפה מאוד,"
    },
    {
      "start": 2997.84,
      "end": 3001.44,
      "text": "יקרון עכשיו שחף, אם אני לא תהיה אמור לקנס,"
    },
    {
      "start": 3001.44,
      "end": 3006.0,
      "text": "אבל רואה שיש גאיות ב..."
    },
    {
      "start": 3006.96,
      "end": 3008.08,
      "text": "לא שומעים אותי?"
    },
    {
      "start": 3009.28,
      "end": 3012.0,
      "text": "אה, הנה נכנס, שומעים, שומעים."
    },
    {
      "start": 3012.0,
      "end": 3013.6,
      "text": "כן, אני פועז לכם משדה גודגון."
    },
    {
      "start": 3013.6,
      "end": 3015.44,
      "text": "אה, אשכרה."
    },
    {
      "start": 3015.44,
      "end": 3018.72,
      "text": "זהו, כי יהודה לא עדכן תנו שנכנסת."
    },
    {
      "start": 3018.72,
      "end": 3022.48,
      "text": "רוצים לתת לי ריקה על מה עברתם בינתיים עד עכשיו?"
    },
    {
      "start": 3022.48,
      "end": 3023.92,
      "text": "כן, אין בעיה."
    },
    {
      "start": 3023.92,
      "end": 3026.2,
      "text": "בעצם מה שעשינו עד עכשיו,"
    },
    {
      "start": 3026.2,
      "end": 3028.24,
      "text": "בעצם עברנו על ה..."
    },
    {
      "start": 3028.24,
      "end": 3031.28,
      "text": "זומבים, הבסיסים של השנה על הזומבי חימום,"
    },
    {
      "start": 3031.28,
      "end": 3034.28,
      "text": "פתרנו זומבי שקורים לו ששבע,"
    },
    {
      "start": 3034.28,
      "end": 3038.28,
      "text": "ולימדנו את התקודה מוב ס-W,"
    },
    {
      "start": 3038.28,
      "end": 3039.96,
      "text": "הסתכלנו על הסורת דים,"
    },
    {
      "start": 3039.96,
      "end": 3044.5600000000004,
      "text": "עליך אנחנו יכולים בעצם לשכפל את הקוד של עצמנו בריצה,"
    },
    {
      "start": 3044.5600000000004,
      "end": 3046.76,
      "text": "ושהיפי שלנו תמיד התקדם,"
    },
    {
      "start": 3046.76,
      "end": 3049.4,
      "text": "והעשינו את הפצצה החכמה,"
    },
    {
      "start": 3049.4,
      "end": 3051.96,
      "text": "ואיך להגן עליה עם פדינג,"
    },
    {
      "start": 3051.96,
      "end": 3054.52,
      "text": "ועת הקוד של הקוד שלנו."
    },
    {
      "start": 3054.52,
      "end": 3057.0800000000004,
      "text": "זה פחות יותר מה שעשינו עד עכשיו."
    },
    {
      "start": 3058.5600000000004,
      "end": 3060.44,
      "text": "זהו, לפי מה שבנו,"
    },
    {
      "start": 3060.44,
      "end": 3064.96,
      "text": "אתה ויהודה איכן אתם שאלו טכניקות מתקדמות,"
    },
    {
      "start": 3064.96,
      "end": 3068.08,
      "text": "דברים כאלה לחברי כאן, נכון?"
    },
    {
      "start": 3068.08,
      "end": 3071.44,
      "text": "כן, נראה לי שאני יכולה לקחת את זה מפה מנטיים."
    },
    {
      "start": 3071.44,
      "end": 3073.92,
      "text": "סבבה בציין, אז רגע שנייה רק,"
    },
    {
      "start": 3073.92,
      "end": 3077.16,
      "text": "יש לך שר פרמי שן, זה אהבו עוד כולל."
    },
    {
      "start": 3077.16,
      "end": 3079.04,
      "text": "נצריך שאתה עביר אותי."
    },
    {
      "start": 3079.04,
      "end": 3082.36,
      "text": "וואי, רגע אני רואה גם שאני לא קיבלתי,"
    },
    {
      "start": 3082.36,
      "end": 3084.12,
      "text": "צריך כאן את גי טוב."
    },
    {
      "start": 3084.12,
      "end": 3087.2400000000002,
      "text": "סבבה, אז מנטיים תציג את עצמך שחף,"
    },
    {
      "start": 3087.2400000000002,
      "end": 3091.44,
      "text": "צפה יוצאת לחברי כאן, מה עשיתם, מה הלך כאן, מה תחות."
    },
    {
      "start": 3091.44,
      "end": 3093.6400000000003,
      "text": "יותם, אתה יכול לבקשה, אני פשוט על הערכות,"
    },
    {
      "start": 3093.6400000000003,
      "end": 3096.6800000000003,
      "text": "אתה יכול להעשיג את גי טוב במישהו שיתן פרמי שן,"
    },
    {
      "start": 3096.6800000000003,
      "end": 3099.1200000000003,
      "text": "סלם אני רואה שאני לא תרגישה פה."
    },
    {
      "start": 3099.1200000000003,
      "end": 3100.2400000000002,
      "text": "אני אקרא לוקש."
    },
    {
      "start": 3100.2400000000002,
      "end": 3101.5200000000004,
      "text": "סבבה, תודה."
    },
    {
      "start": 3102.5200000000004,
      "end": 3106.6000000000004,
      "text": "טוב, טוב, תיק את עצמי, עלינו אני שחף,"
    },
    {
      "start": 3106.6000000000004,
      "end": 3110.88,
      "text": "ב-22 היום בצבא,"
    },
    {
      "start": 3110.88,
      "end": 3113.88,
      "text": "התחראתי בכל דגור, בערך לפני שש שנים,"
    },
    {
      "start": 3114.44,
      "end": 3116.12,
      "text": "התחראתי שלוש שנים,"
    },
    {
      "start": 3117.12,
      "end": 3122.28,
      "text": "וזהו, מאז אני משתדל כמה שיותר כאילו לבוא ולהדריך,"
    },
    {
      "start": 3122.28,
      "end": 3125.6800000000003,
      "text": "ילד נעשות להיות מנטור של כמה שיותר חניכים."
    },
    {
      "start": 3125.6800000000003,
      "end": 3129.0,
      "text": "משתדל לכל שנה, אם הצבא זה קצת יותר קשה,"
    },
    {
      "start": 3129.0,
      "end": 3130.92,
      "text": "אז אני עושה את הבסטפורט."
    },
    {
      "start": 3132.6800000000003,
      "end": 3134.6,
      "text": "וזהו, הנה, אני פה היום."
    },
    {
      "start": 3134.6,
      "end": 3138.36,
      "text": "רציתי לשאול בכללי, אם יש לכם שאלות,"
    },
    {
      "start": 3138.36,
      "end": 3140.28,
      "text": "דברים שלא הבנתם,"
    },
    {
      "start": 3140.28,
      "end": 3141.92,
      "text": "כל סלטים שלו הצלחתם עוד,"
    },
    {
      "start": 3141.92,
      "end": 3143.2400000000002,
      "text": "שלא נפער עשימון,"
    },
    {
      "start": 3143.6000000000004,
      "end": 3146.6000000000004,
      "text": "אני עדיין התחיל בזה ואז נתקדם לדברים ובעים."
    },
    {
      "start": 3147.88,
      "end": 3149.36,
      "text": "מוזמנים לקחת גם,"
    },
    {
      "start": 3149.36,
      "end": 3152.36,
      "text": "קחו את זה דקה אפילו, כאילו בוא תחשבו על שאלות,"
    },
    {
      "start": 3152.36,
      "end": 3154.88,
      "text": "ואני בכפה עבור ועשיתי לכם מקום."
    },
    {
      "start": 3160.2000000000003,
      "end": 3162.92,
      "text": "מזכיר שאין כזה, שאין כך דבר שאלה לא טובה."
    },
    {
      "start": 3162.92,
      "end": 3165.0800000000004,
      "text": "אני בטוח שאם יש משהו שלא הבנתם,"
    },
    {
      "start": 3165.0800000000004,
      "end": 3168.6000000000004,
      "text": "אז יש פה לפחות עוד חמישה אנשים"
    },
    {
      "start": 3168.6000000000004,
      "end": 3171.5200000000004,
      "text": "שיתכם באותה סיטואציה."
    },
    {
      "start": 3172.12,
      "end": 3175.28,
      "text": "שחר, באמת, הוא אחד המתחרים הכי תותחים,"
    },
    {
      "start": 3175.28,
      "end": 3178.08,
      "text": "לפי מה ששמעתי, שיהיו בהיסטוריה של קודגור,"
    },
    {
      "start": 3178.08,
      "end": 3179.72,
      "text": "לפי מה שיהיו גם לספר."
    },
    {
      "start": 3179.72,
      "end": 3182.64,
      "text": "אז באמת, אם יש מישהו שאתם רוצים לישול אותו,"
    },
    {
      "start": 3182.64,
      "end": 3184.08,
      "text": "זה הרבה נדם."
    },
    {
      "start": 3184.08,
      "end": 3188.68,
      "text": "כל דבר שקשור תחרו טכניקות דברים מאוד ממליץ."
    },
    {
      "start": 3190.48,
      "end": 3191.84,
      "text": "אפשר לשאול משהו?"
    },
    {
      "start": 3191.84,
      "end": 3192.84,
      "text": "די די."
    },
    {
      "start": 3192.84,
      "end": 3194.7599999999998,
      "text": "אבל זה, זה מתקדם."
    },
    {
      "start": 3194.7599999999998,
      "end": 3196.64,
      "text": "רק תגיד שם ואז זה..."
    },
    {
      "start": 3196.64,
      "end": 3197.64,
      "text": "זיל."
    },
    {
      "start": 3197.64,
      "end": 3199.12,
      "text": "זה תערנדיל."
    },
    {
      "start": 3199.12,
      "end": 3201.12,
      "text": "איזה כאילו..."
    },
    {
      "start": 3201.12,
      "end": 3202.72,
      "text": "אני יוד יוד."
    },
    {
      "start": 3202.72,
      "end": 3203.72,
      "text": "יוד?"
    },
    {
      "start": 3203.72,
      "end": 3204.72,
      "text": "כן."
    },
    {
      "start": 3204.72,
      "end": 3205.6,
      "text": "זו, בולה."
    },
    {
      "start": 3205.6,
      "end": 3207.12,
      "text": "זה שנה ראשונה שלי."
    },
    {
      "start": 3207.12,
      "end": 3209.3599999999997,
      "text": "אני ראיתי בחלק מהסורדים"
    },
    {
      "start": 3209.3599999999997,
      "end": 3212.48,
      "text": "שהם מצליחים לשנות את הסייס שלהם,"
    },
    {
      "start": 3212.48,
      "end": 3214.88,
      "text": "ואז הם יכולים לשלוט על היפי שלהם"
    },
    {
      "start": 3214.88,
      "end": 3218.64,
      "text": "ולשלוט על המעשה שנכנס לסטק בכל פער."
    },
    {
      "start": 3218.64,
      "end": 3221.72,
      "text": "וכך הם יכולים לפגוע בעצמה ממסטק"
    },
    {
      "start": 3221.72,
      "end": 3225.64,
      "text": "ולגרון, ולשלוט כאילו בוי שלהם, ולא ב-X."
    },
    {
      "start": 3226.52,
      "end": 3227.92,
      "text": "דבר, בולה."
    },
    {
      "start": 3227.92,
      "end": 3230.64,
      "text": "אז אני אתחיל והקדים שכאילו..."
    },
    {
      "start": 3231.84,
      "end": 3234.28,
      "text": "תיאור שלך ש-Y ו-X הוא באמת נוח להשתמש בה,"
    },
    {
      "start": 3234.28,
      "end": 3238.32,
      "text": "אבל תמיד כטיפ תזכור שזה בסוף רציף."
    },
    {
      "start": 3238.32,
      "end": 3240.36,
      "text": "כן, אני יודע, פשוט."
    },
    {
      "start": 3240.36,
      "end": 3244.32,
      "text": "אבל אני מנסביר בקצרה מה..."
    },
    {
      "start": 3245.4,
      "end": 3246.4,
      "text": "מה..."
    },
    {
      "start": 3246.4,
      "end": 3248.92,
      "text": "איך בדיוק הסטרטגיה הזאת עובדת."
    },
    {
      "start": 3249.8,
      "end": 3253.44,
      "text": "וזה בגדול, כאילו, קונספט ראשון"
    },
    {
      "start": 3254.0,
      "end": 3256.32,
      "text": "זה היכולת להפציץ עם כל פער."
    },
    {
      "start": 3256.32,
      "end": 3259.44,
      "text": "זה בעצם היכולת שאנו, כשאנחנו עושים כל פער,"
    },
    {
      "start": 3259.44,
      "end": 3263.36,
      "text": "אנחנו בעצם דוחפים גם את הסגמת"
    },
    {
      "start": 3263.36,
      "end": 3265.28,
      "text": "וגם את האופסט שלנו למחסנית."
    },
    {
      "start": 3265.76,
      "end": 3269.6000000000004,
      "text": "זה דבר ראשון, זה יצא לכם לעבור על מפסיץ כל פער גנרי?"
    },
    {
      "start": 3270.6400000000003,
      "end": 3272.92,
      "text": "לא, הם עוד לא הגיעו לכל פער,"
    },
    {
      "start": 3272.92,
      "end": 3275.8,
      "text": "לא עכשיו, ולא בשבוע קודם,"
    },
    {
      "start": 3275.8,
      "end": 3277.7200000000003,
      "text": "אז עוד לא יצא לנו לעבור עלי כל פער."
    },
    {
      "start": 3278.1200000000003,
      "end": 3280.0800000000004,
      "text": "אבן, גריטים המניצים לעשות זה היום?"
    },
    {
      "start": 3281.0800000000004,
      "end": 3282.48,
      "text": "כרגע, אפשר..."
    },
    {
      "start": 3283.36,
      "end": 3286.1200000000003,
      "text": "אפשר כאילו, אם זה מה ש..."
    },
    {
      "start": 3286.52,
      "end": 3289.2400000000002,
      "text": "חשבת על לעשות עם לך מה שאוכלת, אפשר בהתחלס."
    },
    {
      "start": 3289.2400000000002,
      "end": 3290.48,
      "text": "עכשיו גע, לא פשוט..."
    },
    {
      "start": 3290.48,
      "end": 3293.2000000000003,
      "text": "רואו, לדעתי, לדעתי, הם ברמה ללמוד כל פער,"
    },
    {
      "start": 3293.2000000000003,
      "end": 3296.0,
      "text": "זה פשוט הם צריכים קודם לעבור לשכפול ועדברים סיסיים,"
    },
    {
      "start": 3296.0,
      "end": 3298.6000000000004,
      "text": "אבל עכשיו, לדעתי, כאילו, הם במצב ללמוד את זה."
    },
    {
      "start": 3299.7200000000003,
      "end": 3300.92,
      "text": "בסדר, בסדר, מלוולה."
    },
    {
      "start": 3302.4,
      "end": 3303.8,
      "text": "אז בואו נעשה משהו כזה."
    },
    {
      "start": 3305.36,
      "end": 3307.2000000000003,
      "text": "נראה לי כן אתכן לדבר עם על כל פער,"
    },
    {
      "start": 3307.2000000000003,
      "end": 3309.92,
      "text": "אפשר להמשיך פה מצגת ולעשות אנרגי ודווקא,"
    },
    {
      "start": 3309.92,
      "end": 3312.4,
      "text": "אבל נראה לי שבטרמה אני אין דווקא ללמוד כל פער."
    },
    {
      "start": 3312.88,
      "end": 3315.4,
      "text": "בואו נראה רק אם יש לי משהו בשלוף שעושה זה,"
    },
    {
      "start": 3316.2000000000003,
      "end": 3317.4,
      "text": "אם לא נכתוב מהר."
    },
    {
      "start": 3320.52,
      "end": 3321.52,
      "text": "תהיה, ביי-ביי."
    },
    {
      "start": 3324.6,
      "end": 3326.2400000000002,
      "text": "האמת שלא איכנתי את זה מראש,"
    },
    {
      "start": 3326.76,
      "end": 3328.1600000000003,
      "text": "אני כן חושב שזה חשוב,"
    },
    {
      "start": 3328.4,
      "end": 3330.2000000000003,
      "text": "ואין לה עשה את זה בשיעור הבא בשביל."
    },
    {
      "start": 3331.64,
      "end": 3332.4,
      "text": "כן, אפשר."
    },
    {
      "start": 3333.12,
      "end": 3333.92,
      "text": "תהיה, ביי-ביי."
    },
    {
      "start": 3334.92,
      "end": 3337.12,
      "text": "רגע, בואו נראה לי יש לי אפילו משהו בשלוף."
    },
    {
      "start": 3343.4,
      "end": 3345.4,
      "text": "נראה לי שיש לי משהו בשלוף."
    },
    {
      "start": 3349.4,
      "end": 3351.4,
      "text": "נראה לי נתהיה לך בגלל."
    },
    {
      "start": 3356.4,
      "end": 3358.4,
      "text": "נסתהר עלי כול, מרח בבקר."
    },
    {
      "start": 3358.4,
      "end": 3370.4,
      "text": "אז, זומבים, לקריגה לשנה,"
    },
    {
      "start": 3371.4,
      "end": 3375.4,
      "text": "אנחנו חושבים שזה יהיה קפולטיישה,"
    },
    {
      "start": 3376.4,
      "end": 3378.4,
      "text": "כל הפרטים על הזומבים הראשים,"
    },
    {
      "start": 3378.4,
      "end": 3381.4,
      "text": "כיוון אם התחילת התחרות, אבל כן,"
    },
    {
      "start": 3381.4,
      "end": 3383.4,
      "text": "תצפו שזה יהיה קפולטיישה."
    },
    {
      "start": 3385.4,
      "end": 3386.4,
      "text": "המתי התחרות מתחילה."
    },
    {
      "start": 3386.4,
      "end": 3389.4,
      "text": "אז זומבים הראשונים עם הניקוד,"
    },
    {
      "start": 3389.4,
      "end": 3392.4,
      "text": "אם אני לא תראה איפורסמו בשבוע הקרוב, נכון גאית טוב,"
    },
    {
      "start": 3392.4,
      "end": 3394.4,
      "text": "ושוף שבוע הבא כזה אמרנו?"
    },
    {
      "start": 3395.4,
      "end": 3397.4,
      "text": "כתבנו את זה בתהריכים, לדעתי אבל כן,"
    },
    {
      "start": 3397.4,
      "end": 3400.4,
      "text": "לדעתי זה שוף שבוע בשני הנבדוקטר גן."
    },
    {
      "start": 3406.4,
      "end": 3409.4,
      "text": "אז כן, אז זומבים ראשון הניקוד,"
    },
    {
      "start": 3409.4,
      "end": 3412.4,
      "text": "איפורסמו בסוף שבוע הבא,"
    },
    {
      "start": 3412.4,
      "end": 3415.4,
      "text": "וכל הפרטים יפורסמו איתם."
    },
    {
      "start": 3415.4,
      "end": 3419.4,
      "text": "אז אם אתה רוצה תשובה סופית על המהירות,"
    },
    {
      "start": 3419.4,
      "end": 3423.4,
      "text": "אז הסיבה באמת שאנחנו נחנים תיישה,"
    },
    {
      "start": 3423.4,
      "end": 3425.4,
      "text": "זה שבוע הבא."
    },
    {
      "start": 3425.4,
      "end": 3427.4,
      "text": "כן, כי הסיבה שאנחנו שוקלים תיישה,"
    },
    {
      "start": 3427.4,
      "end": 3430.4,
      "text": "זה פשוט כדי לתת אימאוטיבציה בזה,"
    },
    {
      "start": 3430.4,
      "end": 3433.4,
      "text": "כי ראינו שבשנה מאחרון התפחות יש עבודה על הזומבים."
    },
    {
      "start": 3433.4,
      "end": 3436.4,
      "text": "כן, כי זומבים מדרך אליהם באמת ככה,"
    },
    {
      "start": 3436.4,
      "end": 3439.4,
      "text": "כאילו קשים לפיצוח,"
    },
    {
      "start": 3439.4,
      "end": 3441.4,
      "text": "ואם אין להם הרבה מהירות,"
    },
    {
      "start": 3441.4,
      "end": 3442.4,
      "text": "הם לא שזים את כל העבודה הזאת."
    },
    {
      "start": 3442.4,
      "end": 3445.4,
      "text": "שחפנתת לך את כל הרשעות שאני יכול להביא,"
    },
    {
      "start": 3445.4,
      "end": 3448.4,
      "text": "כי קוסט אני מבקש מי יודע אביך הקוסט גם."
    },
    {
      "start": 3448.4,
      "end": 3452.4,
      "text": "נהיה כול, טוב, אין להם דוגמא מרל כל פער, אנחנו מוכר להתחיל."
    },
    {
      "start": 3452.4,
      "end": 3454.4,
      "text": "בוא נראה, אני יכול לעשות שר?"
    },
    {
      "start": 3454.4,
      "end": 3455.4,
      "text": "די וקוסט."
    },
    {
      "start": 3455.4,
      "end": 3457.4,
      "text": "כן, אתה יכול, כן."
    },
    {
      "start": 3457.4,
      "end": 3460.4,
      "text": "בוא נראה, הנה שירסקין,"
    },
    {
      "start": 3460.4,
      "end": 3462.4,
      "text": "מגיעים."
    },
    {
      "start": 3462.4,
      "end": 3465.4,
      "text": "יופי, תגידו לי אם רואים."
    },
    {
      "start": 3465.4,
      "end": 3467.4,
      "text": "כן, רואים סבב."
    },
    {
      "start": 3467.4,
      "end": 3469.4,
      "text": "אני אדבר איתכם בייק."
    },
    {
      "start": 3469.4,
      "end": 3471.4,
      "text": "בייק איתו."
    },
    {
      "start": 3473.4,
      "end": 3476.4,
      "text": "כנראה שם מתאים שר שני על השלוש של ה-6?"
    },
    {
      "start": 3476.4,
      "end": 3478.4,
      "text": "אולי תם?"
    },
    {
      "start": 3478.4,
      "end": 3480.4,
      "text": "לפני שאתה מתחיל את הכול,"
    },
    {
      "start": 3480.4,
      "end": 3482.4,
      "text": "פר זה שר שני על ה-6?"
    },
    {
      "start": 3482.4,
      "end": 3484.4,
      "text": "בידה, קופשי."
    },
    {
      "start": 3484.4,
      "end": 3486.4,
      "text": "אוקיי, אז שאתה משחפל את התמחה,"
    },
    {
      "start": 3486.4,
      "end": 3489.4,
      "text": "אתה אולי, כאילו, אתה לא,"
    },
    {
      "start": 3489.4,
      "end": 3490.4,
      "text": "זה, אתה לא שואל,"
    },
    {
      "start": 3490.4,
      "end": 3492.4,
      "text": "כבר שאי בי של חג הזה או שאתה,"
    },
    {
      "start": 3492.4,
      "end": 3494.4,
      "text": "או שזה לא פגיע?"
    },
    {
      "start": 3494.4,
      "end": 3496.4,
      "text": "אני לא מתייר שמות."
    },
    {
      "start": 3497.4,
      "end": 3499.4,
      "text": "כשאתה משחפל את התמחה,"
    },
    {
      "start": 3499.4,
      "end": 3503.4,
      "text": "אז אתה לא יותר פגיעו שאתה פגיע רק כפוס שאייתי שלך."
    },
    {
      "start": 3504.4,
      "end": 3506.4,
      "text": "בזמן השכפול עצמו?"
    },
    {
      "start": 3507.4,
      "end": 3509.4,
      "text": "לא, יש לו כבר נוצר, כאילו,"
    },
    {
      "start": 3509.4,
      "end": 3511.4,
      "text": "שיש לך פשוט עוד בתים,"
    },
    {
      "start": 3511.4,
      "end": 3512.4,
      "text": "בקוד כזה."
    },
    {
      "start": 3512.4,
      "end": 3515.4,
      "text": "אז בסוף מה שקובע על האם אתה נפסה לא לא,"
    },
    {
      "start": 3515.4,
      "end": 3517.4,
      "text": "זה האם הרצת הפקודה לוחוקית,"
    },
    {
      "start": 3517.4,
      "end": 3519.4,
      "text": "זאת אומרת, אני אך שאלה,"
    },
    {
      "start": 3519.4,
      "end": 3522.4,
      "text": "האם מישהו יתערב לך בקודש את העולך להריץ?"
    },
    {
      "start": 3522.4,
      "end": 3524.4,
      "text": "אז בזמן שאתה משחפל,"
    },
    {
      "start": 3524.4,
      "end": 3526.4,
      "text": "או באופן גדלי אחרי ששכפל,"
    },
    {
      "start": 3526.4,
      "end": 3528.4,
      "text": "החלק הקודם שלך, השכפול הקודם שלך,"
    },
    {
      "start": 3528.4,
      "end": 3529.4,
      "text": "הוא לא רלוונט יותר."
    },
    {
      "start": 3529.4,
      "end": 3532.4,
      "text": "אז אני לא חושב שזה הגדרה ליותר פגיע."
    },
    {
      "start": 3532.4,
      "end": 3534.4,
      "text": "אז בזמן שאתה משחפל, אני משחפל?"
    },
    {
      "start": 3535.4,
      "end": 3536.4,
      "text": "אז בזמן שאתה משחפל,"
    },
    {
      "start": 3536.4,
      "end": 3539.4,
      "text": "אתה פגיע גם באזור של השכפול עצמו,"
    },
    {
      "start": 3539.4,
      "end": 3541.4,
      "text": "גם מוביס דוולי או רשתה לא עושה את זה,"
    },
    {
      "start": 3542.4,
      "end": 3545.4,
      "text": "ואתה פגיע גם בחלק החדש של התמחה."
    },
    {
      "start": 3547.4,
      "end": 3548.4,
      "text": "טוב, תודה רבה."
    },
    {
      "start": 3548.4,
      "end": 3549.4,
      "text": "נראו לך."
    },
    {
      "start": 3550.4,
      "end": 3552.4,
      "text": "אם הקוד שלי רצה במחסנית,"
    },
    {
      "start": 3552.4,
      "end": 3555.4,
      "text": "אז זה נחשב שאני מת או לא?"
    },
    {
      "start": 3555.4,
      "end": 3557.4,
      "text": "מה הכרונה הקוד של חרת במחסנית?"
    },
    {
      "start": 3557.4,
      "end": 3560.4,
      "text": "ששניתי את השיעס שלי להיות במחסנית,"
    },
    {
      "start": 3560.4,
      "end": 3561.4,
      "text": "ואני רצה שם."
    },
    {
      "start": 3562.4,
      "end": 3565.4,
      "text": "אז איך שזה עובד בגדול,"
    },
    {
      "start": 3565.4,
      "end": 3568.4,
      "text": "אתה לא יכול להריץ כל במחסנית."
    },
    {
      "start": 3569.4,
      "end": 3570.4,
      "text": "יש פה שענות את שיעס."
    },
    {
      "start": 3570.4,
      "end": 3571.4,
      "text": "תמות אוטומטית."
    },
    {
      "start": 3571.4,
      "end": 3573.4,
      "text": "אי אפשר שענות את שיעס אבן נכון?"
    },
    {
      "start": 3574.4,
      "end": 3575.4,
      "text": "אי אפשר שענות את שיעס."
    },
    {
      "start": 3575.4,
      "end": 3577.4,
      "text": "תאמשו, אני ניסיתי את זה, אני ניסיתי בהנח."
    },
    {
      "start": 3577.4,
      "end": 3579.4,
      "text": "לא, זה אמנוע,"
    },
    {
      "start": 3579.4,
      "end": 3581.4,
      "text": "הוא אמול המפשרי הרצה,"
    },
    {
      "start": 3581.4,
      "end": 3583.4,
      "text": "כל הדברים הוא לא השיעס."
    },
    {
      "start": 3584.4,
      "end": 3588.4,
      "text": "כן, כל מיני רעולנות של עבריכה מהזירה"
    },
    {
      "start": 3588.4,
      "end": 3592.4,
      "text": "ולכיות שם, אנחנו עולים על זה, אנחנו לא מאפשרים את זה,"
    },
    {
      "start": 3592.4,
      "end": 3594.4,
      "text": "וחבל כי הסורד שלכם ימות."
    },
    {
      "start": 3595.4,
      "end": 3598.4,
      "text": "אתה יכולים לנסות, אבל אינתם ככה"
    },
    {
      "start": 3598.4,
      "end": 3599.4,
      "text": "סופר סופר"
    }
  ]
}