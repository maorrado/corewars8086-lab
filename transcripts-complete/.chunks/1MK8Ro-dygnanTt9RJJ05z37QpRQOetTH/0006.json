      "text": "ימי שבת אותם שעות עם איזה מלים אחרים ידכנו אתכם"
    },
    {
      "start": 6103.04,
      "end": 6105.5599999999995,
      "text": "כל פעם אנחנו ניגע בנושאים קצת אחרים"
    },
    {
      "start": 6105.5599999999995,
      "end": 6107.2,
      "text": "אני ממליץ, כמובן"
    },
    {
      "start": 6107.2,
      "end": 6108.639999999999,
      "text": "וזה ממש חסור"
    },
    {
      "start": 6108.639999999999,
      "end": 6111.2,
      "text": "בין המפגשים הנכמדים שלנו"
    },
    {
      "start": 6111.2,
      "end": 6113.96,
      "text": "לתרגל לחזור על מה שעשינו פה"
    },
    {
      "start": 6113.96,
      "end": 6115.44,
      "text": "להשתמש במקורות שיש"
    },
    {
      "start": 6115.44,
      "end": 6117.96,
      "text": "כן, קובץ הדרכה, מצגת, ארדילים"
    },
    {
      "start": 6117.96,
      "end": 6120.88,
      "text": "מפתיח לכם שהם נדרים דורות על גבי דורות של"
    },
    {
      "start": 6120.88,
      "end": 6123.679999999999,
      "text": "מתחרים בקודגור אקסרים, השתמשו בהם"
    },
    {
      "start": 6123.679999999999,
      "end": 6126.48,
      "text": "ויצם הם המון"
    },
    {
      "start": 6127.72,
      "end": 6130.360000000001,
      "text": "יש פה גם כתבה על טכניקות נקדמות"
    },
    {
      "start": 6130.360000000001,
      "end": 6131.72,
      "text": "וספון ידכים"
    },
    {
      "start": 6131.72,
      "end": 6132.880000000001,
      "text": "לא ארדכם את זה"
    },
    {
      "start": 6132.880000000001,
      "end": 6133.920000000001,
      "text": "אבל..."
    },
    {
      "start": 6133.920000000001,
      "end": 6135.84,
      "text": "והקלטות זום גם של יהודה"
    },
    {
      "start": 6135.84,
      "end": 6137.64,
      "text": "וגם לדעתי"
    },
    {
      "start": 6139.160000000001,
      "end": 6141.72,
      "text": "אם נלך לכל אחת מהאונות"
    },
    {
      "start": 6141.72,
      "end": 6143.76,
      "text": "עונה 18 הנניח"
    },
    {
      "start": 6144.4800000000005,
      "end": 6146.320000000001,
      "text": "אז יש פה עשרות חטיבה"
    },
    {
      "start": 6147.120000000001,
      "end": 6149.280000000001,
      "text": "פה יש עשרות שלי, שם יש עשרות של יהודה"
    },
    {
      "start": 6149.76,
      "end": 6151.84,
      "text": "אתם יכולים להקדים אותי"
    },
    {
      "start": 6151.84,
      "end": 6154.160000000001,
      "text": "אתם יכולים ללכת ולראות מה לימדתי בשנים קודמות"
    },
    {
      "start": 6154.160000000001,
      "end": 6156.8,
      "text": "לא מופתיח שזה יהיה בדיוק אותו דבר באופן סטרילי"
    },
    {
      "start": 6156.88,
      "end": 6158.6,
      "text": "בשבוע שיש לכם, בן מתקשתם התגש"
    },
    {
      "start": 6158.6,
      "end": 6160.04,
      "text": "מאוד ממני צריכם לתרגל"
    },
    {
      "start": 6160.04,
      "end": 6162.68,
      "text": "להתנסות עם אחרו של עמד נועד עכשיו"
    },
    {
      "start": 6162.68,
      "end": 6164.320000000001,
      "text": "לנסות לחדד את ההבנה שלכם"
    },
    {
      "start": 6164.320000000001,
      "end": 6166.4400000000005,
      "text": "וכמובן, כשאתה תחרות התחילה עלות שלה"
    },
    {
      "start": 6166.4400000000005,
      "end": 6168.08,
      "text": "לעבוד על הסורת שלכם"
    },
    {
      "start": 6168.08,
      "end": 6171.04,
      "text": "לכתוב את הסורת שאתם חושבים שיחזיק הכי טוב"
    },
    {
      "start": 6171.04,
      "end": 6172.8,
      "text": "וכן הלאות וכן הלאה"
    },
    {
      "start": 6172.8,
      "end": 6174.4800000000005,
      "text": "מתי מתחילות את התחוריות?"
    },
    {
      "start": 6175.12,
      "end": 6176.52,
      "text": "אני לא זוכר במדויק"
    },
    {
      "start": 6176.52,
      "end": 6178.2,
      "text": "אני מניח שפיצו על זה הודעה"
    },
    {
      "start": 6178.2,
      "end": 6180.2,
      "text": "כאילו, הגשות ראשונות כזה"
    },
    {
      "start": 6180.8,
      "end": 6182.04,
      "text": "במהלך חודש"
    },
    {
      "start": 6182.04,
      "end": 6183.88,
      "text": "אבל השתכותה ושמדויק"
    },
    {
      "start": 6184.88,
      "end": 6185.88,
      "text": "אני אגיד לחנים"
    },
    {
      "start": 6185.88,
      "end": 6186.88,
      "text": "או מנעמד הסמלי"
    },
    {
      "start": 6186.88,
      "end": 6188.88,
      "text": "אני קשור את החלסי לכאן כדי לראות"
    },
    {
      "start": 6188.88,
      "end": 6190.88,
      "text": "אם אני יכול להכנס את הנמידים שלי"
    },
    {
      "start": 6190.88,
      "end": 6192.88,
      "text": "להבין את הרעיון"
    },
    {
      "start": 6192.88,
      "end": 6193.88,
      "text": "זו בעצם אתה אומר"
    },
    {
      "start": 6193.88,
      "end": 6194.88,
      "text": "שאני יכול להתחיל למטה"
    },
    {
      "start": 6194.88,
      "end": 6196.88,
      "text": "את הדברים הבסיסיים שאתה למדת עכשיו"
    },
    {
      "start": 6196.88,
      "end": 6199.88,
      "text": "ויש לי זמן ללמוץ את הטפיקות"
    },
    {
      "start": 6199.88,
      "end": 6200.88,
      "text": "אם אתה מנעמד את הנמידים"
    },
    {
      "start": 6200.88,
      "end": 6202.88,
      "text": "אז אני גם ממליץ"
    },
    {
      "start": 6202.88,
      "end": 6204.88,
      "text": "על התנח בעברית של הסמלי"
    },
    {
      "start": 6204.88,
      "end": 6206.88,
      "text": "הספר למות של גבאים"
    },
    {
      "start": 6206.88,
      "end": 6207.88,
      "text": "שאונן"
    },
    {
      "start": 6207.88,
      "end": 6208.88,
      "text": "אנחנו משתמשים"
    },
    {
      "start": 6208.88,
      "end": 6209.88,
      "text": "הוא כן"
    },
    {
      "start": 6209.88,
      "end": 6210.88,
      "text": "כן, הוא מצוין"
    },
    {
      "start": 6210.88,
      "end": 6212.88,
      "text": "לדעתי אפשר להביא אותם"
    },
    {
      "start": 6212.88,
      "end": 6214.88,
      "text": "כאילו אני יכול להאיד שיולי"
    },
    {
      "start": 6214.88,
      "end": 6215.88,
      "text": "כמה שנים אחרונות"
    },
    {
      "start": 6215.88,
      "end": 6216.88,
      "text": "על מידים פה מכיתה גימל"
    },
    {
      "start": 6216.88,
      "end": 6217.88,
      "text": "ואת כיתה תט"
    },
    {
      "start": 6217.88,
      "end": 6218.88,
      "text": "ולפעמים אפילו יוד ידע לפתבת"
    },
    {
      "start": 6218.88,
      "end": 6219.88,
      "text": "וגם יוד גימל"
    },
    {
      "start": 6219.88,
      "end": 6221.88,
      "text": "היו לי בזוממים האלה"
    },
    {
      "start": 6221.88,
      "end": 6223.88,
      "text": "שקרו להם בהתחלה אחרי עוד חטיבה"
    },
    {
      "start": 6225.88,
      "end": 6227.88,
      "text": "וכולם כזה הסתדרו די טוב"
    },
    {
      "start": 6227.88,
      "end": 6229.88,
      "text": "ואם יוחד בגלל ההעבה הביטימוספרט שלי"
    },
    {
      "start": 6229.88,
      "end": 6230.88,
      "text": "לענות על שאלות"
    },
    {
      "start": 6230.88,
      "end": 6231.88,
      "text": "כל הזמן"
    },
    {
      "start": 6233.88,
      "end": 6234.88,
      "text": "אז אני ממליץ להביא אותם"
    },
    {
      "start": 6234.88,
      "end": 6236.88,
      "text": "אני חושב שזה"
    },
    {
      "start": 6236.88,
      "end": 6237.88,
      "text": "מעשיר את המוח"
    },
    {
      "start": 6237.88,
      "end": 6238.88,
      "text": "זה כמו פאזלים"
    },
    {
      "start": 6238.88,
      "end": 6240.88,
      "text": "ומבינים גם את המוח שלט"
    },
    {
      "start": 6240.88,
      "end": 6242.88,
      "text": "נכון, תודה רבה לכם"
    },
    {
      "start": 6242.88,
      "end": 6243.88,
      "text": "ובאין, תודה רבה"
    },
    {
      "start": 6243.88,
      "end": 6244.88,
      "text": "להזית אותי"
    },
    {
      "start": 6244.88,
      "end": 6245.88,
      "text": "להגיד אותי"
    },
    {
      "start": 6245.88,
      "end": 6247.88,
      "text": "כל השאר, עוד שאלות שיש לכם"
    },
    {
      "start": 6247.88,
      "end": 6249.88,
      "text": "מוזמנים לשאול"
    },
    {
      "start": 6250.88,
      "end": 6252.88,
      "text": "אני ניסיתי להתיק מזה"
    },
    {
      "start": 6252.88,
      "end": 6255.88,
      "text": "יש כזה, יש המון חוברות כאלה"
    },
    {
      "start": 6255.88,
      "end": 6256.88,
      "text": "בשביל הסטרטגיות"
    },
    {
      "start": 6256.88,
      "end": 6259.88,
      "text": "הייתה הסטרטגיה הזאת של המפציץ"
    },
    {
      "start": 6259.88,
      "end": 6261.88,
      "text": "קווה את דירה לייקורל בזה"
    },
    {
      "start": 6261.88,
      "end": 6262.88,
      "text": "אוקי, נכון, אז תעשה ככה"
    },
    {
      "start": 6262.88,
      "end": 6265.88,
      "text": "ואני טקטית הכל אחד לאחד וזה לא עבד לי"
    },
    {
      "start": 6265.88,
      "end": 6267.88,
      "text": "כי הוא היה חלקים שזה לא כתב בכלל"
    },
    {
      "start": 6268.88,
      "end": 6269.88,
      "text": "שזה לא נלד"
    },
    {
      "start": 6269.88,
      "end": 6270.88,
      "text": "אבל"
    },
    {
      "start": 6270.88,
      "end": 6273.88,
      "text": "אני אומר רגע, משלב זה ועל הה, בגדול"
    },
    {
      "start": 6273.88,
      "end": 6276.88,
      "text": "אנחנו סיימנו את המפגש שלנו"
    },
    {
      "start": 6276.88,
      "end": 6278.88,
      "text": "לשבוע, מפה אני כבר רניאל שאלות"
    },
    {
      "start": 6278.88,
      "end": 6279.88,
      "text": "יכולים לי שאלר ולהסתכל"
    },
    {
      "start": 6280.88,
      "end": 6282.88,
      "text": "בשבוע הבא אנחנו נמשיך מהיפה"
    },
    {
      "start": 6282.88,
      "end": 6283.88,
      "text": "שפסקנו, עכשיו לא אומר שאם אני אדבר"
    },
    {
      "start": 6283.88,
      "end": 6285.88,
      "text": "עכשיו אנחנו אומרת להם מתקדם"
    },
    {
      "start": 6285.88,
      "end": 6286.88,
      "text": "אל תדגו, לא תצא יכול לדעת אותו"
    },
    {
      "start": 6286.88,
      "end": 6287.88,
      "text": "לשבוע הבא"
    },
    {
      "start": 6287.88,
      "end": 6289.88,
      "text": "מה שאתם צריכים לדעת לשבוע הבא"
    },
    {
      "start": 6289.88,
      "end": 6291.88,
      "text": "זה מוף, ליבלים, ג'אם"
    },
    {
      "start": 6291.88,
      "end": 6293.88,
      "text": "ומה זה דולר, כתיבה וקריאה"
    },
    {
      "start": 6293.88,
      "end": 6294.88,
      "text": "מה זיכרם שכבר דיברנו עליהם"
    },
    {
      "start": 6296.88,
      "end": 6298.88,
      "text": "אם אני די הבנתי את האו"
    },
    {
      "start": 6298.88,
      "end": 6299.88,
      "text": "אז אני פשר"
    }
  ]
}