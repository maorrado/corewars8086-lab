{
  "source": "1MK8Ro-dygnanTt9RJJ05z37QpRQOetTH.mp4",
  "source_sha256": "d99a861c21e77659a0e28bf8a305b1c46cf60c414484cf63ea6b9835f902f054",
  "model": "small",
  "language": "he",
  "language_probability": 1,
  "start": 5400.0,
  "end": 6300.0,
  "elapsed_seconds": 614.5116429328918,
  "segments": [
    {
      "start": 5400.0,
      "end": 5402.0,
      "text": "שאלות הייתי ברחישות."
    },
    {
      "start": 5404.56,
      "end": 5407.16,
      "text": "אז אפשר להפציץ יותר מהר? יש לזה מחיר?"
    },
    {
      "start": 5407.32,
      "end": 5409.2,
      "text": "ככל שאתה נעשו להפציץ יותר מהר,"
    },
    {
      "start": 5409.32,
      "end": 5412.72,
      "text": "אתם תראו שאתם מפציצים פחות ופחות שלך,"
    },
    {
      "start": 5412.84,
      "end": 5415.04,
      "text": "אתם מומנם מחסים יותר שלך,"
    },
    {
      "start": 5415.16,
      "end": 5418.04,
      "text": "בהרבה יותר מראות כי עכשיו זה היה משהו קזם,"
    },
    {
      "start": 5418.16,
      "end": 5420.04,
      "text": "אבל אתם מפספסים."
    },
    {
      "start": 5420.84,
      "end": 5424.24,
      "text": "משמעותית, איזורים שבהם אנשים אחרים יכולים להימצא."
    },
    {
      "start": 5426.44,
      "end": 5427.44,
      "text": "ניטאי."
    },
    {
      "start": 5428.4400000000005,
      "end": 5433.280000000001,
      "text": "מה שאמרת הקודם שיש רווחים כזה של CCCC,"
    },
    {
      "start": 5433.400000000001,
      "end": 5435.68,
      "text": "זה דיין כאילו לא משנה אותם, עדיין,"
    },
    {
      "start": 5435.8,
      "end": 5438.84,
      "text": "כאילו בשמון עקן יש קצת רווח משמעותי,"
    },
    {
      "start": 5438.960000000001,
      "end": 5442.320000000001,
      "text": "אבל כמו שאמרת הקודם, אם מישהו הולך לתאחרות עם ג'אמפ דולר,"
    },
    {
      "start": 5442.4400000000005,
      "end": 5445.040000000001,
      "text": "הוא די מנסה להפסיד,"
    },
    {
      "start": 5445.160000000001,
      "end": 5448.040000000001,
      "text": "אז כאילו אם הרווח קטן הוא כך, אין כל כך השפעה,"
    },
    {
      "start": 5448.160000000001,
      "end": 5451.280000000001,
      "text": "כי אף אחד לא יהיה קטן מספיק כדי להתקשם בפנים."
    },
    {
      "start": 5451.400000000001,
      "end": 5454.400000000001,
      "text": "או, נקודה מצוינת."
    },
    {
      "start": 5455.040000000001,
      "end": 5456.56,
      "text": "בואו נתעבר על זה, רגע."
    },
    {
      "start": 5457.4400000000005,
      "end": 5458.4400000000005,
      "text": "כן."
    },
    {
      "start": 5461.160000000001,
      "end": 5462.72,
      "text": "בגדול זה קצת לקפוץ קדימה,"
    },
    {
      "start": 5462.84,
      "end": 5466.4400000000005,
      "text": "ואני מותיח שאני גם אראה לכם איך עושים את זה במפגשים הבאים,"
    },
    {
      "start": 5466.56,
      "end": 5468.56,
      "text": "אבל כמו שאפשר לכתוב לזיכרון,"
    },
    {
      "start": 5468.68,
      "end": 5470.8,
      "text": "אפשר גם לקרוא מהזיכרון."
    },
    {
      "start": 5470.92,
      "end": 5475.4400000000005,
      "text": "ואם אפשר לקרוא מהזיכרון, זה אומר גם שאפשר..."
    },
    {
      "start": 5478.400000000001,
      "end": 5480.88,
      "text": "אפשר להסתכל על הזיכרון שקרוא ולכה."
    },
    {
      "start": 5481.000000000001,
      "end": 5484.160000000001,
      "text": "אני יכול להסתכל חמישה בתים, שישה בתים, עשרה בתים,"
    },
    {
      "start": 5484.280000000001,
      "end": 5486.4800000000005,
      "text": "לפני שהדכוניק שלי מתחילה,"
    },
    {
      "start": 5486.64,
      "end": 5490.68,
      "text": "ופשוט לראות אם מישהו כותב שם, אם מישהו כתב לשם משהו."
    },
    {
      "start": 5490.8,
      "end": 5492.96,
      "text": "מה זה אומר? אני יכול לכתוב לשם, נגיד,"
    },
    {
      "start": 5493.080000000001,
      "end": 5494.4800000000005,
      "text": "איי, איי, איי, איי,"
    },
    {
      "start": 5494.96,
      "end": 5497.360000000001,
      "text": "ולבדוק כל פעם האם זה השתנה,"
    },
    {
      "start": 5497.4800000000005,
      "end": 5499.160000000001,
      "text": "ואם זה השתנה סימן שמישהו אחרי כותב לשם,"
    },
    {
      "start": 5499.280000000001,
      "end": 5501.400000000001,
      "text": "ואם מישהו כותב לשם, אני פשוט אברח למקום אחר."
    },
    {
      "start": 5501.52,
      "end": 5502.88,
      "text": "ואפשר לברוח."
    },
    {
      "start": 5503.200000000001,
      "end": 5505.56,
      "text": "וגדר, חגר, גם אם אני לא עושה את הבדיקה הזאת,"
    },
    {
      "start": 5505.68,
      "end": 5507.320000000001,
      "text": "אם יש רבחים או ספיק גדולים,"
    },
    {
      "start": 5507.4400000000005,
      "end": 5509.88,
      "text": "כל מה שבן אדם צריך כדי לברוח,"
    },
    {
      "start": 5510.000000000001,
      "end": 5511.4800000000005,
      "text": "זה בגדול,"
    },
    {
      "start": 5512.280000000001,
      "end": 5514.200000000001,
      "text": "שמונה בתים או..."
    },
    {
      "start": 5514.8,
      "end": 5516.639999999999,
      "text": "עשרה היבטים, לא יותר מזה."
    },
    {
      "start": 5516.76,
      "end": 5518.72,
      "text": "ואם אתה מבציץ לו את הבית,"
    },
    {
      "start": 5518.84,
      "end": 5521.72,
      "text": "הפצצה את הבית, נגיד, ראשון,"
    },
    {
      "start": 5521.84,
      "end": 5523.24,
      "text": "והוא בבית החמישי,"
    },
    {
      "start": 5524.12,
      "end": 5526.599999999999,
      "text": "הוא כפץ לשישי, אתה הפצצה לו את הרביעי,"
    },
    {
      "start": 5526.72,
      "end": 5528.04,
      "text": "הוא כפץ לשמיעי,"
    },
    {
      "start": 5528.599999999999,
      "end": 5530.04,
      "text": "הוא כפץ לשמיני, הוא כפץ לשישי,"
    },
    {
      "start": 5530.16,
      "end": 5531.96,
      "text": "אתה באת על הפצצות טוב בעשירי,"
    },
    {
      "start": 5532.2,
      "end": 5533.24,
      "text": "הוא כבר ברח."
    },
    {
      "start": 5534.44,
      "end": 5535.96,
      "text": "כמו שהתורות שלך מתקדמין,"
    },
    {
      "start": 5536.08,
      "end": 5537.599999999999,
      "text": "גם ההואייב שלך הרבה פעמים,"
    },
    {
      "start": 5537.72,
      "end": 5539.72,
      "text": "לא נשאר סטי."
    },
    {
      "start": 5539.88,
      "end": 5541.0,
      "text": "הוא גם מנסה לזה,"
    },
    {
      "start": 5541.12,
      "end": 5542.92,
      "text": "והוא יכול לבדוק עם הפצצים אותו,"
    },
    {
      "start": 5543.08,
      "end": 5544.72,
      "text": "או שהוא יכול פשוט לברוח משם."
    },
    {
      "start": 5545.04,
      "end": 5546.84,
      "text": "אז זה עונם מעט,"
    },
    {
      "start": 5547.0,
      "end": 5549.92,
      "text": "אבל הצמצום פער הזה, גם ההואייב שלך,"
    },
    {
      "start": 5550.04,
      "end": 5550.56,
      "text": "עושה אותו."
    },
    {
      "start": 5550.68,
      "end": 5551.72,
      "text": "זאת אומרת, יכול שאתה מתקרב אליו,"
    },
    {
      "start": 5551.84,
      "end": 5553.32,
      "text": "הוא לא נשאר במקום, הוא זזקלים."
    },
    {
      "start": 5553.76,
      "end": 5555.76,
      "text": "הוא היה רוצה לחזור להתחלה ולהריץ את זה שוב,"
    },
    {
      "start": 5555.88,
      "end": 5557.52,
      "text": "אבל אם הוא יודע שאתה מנסה לתפוס אותו,"
    },
    {
      "start": 5557.64,
      "end": 5558.92,
      "text": "או לחלופין עם הסטרטגיה שלו,"
    },
    {
      "start": 5559.04,
      "end": 5560.16,
      "text": "היא לזוז כל הזמן מהרבה,"
    },
    {
      "start": 5560.28,
      "end": 5561.08,
      "text": "שזה אפשרי,"
    },
    {
      "start": 5561.24,
      "end": 5562.2,
      "text": "אז הוא יעשה את זה."
    },
    {
      "start": 5563.12,
      "end": 5563.96,
      "text": "אדם."
    },
    {
      "start": 5564.76,
      "end": 5566.28,
      "text": "קודם כל רגע,"
    },
    {
      "start": 5566.4,
      "end": 5569.56,
      "text": "ממתי החלפת את זה ל-0x124 ביישב דל,"
    },
    {
      "start": 5569.68,
      "end": 5570.68,
      "text": "כאילו?"
    },
    {
      "start": 5570.76,
      "end": 5572.8,
      "text": "איפה הכלפתי ל-0x134?"
    },
    {
      "start": 5574.08,
      "end": 5575.56,
      "text": "מופו, בי-x."
    },
    {
      "start": 5576.88,
      "end": 5578.68,
      "text": "הכלפתי את זה מגודלים כשמסיתי להראות את ההבדל"
    },
    {
      "start": 5578.8,
      "end": 5581.280000000001,
      "text": "בין 0x בבחלה ל-h בסוף."
    },
    {
      "start": 5583.4800000000005,
      "end": 5585.96,
      "text": "שזה בגדול אותו דבר בדיוק."
    },
    {
      "start": 5586.240000000001,
      "end": 5587.84,
      "text": "אם אני לא שמת ה-h שימו לב,"
    },
    {
      "start": 5588.68,
      "end": 5590.76,
      "text": "אוקיי, רואים את ההבדל בצד פה?"
    },
    {
      "start": 5591.72,
      "end": 5593.56,
      "text": "אוקיי."
    },
    {
      "start": 5593.8,
      "end": 5595.08,
      "text": "מה שזה בעצם אומר,"
    },
    {
      "start": 5595.280000000001,
      "end": 5597.4800000000005,
      "text": "זה, כשאני כותב את זה פשוט ככה,"
    },
    {
      "start": 5597.6,
      "end": 5600.4800000000005,
      "text": "זה פשוט אומר המספר 1,234,"
    },
    {
      "start": 5600.96,
      "end": 5603.360000000001,
      "text": "וכשהניסם h זה בעצם אומר"
    },
    {
      "start": 5603.4800000000005,
      "end": 5605.64,
      "text": "לא 1234 אלא"
    },
    {
      "start": 5606.64,
      "end": 5608.0,
      "text": "המספר ה-x עד עצמאלי,"
    },
    {
      "start": 5608.12,
      "end": 5611.4800000000005,
      "text": "1234 שבו בעצם 0x1001,"
    },
    {
      "start": 5611.8,
      "end": 5613.16,
      "text": "0x1001,"
    },
    {
      "start": 5613.96,
      "end": 5616.280000000001,
      "text": "0x1001, 0x1001."
    },
    {
      "start": 5616.52,
      "end": 5617.4800000000005,
      "text": "אם תנסו לתרגם אותו,"
    },
    {
      "start": 5617.6,
      "end": 5619.280000000001,
      "text": "תקבלו נספר כל שהוא,"
    },
    {
      "start": 5619.400000000001,
      "end": 5621.92,
      "text": "אבל הוא לא 1234,"
    },
    {
      "start": 5622.04,
      "end": 5623.16,
      "text": "יכול להיות שהוא יותר גדול."
    },
    {
      "start": 5626.04,
      "end": 5627.400000000001,
      "text": "שאלה שנייה שיש לי,"
    },
    {
      "start": 5627.52,
      "end": 5630.4800000000005,
      "text": "זה, אמרת אתה יכול לכתוב לזיכרון,"
    },
    {
      "start": 5630.4800000000005,
      "end": 5632.360000000001,
      "text": "בעצם משהו שהוא לא חוקי,"
    },
    {
      "start": 5632.4800000000005,
      "end": 5634.4800000000005,
      "text": "כמו 0x1001,"
    },
    {
      "start": 5634.6,
      "end": 5635.4800000000005,
      "text": "נכון?"
    },
    {
      "start": 5635.6,
      "end": 5636.200000000001,
      "text": "נכון."
    },
    {
      "start": 5636.320000000001,
      "end": 5638.72,
      "text": "אז האם אני יכול גם לכתוב לזיכרון"
    },
    {
      "start": 5638.84,
      "end": 5640.000000000001,
      "text": "משהו שהוא כן חוקי,"
    },
    {
      "start": 5640.120000000001,
      "end": 5642.56,
      "text": "כאילו ואז לדלג על העניין?"
    },
    {
      "start": 5643.4800000000005,
      "end": 5645.080000000001,
      "text": "או שזה משהו שאני לא יכול לשנות?"
    },
    {
      "start": 5648.240000000001,
      "end": 5649.360000000001,
      "text": "הדרך הכי דבר לגדוק את זה,"
    },
    {
      "start": 5649.4800000000005,
      "end": 5650.080000000001,
      "text": "היא לעשות אין זון,"
    },
    {
      "start": 5650.200000000001,
      "end": 5650.76,
      "text": "בוא נמיד שעשרה,"
    },
    {
      "start": 5650.88,
      "end": 5651.96,
      "text": "ראות למה רוצה לברוח."
    },
    {
      "start": 5652.88,
      "end": 5653.68,
      "text": "בוא נעשה,"
    },
    {
      "start": 5655.360000000001,
      "end": 5656.200000000001,
      "text": "בוא נגיד"
    },
    {
      "start": 5658.56,
      "end": 5659.84,
      "text": "עד ע-x,"
    },
    {
      "start": 5660.0,
      "end": 5660.92,
      "text": "בוא נעשה ככה."
    },
    {
      "start": 5662.28,
      "end": 5664.8,
      "text": "מוב ax bx,"
    },
    {
      "start": 5665.28,
      "end": 5666.72,
      "text": "לא, bx ax, זה לא,"
    },
    {
      "start": 5666.84,
      "end": 5669.32,
      "text": "אני שם בbx את כתובת ההתחלה שלנו,"
    },
    {
      "start": 5669.96,
      "end": 5670.84,
      "text": "אני מוסיף"
    },
    {
      "start": 5671.4800000000005,
      "end": 5673.4400000000005,
      "text": "לבי x 200,"
    },
    {
      "start": 5674.96,
      "end": 5675.4800000000005,
      "text": "אוקיי?"
    },
    {
      "start": 5676.56,
      "end": 5677.92,
      "text": "אחרי שעשבתי ל-200,"
    },
    {
      "start": 5679.12,
      "end": 5680.4800000000005,
      "text": "אני בעצם"
    },
    {
      "start": 5682.4800000000005,
      "end": 5683.32,
      "text": "נגידי עשה,"
    },
    {
      "start": 5685.0,
      "end": 5687.32,
      "text": "מוב bx"
    },
    {
      "start": 5687.32,
      "end": 5688.32,
      "text": "עד ע-x,"
    },
    {
      "start": 5689.32,
      "end": 5690.32,
      "text": "וע-x,"
    },
    {
      "start": 5691.32,
      "end": 5692.679999999999,
      "text": "מישהו זוכר כותבים"
    },
    {
      "start": 5692.799999999999,
      "end": 5693.799999999999,
      "text": "jump dollar,"
    },
    {
      "start": 5694.32,
      "end": 5695.32,
      "text": "גם אם לא, אני אדשאות,"
    },
    {
      "start": 5695.44,
      "end": 5696.44,
      "text": "תקודפות,"
    },
    {
      "start": 5696.5599999999995,
      "end": 5697.5599999999995,
      "text": "וע-x,"
    },
    {
      "start": 5697.679999999999,
      "end": 5698.679999999999,
      "text": "פירות,"
    },
    {
      "start": 5698.799999999999,
      "end": 5699.799999999999,
      "text": "e-b-f-e,"
    },
    {
      "start": 5700.32,
      "end": 5700.799999999999,
      "text": "אני כותב,"
    },
    {
      "start": 5700.92,
      "end": 5702.32,
      "text": "f-e-e-b,"
    },
    {
      "start": 5702.44,
      "end": 5703.44,
      "text": "למה?"
    },
    {
      "start": 5704.32,
      "end": 5705.32,
      "text": "לא רוצה להתחיל לסביר לכם"
    },
    {
      "start": 5705.44,
      "end": 5706.32,
      "text": "על little and young"
    },
    {
      "start": 5706.44,
      "end": 5707.04,
      "text": "וbig and young,"
    },
    {
      "start": 5707.16,
      "end": 5708.32,
      "text": "אבל כשכותבים לזיכרון,"
    },
    {
      "start": 5708.44,
      "end": 5709.2,
      "text": "צריך לכתוב"
    },
    {
      "start": 5709.32,
      "end": 5710.32,
      "text": "את השני בתים האחרונים,"
    },
    {
      "start": 5710.44,
      "end": 5711.5199999999995,
      "text": "ואז את השני בתים הראשונים,"
    },
    {
      "start": 5711.639999999999,
      "end": 5712.759999999999,
      "text": "בתוך כל"
    },
    {
      "start": 5712.88,
      "end": 5713.88,
      "text": "וע-x,"
    },
