{
  "source": "1MK8Ro-dygnanTt9RJJ05z37QpRQOetTH.mp4",
  "source_sha256": "d99a861c21e77659a0e28bf8a305b1c46cf60c414484cf63ea6b9835f902f054",
  "model": "small",
  "language": "he",
  "language_probability": 1,
  "start": 1800.0,
  "end": 2700.0,
  "elapsed_seconds": 605.8534677028656,
  "segments": [
    {
      "start": 1800.0,
      "end": 1804.64,
      "text": "זומר ש-AB לדוגמה זה 1.0, 1.0, 1.0, 1.0."
    },
    {
      "start": 1804.88,
      "end": 1808.52,
      "text": "מתנדם המיץ שרוצה לנסות לתרגם את הקולט שיש לנו פה,"
    },
    {
      "start": 1809.2,
      "end": 1811.0,
      "text": "או לפחות את השורה הראשונה,"
    },
    {
      "start": 1811.36,
      "end": 1814.6,
      "text": "לאפסים ואחדים, בדיוק כמו ש-CPU היה קר שנה נעושה."
    },
    {
      "start": 1816.84,
      "end": 1818.32,
      "text": "די נורא, תוך יש מתנדם."
    },
    {
      "start": 1820.52,
      "end": 1822.24,
      "text": "אחוז מיניטאי של קוריץ שטף הרוול."
    },
    {
      "start": 1823.36,
      "end": 1824.88,
      "text": "גם ירין שיש את הטפלא רעד."
    },
    {
      "start": 1831.0,
      "end": 1834.0,
      "text": "ארבעה עשר צופים שקטים זה לא ארבעה עשר, זה אחת עשר."
    },
    {
      "start": 1834.08,
      "end": 1835.0,
      "text": "שרות."
    },
    {
      "start": 1837.48,
      "end": 1838.48,
      "text": "מישהו?"
    },
    {
      "start": 1839.6,
      "end": 1840.76,
      "text": "אפשר לנסות."
    },
    {
      "start": 1840.84,
      "end": 1842.0,
      "text": "בטח, בסמך."
    },
    {
      "start": 1842.6,
      "end": 1843.6,
      "text": "אוקיי."
    },
    {
      "start": 1843.92,
      "end": 1847.52,
      "text": "אז המשימה היא לקחת"
    },
    {
      "start": 1850.56,
      "end": 1853.36,
      "text": "את שש ספרות האלה ולאמיר אותן"
    },
    {
      "start": 1854.4,
      "end": 1857.92,
      "text": "לנוכיות פתרון פרקטים."
    },
    {
      "start": 1858.72,
      "end": 1861.92,
      "text": "לנוכיות פתרון המשימה יש לך פה את..."
    },
    {
      "start": 1863.2,
      "end": 1864.2,
      "text": "את זה. קלים."
    },
    {
      "start": 1873.3600000000001,
      "end": 1876.3600000000001,
      "text": "מאמנית לכם גם לנסות עם עצמכם עם דף לי פרוונים, אתם מפעלים."
    },
    {
      "start": 1876.44,
      "end": 1877.96,
      "text": "לא לגלות את השורה כמובן."
    },
    {
      "start": 1878.8000000000002,
      "end": 1883.16,
      "text": "אני לא רואה מילכך את החידה, כי זה לא מרריק, אבל..."
    },
    {
      "start": 1885.3200000000002,
      "end": 1886.6000000000001,
      "text": "זה אלכס, נכון?"
    },
    {
      "start": 1886.68,
      "end": 1887.68,
      "text": "כן."
    },
    {
      "start": 1887.68,
      "end": 1888.68,
      "text": "אז..."
    },
    {
      "start": 1889.96,
      "end": 1890.96,
      "text": "יאללה."
    },
    {
      "start": 1897.68,
      "end": 1899.48,
      "text": "אני בקור פתרתי פשוט אומר."
    },
    {
      "start": 1901.28,
      "end": 1904.96,
      "text": "נראו לך, לשמור לעצמך ולתת לאחרים לנסת תופתור."
    },
    {
      "start": 1912.4,
      "end": 1913.4,
      "text": "שיאמתי."
    },
    {
      "start": 1913.88,
      "end": 1916.6000000000001,
      "text": "אוקיי. מגניב, רוצה להגיד לנו מהיצא?"
    },
    {
      "start": 1918.64,
      "end": 1920.04,
      "text": "זה דיירוך."
    },
    {
      "start": 1920.8,
      "end": 1921.8400000000001,
      "text": "תקריאה, אנחנו נותנים."
    },
    {
      "start": 1924.8,
      "end": 1926.3600000000001,
      "text": "תקריאה. אנחנו נתקשיב."
    },
    {
      "start": 1944.0800000000002,
      "end": 1945.6000000000001,
      "text": "נכון מאוד. יפה."
    },
    {
      "start": 1945.6000000000001,
      "end": 1947.6000000000001,
      "text": "זה בגניב."
    },
    {
      "start": 1947.68,
      "end": 1952.2800000000002,
      "text": "אפשר לעשות עד אחד, אם יהיה אז ישה למסת?"
    },
    {
      "start": 1952.3600000000001,
      "end": 1953.6000000000001,
      "text": "אם יהיו חידות, תקריאה."
    },
    {
      "start": 1953.68,
      "end": 1955.3600000000001,
      "text": "זוכה שאני מפתרה לבשות..."
    },
    {
      "start": 1956.1200000000001,
      "end": 1957.1200000000001,
      "text": "אה, אבל..."
    },
    {
      "start": 1957.2,
      "end": 1961.72,
      "text": "להתת לי את זום השנייה, ואני קצת מבולבן על איך הוא הגיע לכל כך הרבה הפסים."
    },
    {
      "start": 1962.68,
      "end": 1965.3200000000002,
      "text": "אוקיי. איך הוא הגיע לכל כך הרבה הפסים?"
    },
    {
      "start": 1965.4,
      "end": 1969.16,
      "text": "וגדול יש פה שש ספרות, שאמרנו שכל אחד מהספרות"
    },
    {
      "start": 1969.3200000000002,
      "end": 1971.1200000000001,
      "text": "אין בעצם..."
    },
    {
      "start": 1971.96,
      "end": 1975.6000000000001,
      "text": "אין בעצם ארבעה מספרים בן ארים,"
    },
    {
      "start": 1975.68,
      "end": 1977.3600000000001,
      "text": "שזה בעצם 24 ספורות,"
    },
    {
      "start": 1977.44,
      "end": 1979.0800000000002,
      "text": "וזה היה לשביל לכם כמו כך הרבה הפסים,"
    },
    {
      "start": 1979.16,
      "end": 1982.16,
      "text": "כי היה אחד שהתחבש שם באמצע, אני אראה לכם אותו."
    },
    {
      "start": 1982.3600000000001,
      "end": 1986.3600000000001,
      "text": "אז אמרנו שזה בעצם אחד אפס אחד אחד,"
    },
    {
      "start": 1986.44,
      "end": 1987.88,
      "text": "אחד אפס אפס אפס,"
    },
    {
      "start": 1987.96,
      "end": 1990.52,
      "text": "ואז מה שהוא יקראי, מה שאתם שמעתם,"
    },
    {
      "start": 1990.6000000000001,
      "end": 1991.88,
      "text": "זה בגדול, החל מהנקודה הזאת,"
    },
    {
      "start": 1991.96,
      "end": 1993.16,
      "text": "אני שם פה איזשהו שמעת,"
    },
    {
      "start": 1993.24,
      "end": 1995.0,
      "text": "שמעתם אחד אפס אפס אפס,"
    },
    {
      "start": 1995.0800000000002,
      "end": 1996.4,
      "text": "ואז שמעתם..."
    },
    {
      "start": 1997.4,
      "end": 2002.16,
      "text": "אפס אפס אפס אחד, אפס אפס אפס אפס אפס,"
    },
    {
      "start": 2002.24,
      "end": 2004.3600000000001,
      "text": "היא עצה ספציטית מספר שיש בו המון המון הפסים,"
    },
    {
      "start": 2004.44,
      "end": 2005.6000000000001,
      "text": "ובגלל זה זה המשפט..."
    },
    {
      "start": 2005.68,
      "end": 2007.88,
      "text": "חשב, אפס אפס אחד, אפס אפס האלה,"
    },
    {
      "start": 2007.96,
      "end": 2010.44,
      "text": "זה כאילו המספר, המספר ארבע,"
    },
    {
      "start": 2010.52,
      "end": 2012.4,
      "text": "לא כל אחד מהם, זה כאילו לבד?"
    },
    {
      "start": 2012.8400000000001,
      "end": 2014.24,
      "text": "זה כל אחד מהם הוא לבד,"
    },
    {
      "start": 2014.3200000000002,
      "end": 2015.64,
      "text": "ואנחנו עכשיו מגיעים לנושא שקצת,"
    },
    {
      "start": 2015.72,
      "end": 2017.0,
      "text": "הוא זכר פה כספוי לנגנקודם,"
    },
    {
      "start": 2017.0800000000002,
      "end": 2017.8400000000001,
      "text": "ואני אראה להסכיר אותו."
    },
    {
      "start": 2017.92,
      "end": 2019.2800000000002,
      "text": "בגדול כך אני ראה את החלוקה,"
    },
    {
      "start": 2019.3600000000001,
      "end": 2021.0400000000002,
      "text": "אנחנו לא כותבים אותה בשום מקום,"
    },
    {
      "start": 2021.1200000000001,
      "end": 2022.4,
      "text": "אבל החלוקה קורת,"
    },
    {
      "start": 2022.4,
      "end": 2024.2,
      "text": "וזה בעצם אחד אפס אפס אפס אפס אפס זה בי,"
    },
    {
      "start": 2024.2800000000002,
      "end": 2026.64,
      "text": "אכד אפס אפס אפס זה שמונה,"
    },
    {
      "start": 2026.72,
      "end": 2028.2800000000002,
      "text": "אפס אפס אפס אפס אחד, זה אחד,"
    },
    {
      "start": 2028.3600000000001,
      "end": 2031.0400000000002,
      "text": "ומלא很 יפסים זה פשוט אפס אפס ואפס."
    },
    {
      "start": 2032.0800000000002,
      "end": 2033.2800000000002,
      "text": "ויש שם לדבר הזה."
    },
    {
      "start": 2033.3600000000001,
      "end": 2034.8400000000001,
      "text": "ואנחנו עכשיו נתחיל להתת להם שמאות"
    },
    {
      "start": 2034.92,
      "end": 2035.96,
      "text": "כדי שיהיה לנו יותר קל בבקל."
    },
    {
      "start": 2036.0400000000002,
      "end": 2037.72,
      "text": "יש לך תאות אחת, חסיך נ億ר 謝謝."
    },
    {
      "start": 2038.52,
      "end": 2040.4,
      "text": "חסיכם נורא Chrat, חסיכם נכון."
    },
    {
      "start": 2040.48,
      "end": 2041.16,
      "text": "תודה רבה."
    },
    {
      "start": 2042.24,
      "end": 2043.76,
      "text": "אפס אפס אפס אפס?"
    },
    {
      "start": 2044.6000000000001,
      "end": 2045.6000000000001,
      "text": "נכון, תודה רבה."
    },
    {
      "start": 2047.3200000000002,
      "end": 2049.28,
      "text": "בואו נדבר על איך קורים לגד litres,"
    },
    {
      "start": 2049.28,
      "end": 2051.28,
      "text": "ואנחנו צריכים לתחיל לדבר מושגים"
    },
    {
      "start": 2051.28,
      "end": 2054.94,
      "text": "אז לספר, לספר אחת, שיו 0 או 1, קוראים ביט"
    },
    {
      "start": 2054.94,
      "end": 2056.94,
      "text": "אם מישהו פה, אי פעם שמה את המילה ביט"
    },
    {
      "start": 2056.94,
      "end": 2060.36,
      "text": "אז זה מה שזה אומר ביטקוין, גם, פומש למילה הזאת"
    },
    {
      "start": 2060.36,
      "end": 2065.28,
      "text": "אני אגיד שיש איזושהי אמונה שאומרת שמי שמציא את השמות"
    },
    {
      "start": 2065.28,
      "end": 2067.28,
      "text": "נורא נורא אוהב לאכול כריכים"
    },
    {
      "start": 2067.28,
      "end": 2068.48,
      "text": "ואני כבר הסביר את זה"
    },
    {
      "start": 2068.48,
      "end": 2071.36,
      "text": "ביט חתיכה קטנה, בחתיכה קטנה ביותר"
    },
    {
      "start": 2071.36,
      "end": 2073.36,
      "text": "P או 0 או 1"
    },
    {
      "start": 2074.6200000000003,
      "end": 2075.6200000000003,
      "text": "מגניב"
    },
    {
      "start": 2076.28,
      "end": 2078.28,
      "text": "ארבעה ביטים יוצרים מה שנקרא"
    },
    {
      "start": 2078.28,
      "end": 2080.28,
      "text": "ניבל, אוקיי"
    },
    {
      "start": 2080.28,
      "end": 2084.28,
      "text": "ניבל, למי שלא יודע, זה ביס קטן כזה באנגלית"
    },
    {
      "start": 2084.28,
      "end": 2086.28,
      "text": "קצת כמו לנשני"
    },
    {
      "start": 2086.28,
      "end": 2090.28,
      "text": "ניבל הוא ארבעה ספרות, ארבעה ביטים"
    },
    {
      "start": 2092.28,
      "end": 2093.28,
      "text": "מגניב"
    },
    {
      "start": 2093.28,
      "end": 2098.28,
      "text": "בית, שזה עיווד של המילה בית, כן, ביס"
    },
    {
      "start": 2098.28,
      "end": 2100.28,
      "text": "בית הוא שני ניבלים"
    },
    {
      "start": 2102.28,
      "end": 2104.28,
      "text": "או, אם תרצו, שני ניבלים"
    },
    {
      "start": 2105.28,
      "end": 2106.28,
      "text": "אוקיי"
    },
    {
      "start": 2107.28,
      "end": 2108.28,
      "text": "מגניב"
    },
    {
      "start": 2108.28,
      "end": 2111.28,
      "text": "אחרי בית יש וורד, שזה שני בתים"
    },
    {
      "start": 2113.28,
      "end": 2114.28,
      "text": "יש דבל וורד"
    },
    {
      "start": 2115.28,
      "end": 2117.28,
      "text": "שזה שני וורד"
    },
    {
      "start": 2117.28,
      "end": 2120.28,
      "text": "אני לא ייכנס מהלבר לזה, יש גם שמות"
    },
    {
      "start": 2120.28,
      "end": 2123.28,
      "text": "למה, למה אני לא נכנס, כי מכאן בהלע"
    },
    {
      "start": 2123.28,
      "end": 2125.28,
      "text": "יש מולכים שכולכם מכירים"
    },
    {
      "start": 2125.28,
      "end": 2126.28,
      "text": "קילוביץ"
    },
    {
      "start": 2126.28,
      "end": 2128.28,
      "text": "קילוביץ, מגביץ"
    },
    {
      "start": 2129.28,
      "end": 2130.28,
      "text": "ספוילרים"
    },
    {
      "start": 2130.28,
      "end": 2131.28,
      "text": "מגביץ"
    },
    {
      "start": 2131.28,
      "end": 2132.28,
      "text": "קיגביץ"
    },
    {
      "start": 2132.28,
      "end": 2133.28,
      "text": "תראה בית"
    },
    {
      "start": 2133.28,
      "end": 2137.28,
      "text": "אבל אני אשמח שזה, אני אשמח הספר הסביר"
    },
    {
      "start": 2137.28,
      "end": 2139.28,
      "text": "אבל תודה, זה נכון"
    },
    {
      "start": 2139.28,
      "end": 2142.28,
      "text": "אז קילוביץ, שמסומן גם בדרך כלל קיי-בי"
    },
    {
      "start": 2142.28,
      "end": 2144.28,
      "text": "נכון? אני לא תראה, כן"
    },
    {
      "start": 2144.28,
      "end": 2147.28,
      "text": "קיי-בי, שזה בעצם קילו, כמו קילוגרם"
    },
    {
      "start": 2147.28,
      "end": 2149.28,
      "text": "כמו קילומטל, אלף"
    },
    {
      "start": 2149.28,
      "end": 2150.28,
      "text": "בית"
    },
    {
      "start": 2152.28,
      "end": 2154.28,
      "text": "אוקיי"
    },
    {
      "start": 2155.28,
      "end": 2158.28,
      "text": "מאוד, אז קילו בית, שזה אלף בית"
    },
    {
      "start": 2158.28,
      "end": 2160.28,
      "text": "יש לנו מגביץ"
    },
    {
      "start": 2161.28,
      "end": 2164.28,
      "text": "אני לא זוכר, אני חושב שזה אלף קילו בית"
    },
    {
      "start": 2164.28,
      "end": 2166.28,
      "text": "נראה לי"
    },
    {
      "start": 2167.28,
      "end": 2170.28,
      "text": "אלף קילו בית"
    },
    {
      "start": 2170.28,
      "end": 2172.28,
      "text": "ואז יש טרבית"
    },
    {
      "start": 2172.28,
      "end": 2174.28,
      "text": "לא"
    },
    {
      "start": 2175.28,
      "end": 2176.28,
      "text": "יש מגביץ בית"
    },
    {
      "start": 2176.28,
      "end": 2177.28,
      "text": "טרבית"
    },
    {
      "start": 2177.28,
      "end": 2178.28,
      "text": "בית הבית"
    },
    {
      "start": 2178.28,
      "end": 2180.28,
      "text": "וכן, אבל כן, ארא"
    },
    {
      "start": 2181.28,
      "end": 2183.28,
      "text": "נגביץ, נכון"
    },
    {
      "start": 2183.28,
      "end": 2185.28,
      "text": "גגן, נכון, גם גגן"
    },
    {
      "start": 2185.28,
      "end": 2187.28,
      "text": "מגביץ, גגביץ, טרבית"
    },
    {
      "start": 2187.28,
      "end": 2189.28,
      "text": "וכן ארא, יהיו את הבית"
    },
    {
      "start": 2189.28,
      "end": 2191.28,
      "text": "הוות הבית וכל אלה"
    },
    {
      "start": 2191.28,
      "end": 2195.28,
      "text": "אבל המילים שאתם תפקשו בעיקר"
    },
    {
      "start": 2195.28,
      "end": 2199.28,
      "text": "ספציפית בעבודה כזה עם הסמלר של 8.86"
    },
    {
      "start": 2199.28,
      "end": 2201.28,
      "text": "זה פשוט סוג מסוים של"
    },
    {
      "start": 2201.28,
      "end": 2205.28,
      "text": "מהבד או מהרכת"
    },
    {
      "start": 2205.28,
      "end": 2207.28,
      "text": "המילים שאתם תפקשו בעיקר זה World Bight"
    },
    {
      "start": 2207.28,
      "end": 2209.28,
      "text": "זהו, אתם לא רק כך תפקשו ניבל"
    },
    {
      "start": 2209.28,
      "end": 2211.28,
      "text": "אתם גם לא רק כך תפקשו"
    },
    {
      "start": 2211.28,
      "end": 2213.28,
      "text": "כי לא עובדים אופן כמעט"
    },
    {
      "start": 2213.28,
      "end": 2215.28,
      "text": "ביטים בודדים"
    },
    {
      "start": 2215.28,
      "end": 2217.28,
      "text": "כמעט"
    },
    {
      "start": 2217.28,
      "end": 2221.28,
      "text": "אז עכשיו כשאנחנו יודעים לא רק איך מחשבים עובדים"
    },
    {
      "start": 2221.28,
      "end": 2223.28,
      "text": "אלא גם איך הם יחסנים מידע"
    },
    {
      "start": 2223.28,
      "end": 2225.28,
      "text": "ועכשיו אנחנו גם יודעים"
    },
    {
      "start": 2225.28,
      "end": 2227.28,
      "text": "שבגדול"
    },
    {
      "start": 2227.28,
      "end": 2229.28,
      "text": "כל קוד מתורגם"
    },
    {
      "start": 2229.28,
      "end": 2231.28,
      "text": "לעסמלי"
    },
    {
      "start": 2231.28,
      "end": 2233.28,
      "text": "וכל קוד בעסמלי הוא בסך"
    },
    {
      "start": 2233.28,
      "end": 2235.28,
      "text": "המילון"
    },
    {
      "start": 2235.28,
      "end": 2237.28,
      "text": "לדבר הזה"
    },
    {
      "start": 2237.28,
      "end": 2239.28,
      "text": "שכבר הוכח כפי אופסים ואר אחדים"
    },
    {
      "start": 2239.28,
      "end": 2241.28,
      "text": "אז קודם כל מזל טוב"
    },
    {
      "start": 2241.28,
      "end": 2243.28,
      "text": "גיליתם שהכל זה אופסים ואר אחדים"
    },
    {
      "start": 2243.28,
      "end": 2245.28,
      "text": "הייתי שם פה את המים של"
    },
    {
      "start": 2245.28,
      "end": 2247.28,
      "text": "שמי שמכיר עם האסטרונאוטים"
    },
    {
      "start": 2247.28,
      "end": 2249.28,
      "text": "אבל אין זמן"
    },
    {
      "start": 2249.28,
      "end": 2251.28,
      "text": "אז הבנו שכל תכנית שנכתבה"
    },
    {
      "start": 2251.28,
      "end": 2253.28,
      "text": "או נכתבת"
    },
    {
      "start": 2253.28,
      "end": 2255.28,
      "text": "או דברים כאלה"
    },
    {
      "start": 2255.28,
      "end": 2257.28,
      "text": "הכל זה בעצם אופסים ואחדים"
    },
    {
      "start": 2257.28,
      "end": 2259.28,
      "text": "וכאן אנחנו מקבלים אולי איזשהי תשובה לשאלה"
    },
    {
      "start": 2259.28,
      "end": 2261.28,
      "text": "למה בכלל רלוונטי ללמוד עסמלי"
    },
    {
      "start": 2261.28,
      "end": 2263.28,
      "text": "אז רלוונטי ללמוד עסמלי"
    },
    {
      "start": 2263.28,
      "end": 2265.28,
      "text": "משתי סיבות עיקריות"
    },
    {
      "start": 2265.28,
      "end": 2267.28,
      "text": "אה, לפה קוד שלנו תמיד תורגם להסמלי"
    },
    {
      "start": 2267.28,
      "end": 2269.28,
      "text": "כן"
    },
    {
      "start": 2269.28,
      "end": 2271.28,
      "text": "שזה בעצם אומר"
    },
    {
      "start": 2271.28,
      "end": 2273.28,
      "text": "שהקוד שלנו אם ירצה"
    },
    {
      "start": 2273.28,
      "end": 2275.28,
      "text": "ואם לא בסוף פועל בעסמלי"
    },
    {
      "start": 2275.28,
      "end": 2277.28,
      "text": "או פועל בספת מכונה"
    },
    {
      "start": 2277.28,
      "end": 2279.28,
      "text": "שזה בערך אותו דבר כמו שראינו"
    },
    {
      "start": 2279.28,
      "end": 2281.28,
      "text": "כן, זה ספת מכונה, זה הסמלי"
    },
    {
      "start": 2281.28,
      "end": 2283.28,
      "text": "והם מתורגמים ברמת השורה-שורה"
    },
    {
      "start": 2283.28,
      "end": 2285.28,
      "text": "כמעט אין לנו מקומות אחרים שקורה בהם"
    },
    {
      "start": 2285.28,
      "end": 2287.28,
      "text": "תרגום של רמת השורה-שורה"
    },
    {
      "start": 2289.28,
      "end": 2291.28,
      "text": "זה הסיבה הראשונה"
    },
    {
      "start": 2291.28,
      "end": 2293.28,
      "text": "והסיבה השנייה שכל קוד שנכתב"
    },
    {
      "start": 2293.28,
      "end": 2295.28,
      "text": "בכל שפה"
    },
    {
      "start": 2295.28,
      "end": 2297.28,
      "text": "רץ בסוף בעסמלי אמרו לזה כבר"
    },
    {
      "start": 2297.28,
      "end": 2299.28,
      "text": "וניתן"
    },
    {
      "start": 2299.28,
      "end": 2301.28,
      "text": "לקרוא אותו, אין מה לעשות"
    },
    {
      "start": 2301.28,
      "end": 2303.28,
      "text": "זאת אומרת, אם בן אדם"
    },
    {
      "start": 2303.28,
      "end": 2305.28,
      "text": "כתב איזשהו קוד"
    },
    {
      "start": 2305.28,
      "end": 2307.28,
      "text": "לא משנה כמה הוא ירצה להסתיר אותו ממני"
    },
    {
      "start": 2307.28,
      "end": 2309.28,
      "text": "אם יש לי את ה-IXI, יש לי את ה-XLQ"
    },
    {
      "start": 2309.28,
      "end": 2311.28,
      "text": "אני יכול לקרוא את הקוד שלו"
    },
    {
      "start": 2311.28,
      "end": 2313.28,
      "text": "אני יכול לקרוא אותו בעסמלי"
    },
    {
      "start": 2313.28,
      "end": 2315.28,
      "text": "שזה מאוד מאוד מאוד יקשה עליי"
    },
    {
      "start": 2315.28,
      "end": 2317.28,
      "text": "אני מרתי אחריכים שאתם עושה לקרוא קוד בעסמלי"
    },
    {
      "start": 2317.28,
      "end": 2319.28,
      "text": "של תוכנית שלא נכתבה בעסמלי"
    },
    {
      "start": 2319.28,
      "end": 2321.28,
      "text": "היא התוכנית שנכתבה בה"
    },
    {
      "start": 2321.28,
      "end": 2323.28,
      "text": "ואני אפילו אומר C, איסי זאת יחסית קל"
    },
    {
      "start": 2323.28,
      "end": 2325.28,
      "text": "אבל ג'ווה, C-Sharp, Python, ג'ווה סקרקט"
    },
    {
      "start": 2325.28,
      "end": 2327.28,
      "text": "אני גם אומר שמרות של ספות שאנשים נוראו"
    },
    {
      "start": 2327.28,
      "end": 2329.28,
      "text": "ואין פשוט נזכר אתם"
    },
    {
      "start": 2329.28,
      "end": 2331.28,
      "text": "כל שפה תכנות כזאת שאתם תראו"
    },
    {
      "start": 2331.28,
      "end": 2333.28,
      "text": "כל שלה היום"
    },
    {
      "start": 2333.28,
      "end": 2335.28,
      "text": "יהיה לכם נורא נורא קשה להבין"
    },
    {
      "start": 2335.28,
      "end": 2337.28,
      "text": "מי שמכיר את כל תחום הריברסינג"
    },
    {
      "start": 2337.28,
      "end": 2339.28,
      "text": "כל תחום הריברסינג בנוי"
    },
    {
      "start": 2339.28,
      "end": 2341.28,
      "text": "בגידול על זה שאתה לוקח"
    },
    {
      "start": 2341.28,
      "end": 2343.28,
      "text": "קובץ הרצה של תוכנית"
    },
    {
      "start": 2343.28,
      "end": 2345.28,
      "text": "שמישהו כתב"
    },
    {
      "start": 2345.28,
      "end": 2347.28,
      "text": "הוא לא מוכן, הוא לא ייתן לך"
    },
    {
      "start": 2347.28,
      "end": 2349.28,
      "text": "בחיים לראות את קוד המקור"
    },
    {
      "start": 2349.28,
      "end": 2351.28,
      "text": "אבל אתה יכול להסתכל על הקוד בעסמלי"
    },
    {
      "start": 2351.28,
      "end": 2353.28,
      "text": "כי הוא לא יכול להסתיר איזם ממך"
    },
    {
      "start": 2353.28,
      "end": 2355.28,
      "text": "אתה מסתכל על האסמלי"
    },
    {
      "start": 2355.28,
      "end": 2357.28,
      "text": "ואתה יכול להבין מה עושה שם"
    },
    {
      "start": 2357.28,
      "end": 2359.28,
      "text": "אתה גם יכול לשנות את הקוד שהוא כתב"
    },
    {
      "start": 2359.28,
      "end": 2361.28,
      "text": "אתה גם יכול לגרום לקוד לעשות בריים שהוא לא יתכם"
    },
    {
      "start": 2361.28,
      "end": 2363.28,
      "text": "ולעשות"
    },
    {
      "start": 2363.28,
      "end": 2365.28,
      "text": "כשמכיר את האמרה המוכרת"
    },
    {
      "start": 2365.28,
      "end": 2367.28,
      "text": "הכל הוא אופנסורס, כל קוד הוא קוד פתוח"
    },
    {
      "start": 2367.28,
      "end": 2369.28,
      "text": "אם אתה יודע אסמלי"
    },
    {
      "start": 2369.28,
      "end": 2371.28,
      "text": "אז הבנו שגם מבחינת סייבר"
    },
    {
      "start": 2371.28,
      "end": 2373.28,
      "text": "כן, כל מה שנוגע לתחום הריברסינג"
    },
    {
      "start": 2373.28,
      "end": 2375.28,
      "text": "פיינוח של תוכניות שאנשים כתבו"
    },
    {
      "start": 2375.28,
      "end": 2377.28,
      "text": "מציעה חולשות"
    },
    {
      "start": 2377.28,
      "end": 2379.28,
      "text": "בתוכניות שאנשים כתבו"
    },
    {
      "start": 2379.28,
      "end": 2381.28,
      "text": "דורש מאיתנו בהכרח"
    },
    {
      "start": 2381.28,
      "end": 2383.28,
      "text": "ובסמוקה של איך התוכנית נויה"
    },
    {
      "start": 2383.28,
      "end": 2385.28,
      "text": "ובשביל זה, אנחנו צריכים לדעת אסמלי"
    },
    {
      "start": 2385.28,
      "end": 2387.28,
      "text": "שאלות על כל ההקדמה המקסיבה הזאת"
    },
    {
      "start": 2387.28,
      "end": 2389.28,
      "text": "שנקרא לנו שעה שני מה"
    },
    {
      "start": 2389.28,
      "end": 2391.28,
      "text": "אבל היא הייתה חשובה מאוד"
    },
    {
      "start": 2391.28,
      "end": 2393.28,
      "text": "ואני מבטיח לכם, יש הרי תוקניה מדרבה"
    },
    {
      "start": 2393.28,
      "end": 2395.28,
      "text": "אם לא ידעות עם תמידה הזאת עכשיו"
    },
    {
      "start": 2395.28,
      "end": 2397.28,
      "text": "איזה שם שאלות"
    },
    {
      "start": 2397.28,
      "end": 2399.28,
      "text": "כן, על מוג"
    },
    {
      "start": 2399.28,
      "end": 2401.28,
      "text": "מה שכתוב"
    },
    {
      "start": 2401.28,
      "end": 2403.28,
      "text": "במוב"
    },
    {
      "start": 2403.28,
      "end": 2405.28,
      "text": "AX"
    },
    {
      "start": 2405.28,
      "end": 2407.28,
      "text": "וכל אלה זה"
    },
    {
      "start": 2407.28,
      "end": 2409.28,
      "text": "זה פקודות נכון"
    },
    {
      "start": 2409.28,
      "end": 2411.28,
      "text": "כול שורה זה פקודה ואסמלי"
    },
    {
      "start": 2411.28,
      "end": 2413.28,
      "text": "מפייח לכם שאנחנו ניגע בכל הכל הכל כולות האלה"
    },
    {
      "start": 2413.28,
      "end": 2415.28,
      "text": "ואתם תדעו כל אחד מהכל כולות האלה"
    },
    {
      "start": 2415.28,
      "end": 2417.28,
      "text": "אם לא הצוף המפרש הזה אז"
    },
    {
      "start": 2417.28,
      "end": 2419.28,
      "text": "עוד צוף עוד שני מפשין בערך"
    },
    {
      "start": 2419.28,
      "end": 2421.28,
      "text": "רגע אני רוצה לבד שאלות שלא יש לה עוד יפה אחד"
    },
    {
      "start": 2421.28,
      "end": 2423.28,
      "text": "בחוץ"
    },
    {
      "start": 2423.28,
      "end": 2425.28,
      "text": "לא, בסדר"
    },
    {
      "start": 2425.28,
      "end": 2427.28,
      "text": "וזה מה שאנחנו רואים בצד נימין"
    },
    {
      "start": 2427.28,
      "end": 2429.28,
      "text": "בצד שמאל אנחנו רואים איך המאבד מקבל אותם"
    },
    {
      "start": 2429.28,
      "end": 2431.28,
      "text": "כן, אז אמרנו שמוב AX1"
    },
    {
      "start": 2431.28,
      "end": 2433.28,
      "text": "זה בעצם"
    },
    {
      "start": 2433.28,
      "end": 2435.28,
      "text": "המספר הנוער הוא שאלנו פה שזה 1'1'1"
    },
    {
      "start": 2435.28,
      "end": 2437.28,
      "text": "1'1'"
    },
    {
      "start": 2437.28,
      "end": 2439.28,
      "text": "0' 0' 0' 1' 0' 0' 0' 0'"
    },
    {
      "start": 2439.28,
      "end": 2441.28,
      "text": "זה איך המאבד מקבל את זה"
    },
    {
      "start": 2441.28,
      "end": 2443.28,
      "text": "הוא מקבל את זה בדרכים"
    },
    {
      "start": 2443.28,
      "end": 2445.28,
      "text": "שלא ניכנס עליהם היום"
    },
    {
      "start": 2445.28,
      "end": 2447.28,
      "text": "כי זה כבר רכית כתורות מחשב וחשמל"
    },
    {
      "start": 2447.28,
      "end": 2449.28,
      "text": "וכל הדברים האלה"
    },
    {
      "start": 2449.28,
      "end": 2451.28,
      "text": "ומקבל את המספר הזה הוא אומר, אה מגנים"
    },
    {
      "start": 2451.28,
      "end": 2453.28,
      "text": "יש איזה שהוא מקום בזיכרון"
    },
    {
      "start": 2453.28,
      "end": 2455.28,
      "text": "אנחנו ניגע בזה שקום לו AX"
    },
    {
      "start": 2455.28,
      "end": 2457.28,
      "text": "סימבור את המספר אחד"
    },
    {
      "start": 2457.28,
      "end": 2459.28,
      "text": "שמור אותו קצת כמו משתנה בקוד"
    },
    {
      "start": 2459.28,
      "end": 2461.28,
      "text": "למי שצא לו לתחני לפני"
    },
    {
      "start": 2461.28,
      "end": 2463.28,
      "text": "אהה"
    },
    {
      "start": 2463.28,
      "end": 2465.28,
      "text": "אז כל שורה שאנחנו רואים פה"
    },
    {
      "start": 2465.28,
      "end": 2467.28,
      "text": "בצד ימין, ישורת קודם בסמבלי"
    },
    {
      "start": 2467.28,
      "end": 2469.28,
      "text": "ובצד שמאל זה איך המאבד מקבל אותם"
    },
    {
      "start": 2469.28,
      "end": 2471.28,
      "text": "כי רצף של אהפסים ואחד עם"
    },
    {
      "start": 2471.28,
      "end": 2473.28,
      "text": "או שלא"
    },
    {
      "start": 2473.28,
      "end": 2475.28,
      "text": "אז השאלה שלי"
    },
    {
      "start": 2475.28,
      "end": 2477.28,
      "text": "כמה פקודות אנחנו נצטרך עדל בשביל התחרות"
    },
    {
      "start": 2477.28,
      "end": 2479.28,
      "text": "כאילו רק את הבסיס"
    },
    {
      "start": 2479.28,
      "end": 2481.28,
      "text": "אין יש משהו שצריך לזכור"
    },
    {
      "start": 2481.28,
      "end": 2483.28,
      "text": "מגנים"
    },
    {
      "start": 2483.28,
      "end": 2485.28,
      "text": "שאלה מצויונת, שובה עם שתי חלקים"
    },
    {
      "start": 2485.28,
      "end": 2487.28,
      "text": "אבל קצרה מאוד"
    },
    {
      "start": 2487.28,
      "end": 2489.28,
      "text": "קודם כל, את כל הקבילות שתסלחו לדעת"
    },
    {
      "start": 2489.28,
      "end": 2491.28,
      "text": "אנחנו נעבור עליהם פה, והם גם מופיעות"
    },
    {
      "start": 2491.28,
      "end": 2493.28,
      "text": "כל אחת מהן בהקלטות משנים קודמות"
    },
    {
      "start": 2493.28,
      "end": 2495.28,
      "text": "שתיים"
    },
    {
      "start": 2495.28,
      "end": 2497.28,
      "text": "כל פקודה שאתם צריכים להכיר, מופיעות"
    },
    {
      "start": 2497.28,
      "end": 2499.28,
      "text": "מקובל צדרכה, או במצגת"
    },
    {
      "start": 2499.28,
      "end": 2503.52,
      "text": "יש... עשם לי"
    },
    {
      "start": 2507.52,
      "end": 2509.28,
      "text": "אתם יצריכו להכיר"
    },
    {
      "start": 2509.28,
      "end": 2511.28,
      "text": "שצ самой אשית קטן"
    },
    {
      "start": 2511.28,
      "end": 2513.28,
      "text": "אבל לברום לכם לעשות המון"
    },
    {
      "start": 2515.28,
      "end": 2517.28,
      "text": "אתם תוכנו לכתוב"
    },
    {
      "start": 2517.28,
      "end": 2519.28,
      "text": "אני מאמין את רוב"
    },
    {
      "start": 2519.28,
      "end": 2521.28,
      "text": "אוקיי אני אחרא לזה ככה"
    },
    {
      "start": 2521.28,
      "end": 2533.28,
      "text": "אני השתתפתי בתחרות בשנה הראשונה שלי עם האסמבלי שידעתי מהתחרות, הצלחתי לכתוב קומפיילר, צלחתי לכתוב, ספת תכנות פי של עצמי, אז זה מספיק."
    },
    {
      "start": 2533.28,
      "end": 2543.28,
      "text": "מבטיח לכם, זה מעט, אבל זה מספיק, למה? כי עם 100 עושים הרבה, כאילו צריך מעט מאוד פקודות כדי לעשות הרבה מאוד באסמבלי, וזה בעצם היופי שלו."
    },
    {
      "start": 2544.28,
      "end": 2547.28,
      "text": "שוחזור על הכלות האלה, המון דמים."
    },
    {
      "start": 2550.28,
      "end": 2551.28,
      "text": "עוד שאלות."
    },
    {
      "start": 2557.28,
      "end": 2559.28,
      "text": "אוקיי, מגניב, אני ממשיך."
    },
    {
      "start": 2559.28,
      "end": 2562.28,
      "text": "אה, כן, על מוגות שאלה או ש..."
    },
    {
      "start": 2562.28,
      "end": 2565.28,
      "text": "אה, לא, כשתשכחתי לו, את זה."
    },
    {
      "start": 2565.28,
      "end": 2567.28,
      "text": "סבבה, אוקיי."
    },
    {
      "start": 2568.28,
      "end": 2577.28,
      "text": "אז מה שעולך לקרות עכשיו, זה שאנחנו נבין מה זה בכלל התחרות הזאת, שמכלשתם עליה, איך מסכים בה ומה עושים."
    },
    {
      "start": 2580.28,
      "end": 2582.28,
      "text": "אז אני אכליך לקראת קודם רע פשוט."
    },
    {
      "start": 2583.28,
      "end": 2589.28,
      "text": "ג'מפ, דולר, שאהבה מה, מה שהקודם הזה עושה, E-B-F-E בגדול,"
    },
    {
      "start": 2590.28,
      "end": 2595.28,
      "text": "ג'מפ, קודה באסמבלי, מה שהקודה הזאת עושה זה בעצם קופצת למקום מסיום בזיכרון,"
    },
    {
      "start": 2595.28,
      "end": 2598.28,
      "text": "דולר, זה בעצם סמד למקום הנוכחי שלי."
    },
    {
      "start": 2599.28,
      "end": 2601.28,
      "text": "אוקיי, מה זה אומר, אתם כבר תראו?"
    },
    {
      "start": 2602.28,
      "end": 2605.28,
      "text": "נו, פיירס, אדל, סבבה, אה, ככה, תראו תראו תראו, סבבה."
    },
    {
      "start": 2608.28,
      "end": 2610.28,
      "text": "ג'מפ, דולר, שאהבה."
    },
    {
      "start": 2611.28,
      "end": 2615.28,
      "text": "אוקיי, מה שאתם רואים פה,"
    },
    {
      "start": 2616.28,
      "end": 2622.28,
      "text": "הזירה הנורא נורא מוזרה הזאת, היא בעצם מדמה את הזיכרון שלנו."
    },
    {
      "start": 2623.28,
      "end": 2628.28,
      "text": "אוקיי, מה זה אומר, אם תסתכלו פה, אתם רואים C, C, C, C, C, C, C."
    },
    {
      "start": 2629.28,
      "end": 2633.28,
      "text": "כמו שאמרנו כמובן, C זה אחד אחד אפס אפס."
    },
    {
      "start": 2634.28,
      "end": 2639.28,
      "text": "אז בגדול מה שכתוב פה זה פשוט אחד אחד אפס אפס, שתנו רות פלוקות, שתנו רות קוויות, שתנו רות פלוקות, שתנו רות קוויות."
    },
    {
      "start": 2645.28,
      "end": 2651.28,
      "text": "אה שם, בתחילת הזיכרון, אני שמתי, E-B-F-E."
    },
    {
      "start": 2652.28,
      "end": 2659.28,
      "text": "אחד אחד אחד אפס, אחד אחד אפס אפס, אחד אחד אחד אחד אפס, אוקיי?"
    },
    {
      "start": 2660.28,
      "end": 2665.28,
      "text": "אנחנו, היחסיק לתרגים להפסים ואחד עם פשוט כי זה באמת, היא כך לנת כל היום, E-B-F-E."
    },
    {
      "start": 2666.28,
      "end": 2673.28,
      "text": "ארבע ספרות, ארבע ספרות ב-X-Z שיהן בעצם הפקודה, ג'מפ, דולר."
    },
    {
      "start": 2674.28,
      "end": 2678.28,
      "text": "עכשיו, כמו שאמרתי מקודם, ג'מפ, קפוץ למקום מסוים בזיכרון, דולר,"
    },
    {
      "start": 2678.28,
      "end": 2683.28,
      "text": "מסמלת המקום המחריךי, אז מה שזה יעשה בגדול, זה שום דבר."
    },
    {
      "start": 2684.28,
      "end": 2688.28,
      "text": "כן, אני הלך למדע רגע עם האופציה, אוקיי?"
    },
    {
      "start": 2692.28,
      "end": 2694.28,
      "text": "אה, אני רוצה רגע לבוא בבוקר סליחה."
    },
    {
      "start": 2698.28,
      "end": 2699.28,
      "text": "אוקיי, מנגיל."
    }
  ]
}