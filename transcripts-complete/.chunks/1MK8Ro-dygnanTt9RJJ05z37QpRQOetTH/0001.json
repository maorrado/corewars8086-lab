    },
    {
      "start": 1487.92,
      "end": 1488.92,
      "text": "אם יש זום,"
    },
    {
      "start": 1488.92,
      "end": 1489.92,
      "text": "אם כבר לא לפתוח מתי שהוא,"
    },
    {
      "start": 1489.92,
      "end": 1490.92,
      "text": "אז זה או עכשיו,"
    },
    {
      "start": 1490.92,
      "end": 1491.92,
      "text": "או ממש מזום עם האחרונים אחרונים?"
    },
    {
      "start": 1491.92,
      "end": 1492.92,
      "text": "למה?"
    },
    {
      "start": 1492.92,
      "end": 1494.92,
      "text": "כי עכשיו אנחנו מדברים בעיקר מבוא,"
    },
    {
      "start": 1494.92,
      "end": 1495.92,
      "text": "וברכותיי,"
    },
    {
      "start": 1495.92,
      "end": 1497.92,
      "text": "הצלחתם להבין מה זה הסיפיעו, מה הוא עושה,"
    },
    {
      "start": 1497.92,
      "end": 1498.92,
      "text": "ואיך כל תכנית מוכשר ברצה,"
    },
    {
      "start": 1498.92,
      "end": 1499.92,
      "text": "זה משמע מפוצץ,"
    },
    {
      "start": 1499.92,
      "end": 1500.92,
      "text": "אבל זה לא."
    },
    {
      "start": 1502.92,
      "end": 1503.92,
      "text": "ואז זום עם האחרונים,"
    },
    {
      "start": 1503.92,
      "end": 1504.92,
      "text": "זה יהיה בסדר,"
    },
    {
      "start": 1504.92,
      "end": 1505.92,
      "text": "כי אתה תצליח להתחיל"
    },
    {
      "start": 1505.92,
      "end": 1506.92,
      "text": "לחשוב את הדברים בראש."
    },
    {
      "start": 1506.92,
      "end": 1507.92,
      "text": "אבל באמצע,"
    },
    {
      "start": 1507.92,
      "end": 1508.92,
      "text": "ואני אגיד, זה בכללי,"
    },
    {
      "start": 1508.92,
      "end": 1511.92,
      "text": "כל מי שיש לו פה איזושהי אוריינטציה,"
    },
    {
      "start": 1511.92,
      "end": 1512.92,
      "text": "אורייקה טכנולוגית,"
    },
    {
      "start": 1513.92,
      "end": 1514.92,
      "text": "שתי המלצות יש לי עליכם,"
    },
    {
      "start": 1514.92,
      "end": 1515.92,
      "text": "תמיד תלמדו,"
    },
    {
      "start": 1516.92,
      "end": 1518.92,
      "text": "מי ליישם מילה לעשות בעצמכם,"
    },
    {
      "start": 1518.92,
      "end": 1519.92,
      "text": "תמיד גם אם אתם רואים מישהו כותב את זה,"
    },
    {
      "start": 1519.92,
      "end": 1521.92,
      "text": "תכתבו מילה במילה,"
    },
    {
      "start": 1521.92,
      "end": 1522.92,
      "text": "ותעשו את זה בעצמכם,"
    },
    {
      "start": 1522.92,
      "end": 1523.92,
      "text": "ותעשו להבין,"
    },
    {
      "start": 1523.92,
      "end": 1524.92,
      "text": "ושתיים כמי תעבדו עם מקורות מידה."
    },
    {
      "start": 1524.92,
      "end": 1525.92,
      "text": "ובשביל זה,"
    },
    {
      "start": 1525.92,
      "end": 1526.92,
      "text": "יש את הקישור השני שאני שואלת לכם,"
    },
    {
      "start": 1526.92,
      "end": 1527.92,
      "text": "זה התל אשל קודגורו,"
    },
    {
      "start": 1527.92,
      "end": 1529.92,
      "text": "אני מניח שפולכם מכירים אותו,"
    },
    {
      "start": 1529.92,
      "end": 1531.92,
      "text": "זה טאב ספציפי שנקרא המדריך,"
    },
    {
      "start": 1531.92,
      "end": 1532.92,
      "text": "ויש בו המון המון קישורים,"
    },
    {
      "start": 1532.92,
      "end": 1533.92,
      "text": "שגם אני משתמש בהם,"
    },
    {
      "start": 1533.92,
      "end": 1535.92,
      "text": "ואני אספר לכם גם סיפור מצחיק,"
    },
    {
      "start": 1535.92,
      "end": 1536.92,
      "text": "בפעם הראשונה,"
    },
    {
      "start": 1536.92,
      "end": 1538.92,
      "text": "שאני למדיתי בתחרות,"
    },
    {
      "start": 1538.92,
      "end": 1539.92,
      "text": "אני עדי לדעתי את החומר עד הסוף,"
    },
    {
      "start": 1539.92,
      "end": 1541.92,
      "text": "ולכן הייתי מעביר את הזוממים האלה,"
    },
    {
      "start": 1541.92,
      "end": 1543.92,
      "text": "עם הקובץ על דרכה,"
    },
    {
      "start": 1543.92,
      "end": 1545.92,
      "text": "ועם המצגת, ועם התרגילים,"
    },
    {
      "start": 1545.92,
      "end": 1546.92,
      "text": "פתוחים לי בצד,"
    },
    {
      "start": 1546.92,
      "end": 1547.92,
      "text": "והייתי מסתכל תוך כדי."
    },
    {
      "start": 1548.92,
      "end": 1550.92,
      "text": "זה עד כדי כך חשוב,"
    },
    {
      "start": 1550.92,
      "end": 1551.92,
      "text": "כאילו, אתם לא,"
    },
    {
      "start": 1551.92,
      "end": 1553.92,
      "text": "אנחנו לא חיים בידם שבוצא כלשנן הכל בעל פה,"
    },
    {
      "start": 1553.92,
      "end": 1555.92,
      "text": "אנחנו חיים בידם שבוצא כלדת איפה נמצוא תקשובות,"
    },
    {
      "start": 1555.92,
      "end": 1557.92,
      "text": "בו אחר התעסקות עם היד,"
    },
    {
      "start": 1557.92,
      "end": 1559.92,
      "text": "שהיא בעיניי מקסימה."
    },
    {
      "start": 1560.92,
      "end": 1562.92,
      "text": "טוב, בחזרה למעשה,"
    },
    {
      "start": 1562.92,
      "end": 1563.92,
      "text": "אז הסמלי,"
    },
    {
      "start": 1563.92,
      "end": 1565.92,
      "text": "שהיא לא כזאת מרשימה,"
    },
    {
      "start": 1565.92,
      "end": 1566.92,
      "text": "למה?"
    },
    {
      "start": 1566.92,
      "end": 1568.92,
      "text": "כי אם אני אתחיל לכתוב קוד בסמלי,"
    },
    {
      "start": 1568.92,
      "end": 1569.92,
      "text": "תתלמו מהקוד עצמות,"
    },
    {
      "start": 1569.92,
      "end": 1570.92,
      "text": "אתם אולי לא תלוינו אותו."
    },
    {
      "start": 1583.92,
      "end": 1584.92,
      "text": "סהרה."
    },
    {
      "start": 1585.92,
      "end": 1586.92,
      "text": "הקוד הזה בסמלי,"
    },
    {
      "start": 1586.92,
      "end": 1588.92,
      "text": "הוא בסך הכל, מספרים,"
    },
    {
      "start": 1588.92,
      "end": 1589.92,
      "text": "ככה, ואתם אומרים לי,"
    },
    {
      "start": 1589.92,
      "end": 1590.92,
      "text": "מה זה, בן,"
    },
    {
      "start": 1590.92,
      "end": 1592.92,
      "text": "שיקרת, אמרת, מספרים משפוטיות."
    },
    {
      "start": 1592.92,
      "end": 1593.92,
      "text": "נכון?"
    },
    {
      "start": 1594.92,
      "end": 1595.92,
      "text": "בואו נדבר על זה."
    },
    {
      "start": 1596.92,
      "end": 1598.92,
      "text": "שיטה ממש ממש מגניבה,"
    },
    {
      "start": 1598.92,
      "end": 1599.92,
      "text": "עוד בסיס ספירה,"
    },
    {
      "start": 1599.92,
      "end": 1601.92,
      "text": "אם אמרנו בסיס 2 שיש בו רק 0,1,"
    },
    {
      "start": 1601.92,
      "end": 1602.92,
      "text": "בינרי,"
    },
    {
      "start": 1602.92,
      "end": 1604.92,
      "text": "יש עוד בסיס הספירה בעולם,"
    },
    {
      "start": 1604.92,
      "end": 1606.92,
      "text": "יש בסיס 3 שיש בו 0,1 ו2,"
    },
    {
      "start": 1606.92,
      "end": 1608.92,
      "text": "בסיס 4, בו 0,1 ו3,"
    },
    {
      "start": 1608.92,
      "end": 1609.92,
      "text": "אה,"
    },
    {
      "start": 1609.92,
      "end": 1611.92,
      "text": "כולם עובדים באופן יחסית דומה,"
    },
    {
      "start": 1611.92,
      "end": 1613.92,
      "text": "יש גם בסיס ממש גדול,"
    },
    {
      "start": 1613.92,
      "end": 1614.92,
      "text": "שנקרא בסיס 16,"
    },
    {
      "start": 1614.92,
      "end": 1615.92,
      "text": "או במילים אחרות,"
    },
    {
      "start": 1615.92,
      "end": 1617.92,
      "text": "היקסה, דצימה לי,"
    },
    {
      "start": 1617.92,
      "end": 1618.92,
      "text": "היקסה זה 6,"
    },
    {
      "start": 1618.92,
      "end": 1619.92,
      "text": "דצימה לזה 10,"
    },
    {
      "start": 1619.92,
      "end": 1620.92,
      "text": "כמו דצמבר,"
    },
    {
      "start": 1620.92,
      "end": 1622.92,
      "text": "והיקסה כמו היקסאגון,"
    },
    {
      "start": 1622.92,
      "end": 1623.92,
      "text": "כמו משושה,"
    },
    {
      "start": 1623.92,
      "end": 1625.92,
      "text": "בסיס 16,"
    },
    {
      "start": 1626.92,
      "end": 1628.92,
      "text": "בו 0,1,2,3,4,5,6,7,8,"
    },
    {
      "start": 1628.92,
      "end": 1629.92,
      "text": "8,"
    },
    {
      "start": 1629.92,
      "end": 1630.92,
      "text": "ואישה,"
    },
    {
      "start": 1630.92,
      "end": 1631.92,
      "text": "אי,"
    },
    {
      "start": 1631.92,
      "end": 1632.92,
      "text": "בי,"
    },
    {
      "start": 1632.92,
      "end": 1634.92,
      "text": "c, d, e, k,"
    },
    {
      "start": 1634.92,
      "end": 1636.92,
      "text": "אוקיי,"
    },
    {
      "start": 1636.92,
      "end": 1638.92,
      "text": "זה כאילו נגמרו הספרות בעולם,"
    },
    {
      "start": 1638.92,
      "end": 1640.92,
      "text": "אחרי את האישה,"
    },
    {
      "start": 1640.92,
      "end": 1641.92,
      "text": "אין עוד ספרות הרי,"
    },
    {
      "start": 1641.92,
      "end": 1643.92,
      "text": "יש עוד מספרים אבל אין עוד ספרות,"
    },
    {
      "start": 1643.92,
      "end": 1644.92,
      "text": "אז הם ציעו,"
    },
    {
      "start": 1644.92,
      "end": 1646.92,
      "text": "אי, בי, c, d, e, k,"
    },
    {
      "start": 1646.92,
      "end": 1648.92,
      "text": "עכשיו, למה אנחנו רואים את זה פה,"
    },
    {
      "start": 1648.92,
      "end": 1650.92,
      "text": "בתור,"
    },
    {
      "start": 1650.92,
      "end": 1652.92,
      "text": "בי 8, 0,1, 0,1,"
    },
    {
      "start": 1652.92,
      "end": 1654.92,
      "text": "למה אנחנו רואים את זה,"
    },
    {
      "start": 1654.92,
      "end": 1656.92,
      "text": "פשוט כי מה שקורה,"
    },
    {
      "start": 1656.92,
      "end": 1657.92,
      "text": "זה שכל"
    },
    {
      "start": 1657.92,
      "end": 1659.92,
      "text": "4 ספרות בינריות,"
    },
    {
      "start": 1659.92,
      "end": 1661.92,
      "text": "מומרות לספרה 1,"
    },
    {
      "start": 1661.92,
      "end": 1663.92,
      "text": "x' קסם מגניב,"
    },
    {
      "start": 1663.92,
      "end": 1665.92,
      "text": "למה? כי 2,0,1,"
    },
    {
      "start": 1665.92,
      "end": 1666.92,
      "text": "זה 16,"
    },
    {
      "start": 1666.92,
      "end": 1667.92,
      "text": "אז אני יכול לקווץ"
    },
    {
      "start": 1667.92,
      "end": 1669.92,
      "text": "כל 4 ספרות בינריות,"
    },
    {
      "start": 1669.92,
      "end": 1671.92,
      "text": "כל 0,0,1,"
    },
    {
      "start": 1671.92,
      "end": 1672.92,
      "text": "1,1,0,1,"
    },
    {
      "start": 1672.92,
      "end": 1673.92,
      "text": "כל שילור,"
    },
    {
      "start": 1673.92,
      "end": 1675.92,
      "text": "כל קומבינציה של 4 ספרות בינריות,"
    },
    {
      "start": 1675.92,
      "end": 1676.92,
      "text": "0,1,"
    },
    {
      "start": 1676.92,
      "end": 1677.92,
      "text": "אני יכול להפוך אותה,"
    },
    {
      "start": 1677.92,
      "end": 1679.92,
      "text": "לזה שהיא קומבינציה של"
    },
    {
      "start": 1680.92,
      "end": 1681.92,
      "text": "x' איך זה יראה,"
    },
    {
      "start": 1681.92,
      "end": 1683.92,
      "text": "0,0,0,0,"
    },
    {
      "start": 1683.92,
      "end": 1685.92,
      "text": "זה 0,"
    },
    {
      "start": 1685.92,
      "end": 1687.92,
      "text": "הופה, סליחה,"
    },
    {
      "start": 1687.92,
      "end": 1691.92,
      "text": "זה 0,0,0,1,"
    },
    {
      "start": 1691.92,
      "end": 1693.92,
      "text": "זה 1,"
    },
    {
      "start": 1693.92,
      "end": 1696.92,
      "text": "0,0,1,0,"
    },
    {
      "start": 1696.92,
      "end": 1701.92,
      "text": "זה 2,"
    },
    {
      "start": 1701.92,
      "end": 1703.92,
      "text": "אני כן איך טוב את זה,"
    },
    {
      "start": 1703.92,
      "end": 1705.92,
      "text": "כי בעיניי זה חשוב,"
    },
    {
      "start": 1705.92,
      "end": 1707.92,
      "text": "0,0,1,"
    },
    {
      "start": 1707.92,
      "end": 1709.92,
      "text": "אתם תראו שאני כל פעם"
    },
    {
      "start": 1709.92,
      "end": 1711.92,
      "text": "מוסיף, אנחנו קיוץ לפעמים קצת,"
    },
    {
      "start": 1711.92,
      "end": 1712.92,
      "text": "קשה לי קלות פועת חלה,"
    },
    {
      "start": 1712.92,
      "end": 1714.92,
      "text": "בשלב מסיימת אתה פשוט נהיה"
    },
    {
      "start": 1714.92,
      "end": 1716.92,
      "text": "פלואנט בזה,"
    },
    {
      "start": 1716.92,
      "end": 1719.92,
      "text": "זה נהיה 3,"
    },
    {
      "start": 1719.92,
      "end": 1722.92,
      "text": "0,1,0,0,"
    },
    {
      "start": 1722.92,
      "end": 1728.92,
      "text": "נהיה 4,"
    },
    {
      "start": 1728.92,
      "end": 1733.92,
      "text": "0,1,0,1,"
    },
    {
      "start": 1733.92,
      "end": 1735.92,
      "text": "נהיה 5,"
    },
    {
      "start": 1735.92,
      "end": 1740.92,
      "text": "0,1,1,"
    },
    {
      "start": 1740.92,
      "end": 1743.92,
      "text": "נהיה 0,1,0,0,"
    },
    {
      "start": 1743.92,
      "end": 1746.92,
      "text": "נהיה 6,"
    },
    {
      "start": 1746.92,
      "end": 1749.92,
      "text": "0,1,1,"
    },
    {
      "start": 1749.92,
      "end": 1752.92,
      "text": "נהיה 7,"
    },
    {
      "start": 1752.92,
      "end": 1754.92,
      "text": "0,0,0,0,0,0,"
    },
    {
      "start": 1754.92,
      "end": 1756.92,
      "text": "אני יודע שאני משאמר אתכם,"
    },
    {
      "start": 1756.92,
      "end": 1758.92,
      "text": "אבל אני מפליח לכם שאתם טוב בגלל זה,"
    },
    {
      "start": 1758.92,
      "end": 1760.92,
      "text": "זה נהיה 9,"
    },
    {
      "start": 1760.92,
      "end": 1762.92,
      "text": "זה נהיה 8,"
    },
    {
      "start": 1762.92,
      "end": 1764.92,
      "text": "לא 10, כי אמרנו,"
    },
    {
      "start": 1764.92,
      "end": 1766.92,
      "text": "אין ספירות,"
    },
    {
      "start": 1766.92,
      "end": 1768.92,
      "text": "1,1,1,"
    },
    {
      "start": 1768.92,
      "end": 1770.92,
      "text": "לא כל חביות,"
    },
    {
      "start": 1770.92,
      "end": 1772.92,
      "text": "זה b,"
    },
    {
      "start": 1772.92,
      "end": 1776.92,
      "text": "1511 c,"
    },
    {
      "start": 1776.92,
      "end": 1780.92,
      "text": "1511 b"
    },
    {
      "start": 1780.92,
      "end": 1782.92,
      "text": "לא אתה ריף, אתה מפרסmbolי,"
