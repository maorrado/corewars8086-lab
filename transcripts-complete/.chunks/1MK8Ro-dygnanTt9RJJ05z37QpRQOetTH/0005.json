    },
    {
      "start": 5249.28,
      "end": 5251.28,
      "text": "וורד"
    },
    {
      "start": 5251.28,
      "end": 5253.28,
      "text": "כן, הבדלים ממש ממש קטנים שאני מפייח לכם"
    },
    {
      "start": 5253.28,
      "end": 5255.28,
      "text": "שאם תשאלו את הצ'ט"
    },
    {
      "start": 5255.28,
      "end": 5257.28,
      "text": "או תחפשו בעצמכם תראו שאתם פוקשים"
    },
    {
      "start": 5257.28,
      "end": 5259.28,
      "text": "אוקיי פעם ואף פעם"
    },
    {
      "start": 5259.28,
      "end": 5261.28,
      "text": "וגם אם כן מתרגנים נורא מהרקיין כזה הבדל"
    },
    {
      "start": 5261.28,
      "end": 5263.28,
      "text": "זה לא כמו ג'אבו בפייטון"
    },
    {
      "start": 5263.28,
      "end": 5265.28,
      "text": "או שפות אחרות שיש ביניהם הבדם מטורף"
    },
    {
      "start": 5265.28,
      "end": 5267.28,
      "text": "זה ממש דיאלקטים דומים של דותה הספור"
    },
    {
      "start": 5267.28,
      "end": 5269.28,
      "text": "ירעים"
    },
    {
      "start": 5271.28,
      "end": 5273.28,
      "text": "איפה יש כתוב דכנית"
    },
    {
      "start": 5273.28,
      "end": 5275.28,
      "text": "יש כאילו"
    },
    {
      "start": 5275.28,
      "end": 5277.28,
      "text": "איפה צריך להוסיף טכניקות לכל"
    },
    {
      "start": 5277.28,
      "end": 5279.28,
      "text": "זה נראה חסית רנדומל לי"
    },
    {
      "start": 5279.28,
      "end": 5281.28,
      "text": "כאילו, אתה צריך לקוות לטוב"
    },
    {
      "start": 5281.28,
      "end": 5283.28,
      "text": "אז עד שוב הייש שכן"
    },
    {
      "start": 5283.28,
      "end": 5285.28,
      "text": "כל הכל צריך לקוות לטוב, תמיד"
    },
    {
      "start": 5285.28,
      "end": 5287.28,
      "text": "אוקיי, אבל כאילו איפה זה נכנס"
    },
    {
      "start": 5287.28,
      "end": 5289.28,
      "text": "אין לי טכניקות יש"
    },
    {
      "start": 5289.28,
      "end": 5291.28,
      "text": "נעשה קצת נאים דרופים"
    },
    {
      "start": 5291.28,
      "end": 5293.28,
      "text": "אז טכניקות שיכולת לקרות"
    },
    {
      "start": 5293.28,
      "end": 5295.28,
      "text": "ביניהתר, כוללות"
    },
    {
      "start": 5295.28,
      "end": 5297.28,
      "text": "לזוז במפה"
    },
    {
      "start": 5297.28,
      "end": 5299.28,
      "text": "לשתף פעולה בין הסורדים של אחר"
    },
    {
      "start": 5299.28,
      "end": 5301.28,
      "text": "והטכניקות אולי הכי חשובות"
    },
    {
      "start": 5301.28,
      "end": 5303.28,
      "text": "שהן"
    },
    {
      "start": 5303.28,
      "end": 5305.28,
      "text": "לכתוב יותר מהר"
    },
    {
      "start": 5305.28,
      "end": 5307.28,
      "text": "או"
    },
    {
      "start": 5307.28,
      "end": 5309.28,
      "text": "בצ'נקים יותר גדולים למהפה"
    },
    {
      "start": 5309.28,
      "end": 5311.28,
      "text": "אוקיי"
    },
    {
      "start": 5311.28,
      "end": 5313.28,
      "text": "דמינו שהייתי עושה כל פעם"
    },
    {
      "start": 5315.28,
      "end": 5317.28,
      "text": "אינק בייקס"
    },
    {
      "start": 5317.28,
      "end": 5319.28,
      "text": "אינק בייקס, למי שלא מכיר זה, להוסיף אחד"
    },
    {
      "start": 5319.28,
      "end": 5321.28,
      "text": "זה בייקס"
    },
    {
      "start": 5321.28,
      "end": 5323.28,
      "text": "כמה יותר, כמה איתי יותר"
    },
    {
      "start": 5323.28,
      "end": 5325.28,
      "text": "זה יהיה"
    },
    {
      "start": 5325.28,
      "end": 5327.28,
      "text": "אוקיי, זה המאירות"
    },
    {
      "start": 5327.28,
      "end": 5329.28,
      "text": "של להוסיף כל פעם אחד"
    },
    {
      "start": 5329.28,
      "end": 5331.28,
      "text": "עכשיו אני רוצה להרות לכם איך זה כשהייתי"
    },
    {
      "start": 5331.28,
      "end": 5333.28,
      "text": "להוסיף כל פעם שתיים"
    },
    {
      "start": 5337.28,
      "end": 5339.28,
      "text": "הרבה יותר מהיר"
    },
    {
      "start": 5339.28,
      "end": 5341.28,
      "text": "לא רואים את זה"
    },
    {
      "start": 5341.28,
      "end": 5343.28,
      "text": "כי הלוח קטן הרבה הרבה יותר מהיר"
    },
    {
      "start": 5343.28,
      "end": 5345.28,
      "text": "פי שתיים יותר מהיר, למה על האמת"
    },
    {
      "start": 5347.28,
      "end": 5349.28,
      "text": "אם היינו יכולים לעשות"
    },
    {
      "start": 5349.28,
      "end": 5351.28,
      "text": "עד ארבע"
    },
    {
      "start": 5351.28,
      "end": 5353.28,
      "text": "שזה קצת לקפוץ לדבר ארבע"
    },
    {
      "start": 5353.28,
      "end": 5355.28,
      "text": "איך אגב אפשר לעשות עד ארבע זה נראה ככה"
    },
    {
      "start": 5357.28,
      "end": 5359.28,
      "text": "זה הרבה הרבה יותר מהיר"
    },
    {
      "start": 5359.28,
      "end": 5361.28,
      "text": "מה החיסרון"
    },
    {
      "start": 5361.28,
      "end": 5363.28,
      "text": "זה לא מפציץ כל מקום"
    },
    {
      "start": 5363.28,
      "end": 5365.28,
      "text": "כן, אם מישהו הצליח איך שהוא להיות פה"
    },
    {
      "start": 5365.28,
      "end": 5367.28,
      "text": "ואנחנו נוכל לראות את זה פה"
    },
    {
      "start": 5367.28,
      "end": 5369.28,
      "text": "בקומפטיישן מאוד"
    },
    {
      "start": 5369.28,
      "end": 5371.28,
      "text": "לא כל הזמן הוא עורג אותו"
    },
    {
      "start": 5371.28,
      "end": 5373.28,
      "text": "לפעמים הוא סורד"
    },
    {
      "start": 5373.28,
      "end": 5375.28,
      "text": "זה בגדול אמור להיות"
    },
    {
      "start": 5375.28,
      "end": 5377.28,
      "text": "סיכוי של כאילו"
    },
    {
      "start": 5377.28,
      "end": 5379.28,
      "text": "1"
    },
    {
      "start": 5379.28,
      "end": 5381.28,
      "text": "2 3 4"
    },
    {
      "start": 5381.28,
      "end": 5383.28,
      "text": "רבע, זה אמור להתאזנה לזור הרבע"
    },
    {
      "start": 5383.28,
      "end": 5385.28,
      "text": "למה כי"
    },
    {
      "start": 5385.28,
      "end": 5387.28,
      "text": "באחד מכל ארבע מקרים"
    },
    {
      "start": 5387.28,
      "end": 5389.28,
      "text": "הוא נמצא בדיוק באמצע"
    },
    {
      "start": 5389.28,
      "end": 5391.28,
      "text": "הוא יכול להיות לגמרי איפה שמפציסים אותו"
    },
    {
      "start": 5391.28,
      "end": 5393.28,
      "text": "הוא יכול להיות רגל פה רגל שם"
    },
    {
      "start": 5393.28,
      "end": 5395.28,
      "text": "או שהוא יכול להיות בדיוק באמצע"
    },
    {
      "start": 5395.28,
      "end": 5397.28,
      "text": "אתם תראו שזה כנראה בסוף התאזן"
    },
    {
      "start": 5397.28,
      "end": 5399.28,
      "text": "על אזור האחד ל-4"
    },
    {
      "start": 5399.28,
      "end": 5401.28,
      "text": "ומקווה"
    }
  ]
}