{
  "source": "1MK8Ro-dygnanTt9RJJ05z37QpRQOetTH.mp4",
  "source_sha256": "d99a861c21e77659a0e28bf8a305b1c46cf60c414484cf63ea6b9835f902f054",
  "model": "small",
  "language": "he",
  "language_probability": 1,
  "start": 7200.0,
  "end": 7425.536,
  "elapsed_seconds": 54.64966416358948,
  "segments": [
    {
      "start": 7200.0,
      "end": 7214.26,
      "text": "כל פר, 1100, 144, זה פר קול אולי, בוא נראה לי פר אוכל, פר קול, לא."
    },
    {
      "start": 7214.26,
      "end": 7220.86,
      "text": "לא איך עוד ביובר פה לנסטרקשן. וגם פר אוכל כלום יותר בחיים האלה."
    },
    {
      "start": 7221.84,
      "end": 7229.26,
      "text": "פר שזה צריך להיות CXBX, וואי, אה, ו..."
    },
    {
      "start": 7231.06,
      "end": 7237.34,
      "text": "כל BX, אוקיי, כל פר CXBX, לא."
    },
    {
      "start": 7240.540000000001,
      "end": 7244.000000000001,
      "text": "פר שזה ככה CXBX."
    },
    {
      "start": 7245.06,
      "end": 7248.56,
      "text": "בואי להסתכל, וואה זה, מה אנחנו שוברים את הראש. ויהיה..."
    },
    {
      "start": 7251.740000000001,
      "end": 7252.860000000001,
      "text": "שובר..."
    },
    {
      "start": 7254.26,
      "end": 7257.900000000001,
      "text": "וכן, שפולה, ארצה צורר, לא."
    },
    {
      "start": 7259.3,
      "end": 7262.740000000001,
      "text": "כן, אני לא תמיד זוכר סינדרסו לי, קצת מברס, אבל..."
    },
    {
      "start": 7269.06,
      "end": 7278.860000000001,
      "text": "אוקיי, מה במילים? אה, זה הסטחה, זה הסבר הרסם, בלי... רגיל, אני רוצה את ה... מציגת."
    },
    {
      "start": 7281.860000000001,
      "end": 7286.660000000001,
      "text": "מגניב. אוקיי, יש לך מירה, אופה, כפסתי גדימה,"
    },
    {
      "start": 7286.660000000001,
      "end": 7294.660000000001,
      "text": "כל DWBX, ולמה? BXBX..."
    },
    {
      "start": 7297.660000000001,
      "end": 7303.160000000001,
      "text": "אה, אוקיי, מגניב. אז לא צריך לציין, לדעתי, הוא ידע לבן, מגניב. אז..."
    },
    {
      "start": 7304.160000000001,
      "end": 7308.160000000001,
      "text": "כל DWBX,"
    },
    {
      "start": 7311.26,
      "end": 7315.26,
      "text": "למה בנץ, באמת, יואו, אוקיי."
    },
    {
      "start": 7317.660000000001,
      "end": 7321.460000000001,
      "text": "BX, לא תתנו לי את זה ככה, אני לא זוכר כך קודם לדעת, לא משנה."
    },
    {
      "start": 7322.160000000001,
      "end": 7325.160000000001,
      "text": "שזה ילד פה. לא, איזה יופי."
    },
    {
      "start": 7327.160000000001,
      "end": 7331.960000000001,
      "text": "באופן כלל, איק, אז בקיצור, כשמשתמשים בכל פע, לא זוכר לציין את הקצת המכרחי,"
    },
    {
      "start": 7332.460000000001,
      "end": 7337.660000000001,
      "text": "אז תציפי, הוא כותב ארבעה בתים, אם הפךתי את המכסנית,"
    },
    {
      "start": 7338.5599999999995,
      "end": 7342.86,
      "text": "למה? אמרתי עכשיו, במקום לכתוב למכסנית שנמצאת איפה שהוא תכתוב לזירה,"
    },
    {
      "start": 7342.86,
      "end": 7344.86,
      "text": "אני יכול להפציץ ארבעה בתים כל פעם,"
    },
    {
      "start": 7345.86,
      "end": 7348.36,
      "text": "ואז בעצם אני יכול להשתמש בכל פע,"
    },
    {
      "start": 7349.36,
      "end": 7353.36,
      "text": "כדי לכתוב פשתיים יותר מהר מכל בן אדם אחר, גם אם הוא כותב באפרשים."
    },
    {
      "start": 7354.16,
      "end": 7356.36,
      "text": "גם אם הוא כותב באפרשים, אני מפציץ רציף"
    },
    {
      "start": 7357.86,
      "end": 7360.36,
      "text": "ארבעה בתים כל תור, לא אחד או שניים."
    },
    {
      "start": 7362.36,
      "end": 7364.86,
      "text": "אז זה הטכניקה של כל פע, שהם מנצחת לרוב..."
    },
    {
      "start": 7364.860000000001,
      "end": 7366.860000000001,
      "text": "כן."
    },
    {
      "start": 7370.360000000001,
      "end": 7374.06,
      "text": "שאלה אחרונה, לפני שאתה צריך לסיים,"
    },
    {
      "start": 7376.76,
      "end": 7380.860000000001,
      "text": "יש לך טיפים, איך להשמש בסטור SW בצורה טובה?"
    },
    {
      "start": 7381.660000000001,
      "end": 7382.660000000001,
      "text": "אוף, לא."
    },
    {
      "start": 7383.56,
      "end": 7385.660000000001,
      "text": "לא כי כמעט ולא יש ממשתי בסטור SW."
    },
    {
      "start": 7386.360000000001,
      "end": 7387.960000000001,
      "text": "למה? זה ממש לא עוזר?"
    },
    {
      "start": 7388.660000000001,
      "end": 7389.960000000001,
      "text": "לא, זה לא שזה ממש לא עוזר,"
    },
    {
      "start": 7389.960000000001,
      "end": 7393.56,
      "text": "אז זה פשוט בשלב מסיימת, אתה הולך לנישה הספציפית שלך."
    },
    {
      "start": 7393.56,
      "end": 7396.26,
      "text": "אז אני שש שלי ספציפית לחתוף זומבים,"
    },
    {
      "start": 7396.26,
      "end": 7398.26,
      "text": "כי אני אוהב חידות."
    },
    {
      "start": 7398.26,
      "end": 7399.860000000001,
      "text": "אבל יודע מה,"
    },
    {
      "start": 7402.76,
      "end": 7404.26,
      "text": "בשימוש אני אדבר על סטור SW,"
    },
    {
      "start": 7404.26,
      "end": 7406.56,
      "text": "אני אשתדל לעשות אקסטרה חנה לפני,"
    },
    {
      "start": 7406.56,
      "end": 7409.96,
      "text": "לדעת בדיוק, כאילו להכיר את כל הטכניקות של שימוש בסטור SW."
    },
    {
      "start": 7409.96,
      "end": 7410.96,
      "text": "בסדר?"
    },
    {
      "start": 7411.360000000001,
      "end": 7412.360000000001,
      "text": "אוקיי."
    },
    {
      "start": 7412.360000000001,
      "end": 7413.360000000001,
      "text": "מהולה?"
    },
    {
      "start": 7414.860000000001,
      "end": 7417.360000000001,
      "text": "טוב, תודה, אבל לכם, היה ממש ממש כיף."
    },
    {
      "start": 7417.360000000001,
      "end": 7419.360000000001,
      "text": "אני פגש פה בשבוע הבא,"
    },
    {
      "start": 7419.360000000001,
      "end": 7421.860000000001,
      "text": "וזה רק כאילו לכם, בלילה טוב ושבוע טוב."
    },
    {
      "start": 7422.660000000001,
      "end": 7423.160000000001,
      "text": "טוב."
    },
    {
      "start": 7423.160000000001,
      "end": 7424.160000000001,
      "text": "תודה, תודה, אבל."
    },
    {
      "start": 7424.160000000001,
      "end": 7425.160000000001,
      "text": "ווקה, שם."
    }
  ]
}