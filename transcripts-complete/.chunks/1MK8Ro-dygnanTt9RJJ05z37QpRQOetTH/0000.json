{
  "source": "1MK8Ro-dygnanTt9RJJ05z37QpRQOetTH.mp4",
  "source_sha256": "d99a861c21e77659a0e28bf8a305b1c46cf60c414484cf63ea6b9835f902f054",
  "model": "small",
  "language": "he",
  "language_probability": 1,
  "start": 0.0,
  "end": 900.0,
  "elapsed_seconds": 463.31266808509827,
  "segments": [
    {
      "start": 0.0,
      "end": 5.0,
      "text": "אוקיי, כולם מצליחים לשמועתי."
    },
    {
      "start": 5.0,
      "end": 9.0,
      "text": "יפה, נוולה."
    },
    {
      "start": 9.0,
      "end": 10.0,
      "text": "כן, שמיין."
    },
    {
      "start": 10.0,
      "end": 12.0,
      "text": "או, לשתוח מצלמות."
    },
    {
      "start": 12.0,
      "end": 16.0,
      "text": "סתם כזה שאני יכול לראות אתכם כי, לא יודע, מוזר לדבר לרגויים שחורים."
    },
    {
      "start": 16.0,
      "end": 22.0,
      "text": "יאללה, נוולה."
    },
    {
      "start": 22.0,
      "end": 27.0,
      "text": "טוב, אז אני שוב רגע הציעית עצמי."
    },
    {
      "start": 28.0,
      "end": 34.0,
      "text": "קורשונות יקורים לי בן, רקע של משהו כמו 3 או 4 שנים בתחרות הזאת,"
    },
    {
      "start": 34.0,
      "end": 39.0,
      "text": "גם כמשתתף, גם כצוות של התחרות במיוחד בחלק הזה של האחשרות."
    },
    {
      "start": 39.0,
      "end": 44.0,
      "text": "מה שאנחנו נעשה במפגש הזה, זה נבין שנייה מה זה בכלל התחרות הזאת,"
    },
    {
      "start": 44.0,
      "end": 46.0,
      "text": "מה זה הנקודות המוזרות האלה שהיו על המסך,"
    },
    {
      "start": 46.0,
      "end": 48.0,
      "text": "כשיהיו דעירה הרצאה של משחק,"
    },
    {
      "start": 48.0,
      "end": 52.0,
      "text": "שלא באמת אינטואיטיבי כל כך להבין אותם,"
    },
    {
      "start": 52.0,
      "end": 56.0,
      "text": "איך זה מתחבר למושב שכבר אחד מכם עכשיו יש לו בו בית,"
    },
    {
      "start": 56.0,
      "end": 60.0,
      "text": "איפה זה נקודם, נדברים כאלה, כי זה די כזה מחובר לכל,"
    },
    {
      "start": 60.0,
      "end": 64.0,
      "text": "ואפילו נגיע אני מאמין ללשתור כמה תכניות שיסיות."
    },
    {
      "start": 64.0,
      "end": 70.0,
      "text": "נראה לי, ממש אני זוכר, זה הסמלר 86,"
    },
    {
      "start": 70.0,
      "end": 71.0,
      "text": "נכון."
    },
    {
      "start": 71.0,
      "end": 74.0,
      "text": "שהוא לא משום משהו כבר יותר,"
    },
    {
      "start": 74.0,
      "end": 75.0,
      "text": "אה אז."
    },
    {
      "start": 75.0,
      "end": 77.0,
      "text": "אוקיי, נקודה ממש מגניבה."
    },
    {
      "start": 77.0,
      "end": 79.0,
      "text": "מה השם?"
    },
    {
      "start": 79.0,
      "end": 81.0,
      "text": "יליסי."
    },
    {
      "start": 81.0,
      "end": 82.0,
      "text": "יליסי, אוקיי."
    },
    {
      "start": 82.0,
      "end": 83.0,
      "text": "כן."
    },
    {
      "start": 83.0,
      "end": 85.0,
      "text": "אז נקודה ממש ממש טובה,"
    },
    {
      "start": 86.0,
      "end": 89.0,
      "text": "הסמלר 86 לא משום משהו יותר היום."
    },
    {
      "start": 89.0,
      "end": 90.0,
      "text": "האם..."
    },
    {
      "start": 90.0,
      "end": 91.0,
      "text": "לא, לרוב."
    },
    {
      "start": 91.0,
      "end": 95.0,
      "text": "יש את התחריות כמונו."
    },
    {
      "start": 95.0,
      "end": 97.0,
      "text": "אוקיי, אז כן ולא."
    },
    {
      "start": 97.0,
      "end": 100.0,
      "text": "ואני רגע הסביר למה אני מתכוון כשאני אומר כן ולא,"
    },
    {
      "start": 100.0,
      "end": 103.0,
      "text": "ואני רואה אם יש לי אפשרות לשתתף כמה שך שלי."
    },
    {
      "start": 106.0,
      "end": 107.0,
      "text": "אוקיי."
    },
    {
      "start": 107.0,
      "end": 109.0,
      "text": "כולם, אז לכם לראות?"
    },
    {
      "start": 109.0,
      "end": 112.0,
      "text": "תגידו לי שם כמה, נעולם."
    },
    {
      "start": 113.0,
      "end": 116.0,
      "text": "טוב, מגניב."
    },
    {
      "start": 118.0,
      "end": 120.0,
      "text": "איזה אני יכול לסתכל, כי דבר לא נראה לך אחד."
    },
    {
      "start": 120.0,
      "end": 126.0,
      "text": "סבבה, כל העצר כמובן לראות את הריבורה כאילו את כמו כזה סוג של כותב טקסט שיש לי."
    },
    {
      "start": 126.0,
      "end": 128.0,
      "text": "כן."
    },
    {
      "start": 128.0,
      "end": 129.0,
      "text": "כן, זה..."
    },
    {
      "start": 129.0,
      "end": 131.0,
      "text": "זה התרמינל לא?"
    },
    {
      "start": 131.0,
      "end": 135.0,
      "text": "כן, סיפור החתית רק סופו איזה, אני נראה איבטה שתיות הילה."
    },
    {
      "start": 135.0,
      "end": 136.0,
      "text": "אוקיי."
    },
    {
      "start": 136.0,
      "end": 139.0,
      "text": "אני מתכנת כאן בסופות אחרות,"
    },
    {
      "start": 139.0,
      "end": 141.0,
      "text": "כאילו אני יודע מה זה התרמינל."
    },
    {
      "start": 141.0,
      "end": 145.0,
      "text": "מולה, זה סוג של הטרמינל, אבל זה אפליקציה בתוך הטרמינל."
    },
    {
      "start": 145.0,
      "end": 146.0,
      "text": "אבל אני כנסה זה עכשיו."
    },
    {
      "start": 146.0,
      "end": 148.0,
      "text": "אני אגיד רגע משהו, נורא נורא חשוב."
    },
    {
      "start": 148.0,
      "end": 154.0,
      "text": "אנחנו שבעה שם אנשים כולדותי, ברמות נורא נורא שונות בגילים שונים,"
    },
    {
      "start": 154.0,
      "end": 157.0,
      "text": "ולכן אני אנסה לדבר עם כמה שכוחות מושגים."
    },
    {
      "start": 157.0,
      "end": 161.0,
      "text": "אם אני אומר משהו וזה נשמע לכם כמו משג של הדם מכירים,"
    },
    {
      "start": 161.0,
      "end": 162.0,
      "text": "וזה בתוך הכי כמה די שוב,"
    },
    {
      "start": 163.0,
      "end": 166.0,
      "text": "אז מגניב, מזמין אתכם, לכתוב לכם את זה בצד,"
    },
    {
      "start": 166.0,
      "end": 168.0,
      "text": "פשוט אם אתם מתזרקו את המושג הזה להעביר,"
    },
    {
      "start": 168.0,
      "end": 170.0,
      "text": "זה קצת יכול להרטיע אנשים אחרים."
    },
    {
      "start": 171.0,
      "end": 176.0,
      "text": "אני כן הולך לדבר על נקודה שאלה של האם באמת משתמשים בזה,"
    },
    {
      "start": 176.0,
      "end": 179.0,
      "text": "כי זה קצת עמך עכשיו צריך למה שתיכנסו עכשיו לעשרה מפגשים"
    },
    {
      "start": 179.0,
      "end": 181.0,
      "text": "על משהו שאפשר להמשתמש בו."
    },
    {
      "start": 182.0,
      "end": 184.0,
      "text": "אוקיי, סבבה."
    },
    {
      "start": 184.0,
      "end": 188.0,
      "text": "אז אני רוצה רגע להכיל באיזושהי שאלה."
    },
    {
      "start": 188.0,
      "end": 192.0,
      "text": "אני אצטרך שתשתמשו קצת בעצמאות ובערמת יד פה,"
    },
    {
      "start": 192.0,
      "end": 195.0,
      "text": "פשוט כי יכול להיות שכולכם תרצו לנו את הלב שאלה,"
    },
    {
      "start": 195.0,
      "end": 196.0,
      "text": "ואז זה נורא מוזר."
    },
    {
      "start": 196.0,
      "end": 199.0,
      "text": "אז בערמת יד רגע עם הריקשן של הרי זנד."
    },
    {
      "start": 201.0,
      "end": 202.0,
      "text": "איך הייתם אומרים לבן אדם?"
    },
    {
      "start": 202.0,
      "end": 204.0,
      "text": "אם הייתם רוצים שייבד לכם תפוח."
    },
    {
      "start": 212.0,
      "end": 213.0,
      "text": "אוקיי, ירין."
    },
    {
      "start": 214.0,
      "end": 216.0,
      "text": "מה, אמוין שפשוט מבקשו?"
    },
    {
      "start": 216.0,
      "end": 218.0,
      "text": "איך אתה אומרת?"
    },
    {
      "start": 218.0,
      "end": 219.0,
      "text": "אוקיי, אתה מבקש ממרא."
    },
    {
      "start": 219.0,
      "end": 221.0,
      "text": "האם יש לך תפוח?"
    },
    {
      "start": 221.0,
      "end": 223.0,
      "text": "האם אתה יכול להביא לי אותו?"
    },
    {
      "start": 223.0,
      "end": 225.0,
      "text": "אוקיי."
    },
    {
      "start": 233.0,
      "end": 237.0,
      "text": "אני הייתי אומר כאילו,"
    },
    {
      "start": 237.0,
      "end": 242.0,
      "text": "אם הוא לא מבין מה לעשות, אתה אומר לו בדטליים."
    },
    {
      "start": 242.0,
      "end": 244.0,
      "text": "כאילו, אוקיי."
    },
    {
      "start": 244.0,
      "end": 246.0,
      "text": "כאילו למשל, אז,"
    },
    {
      "start": 246.0,
      "end": 249.0,
      "text": "לך למקום שאתה יודע שבו יש תפוחים,"
    },
    {
      "start": 250.0,
      "end": 252.0,
      "text": "ותביא לי אחד."
    },
    {
      "start": 252.0,
      "end": 255.0,
      "text": "אתה ביא אותו לפה ותביא לי בידיים."
    },
    {
      "start": 255.0,
      "end": 257.0,
      "text": "מגניב."
    },
    {
      "start": 257.0,
      "end": 260.0,
      "text": "מישהו ניסה פעם להגיד למחשב במילים,"
    },
    {
      "start": 260.0,
      "end": 266.0,
      "text": "אתה יכול מבקשה להראות לי את עמוד ויקיפדיה של מייקלדגסון,"
    },
    {
      "start": 266.0,
      "end": 270.0,
      "text": "או אתה יכול מבקשה למצוא לי מערכים הכי זולים ללא יודע מה,"
    },
    {
      "start": 270.0,
      "end": 273.0,
      "text": "ואני לא מדבר על קולטן סמת, אני מדבר על פשוט לדבר למחשב."
    },
    {
      "start": 273.0,
      "end": 275.0,
      "text": "נסיתם?"
    },
    {
      "start": 276.0,
      "end": 278.0,
      "text": "כאילו, כן."
    },
    {
      "start": 278.0,
      "end": 280.0,
      "text": "תלוי לאיזה, יש,"
    },
    {
      "start": 280.0,
      "end": 284.0,
      "text": "יש AI, יש את הגוג, יש את הברוזר, יש..."
    },
    {
      "start": 284.0,
      "end": 287.0,
      "text": "אוקיי, אז אני לא מדבר, אני לא מדבר למחשב,"
    },
    {
      "start": 287.0,
      "end": 290.0,
      "text": "שמקשיב לכם ומנסה לקרות מה את אומרים פשוט,"
    },
    {
      "start": 290.0,
      "end": 292.0,
      "text": "להציטם שהמחשב יעשה משהו,"
    },
    {
      "start": 292.0,
      "end": 294.0,
      "text": "ופשוט אמרתם לו, תעשה את זה."
    },
    {
      "start": 294.0,
      "end": 296.0,
      "text": "לא, כי זה קצת מוזר."
    },
    {
      "start": 296.0,
      "end": 298.0,
      "text": "למה? כי מחשבים"
    },
    {
      "start": 299.0,
      "end": 302.0,
      "text": "לא מבינים שפה של בני אדם."
    },
    {
      "start": 302.0,
      "end": 304.0,
      "text": "כן, אם אני אגיד למחשב,"
    },
    {
      "start": 304.0,
      "end": 306.0,
      "text": "תביא לי תפוח, הוא לא יעשה את זה."
    },
    {
      "start": 306.0,
      "end": 308.0,
      "text": "בין היתר כי אני לא תפוח, אבל גם כי הוא לא יודע מה אני רוצה,"
    },
    {
      "start": 308.0,
      "end": 310.0,
      "text": "הוא לא שומע את זה בכלל."
    },
    {
      "start": 310.0,
      "end": 313.0,
      "text": "איך מחשבים, כן, מתקשרים?"
    },
    {
      "start": 313.0,
      "end": 316.0,
      "text": "דרך, דרך שפה, כאילו,"
    },
    {
      "start": 316.0,
      "end": 319.0,
      "text": "נכון, אני אגיד שוב,"
    },
    {
      "start": 319.0,
      "end": 321.0,
      "text": "אני אגיד שוב, שאני ממש אשמח,"
    },
    {
      "start": 321.0,
      "end": 324.0,
      "text": "כאילו, אני אשמח שכזה, תחכו שאני"
    },
    {
      "start": 324.0,
      "end": 326.0,
      "text": "אתן לכם לדבר, פשוט כן, גם רוצה לתת,"
    },
    {
      "start": 326.0,
      "end": 328.0,
      "text": "אנחנו מכירים לסדמנות לחשוב, בסדר?"
    },
    {
      "start": 329.0,
      "end": 330.0,
      "text": "אוקיי, מעולה."
    },
    {
      "start": 331.0,
      "end": 333.0,
      "text": "אז כמו שאמרת,"
    },
    {
      "start": 333.0,
      "end": 335.0,
      "text": "מחשבים מדבר, מדבר,"
    },
    {
      "start": 335.0,
      "end": 337.0,
      "text": "בצורה טיפה אחרת."
    },
    {
      "start": 337.0,
      "end": 339.0,
      "text": "איך זה מראה פרקטית?"
    },
    {
      "start": 339.0,
      "end": 341.0,
      "text": "אז יש לו כזה..."
    },
    {
      "start": 345.0,
      "end": 346.0,
      "text": "איזה יגר."
    },
    {
      "start": 351.0,
      "end": 355.0,
      "text": "יש לו המון מנורות קטנות בדרך המחשב."
    },
    {
      "start": 355.0,
      "end": 357.0,
      "text": "יכול לתציור שלי במחשב קצת גרוע,"
    },
    {
      "start": 357.0,
      "end": 360.0,
      "text": "אבל אני אותך, כמו שיורם, ציל זרוע יותר טוב."
    },
    {
      "start": 361.0,
      "end": 364.0,
      "text": "אוקיי, יש לו חושבות המון מנורות קטנות,"
    },
    {
      "start": 364.0,
      "end": 366.0,
      "text": "אני מניח שזה מנורא, כי זה צבוע וצרון,"
    },
    {
      "start": 366.0,
      "end": 368.0,
      "text": "זה לא צבוע וצרון, בסדר?"
    },
    {
      "start": 369.0,
      "end": 372.0,
      "text": "יש המון-מון מנורות קטנות בדרך המחשב,"
    },
    {
      "start": 372.0,
      "end": 374.0,
      "text": "והוא מאכסן בתוכן,"
    },
    {
      "start": 374.0,
      "end": 376.0,
      "text": "עם מנורא עדוקה,"
    },
    {
      "start": 376.0,
      "end": 378.0,
      "text": "או לא, אם נרצה רגע להראות את זה,"
    },
    {
      "start": 378.0,
      "end": 380.0,
      "text": "איך זה נראה פרקטית."
    },
    {
      "start": 382.0,
      "end": 383.0,
      "text": "אז..."
    },
    {
      "start": 384.0,
      "end": 385.0,
      "text": "יגר."
    },
    {
      "start": 388.0,
      "end": 390.0,
      "text": "שעה עכשיו על זה ככה,"
    },
    {
      "start": 390.0,
      "end": 392.0,
      "text": "ככל מיני טעים, אוקיי?"
    },
    {
      "start": 392.0,
      "end": 394.0,
      "text": "ובוא נעשה..."
    },
    {
      "start": 396.0,
      "end": 400.0,
      "text": "לוק,"
    },
    {
      "start": 400.0,
      "end": 402.0,
      "text": "בבוי,"
    },
    {
      "start": 402.0,
      "end": 404.0,
      "text": "בבוי,"
    },
    {
      "start": 404.0,
      "end": 406.0,
      "text": "לוק,"
    },
    {
      "start": 406.0,
      "end": 408.0,
