--- repos/corewars8086-6.0.0-fast/src/main/java/il/co/codeguru/corewars8086/war/Ablation.java	1970-01-01 02:00:00.000000000 +0200
+++ repos/corewars8086-6.0.0-ablation/src/main/java/il/co/codeguru/corewars8086/war/Ablation.java	2026-10-01 03:01:45.725655400 +0300
@@ -0,0 +1,24 @@
+package il.co.codeguru.corewars8086.war;
+
+/**
+ * ABLATION BUILD ONLY: each flag restores the ORIGINAL code of one speedup, so its
+ * contribution can be measured alone and in combination. static final -> the JIT
+ * folds the unused branch away, so the toggles themselves cost nothing.
+ * Enable with -Dcw.orig.<name>=true.
+ */
+public final class Ablation {
+    public static final boolean ORIG_MULTICASTER = Boolean.getBoolean("cw.orig.multicaster");
+    public static final boolean ORIG_MEMEVENTS = Boolean.getBoolean("cw.orig.memevents");
+    public static final boolean ORIG_COUNT = Boolean.getBoolean("cw.orig.count");
+    public static final boolean ORIG_FILL = Boolean.getBoolean("cw.orig.fill");
+    public static final boolean ORIG_RANDOM = Boolean.getBoolean("cw.orig.random");
+    public static final boolean ORIG_REGIONS = Boolean.getBoolean("cw.orig.regions");
+
+    private Ablation() {
+    }
+
+    public static String describe() {
+        return "multicaster=" + ORIG_MULTICASTER + " memevents=" + ORIG_MEMEVENTS + " count=" + ORIG_COUNT
+            + " fill=" + ORIG_FILL + " random=" + ORIG_RANDOM + " regions=" + ORIG_REGIONS;
+    }
+}
