    },
    {
      "start": 847.28,
      "end": 848.64,
      "text": "טוב, ביי, אני צריך ללכת"
    },
    {
      "start": 848.68,
      "end": 850.96,
      "text": "אוקיי, בסדר, עכשיו, רגע, חבר'ה"
    },
    {
      "start": 851.88,
      "end": 857.0,
      "text": "יונתן, אני מציעה שתצטרף, אני רואה שאף..."
    },
    {
      "start": 857.8,
      "end": 860.68,
      "text": "כולם פה רוצים להישאר איתי או שיש פה חבר'ה שרוצים לעשות משהו"
    },
    {
      "start": 860.72,
      "end": 862.6,
      "text": "אני יכולה יותר מתקדם עם יונתן"
    },
    {
      "start": 863.0,
      "end": 864.48,
      "text": "תוכל פה שרוצים משהו יותר מתקדם"
    },
    {
      "start": 865.27,
      "end": 867.67,
      "text": "אתה... רומן אתה אצל את זה משהו יותר מתקדם?"
    },
    {
      "start": 867.87,
      "end": 869.67,
      "text": "כן, כי אני כל הזי עשם בלי"
    },
    {
      "start": 870.35,
      "end": 872.83,
      "text": "אוקיי, יונתן, תוכל להבורי אחת, רומן"
    },
    {
      "start": 873.31,
      "end": 875.07,
      "text": "יונתן, אתה עבור לחדר שלוש"
    },
    {
      "start": 875.11,
      "end": 878.11,
      "text": "וכל מי שרוצה עבורים קצת יותר מתקדמים, לעבור..."
    },
    {
      "start": 878.15,
      "end": 883.35,
      "text": "סבבה, יהודה, רק אני צריך לצאת מהבית עוד חמש דקות"
    },
    {
      "start": 883.39,
      "end": 886.27,
      "text": "אז זה בסדר, אם אני מביא את היותם ברכן, אלא"
    },
    {
      "start": 886.39,
      "end": 888.59,
      "text": "שיחליפו תיקילו, שיראו אותי מטבע..."
    },
    {
      "start": 888.63,
      "end": 891.11,
      "text": "תבדוק את הכול עם כלים זה עובד, וכן..."
    },
    {
      "start": 891.47,
      "end": 895.59,
      "text": "סבבה, אם אתה רוצה עוד חמש דקות, אז בעצם אין לנו עוד מישהו לחדר"
    },
    {
      "start": 896.35,
      "end": 900.03,
      "text": "רומן, אני משעתי את היותם, אם לא היותם, אז אולי גייטוב"
    },
    {
      "start": 900.03,
      "end": 904.03,
      "text": "פשוט גייטוב יצא עלי כמה שניות, אני ממלא בשבילו בחרים"
    },
    {
      "start": 904.07,
      "end": 907.51,
      "text": "אני לא יודע כמו כשגייטוב יש מספיק ידע בשביל, לגייטוב יותר במקום הטכני"
    },
    {
      "start": 907.55,
      "end": 909.31,
      "text": "אני לא חושב שהוא יוכל לעשות את זה"
    },
    {
      "start": 909.35,
      "end": 914.35,
      "text": "סבבה, שאלכתי לי אותם, הוא אמר שסבבה שאותם השני אמר לו שהוא הסתדר"
    },
    {
      "start": 914.39,
      "end": 916.03,
      "text": "אז אני אוהבור לשלוש"
    },
    {
      "start": 916.07,
      "end": 918.03,
      "text": "בסדר, אז תדגו לזה..."
    },
    {
      "start": 918.07,
      "end": 920.87,
      "text": "למי שרוצה משהו יותר מתקדמים"
    },
    {
      "start": 920.91,
      "end": 923.67,
      "text": "לעבור לחדר של..."
    },
    {
      "start": 923.71,
      "end": 927.27,
      "text": "לעבור לחדר של יותם, לחדר מספר שלוש"
    },
    {
      "start": 927.43,
      "end": 931.91,
      "text": "חדר מספר שלוש, חדר מספר שלוש, כל מי שעודי הסמבלי, אבל עדיין"
    },
    {
      "start": 931.95,
      "end": 937.23,
      "text": "לא לגמרי מתקדם בתחרות, חבר'ה שחדשים לקודגורו, אבל עודים הסמבלי"
    },
    {
      "start": 937.27,
      "end": 942.31,
      "text": "שמתקדמים מעבר לשיטור את הספרה, אתם מוזמנים לעבור אליי"
    },
    {
      "start": 942.35,
      "end": 943.95,
      "text": "אני עשמיע ליותר מתקדם"
    },
    {
      "start": 943.99,
      "end": 947.08,
      "text": "קודם, קודם, כאילו, הכתוב קודם"
    },
    {
      "start": 947.12,
      "end": 951.68,
      "text": "גם יקדל לי שהר איתי בגדול, מי שלא מכיר את התחרות"
    },
    {
      "start": 951.72,
      "end": 954.4,
      "text": "רגע אחד, פתחו להתודה לתפה"
    },
    {
      "start": 954.44,
      "end": 956.96,
      "text": "סליחה, אופה"
    },
    {
      "start": 956.96,
      "end": 958.24,
      "text": "בסדר? יאללה"
    },
    {
      "start": 958.28,
      "end": 961.12,
      "text": "אוקיי, חבר'ה, חבר'ה ללד זמן, ממשיכים"
    },
    {
      "start": 961.16,
      "end": 963.68,
      "text": "אז בעצם הסברנו בקטע הזה"
    },
    {
      "start": 963.72,
      "end": 968.48,
      "text": "איך אני מבין, יודע לי קרוקות, בואו נסתכל על זה שופה"
    },
    {
      "start": 968.52,
      "end": 974.33,
      "text": "אני אסשר, ואם אני ייכנס עכשיו לתוך..."
    },
    {
      "start": 974.37,
      "end": 978.97,
      "text": "אם אני ייכנס עכשיו..."
    },
    {
      "start": 979.01,
      "end": 982.85,
      "text": "קודרול, רגע, קודרולי, יליד קודרולי"
    },
    {
      "start": 982.89,
      "end": 986.49,
      "text": "אם אני ייכנס לפה, אני בעצם יכול לקרוא, האם כולכם מבינים"
    },
    {
      "start": 986.49,
      "end": 990.17,
      "text": "שאני יכול לקרוא, שבעצם ה-1 הזה"
    },
    {
      "start": 990.21,
      "end": 997.65,
      "text": "זה מנורה 8, 4 ו-2 קבויה, ומחרק מנורה 1 דלוקה, אם זה מובן?"
    },
    {
      "start": 997.69,
      "end": 1003.61,
      "text": "ופה זה מורה... איזה 14, 8, 4 ו-2 דלוקה"
    },
    {
      "start": 1003.65,
      "end": 1007.61,
      "text": "ואחת קבויה, זה 1, 1, 1, 0, האם זה מובן?"
    },
    {
      "start": 1007.65,
      "end": 1011.56,
      "text": "למה זה... מנורה הזאת, המנורה הזאת"
    },
    {
      "start": 1011.6,
      "end": 1014.0,
      "text": "רגע, אך בר שזה לא זזטול..."
    },
    {
      "start": 1014.04,
      "end": 1018.11,
      "text": "אבל למה זה 1, 1, 0?"
    },
    {
      "start": 1018.15,
      "end": 1021.39,
      "text": "אוקיי, אני אסגל"
    },
    {
      "start": 1021.39,
      "end": 1029.45,
      "text": "האם מובן שכל עוד פה מייצגת 4 מנורות, האם זה מובן?"
    },
    {
      "start": 1029.49,
      "end": 1031.17,
      "text": "אני חושב"
    },
    {
      "start": 1031.21,
      "end": 1034.57,
      "text": "אז איך אתה תגיע למספר 1?"
    },
    {
      "start": 1034.61,
      "end": 1036.77,
      "text": "אם יש לך מנורה 8, 4, 2 ואחת"
    },
    {
      "start": 1036.81,
      "end": 1040.77,
      "text": "תכווה את 8, 4 ו-2, ותדליק רק את 1, נכון?"
    },
    {
      "start": 1040.81,
      "end": 1041.61,
      "text": "נכון"
    },
    {
      "start": 1041.65,
      "end": 1045.73,
      "text": "וזה 0, 0, 0, 1, מובן?"
    },
    {
      "start": 1045.77,
      "end": 1048.57,
      "text": "0, 0, 0, אוקיי"
    },
    {
      "start": 1048.61,
      "end": 1052.27,
      "text": "ועוד E, מה זה העוד E?"
    },
    {
      "start": 1052.27,
      "end": 1055.15,
      "text": "עוד E זה 14"
    },
    {
      "start": 1055.19,
      "end": 1060.75,
      "text": "14, אז 14 זה 8, 4 ו-2 דלוקות ואחת קבויה, נכון?"
    },
    {
      "start": 1060.79,
      "end": 1061.75,
      "text": "אוקיי"
    },
    {
      "start": 1061.79,
      "end": 1066.4,
      "text": "אז 1, 1, 1, 0, בסדר?"
    },
    {
      "start": 1066.44,
      "end": 1067.08,
      "text": "אוקיי"
    },
    {
      "start": 1067.12,
      "end": 1068.76,
      "text": "למה E זה 14?"
    },
    {
      "start": 1068.8,
      "end": 1071.12,
      "text": "איזה 10?"
    },
    {
      "start": 1071.16,
      "end": 1076.2,
      "text": "A זה 10, B זה 11, C זה 12, D זה 13"
    },
    {
      "start": 1076.24,
      "end": 1081.54,
      "text": "E זה 14, B זה 15, מובן?"
    },
    {
      "start": 1081.58,
      "end": 1083.44,
      "text": "אוקיי"
    },
    {
      "start": 1083.6,
      "end": 1086.48,
      "text": "זה אנחנו סופרים פשוט באקסד בצימלי"
    },
    {
      "start": 1086.52,
      "end": 1088.72,
      "text": "אני לא כנס עכשיו להסברים שבספרי ספירה"
    },
    {
      "start": 1088.76,
      "end": 1089.8,
      "text": "אבל עכשיו אני רוצה, אוקיי"
    },
    {
      "start": 1089.84,
      "end": 1092.12,
      "text": "עכשיו אני רוצה להיכנס לתחרות עצמה, בסדר?"
    },
    {
      "start": 1092.16,
      "end": 1095.12,
      "text": "אבל איך סופרת 1, 1, 1, 0"
    },
    {
      "start": 1095.16,
      "end": 1097.04,
      "text": "לגי כשאמרת שזה E?"
    },
    {
      "start": 1097.08,
      "end": 1100.84,
      "text": "אימן, למשל אתה רואה פה שכתוב 1E?"
    },
    {
      "start": 1100.88,
      "end": 1102.96,
      "text": "זה בת"
    },
    {
      "start": 1103.0,
      "end": 1106.0,
      "text": "אהלן, אתה שואל אותי אלן?"
    },
    {
      "start": 1106.04,
      "end": 1106.96,
      "text": "כן"
    },
    {
      "start": 1107.0,
      "end": 1111.16,
      "text": "אלן, אני לא פשוט לא, לא בהכרוא על מי שואל אותי"
    },
    {
      "start": 1111.2,
      "end": 1113.04,
      "text": "אלן, אתה רואה פה שכתוב"
    },
    {
      "start": 1113.04,
      "end": 1116.96,
      "text": "כל מספר בו זה מציין 4 מנורא"
    },
    {
      "start": 1117.0,
      "end": 1118.92,
      "text": "8, 4, 2, 1"
    },
    {
      "start": 1118.96,
      "end": 1120.96,
      "text": "איך את מקבלת את המספר 1?"
    },
    {
      "start": 1121.0,
      "end": 1122.96,
      "text": "את מחבק 8, 8, 1"
    },
    {
      "start": 1123.0,
      "end": 1125.12,
      "text": "כרק את 1, האם זה ככה?"
    },
    {
      "start": 1125.16,
      "end": 1126.52,
      "text": "כן"
    },
    {
      "start": 1126.56,
      "end": 1130.24,
      "text": "אימן, למשל, אם המנורא, פוקטוב 8"
    },
    {
      "start": 1130.28,
      "end": 1132.64,
      "text": "8 זה דווקא מנורא, אז מעוד את זה"
    },
    {
      "start": 1132.68,
      "end": 1134.76,
      "text": "1, 0, 0, 0, אין זה ככה?"
    },
    {
      "start": 1134.8,
      "end": 1139.14,
      "text": "אה?"
    },
    {
      "start": 1139.18,
      "end": 1140.42,
      "text": "אלן, את מבינה?"
    },
    {
      "start": 1140.46,
      "end": 1141.1,
      "text": "אה?"
    },
    {
      "start": 1141.14,
      "end": 1143.14,
      "text": "אה, אני לא פשוט לא בהכרוא"
    },
    {
      "start": 1143.18,
      "end": 1145.3,
      "text": "אוקיי, אז אני אסביר את זה את זה"
    },
    {
      "start": 1145.3,
      "end": 1148.3,
      "text": "רק רגע, אלן, תראי"
    },
    {
      "start": 1148.34,
      "end": 1155.02,
      "text": "יש לנו, יש לנו 8 מנורות לכל ספר, בסדר?"
    },
    {
      "start": 1155.06,
      "end": 1161.57,
      "text": "4 מנורות לכל ספר, 1, 2, 3, 4"
    },
    {
      "start": 1161.61,
      "end": 1164.79,
      "text": "עכשיו, המנורא הזאת"
    },
    {
      "start": 1164.83,
      "end": 1167.11,
      "text": "זה מנורא שהאבק שלה הוא שם"
    },
    {
      "start": 1167.15,
      "end": 1169.65,
      "text": "המנורא הזאת 1"
    },
    {
      "start": 1169.69,
      "end": 1173.12,
      "text": "רגע, המנורא הזאת זה 1"
    },
    {
      "start": 1173.16,
      "end": 1175.44,
      "text": "המנורא הזאת זה 2"
    },
    {
      "start": 1175.44,
      "end": 1179.6,
      "text": "המנורא הזאת זה 4"
    },
    {
      "start": 1179.64,
      "end": 1185.94,
      "text": "והמנורא הזאת זה 8, האם זה מובן?"
    },
    {
      "start": 1185.98,
      "end": 1188.79,
      "text": "שם, אני לא מדבר"
    },
    {
      "start": 1188.83,
      "end": 1191.99,
      "text": "אם אני רוצה, אם אני אומרת, תדליק לי אותה"
    },
    {
      "start": 1192.03,
      "end": 1195.22,
      "text": "תדליק לי את המנורות האלה, ועוד אי"
    },
    {
      "start": 1195.26,
      "end": 1198.22,
      "text": "כמה זה העוד אי? זוכרת זוכרת?"
    },
    {
      "start": 1198.26,
      "end": 1201.34,
      "text": "כן, 8, 4 ו..."
    },
    {
      "start": 1201.38,
      "end": 1203.22,
      "text": "לא, העוד אי, העוד אי זה"
    },
    {
      "start": 1203.26,
      "end": 1205.86,
      "text": "העוד אי מייצג את המספר 14"
    },
    {
      "start": 1205.9,
      "end": 1206.82,
      "text": "אני לא זוכרת?"
    },
    {
      "start": 1206.86,
      "end": 1208.22,
      "text": "כן"
    },
    {
      "start": 1208.26,
      "end": 1209.42,
      "text": "זוכרת?"
    },
    {
      "start": 1209.46,
      "end": 1209.82,
      "text": "כן"
    },
    {
      "start": 1209.82,
      "end": 1212.82,
      "text": "איך אני יצא פה את המספר 14? מה אני אצא?"
    },
    {
      "start": 1212.86,
      "end": 1214.7,
      "text": "8, 4 ו-2"
    },
    {
      "start": 1214.74,
      "end": 1218.1,
      "text": "איזה יוקד, 8, 4 ו-2"
    },
    {
      "start": 1218.14,
      "end": 1221.26,
      "text": "מה זה 8, 4 ו-2?"
    },
    {
      "start": 1221.3,
      "end": 1225.94,
      "text": "1, 1, 1, 0"
    },
    {
      "start": 1225.98,
      "end": 1227.14,
      "text": "האם זה מובן?"
    },
    {
      "start": 1227.18,
      "end": 1228.3,
      "text": "כן"
    },
    {
      "start": 1228.34,
      "end": 1229.82,
      "text": "זהו, זה כל העניין"
    },
    {
      "start": 1229.86,
      "end": 1232.78,
      "text": "סבבה, גמרנו את השלב הזה, ספרנו"
    },
    {
      "start": 1232.82,
      "end": 1235.74,
      "text": "איך אתה ראה איתה של השלב הזה"
    },
    {
      "start": 1235.78,
      "end": 1238.46,
      "text": "להסתכל על קוד בתוך הזיכרון"
    },
    {
      "start": 1238.46,
      "end": 1240.9,
      "text": "ולהיות מסוגל להמיר אותו לביטים"
    },
    {
      "start": 1240.94,
      "end": 1242.97,
      "text": "האם זה מובן?"
    },
    {
      "start": 1243.01,
      "end": 1246.37,
      "text": "זאת אומרת, שנבין מה זה, את המסעותיות האלה שאנחנו רואים"
    },
    {
      "start": 1246.41,
      "end": 1247.89,
      "text": "כולם פה הבינו את העיקרון"
    },
    {
      "start": 1247.93,
      "end": 1249.61,
      "text": "גם אם אתם לא יודעים, תרגם את זה בקלות"
    },
    {
      "start": 1249.65,
      "end": 1251.75,
      "text": "כולם הבינו"
    },
    {
      "start": 1251.79,
      "end": 1255.35,
      "text": "ואני רוצה לראות רצף של קודים, של אופ קודים"
    },
    {
      "start": 1255.39,
      "end": 1258.11,
      "text": "ולהבין איך להמיר את זה, איך להמיר את זה"
    },
    {
      "start": 1258.15,
      "end": 1259.71,
      "text": "ל-1, 1, 0, 0"
    },
    {
      "start": 1259.75,
      "end": 1261.44,
      "text": "עכשיו אני עובר"
    },
    {
      "start": 1261.48,
      "end": 1264.4,
      "text": "עכשיו אני עובר ללכתו תוכנית ממש"
    },
    {
      "start": 1264.44,
      "end": 1265.87,
      "text": "בסדר?"
    },
    {
      "start": 1265.91,
