# Machine-specific environments and caches
.venv/
**/__pycache__/
*.py[cod]

# Local metadata retained from repositories vendored into this lab
**/.nested-git/

# OS/editor noise
.DS_Store
Thumbs.db
*.swp

# Regenerable optimization scratch data. Aggregate audit JSONs stay in experiments/.
build/chimera/
build/chimera-asymmetric/
build/chimera-extensions/
build/chimera-focused/
build/field-baselines/
build/official-runs/*-2025-*/
build/official-runs/k*/
build/official-runs/l*/
build/official-runs/m*/
build/final/Chimera*.lst

# Per-candidate screen/sweep configs are generated from the templates and
# recorded environment variables; the aggregate result JSONs remain tracked.
config-screen-[klm]*.json
config-sweep-[klm]*.json
